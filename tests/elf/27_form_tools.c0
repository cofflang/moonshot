// expect: 0
// What form's scale and mirror made of tools.form, in the root, for
// verify_form_tools.sh, which scales the first side of a new cube, the one
// at x low, and mirrors it. 1 when there are not 14 faces, 2 when not 12
// corners, 3 when the two new faces are not the side's two mirrored, each
// corner's x negated and the corners in the other order. Otherwise 100
// plus the largest coordinate in sixteenths of a unit. There is no
// tools.form when the ELF tests run on their own, so then it is 0.
include "djup.c0";

// 1 when corner w is corner v with its x negated.
int mirrored(int m, int v, int w) {
    int p = djup_vert(m, v);
    int q = djup_vert(m, w);
    return load64(q) == 0 - load64(p) && load64(q + 8) == load64(p + 8) && load64(q + 16) == load64(p + 16);
}

int main() {
    int m = djup_load("/tools.form", 512, 1024);
    if (!m) { return 0; }
    if (m.dh_faces != 14) { return 1; }
    if (m.dh_verts != 12) { return 2; }
    int f = 0;
    for (f = 0; f < 2; f += 1) {
        int a = djup_face(m, f);
        int b = djup_face(m, 12 + f);
        if (!mirrored(m, load64(a), load64(b)) || !mirrored(m, load64(a + 16), load64(b + 8))
            || !mirrored(m, load64(a + 8), load64(b + 16))) {
            return 3;
        }
    }
    int most = 0;
    int i = 0;
    for (i = 0; i < m.dh_verts; i += 1) {
        int k = 0;
        for (k = 0; k < 3; k += 1) {
            int c = load64(djup_vert(m, i) + k * 8);
            if (c < 0) { c = 0 - c; }
            if (c > most) { most = c; }
        }
    }
    return 100 + most / 4096;
}
