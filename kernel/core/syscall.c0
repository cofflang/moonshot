// syscall.c0 -- SYSCALL/SYSRET dispatch and ring-3 entry.

int SYS_EXIT       = 0;
int SYS_DEBUG_PRINT = 1;
int SYS_WIN_INFO    = 2;
int SYS_FILL        = 3;
int SYS_KEY_POLL    = 4;
int SYS_ALLOC       = 6;
int SYS_TICKS       = 7;
int SYS_READFILE    = 8;
int SYS_PRESENT     = 9;
int SYS_WIN_MAX     = 10;
int SYS_MOUSE_POLL  = 11;
int SYS_GLYPH       = 12;
int SYS_DEALLOC     = 13;
int SYS_SOUND       = 14;
int SYS_WRITEFILE   = 15;
int SYS_SLEEP       = 16;
int SYS_ARGC        = 17;
int SYS_ARGV        = 18;
int SYS_LISTDIR     = 19;
int SYS_SPAWN       = 20;
int SYS_PROTECT     = 21;
int SYS_EDIT        = 22;
int SYS_OPEN        = 23;
int SYS_READ        = 24;
int SYS_WRITE       = 25;
int SYS_CLOSE       = 26;
int SYS_EXIT_CLOSE  = 27;
int SYS_SHELL       = 28;
int SYS_WAIT        = 29;
int SYS_REMOVE      = 30;
int SYS_SOUND_FORMAT = 31;
int SYS_CLOSE_KEY   = 32;
int SYS_CLOCK       = 33;
int SYS_INFO        = 34;
int SYS_KILL        = 35;
int SYS_POINTER     = 36;
int SYS_WHEEL       = 37;
int SYS_READFILE_OWNED = 38;

// --- a program's memory ------------------------------------------------------
//
// Every pointer a program passes is checked here, once, before the kernel
// reads or writes through it. A span of a program's memory is good when it
// lies wholly in [USER_VIRT_BASE, USER_TOP), outside what the process shares
// with the kernel's root, and every page of it is present with U set at
// every level of the caller's own tables, and W too for a span the kernel
// writes. That takes in the ELF segments, the stack and the heap up to
// task_heap_mapped_base, and leaves out lager's block table, which is
// supervisor-only, the reserved heap not yet mapped, and every kernel page.
// The sums are taken as differences, so no length wraps the check.
//
// What makes a span that passed still good when it is copied is that
// interrupts are off from the SYSCALL instruction to SYSRET, and this kernel
// runs on one CPU, so nothing can change the program's tables or its bytes
// in between. That is asserted, at sys_dispatch's entry and in every check,
// and a handler that waits with interrupts on (SYS_SLEEP, SYS_WAIT) touches
// no program memory while it waits.

// Stops the kernel when interrupts are on where they must be off. The
// assertion above, a kernel bug and never a program's.
void user_assert_irq_off(int where) {
    int fl = read_flags;
    if ((fl() & 512) == 0) { return; }
    int off = disable_interrupts;
    off();
    serial_print("KERNEL PANIC: interrupts on in ");
    serial_print(where);
    serial_print("\n");
    while (1) { halt(); }
    return;
}

// 1 when the page at `va` is present, not a large page and user-accessible
// at every level under `root`, and writable at every level too when `write`
// is 1.
int user_page(int root, int va, int write) {
    int need = 5;
    if (write) { need = 7; }
    int t = root;
    int level = 0;
    for (level = 0; level < 4; level += 1) {
        int e = load64(t + pt_index(va, level) * 8);
        if ((e & need) != need) { return 0; }
        if (level > 0 && level < 3 && (e & 128) != 0) { return 0; }
        t = e & PTE_ADDR;
    }
    return 1;
}

// 1 when the n bytes at p are the calling program's own, readable by the
// kernel for `write` 0 and writable for `write` 1, as the comment above
// describes. A zero length is good and is never looked at, a negative one
// never is.
int user_span(int p, int n, int write) {
    user_assert_irq_off("user_span");
    if (n < 0) { return 0; }
    if (n == 0) { return 1; }
    if (p < USER_VIRT_BASE || p >= USER_TOP || n > USER_TOP - p) { return 0; }
    int root = load64(task_cr3_base + sched_current * 8);
    int cr3 = read_cr3;
    if (root == pml4_phys || (cr3() & PTE_ADDR) != root) { return 0; }
    if (!pt_private_range(root, p - (p & 4095), p + n)) { return 0; }
    int va = p - (p & 4095);
    while (va < p + n) {
        if (!user_page(root, va, write)) { return 0; }
        va += 4096;
    }
    return 1;
}

// Fixed task records exist before task creation and require no fault-time allocation.
// Four slots hold kind and pointer pairs, followed by the draw restoration flag.
int user_context(int tid) {
    if (tid < 0 || tid >= MAX_TASKS || MAX_TASKS > 8) {
        jenna_stop("KERNEL PANIC: user context index\n");
    }
    return user_context_records + tid * 192;
}

int user_reserve(int kind) {
    user_assert_irq_off("user_reserve");
    int c = user_context(sched_current);
    int i = 0;
    for (i = 3; i >= 0; i -= 1) {
        int slot = c + 64 + i * 16;
        if (!load64(slot)) {
            store64(slot, kind);
            store64(slot + 8, 0);
            return slot;
        }
    }
    return 0;
}

void user_release_slot(int slot) {
    int kind = load64(slot);
    int ptr = load64(slot + 8);
    store64(slot, 0);
    store64(slot + 8, 0);
    if (ptr) {
        if (kind == 1) { kfree(ptr); }
        else if (kind == 2) { jakel_dfree(ptr); }
        else { jenna_stop("KERNEL PANIC: user cleanup kind\n"); }
    }
    return;
}

int user_temp_alloc(int n) {
    int slot = user_reserve(1);
    if (!slot) { return 0; }
    int ptr = kmalloc(n);
    if (!ptr) { user_release_slot(slot); return 0; }
    store64(slot + 8, ptr);
    return ptr;
}

void user_temp_free(int ptr) {
    user_assert_irq_off("user_temp_free");
    int c = user_context(sched_current);
    int i = 0;
    for (i = 0; i < 4; i += 1) {
        int slot = c + 64 + i * 16;
        if (load64(slot) && load64(slot + 8) == ptr) {
            user_release_slot(slot);
            return;
        }
    }
    jenna_stop("KERNEL PANIC: unowned user temporary\n");
    return;
}

void user_cleanup(int tid) {
    user_assert_irq_off("user_cleanup");
    int c = user_context(tid);
    store64(c, 0);
    int i = 0;
    for (i = 0; i < 4; i += 1) { user_release_slot(c + 64 + i * 16); }
    if (load64(c + 128)) {
        store64(c + 128, 0);
        klick_drop();
    }
    return;
}

// The descriptor exists only for this nonblocking transfer and its exact span.
int user_begin(int p, int n, int write) {
    if (!user_span(p, n, write)) { return 0; }
    int c = user_context(sched_current);
    if (load64(c)) { jenna_stop("KERNEL PANIC: nested user transfer\n"); }
    store64(c + 8, load64(task_cr3_base + sched_current * 8));
    store64(c + 16, p);
    store64(c + 24, p + n);
    store64(c + 32, write);
    store64(c, 1);
    return c;
}

int user_fault(int vector, int errcode, int cr2, int rip, int frame) {
    if (vector != 13 && vector != 14) { return 0; }
    if ((load64(frame + 144) & 3) != 0) { return 0; }
    int c = user_context(sched_current);
    int rd = user_access_read;
    int re = user_access_read_end;
    int wr = user_access_write_site;
    int we = user_access_write_end;
    int write = load64(c + 32);
    if (write == 0) { if ((rip < rd || rip >= re) && rip != user_blit_read_site && rip != user_copy_read_site) { return 0; } }
    else { if (rip < wr || rip >= we) { return 0; } }
    int cr = read_cr3;
    int root = load64(task_cr3_base + sched_current * 8);
    int fl = read_flags;
    if (load64(c) != 1 || load64(c + 8) != root || (cr() & PTE_ADDR) != root
            || root == pml4_phys || (fl() & 512) != 0) { return 0; }
    if (vector == 14 && (cr2 < load64(c + 16) || cr2 >= load64(c + 24))) { return 0; }
    int sb = load64(task_stack_base + sched_current * 8);
    if (frame < sb || frame > sb + TASK_STACK_SIZE - 176) { return 0; }
    int sp = load64(frame + 160);
    if (sp < sb || sp > sb + TASK_STACK_SIZE) { return 0; }
    store64(c, 2);
    store64(c + 48, vector);
    store64(c + 56, rip);
    store64(frame + 136, user_abort_landing);
    return 1;
}

int user_abort_stack() {
    return load64(task_stack_base + sched_current * 8) + TASK_STACK_SIZE;
}

void user_abort_finish() {
    user_assert_irq_off("user_abort_finish");
    int me = sched_current;
    int c = user_context(me);
    if (load64(c) != 2) { jenna_stop("KERNEL PANIC: user abort state\n"); }
    int vector = load64(c + 48);
    user_cleanup(me);
    task_set_end(me, 2, vector);
    store64(task_state_base + me * 8, TASK_EXITED);
    int sl = serial_line_begin();
    serial_print("[usercopy] stopped task ");
    serial_print_int(me);
    serial_print(" vector=");
    serial_print_int(vector);
    serial_print("\n");
    serial_line_end(sl);
    int on = enable_interrupts;
    on();
    while (1) { cpu_wait(); }
    return;
}

int user_read_byte(int p) {
    int c = user_begin(p, 1, 0);
    if (!c) { jenna_stop("KERNEL PANIC: invalid internal user read\n"); }
    int access = user_access_read;
    int v = access(p);
    store64(c, 0);
    return v;
}

void user_write_byte(int p, int v) {
    int c = user_begin(p, 1, 1);
    if (!c) { jenna_stop("KERNEL PANIC: invalid internal user write\n"); }
    int access = user_access_write;
    access(p, v);
    store64(c, 0);
    return;
}

void user_write_word(int p, int v, int n) {
    int c = user_begin(p, n, 1);
    if (!c) { jenna_stop("KERNEL PANIC: invalid internal user word\n"); }
    int access = user_access_write;
    int i = 0;
    for (i = 0; i < n; i += 1) { access(p + i, v & 255); v = v >> 8; }
    store64(c + 16, p + n);
    store64(c, 0);
    return;
}

int user_read_next(int c, int n) {
    user_assert_irq_off("user_read_next");
    int cr = read_cr3;
    if (c != user_context(sched_current) || load64(c) != 1 || load64(c + 32) != 0
            || load64(c + 8) != (cr() & PTE_ADDR)
            || load64(c + 8) != load64(task_cr3_base + sched_current * 8) || n < 0 || n > 8
            || n > load64(c + 24) - load64(c + 16)) {
        jenna_stop("KERNEL PANIC: invalid user descriptor\n");
    }
    int p = load64(c + 16);
    int access = user_access_read;
    int v = 0;
    int i = 0;
    for (i = 0; i < n; i += 1) { v |= access(p + i) << (i * 8); }
    store64(c + 16, p + n);
    return v;
}

// Copies n bytes of the program's memory at p into the kernel's dst. 1, or
// 0 with nothing read when the span is not the caller's to read.
int user_copy_in(int dst, int p, int n) {
    int c = user_begin(p, n, 0);
    if (!c) { return 0; }
    int access = user_copy_read;
    access(dst, p, n);
    store64(c + 16, p + n);
    store64(c, 0);
    return 1;
}

// Copies n bytes of the kernel's src into the program's memory at p. 1, or
// 0 with nothing written when the span is not the caller's to write.
int user_copy_out(int p, int src, int n) {
    int c = user_begin(p, n, 1);
    if (!c) { return 0; }
    int access = user_access_write;
    int i = 0;
    for (i = 0; i < n; i += 1) { access(p + i, load8(src + i)); }
    store64(c + 16, p + n);
    store64(c, 0);
    return 1;
}

// Copies the string at the program's p into the kernel's dst, which holds
// cap bytes, stopping after its NUL or at cap - 1 bytes, and ends it with a
// NUL. Each byte is read once, and a page is checked as the string reaches
// it, so a short string at the end of the program's memory is good and a
// page past its NUL is never looked at. Returns the length, or -1 when a
// byte before the NUL is not the caller's.
int user_copy_text(int dst, int p, int cap) {
    user_assert_irq_off("user_copy_text");
    if (cap <= 0) { return 0 - 1; }
    if (p < USER_VIRT_BASE || p >= USER_TOP) { return 0 - 1; }
    int i = 0;
    for (i = 0; i < cap - 1; i += 1) {
        if (i == 0 || ((p + i) & 4095) == 0) {
            if (p + i >= USER_TOP || !user_span(p + i, 1, 0)) { return 0 - 1; }
        }
        int c = user_read_byte(p + i);
        store8(dst + i, c);
        if (!c) { return i; }
    }
    store8(dst + i, 0);
    return i;
}

// Copies a path out of user memory into a fresh kmalloc'd buffer, bounded by
// what jakel allows, and returns it (the caller releases its slot), or 0, for a
// path that is not the caller's to read too.
//
// Its own buffer, never jakel's name scratch, which is where jakel_open
// builds each component. A path copied there would have its '/' overwritten
// by the first component's terminating 0, so "test/x" would resolve to the
// directory "test".
int sys_copy_path(int src) {
    int max = JAKEL_NAME_LEN * 4;
    int buf = user_temp_alloc(max);
    if (!buf) { return 0; }
    if (user_copy_text(buf, src, max) < 0) {
        user_temp_free(buf);
        return 0;
    }
    return buf;
}

// The kernel's bounce buffer for console output, which is copied out of the
// program a piece at a time and printed from here. Taken on first use.
int USER_BOUNCE = 256;
int user_bounce = 0;


// A ring-3 process's open files, FD_SLOTS of them per task. Slot i is fd
// i + 3, since 0, 1 and 2 are the console. A slot holds its jakel id plus 1
// (0 for a free slot), the offset the next read or write starts at, and 1
// when it was opened for writing. The ELF loader empties a task's slots, so
// nothing a previous process in that task left open carries over.
int FD_SLOTS = 8;
// Per task, the directory SYS_OPEN's relative paths start from, the shell's
// current directory when start ran the program. 0, the root, for anything
// started some other way.
int task_cwd_base = 0;

// Per task, 1 when what the program prints goes to the serial line only,
// for a program another one runs in the background (SYS_SPAWN's flag 1).
int task_quiet_base = 0;

int task_quiet(int tid) {
    if (!task_quiet_base) { return 0; }
    return load64(task_quiet_base + tid * 8);
}

void task_set_quiet(int tid, int q) {
    if (!task_quiet_base) {
        task_quiet_base = kmalloc(MAX_TASKS * 8);
        if (!task_quiet_base) { return; }
        int i = 0;
        for (i = 0; i < MAX_TASKS; i += 1) { store64(task_quiet_base + i * 8, 0); }
    }
    store64(task_quiet_base + tid * 8, q);
    return;
}

// Per task, the line it is printing, held back from the serial line until it
// ends. A program often prints one line in several writes (coff writes its
// message a word at a time), and between two of them the timer can switch
// tasks, so a kernel line or another task's would land in its middle. The
// line goes out whole at its newline, when the hold is full, and before the
// task does anything other than print, so it still comes before what that
// call logs. What is left when the task ends goes out when it exits or is
// reaped. The screen gets every byte at once as before.
int SERIAL_HOLD = 256;
int task_hold_base = 0;
int task_hold_len_base = 0;

void task_hold_flush(int tid) {
    if (!task_hold_len_base || tid < 0 || tid >= MAX_TASKS) { return; }
    int n = load64(task_hold_len_base + tid * 8);
    if (n == 0) { return; }
    store64(task_hold_len_base + tid * 8, 0);
    int at = task_hold_base + tid * SERIAL_HOLD;
    int sl = serial_line_begin();
    int i = 0;
    for (i = 0; i < n; i += 1) { serial_putc(load8(at + i)); }
    serial_line_end(sl);
    return;
}

void task_hold_putc(int tid, int ch) {
    // Both tables are zeroed before they are published. Without them the
    // byte goes straight out, as it would with no hold at all.
    if (!task_hold_base) {
        int hb = kmalloc(MAX_TASKS * SERIAL_HOLD);
        int lb = kmalloc(MAX_TASKS * 8);
        if (hb && lb) {
            int i = 0;
            for (i = 0; i < MAX_TASKS; i += 1) { store64(lb + i * 8, 0); }
            task_hold_len_base = lb;
            task_hold_base = hb;
        } else {
            if (hb) { kfree(hb); }
            if (lb) { kfree(lb); }
        }
    }
    if (!task_hold_base || tid < 0 || tid >= MAX_TASKS) {
        serial_putc(ch);
        return;
    }
    int n = load64(task_hold_len_base + tid * 8);
    store8(task_hold_base + tid * SERIAL_HOLD + n, ch);
    store64(task_hold_len_base + tid * 8, n + 1);
    if (ch == '\n' || n + 1 == SERIAL_HOLD) { task_hold_flush(tid); }
    return;
}

// Per task, 1 while the task runs the kernel's coff or smed, whoever started
// it. A build reads only files that its uid or root owns, along the whole
// folder chain (sys_build_may_read), so a file another user made can never
// become part of a program this user builds. What it writes is not limited
// by this. spawn_program_owned allocates the table before any program
// starts, and fails the spawn when it cannot.
int task_build_base = 0;

void task_set_build(int tid, int b) {
    if (!task_build_base || tid < 0 || tid >= MAX_TASKS) { return; }
    store64(task_build_base + tid * 8, b);
    return;
}

int task_build(int tid) {
    if (!task_build_base || tid < 0 || tid >= MAX_TASKS) { return 0; }
    return load64(task_build_base + tid * 8);
}

// 1 when the calling task may read node id, 0 when it is a build and id or
// a folder above it belongs to another user, which it then says on serial.
int sys_build_may_read(int id) {
    if (!task_build(sched_current)) { return 1; }
    if (jakel_trusted_chain(task_uid(sched_current), id)) { return 1; }
    serial_print("[syscall] build refused a file another user owns\n");
    return 0;
}

// Per task, the creation stamp of the directory in task_cwd_base.
int task_cwd_stamp_base = 0;

// The creation stamp kept with task tid's directory. Read in the same jakel
// section as task_cwd(tid), or with interrupts off as a syscall is.
int task_cwd_stamp(int tid) {
    if (!task_cwd_stamp_base || tid < 0 || tid >= MAX_TASKS) { return 0; }
    return load64(task_cwd_stamp_base + tid * 8);
}

// Task tid's directory. A directory removed since the task started, whose
// slot may hold a file or another directory by now, is never used. The task
// goes back to the root, and the serial line says so.
int task_cwd(int tid) {
    if (!task_cwd_base || !task_cwd_stamp_base || tid < 0 || tid >= MAX_TASKS) { return 0; }
    int held = jakel_lock();
    int d = load64(task_cwd_base + tid * 8);
    int ok = d == 0 || (jakel_is_dir(d) && jakel_stamp(d) == load64(task_cwd_stamp_base + tid * 8));
    if (!ok) {
        store64(task_cwd_base + tid * 8, 0);
        store64(task_cwd_stamp_base + tid * 8, 0);
    }
    jakel_unlock(held);
    if (ok) { return d; }
    int sl = serial_line_begin();
    serial_print("[syscall] task ");
    serial_print_int(tid);
    serial_print(" folder is gone, back in /\n");
    serial_line_end(sl);
    return 0;
}

// Per task, how the program in it ended. 1 when it called exit, with the
// code in task_exit_code_base, 2 when the kernel stopped it for a fault,
// and 3 while it runs or when it was killed. A finished task's slot is
// reaped within a tick, so this is what the shell's execute reads once the
// task is no longer runnable.
int task_end_base = 0;
int task_exit_code_base = 0;

void task_set_end(int tid, int how, int code) {
    if (!task_end_base) {
        task_end_base = kmalloc(MAX_TASKS * 8);
        task_exit_code_base = kmalloc(MAX_TASKS * 8);
    }
    store64(task_end_base + tid * 8, how);
    store64(task_exit_code_base + tid * 8, code);
    return;
}
int fd_file_base = 0;
int fd_off_base = 0;
int fd_wr_base = 0;
// Per slot, the creation stamp of the file, so a file removed while it is
// open, whose node slot may hold another file by now, is never read or
// written through the old fd (fd_live).
int fd_stamp_base = 0;

void fd_reset(int tid) {
    int i = 0;
    if (!fd_file_base) {
        fd_file_base = kmalloc(MAX_TASKS * FD_SLOTS * 8);
        fd_off_base = kmalloc(MAX_TASKS * FD_SLOTS * 8);
        fd_wr_base = kmalloc(MAX_TASKS * FD_SLOTS * 8);
        fd_stamp_base = kmalloc(MAX_TASKS * FD_SLOTS * 8);
        for (i = 0; i < MAX_TASKS * FD_SLOTS; i += 1) { store64(fd_file_base + i * 8, 0); }
    }
    for (i = 0; i < FD_SLOTS; i += 1) { store64(fd_file_base + (tid * FD_SLOTS + i) * 8, 0); }
    return;
}

// 1 when table slot k still names the file it was opened on, a live file
// with the same creation stamp.
int fd_live(int k) {
    int id = load64(fd_file_base + k * 8) - 1;
    if (!jakel_valid(id) || load64(jakel_type_base + id * 8) != JAKEL_TYPE_FILE) { return 0; }
    return jakel_stamp(id) == load64(fd_stamp_base + k * 8);
}

// The table index of the current task's fd, or -1 for one that is not open.
int fd_slot(int fd) {
    if (!fd_file_base || fd < 3 || fd >= 3 + FD_SLOTS) { return 0 - 1; }
    int k = sched_current * FD_SLOTS + fd - 3;
    if (!load64(fd_file_base + k * 8)) { return 0 - 1; }
    return k;
}

// Writes len bytes at s to the console, the serial port and the process's
// window, or the focused one when it has none. Returns len, or -1 with
// nothing printed when the bytes are not the caller's to read.
int sys_console_write(int s, int len) {
    if (len < 0 || !user_span(s, len, 0)) { return 0 - 1; }
    if (len == 0) { return 0; }
    if (!user_bounce) { user_bounce = kmalloc(USER_BOUNCE); }
    if (!user_bounce) { return 0 - 1; }
    int wid = load64(task_win_base + sched_current * 8);
    int quiet = task_quiet(sched_current);
    int i = 0;
    for (i = 0; i < len; i += 1) {
        int k = i % USER_BOUNCE;
        if (k == 0) {
            int piece = len - i;
            if (piece > USER_BOUNCE) { piece = USER_BOUNCE; }
            if (!user_copy_in(user_bounce, s + i, piece)) { return 0 - 1; }
        }
        int ch = load8(user_bounce + k);
        task_hold_putc(sched_current, ch);
        if (quiet == 1) {
            // Started by another program to work in the background (see
            // SYS_SPAWN's flags), so nothing reaches the screen.
        } else if (wid >= 0 && kakel_active == 1) {
            kakel_putc_fg(wid, ch, FB_FG);
        } else {
            sk_putc(ch);
        }
    }
    return len;
}

// Closes the calling task's own tavla, for SYS_EXIT_CLOSE. The window is
// let go of first, so kakel_close_id finds no live owner to kill and the task
// stays where it is, about to exit. The shells are prompted again as Alt+W
// does, since the window that takes the focus may be a shell waiting at a
// prompt it never drew.
void sys_close_own_window() {
    int tid = sched_current;
    int wid = load64(task_win_base + tid * 8);
    if (wid < 0 || kakel_active != 1 || kakel_is_tavla(wid) == 0) { return; }
    if (load64(kakel_owner_base + wid * 8) != tid) { return; }
    store64(kakel_owner_base + wid * 8, 0 - 1);
    store64(task_win_base + tid * 8, 0 - 1);
    if (kakel_close_id(wid) == 1) {
        shell_reprompt_others(0 - 1);
        shell_prompt_session(kakel_focus);
    }
    return;
}

// --- what insyn shows ------------------------------------------------------------

int sys_calls = 0;           // system calls since boot
int task_presents_base = 0;  // per task, SYS_PRESENT calls since it started
int task_name_base = 0;      // per task, its program's name, kmalloc'd, or 0
int task_parent_base = 0;    // per task, the task that started it, or -1

void task_info_reset(int tid) {
    klick_pointer_reset(tid);
    if (!task_presents_base) {
        task_presents_base = kmalloc(MAX_TASKS * 8);
        task_name_base = kmalloc(MAX_TASKS * 8);
        task_parent_base = kmalloc(MAX_TASKS * 8);
        if (!task_presents_base || !task_name_base || !task_parent_base) { return; }
        int i = 0;
        for (i = 0; i < MAX_TASKS; i += 1) {
            store64(task_presents_base + i * 8, 0);
            store64(task_name_base + i * 8, 0);
            store64(task_parent_base + i * 8, 0 - 1);
        }
    }
    store64(task_presents_base + tid * 8, 0);
    store64(task_parent_base + tid * 8, 0 - 1);
    // A task started by the slot's previous occupant is no child of the
    // next one, so every link to the slot goes with it.
    int c = 0;
    for (c = 0; c < MAX_TASKS; c += 1) {
        if (load64(task_parent_base + c * 8) == tid) { store64(task_parent_base + c * 8, 0 - 1); }
    }
    int nm = load64(task_name_base + tid * 8);
    if (nm) { kfree(nm); }
    store64(task_name_base + tid * 8, 0);
    return;
}

// Copies the string s, at most n - 1 bytes and a NUL, to dst.
void info_str(int dst, int s, int n) {
    int i = 0;
    while (s && i < n - 1 && load8(s + i) != 0) {
        store8(dst + i, load8(s + i));
        i += 1;
    }
    while (i < n) { store8(dst + i, 0); i += 1; }
    return;
}

int INFO_TASK_BYTES = 96;

// SYS_INFO's three views, staged in kernel storage before transfer to the
// caller, at most max bytes. Returns the bytes written, or -1.
int sys_info(int what, int buf, int max) {
    if (what == 0) {
        // The machine, sixteen numbers, or seventeen.
        if (max < 128) { return 0 - 1; }
        store64(buf, pit_ticks);
        store64(buf + 8, 100);
        store64(buf + 16, pmm_total_pages());
        store64(buf + 24, pmm_available_pages());
        store64(buf + 32, heap_end - heap_start);
        store64(buf + 40, arena_used(heap_start, heap_end));
        store64(buf + 48, jakel_used_bytes());
        store64(buf + 56, JAKEL_ARENA_PAGES * 4096);
        store64(buf + 64, sys_calls);
        store64(buf + 72, key_irqs);
        store64(buf + 80, klick_packets);
        store64(buf + 88, oljud_irqs);
        store64(buf + 96, fb_width);
        store64(buf + 104, fb_height);
        store64(buf + 112, MAX_TASKS);
        store64(buf + 120, clock_utc());
        // A seventeenth for a caller with room, the bytes of sound mixed for
        // programs, ever. It stands still while nothing plays, unlike the
        // interrupts, which the card raises for silence too.
        if (max >= 136) {
            store64(buf + 128, oljud_played);
            return 136;
        }
        return 128;
    }
    if (what == 1) {
        // Every task slot, INFO_TASK_BYTES each. state, timer ticks it was
        // found working (10ms of CPU each), heap bytes, window, presents,
        // how it ended, then its name in 48 bytes.
        int n = 0;
        int t = 0;
        for (t = 0; t < MAX_TASKS && (n + 1) * INFO_TASK_BYTES <= max; t += 1) {
            int r = buf + n * INFO_TASK_BYTES;
            store64(r, load64(task_state_base + t * 8));
            store64(r + 8, load64(task_cpu_base + t * 8));
            store64(r + 16, lager_in_use(t));
            store64(r + 24, load64(task_win_base + t * 8));
            int pr = 0;
            if (task_presents_base) { pr = load64(task_presents_base + t * 8); }
            store64(r + 32, pr);
            int how = 0;
            if (task_end_base) { how = load64(task_end_base + t * 8); }
            store64(r + 40, how);
            int nm = 0;
            if (task_name_base) { nm = load64(task_name_base + t * 8); }
            if (!nm && t == shell_task_id) { nm = "skalman"; }
            if (!nm) { nm = "kernel"; }
            info_str(r + 48, nm, 48);
            n += 1;
        }
        return n * INFO_TASK_BYTES;
    }
    if (what == 2) {
        // The hardware. cpuid leaves 0, 1 and the brand string, then the
        // devices. 0..15 vendor, 16..63 brand, 64 leaf 1 eax (family,
        // model, stepping), 72 ecx features, 80 edx features, 88 framebuffer
        // bits per pixel, 96 disk present, 104 disk sectors jakel uses, 112
        // mouse present, 120 sound card DSP version (major * 256 + minor).
        if (max < 128) { return 0 - 1; }
        int regs = kmalloc(32);
        if (!regs) { return 0 - 1; }
        int cpuid = cpuid_into;
        cpuid(0, regs);
        int i = 0;
        for (i = 0; i < 16; i += 1) { store8(buf + i, 0); }
        store32(buf, load64(regs + 8));
        store32(buf + 4, load64(regs + 24));
        store32(buf + 8, load64(regs + 16));
        for (i = 0; i < 48; i += 1) { store8(buf + 16 + i, 0); }
        cpuid(0x80000000, regs);
        if (load64(regs) >= 0x80000004) {
            int leaf = 0;
            for (leaf = 0; leaf < 3; leaf += 1) {
                cpuid(0x80000002 + leaf, regs);
                int k = 0;
                for (k = 0; k < 4; k += 1) {
                    store32(buf + 16 + leaf * 16 + k * 4, load64(regs + k * 8));
                }
            }
        }
        store8(buf + 63, 0);
        cpuid(1, regs);
        store64(buf + 64, load64(regs));
        store64(buf + 72, load64(regs + 16));
        store64(buf + 80, load64(regs + 24));
        kfree(regs);
        store64(buf + 88, 32);
        store64(buf + 96, ata_present);
        store64(buf + 104, JAKEL_ARENA_PAGES * 8);
        store64(buf + 112, klick_active);
        store64(buf + 120, oljud_dsp_version);
        return 128;
    }
    return 0 - 1;
}

int sys_dispatch(int num, int a1, int a2, int a3, int a4, int a5, int a6) {
    // SYSCALL cleared IF on the way in (SFMASK, boot.s), and every check of
    // a program's pointer below relies on that. See user_span.
    user_assert_irq_off("sys_dispatch");
    sys_calls += 1;
    if (num != 1 && !(num == 25 && (a1 == 1 || a1 == 2))) { task_hold_flush(sched_current); }
    // A program closed with alt+w or its [x] is ended from an interrupt,
    // and when that interrupt came while the program itself was running,
    // the CPU goes back to it and it runs on until the next tick. Its next
    // call must do nothing, least of all sleep, which would mark it BLOCKED
    // and so bring it back after it was ended. It parks the way SYS_EXIT
    // does, halting with interrupts on until the scheduler switches away
    // from it for good and the reaper frees it.
    if (load64(task_state_base + sched_current * 8) == TASK_EXITED) {
        int on0 = enable_interrupts;
        on0();
        while (1) { cpu_wait(); }
    }
    // SYS_READFILE_OWNED is SYS_READFILE for a file the caller's uid or root
    // owns, a number of its own rather than a fourth argument, since the
    // readfile builtin leaves that register unset.
    int owned_read = 0;
    if (num == SYS_READFILE_OWNED) {
        num = 8;
        owned_read = 1;
    }
    // SYS_EXIT_CLOSE(code) -- SYS_EXIT for a program whose window means
    // nothing once it is gone, like an editor that was quit. A plain exit
    // leaves the last frame on screen (see kakel_tavla_orphan), which is right
    // for a game or a page and wrong here. A separate number and not an
    // argument to SYS_EXIT, since a program returning from main reaches
    // SYS_EXIT with whatever its last call left in rsi.
    if (num == SYS_EXIT_CLOSE) {
        sys_close_own_window();
        num = 0;
    }
    if (!num) {
        int tid = sched_current;
        store64(task_state_base + tid * 8, TASK_EXITED);
        serial_print("[syscall] exit code=");
        serial_print_int(a1);
        serial_print("\n");
        task_set_end(sched_current, 1, a1);
        // The SYSCALL instruction's SFMASK MSR (boot.s) clears RFLAGS.IF on
        // entry -- normally restored by SYSRET, but this handler
        // deliberately never reaches it (see the halt loop below), so IF
        // would otherwise stay clear FOREVER. On this single-core kernel
        // that means the timer could never fire again to switch away from
        // this now-EXITED task -- not a slow leak, a total freeze the
        // instant any ring-3 process calls sys_exit, with no fault and no
        // panic. enable_interrupts (boot.s,
        // reached by name) is the same "c0 cannot execute a privileged
        // instruction" hand-off halt() below already uses for `hlt`.
        int sti = enable_interrupts;
        sti();
        // Loop-halt. The timer ISR's scheduler will swap away from this
        // EXITED task on the next tick. An NMI can wake hlt, so looping
        // ensures we never accidentally sysretq back to ring 3.
        while (1 == 1) {
            cpu_wait();
        }
        return 0;
    }
    if (num == 1) {
        // sys_write(str, len) — write to serial and screen.
        // If this task has its own kakel window (windowed spawn), route
        // screen output there directly instead of through sk_putc (which
        // goes to kakel_focus — the shell's focus, not this process's).
        return sys_console_write(a1, a2);
    }
    if (num == 2) {
        // SYS_WIN_INFO — returns the task's window pixel dimensions packed as
        // width * 65536 + height, or 0 if no window is attached (non-windowed
        // spawn, or VGA-only fallback).
        //
        // Cell geometry MUST go through FONT_W/FONT_H, never literals. All
        // FONT_H is 8, not 16, and a hardcoded 16 would double every height
        // and every y origin, so a program would be told its window is twice as
        // tall as it is and bounce its sprite off an edge far below anything
        // visible.
        int wid2 = load64(task_win_base + sched_current * 8);
        if (wid2 < 0 || !kakel_active) { return 0; }
        int w = load64(kakel_cols_base + wid2 * 8) * FONT_W;
        int h = load64(kakel_rows_base + wid2 * 8) * FONT_H;
        // Once one pixel short after the window comes back into view, so the
        // program sees a change and draws a whole frame (kakel_nudge_live).
        if (kakel_take_nudge(wid2) == 1) { h -= 1; }
        // Remember what we told it. A program sizes its frame buffer from this
        // answer and in practice keeps it (it has nothing to realloc with), so
        // this is the pitch its buffer will be written at for as long as it
        // runs -- SYS_PRESENT needs that, not the window's size today. See
        // task_win_reported_base (chrone.c0).
        store64(task_win_reported_base + sched_current * 8, (w << 16) | h);
        return (w << 16) | h;
    }
    if (num == 3) {
        // SYS_FILL(x, y, w, h, color) — fill a rectangle in the task's
        // window. Coordinates are window-relative; the handler translates
        // to absolute screen coordinates and clips to both the window
        // bounds and the framebuffer edges.
        int wid3 = load64(task_win_base + sched_current * 8);
        if (wid3 < 0 || !kakel_active) { return -1; }
        kakel_fill(wid3, a1, a2, a3, a4, a5);
        return 0;
    }
    if (num == 4) {
        // SYS_KEY_POLL — dequeues one raw key event from THIS TASK'S queue
        // and returns make_code * 2 + is_break, or -1 if empty. Per-task, so
        // two graphical programs running at once cannot drain each other's
        // input; the keyboard handler pushes only to the owner of the focused
        // tavla, so a program sees only keys typed at its own window.
        return key_task_poll(sched_current);
    }
    if (num == 5) {
        // SYS_BLIT(buf, x, y, w, h) — copy w*h pixels from a user-space
        // buffer to the task's window. Each pixel is 4 bytes (0xRRGGBB
        // in framebuffer order, blue at offset 0, green 1, red 2, zero 3).
        // Coordinates are window-relative; clipped to window bounds.
        int wid5 = load64(task_win_base + sched_current * 8);
        if (wid5 < 0 || !kakel_active) { return -1; }
        if (kakel_shown(wid5) == 0) { return 0; }
        int wx5 = load64(kakel_cx_base + wid5 * 8) * FONT_W;
        int wy5 = load64(kakel_cy_base + wid5 * 8) * FONT_H;
        int ww5 = load64(kakel_cols_base + wid5 * 8) * FONT_W;
        int wh5 = load64(kakel_rows_base + wid5 * 8) * FONT_H;
        // Only the rows and columns that land in the window are read, each
        // visible row checked before the first pixel is drawn, so a huge
        // height costs at most the window's rows and a bad source draws
        // nothing. The source pitch a4 * 4 and the offset of the last row
        // read must both fit below USER_TOP before either is multiplied.
        if (a4 < 0 || a5 < 0) { return 0 - 1; }
        if (a4 > USER_TOP / 4) { return 0 - 1; }
        fb_clip(a2, a4, ww5);
        int c05 = clip_lo;
        int c15 = clip_hi;
        fb_clip(a3, a5, wh5);
        int r05 = clip_lo;
        int r15 = clip_hi;
        if (c05 >= c15 || r05 >= r15) { return 0; }
        if (r15 - 1 > (USER_TOP / 4 - c15) / a4) { return 0 - 1; }
        if (a1 < USER_VIRT_BASE || a1 >= USER_TOP) { return 0 - 1; }
        int row5 = 0;
        for (row5 = r05; row5 < r15; row5 += 1) {
            if (!user_span(a1 + (row5 * a4 + c05) * 4, (c15 - c05) * 4, 0)) { return 0 - 1; }
        }
        fb_blit_user_rows(a1, a4, a2, a3, r05, r15, c05, c15, wx5, wy5);
        return 0;
    }
    if (num == 6) {
        // SYS_ALLOC(n) -- n bytes (rounded up to 8), zeroed, from this
        // task's own ring-3 heap. Returns 0 on a bad request or when the heap
        // is exhausted. lager.c0 keeps the block table and reuses what
        // SYS_DEALLOC gave back. Until lager this was a bump pointer with no
        // free at all.
        return lager_alloc(sched_current, a1);
    }
    if (num == 13) {
        // SYS_DEALLOC(ptr) -- gives back a block SYS_ALLOC returned. Returns
        // 0, or -1 (and a line in the serial log) for anything that is not
        // the start of a live block. See lager.c0.
        return lager_free(sched_current, a1);
    }
    if (num == 7) {
        // SYS_TICKS — the kernel's own monotonic ~100Hz PIT tick counter
        // (interrupts.c0's `pit_ticks`, incremented by timer_tick, never
        // reset). Deliberately NOT sched_tick_count (chrone.c0) -- that
        // one is a countdown that wraps every SCHED_SWITCH_PERIOD ticks
        // for scheduling quantum bookkeeping, useless as an elapsed-time
        // source. Lets a ring-3 program (Gnista) measure real elapsed
        // time between frames instead of tying movement speed to however
        // fast its own loop happens to spin.
        return pit_ticks;
    }
    if (num == 8) {
        // SYS_READFILE(name, buf, max) — read a file from jakel into the
        // process's own memory. Returns the number of bytes copied, or -1 if
        // the path does not resolve to a file. As SYS_READFILE_OWNED it reads
        // only a file that the caller's uid or root owns and returns -2 for
        // any other, so a program learns, in the same call that reads them,
        // whether the bytes come from a file it may trust as code. utsikt
        // reads pages that way and runs a page's scripts only then.
        //
        // With buf == 0 it returns the file's SIZE and copies nothing, so a
        // program can size its alloc() before the real read. That is why
        // there is no separate stat syscall, and this costs one branch.
        //
        // This is the syscall that makes runtime assets possible. Without it a
        // ring-3 program could not read a file at all, so every sprite would have
        // to be baked into the ELF by a host script and changing one pixel would
        // mean a recompile -- see pensel, which draws sprites on Moonshot itself.
        //
        // Pointers arrive as the process's own virtual addresses, since
        // SYSCALL does not switch CR3, so the process's address space is
        // still live here. The path and the bytes the read fills are both
        // checked to be the caller's own first (user_span), the buffer for
        // writing, since a bad one would have the kernel scribble file
        // contents into its own memory.
        if (!a1) { return -1; }
        int nbuf = sys_copy_path(a1);
        if (!nbuf) { return -1; }
        int fid = jakel_open(0, nbuf);
        user_temp_free(nbuf);
        if (fid < 0) { return -1; }
        if (load64(jakel_type_base + fid * 8) != JAKEL_TYPE_FILE) { return -1; }
        if (!jakel_can_read(task_uid(sched_current), fid)) { return -1; }
        if (!sys_build_may_read(fid)) { return -1; }
        if (owned_read) {
            int own8 = load64(jakel_uid_base + fid * 8);
            if (own8 != task_uid(sched_current) && own8 != 0) { return 0 - 2; }
        }
        int fsz = load64(jakel_size_base + fid * 8);
        if (!a2) { return fsz; }
        if (a2 < USER_VIRT_BASE) {
            serial_print("[syscall] readfile: refusing non-user buffer\n");
            return -1;
        }
        int n = fsz;
        if (a3 < n) { n = a3; }
        if (n < 0) { return 0 - 1; }
        if (n == 0) { return 0; }
        if (!user_span(a2, n, 1)) { return -1; }
        if (jakel_read_user(task_uid(sched_current), fid, 0, a2, n) != n) { return -1; }
        return n;
    }
    if (num == 9) {
        // SYS_PRESENT(buf) — copy a whole window's worth of pixels from the
        // caller's buffer straight onto the framebuffer. The fast path for a
        // program that composites entire frames, which is what anything with
        // a scrolling camera has to do. When the view moves, every pixel
        // changes, and SYS_BLIT's per-pixel work becomes the frame budget.
        //
        // How much work it removes is the point. SYS_BLIT reads four bytes
        // and multiplies them together to rebuild each pixel, checks it
        // against colour 0 so sprites can have holes, then writes through
        // fb_put_pixel. Several memory accesses and a handful of arithmetic
        // ops per pixel.
        //
        // This does none of it. It copies whole rows, eight bytes (two pixels) at a
        // time, no per-pixel branch and no arithmetic. It can, because a
        // full-window present has no transparency to honour -- every pixel
        // is replaced -- and because kakel's geometry is CELL aligned, so a
        // row is always a whole number of 8-byte groups. That is the same
        // argument kakel_scroll's row copy already relies on, that a window's x
        // origin is cx*FONT_W pixels (32 bytes) and its width cols*FONT_W
        // pixels, both multiples of 8 bytes.
        //
        // The buffer must hold exactly width*height pixels for the task's own
        // window, in framebuffer order. Returns 0, or -1 if the task has no
        // window.
        int wid9 = load64(task_win_base + sched_current * 8);
        if (wid9 < 0 || !kakel_active) { return -1; }
        // Hidden behind a maximized window or rotated out of view, the frame
        // goes nowhere. The program carries on as if it had been shown.
        if (kakel_shown(wid9) == 0) { return 0; }
        if (task_presents_base) {
            store64(task_presents_base + sched_current * 8,
                    load64(task_presents_base + sched_current * 8) + 1);
        }
        if (!a1) { return -1; }
        int wx9 = load64(kakel_cx_base + wid9 * 8) * FONT_W;
        int wy9 = load64(kakel_cy_base + wid9 * 8) * FONT_H;
        int ww9 = load64(kakel_cols_base + wid9 * 8) * FONT_W;
        int wh9 = load64(kakel_rows_base + wid9 * 8) * FONT_H;
        // The buffer's own geometry -- what SYS_WIN_INFO last told this task,
        // NOT the window's size today. They are the same number right up until
        // the layout reflows underneath a running program, which happens on
        // every split, close and start, and the program has no way to hear
        // about it and no way to resize a bump-allocated buffer if it did.
        //
        // Reading the buffer at the WINDOW's pitch would be wrong in both
        // directions. With a wider window each source row would be
        // read past its end into the start of the next, so the frame would come out
        // duplicated side by side, and past the last row it would run off the mapped
        // part of the heap entirely and page-fault in ring 0. With a narrower
        // window, rows would be read short and the image would shear diagonally.
        //
        // Reading at the buffer's own pitch and copying the OVERLAP of the two
        // rectangles keeps the frame intact and correctly shaped; it simply
        // does not fill a window that has grown, or shows the top-left corner
        // of one that has shrunk. Wrong size, right picture.
        int rep9 = load64(task_win_reported_base + sched_current * 8);
        int bw9 = ww9;
        int bh9 = wh9;
        if (rep9 > 0) {
            bw9 = rep9 >> 16;
            bh9 = rep9 & 65535;
        }
        int srcbytes = bw9 * 4;               // the caller's row pitch
        int copybytes = srcbytes;             // how much of a row lands on screen
        if (ww9 * 4 < copybytes) { copybytes = ww9 * 4; }
        int rows9 = bh9;
        if (wh9 < rows9) { rows9 = wh9; }
        if (copybytes <= 0 || rows9 <= 0) { return 0; }
        // Belt and braces against a task whose reported size somehow outruns
        // what it actually allocated, and never reads past the heap bump pointer.
        // Buffers outside the heap (a static array in the program's data
        // segment) sit far below it, leaving this bound enormous and inert.
        int hnext9 = load64(task_heap_next_base + sched_current * 8);
        if (a1 >= USER_VIRT_BASE && a1 < hnext9) {
            int max_rows = (hnext9 - a1) / srcbytes;
            if (rows9 > max_rows) { rows9 = max_rows; }
        }
        if (rows9 <= 0) { return 0; }
        // That bound only trims a frame, it proves nothing about the source.
        // Every byte the rows below read is checked to be the caller's
        // before the first one is copied. Both factors are window sizes
        // under 65536, so the product cannot overflow.
        if (!user_span(a1, (rows9 - 1) * srcbytes + copybytes, 0)) { return 0 - 1; }
        store64(user_context(sched_current) + 128, 1);
        klick_lift_rect(wx9, wy9, copybytes / 4, rows9);
        int r9 = 0;
        for (r9 = 0; r9 < rows9; r9 += 1) {
            user_copy_in(fb_addr + (wy9 + r9) * fb_pitch + wx9 * 4,
                     a1 + r9 * srcbytes, copybytes);
        }
        klick_drop();
        store64(user_context(sched_current) + 128, 0);
        return 0;
    }
    if (num == 11) {
        // SYS_MOUSE_POLL -- the pointer as seen from THIS TASK'S window,
        // (x * 1024 + y) * 8 + buttons, with x and y relative to the window's
        // client area and buttons packed left=1, right=2, middle=4 (the same
        // packing klick's own event ring uses). Returns -1 when the task has
