// expect: 0
// Calls every syscall with arguments a hostile program would choose, for
// verify_hostile_syscalls.sh. Null, kernel half, non-canonical and unmapped
// pointers, pointers whose end wraps, negative and huge lengths, bad
// handles and bad task ids.
//
// With the argument all it runs every case below 100, one after the other,
// while a second copy of itself keeps a canary in memory and in a file and
// checks it throughout. Each case that holds adds one, and so does the
// canary. With a number it runs that one case alone, and exits 77 when it
// holds or the number of the check that did not. With anything else, as
// when the elf backend test starts every program, it exits 0 at once, since
// that test reads one exit code per program and this one starts others.
// Cases from 100 on each expose a known open finding, they are listed in
// the script and are never run without a number, since some of them take
// the kernel down.
include "moon.c0";

int WIRED_LAST = 59;

// The pointers a hostile program passes. A buffer of its own is the one case
// the kernel has to accept.
int p_null() { return 0; }
int p_low() { return 0x100000; }
int p_high() { return (0 - 1) << 47; }
int p_noncanon() { return 1 << 63; }
int p_unmapped() { return 1 << 42; }
int p_sentinel() { return 1 << 32; }
int huge() { return (1 << 62) - 1 + (1 << 62); }

// A result line is built whole and printed with one call, since the kernel
// can print between two calls and split the line.
int lbuf = 0;
int llen = 0;

void lput(int s) {
    int i = 0;
    while (load8(s + i) != 0) { store8(lbuf + llen, load8(s + i)); llen += 1; i += 1; }
    store8(lbuf + llen, 0);
}

void lnum(int n) {
    if (n < 0) { lput("-"); n = 0 - n; }
    if (n == 0) { lput("0"); return; }
    int top = 1;
    while (top <= n / 10) { top = top * 10; }
    while (top > 0) {
        store8(lbuf + llen, '0' + n / top % 10);
        llen += 1;
        top = top / 10;
    }
    store8(lbuf + llen, 0);
}

int same(int a, int b) {
    int i = 0;
    while (load8(a + i) != 0 || load8(b + i) != 0) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i += 1;
    }
    return 1;
}

int bad(int r) { return r != 0 - 1; }

// Syscall 0 and 27 end the program, so their cases run in a child.
int child_exit(int arg) {
    int t = spawn_with(arg, 1);
    if (t < 0) { return 1; }
    return wait_for(t, 500);
}

int c_exit_huge_code() {
    if (child_exit("test/et29.elf x0") != (1 << 40) + 5) { return 1; }
    return 0;
}

int c_exit_close_huge_code() {
    if (child_exit("test/et29.elf x27") != (1 << 40) + 6) { return 1; }
    return 0;
}

int c_unknown_numbers() {
    if (bad(syscall(39, 0, 0, 0, 0, 0))) { return 1; }
    if (bad(syscall(0 - 1, 0, 0, 0, 0, 0))) { return 2; }
    if (bad(syscall(1 << 62, 1, 2, 3, 4, 5))) { return 3; }
    if (bad(syscall(1 << 63, 1, 2, 3, 4, 5))) { return 4; }
    if (bad(syscall(0x100000000 + 6, 1, 2, 3, 4, 5))) { return 5; }
    return 0;
}

int c_debug_print_lengths() {
    int b = alloc(64);
    if (syscall(1, b, 0 - 1, 0, 0, 0) > 0) { return 1; }
    if (syscall(1, b, 1 << 63, 0, 0, 0) > 0) { return 2; }
    if (syscall(1, p_high(), 0, 0, 0, 0) != 0) { return 3; }
    if (syscall(1, p_null(), 0, 0, 0, 0) != 0) { return 4; }
    return 0;
}

int c_no_argument_calls() {
    int h = huge();
    int before = ticks();
    syscall(2, h, h, h, h, h);
    syscall(4, h, h, h, h, h);
    syscall(10, h, h, h, h, h);
    syscall(11, h, h, h, h, h);
    syscall(17, h, 0 - 1, h, h, h);
    syscall(37, h, h, h, h, h);
    if (syscall(7, h, h, h, h, h) < before) { return 1; }
    return 0;
}

int c_fill_geometry() {
    int h = huge();
    int m = 1 << 63;
    syscall(3, 0 - 1, 0 - 1, 0 - 1, 0 - 1, 0xff00ff);
    syscall(3, m, m, m, m, 0xff00ff);
    syscall(3, h, h, h, h, 0xff00ff);
    syscall(3, 0 - 100, 0 - 100, 1 << 40, 1 << 40, 0xff00ff);
    syscall(3, 5, 5, 0 - 3, 4, 0xff00ff);
    syscall(3, h - 3, h - 3, 16, 16, 0xff00ff);
    return 0;
}

int c_blit_empty_and_offscreen() {
    int b = alloc(256);
    int h = huge();
    int m = 1 << 63;
    syscall(5, b, 0, 0, 0, 0);
    syscall(5, b, 0, 0, 0 - 1, 0 - 1);
    syscall(5, b, 0, 0, 0 - 1, 4);
    syscall(5, b, 0, 0, 4, 0 - 1);
    syscall(5, b, h, h, 4, 4);
    syscall(5, b, m, m, 4, 4);
    syscall(5, b, 0 - 100000, 0 - 100000, 4, 4);
    return 0;
}

int c_alloc_sizes() {
    if (syscall(6, 0, 0, 0, 0, 0) != 0) { return 1; }
    if (syscall(6, 0 - 1, 0, 0, 0, 0) != 0) { return 2; }
    if (syscall(6, 1 << 63, 0, 0, 0, 0) != 0) { return 3; }
    if (syscall(6, 1 << 62, 0, 0, 0, 0) != 0) { return 4; }
    if (syscall(6, 1 << 40, 0, 0, 0, 0) != 0) { return 5; }
    int p = alloc(16);
    if (!p) { return 6; }
    store64(p, 7);
    if (load64(p) != 7) { return 7; }
    if (dealloc(p) != 0) { return 8; }
    return 0;
}

int c_dealloc_handles() {
    int p = alloc(32);
    if (bad(syscall(13, 1, 0, 0, 0, 0))) { return 1; }
    if (bad(syscall(13, p_low(), 0, 0, 0, 0))) { return 2; }
    if (bad(syscall(13, p_high(), 0, 0, 0, 0))) { return 3; }
    if (bad(syscall(13, p_noncanon(), 0, 0, 0, 0))) { return 4; }
    if (bad(syscall(13, p_unmapped(), 0, 0, 0, 0))) { return 5; }
    if (bad(syscall(13, p + 8, 0, 0, 0, 0))) { return 6; }
    if (dealloc(p) != 0) { return 7; }
    if (bad(syscall(13, p, 0, 0, 0, 0))) { return 8; }
    return 0;
}

int c_sleep_lengths() {
    int t0 = ticks();
    sleep(0 - 1);
    sleep(1 << 63);
    sleep(0);
    if (ticks() - t0 > 100) { return 1; }
    return 0;
}

int c_argv_indices() {
    if (argv(0 - 1) != 0) { return 1; }
    if (argv(1 << 62) != 0) { return 2; }
    if (argv(1 << 63) != 0) { return 3; }
    if (argv(0x100000000) != 0) { return 4; }
    if (argv(argc()) != 0) { return 5; }
    return 0;
}

int c_readfile_pointers() {
    int b = alloc(64);
    if (bad(syscall(8, 0, b, 64, 0, 0))) { return 1; }
    if (bad(syscall(8, "no/such/file", b, 64, 0, 0))) { return 2; }
    if (bad(syscall(8, "test", b, 64, 0, 0))) { return 3; }
    if (bad(syscall(8, "test/et29.can", 8, 64, 0, 0))) { return 4; }
    if (bad(syscall(8, "test/et29.can", p_low(), 64, 0, 0))) { return 5; }
    if (bad(syscall(8, "test/et29.can", p_high(), 64, 0, 0))) { return 6; }
    if (bad(syscall(8, "test/et29.can", p_noncanon(), 64, 0, 0))) { return 7; }
    // 38 is readfile for a file the caller or root owns, the same checks.
    if (bad(syscall(38, 0, b, 64, 0, 0))) { return 8; }
    if (bad(syscall(38, "no/such/file", b, 64, 0, 0))) { return 9; }
    if (bad(syscall(38, "test", b, 64, 0, 0))) { return 10; }
    if (bad(syscall(38, "test/et29.can", 8, 64, 0, 0))) { return 11; }
    if (bad(syscall(38, "test/et29.can", p_low(), 64, 0, 0))) { return 12; }
    if (bad(syscall(38, "test/et29.can", p_high(), 64, 0, 0))) { return 13; }
    if (bad(syscall(38, "test/et29.can", p_noncanon(), 64, 0, 0))) { return 14; }
    return 0;
}

int c_readfile_lengths() {
    int b = alloc(64);
    store64(b, 99);
    if (syscall(8, "test/et29.can", b, 0 - 1, 0, 0) != 0 - 1) { return 1; }
    if (syscall(8, "test/et29.can", b, 1 << 63, 0, 0) != 0 - 1) { return 2; }
    if (load64(b) != 99) { return 3; }
    int n = syscall(8, "test/et29.can", 0, 0, 0, 0);
    if (n != 256) { return 4; }
    int big = alloc(512);
    if (syscall(8, "test/et29.can", big, huge(), 0, 0) != 256) { return 5; }
    if (syscall(38, "test/et29.can", b, 0 - 1, 0, 0) != 0 - 1) { return 6; }
    if (syscall(38, "test/et29.can", b, 1 << 63, 0, 0) != 0 - 1) { return 7; }
    if (load64(b) != 99) { return 8; }
    if (syscall(38, "test/et29.can", 0, 0, 0, 0) != 256) { return 9; }
    if (syscall(38, "test/et29.can", big, huge(), 0, 0) != 256) { return 10; }
    return 0;
}

int c_writefile_arguments() {
    int b = alloc(64);
    if (bad(syscall(15, 0, b, 8, 0, 0))) { return 1; }
    if (bad(syscall(15, "test/et29.tmp", b, 0 - 1, 0, 0))) { return 2; }
    if (bad(syscall(15, "test/et29.tmp", b, 1 << 63, 0, 0))) { return 3; }
    if (bad(syscall(15, "test/et29.tmp", p_null() + 8, 8, 0, 0))) { return 4; }
    if (bad(syscall(15, "test/et29.tmp", p_low(), 8, 0, 0))) { return 5; }
    if (bad(syscall(15, "test/et29.tmp", p_high(), 8, 0, 0))) { return 6; }
    if (bad(syscall(15, "test/et29.tmp", p_noncanon(), 8, 0, 0))) { return 7; }
    if (bad(syscall(15, "test", b, 8, 0, 0))) { return 8; }
    if (bad(syscall(15, "no/such/dir/x", b, 8, 0, 0))) { return 9; }
    return 0;
}

int c_listdir_arguments() {
    int b = alloc(512);
    if (bad(syscall(19, 0, b, 4, 0, 0))) { return 1; }
    if (bad(syscall(19, "test/et29.can", b, 4, 0, 0))) { return 2; }
    if (bad(syscall(19, "no/such/dir", b, 4, 0, 0))) { return 3; }
    if (bad(syscall(19, "test", p_null() + 8, 4, 0, 0))) { return 4; }
    if (bad(syscall(19, "test", p_low(), 4, 0, 0))) { return 5; }
    if (bad(syscall(19, "test", p_high(), 4, 0, 0))) { return 6; }
    if (bad(syscall(19, "test", p_noncanon(), 4, 0, 0))) { return 7; }
    if (syscall(19, "test", b, 0 - 1, 0, 0) > 0) { return 8; }
    if (syscall(19, "test", b, 1 << 63, 0, 0) > 0) { return 9; }
    if (syscall(19, "test", b, 0, 0, 0) != 0) { return 10; }
    return 0;
}

int c_spawn_arguments() {
    if (bad(syscall(20, 0, 0, 0, 0, 0))) { return 1; }
    if (bad(syscall(20, "test/et29.elf x0", 0 - 1, 0, 0, 0))) { return 2; }
    if (bad(syscall(20, "test/et29.elf x0", 4, 0, 0, 0))) { return 3; }
    if (bad(syscall(20, "test/et29.elf x0", 1 << 62, 0, 0, 0))) { return 4; }
    if (bad(syscall(20, "test/et29.elf x0", 1 << 63, 0, 0, 0))) { return 5; }
    if (syscall(20, "", 1, 0, 0, 0) >= 0) { return 6; }
    if (syscall(20, "no/such.elf", 1, 0, 0, 0) >= 0) { return 7; }
    if (syscall(20, "test", 1, 0, 0, 0) >= 0) { return 8; }
    int n = 300;
    int b = alloc(n);
    int i = 0;
    for (i = 0; i < n - 1; i += 1) { store8(b + i, 'a'); }
    if (syscall(20, b, 1, 0, 0, 0) >= 0) { return 9; }
    return 0;
}

int c_protect_arguments() {
    int b = alloc(8192);
    int page = (b + 4095) / 4096 * 4096;
    if (bad(syscall(21, 0, 1, 0, 0, 0))) { return 1; }
    if (bad(syscall(21, page + 1, 1, 0, 0, 0))) { return 2; }
    if (bad(syscall(21, page, 0, 0, 0, 0))) { return 3; }
    if (bad(syscall(21, page, 0 - 1, 0, 0, 0))) { return 4; }
    if (bad(syscall(21, page, 257, 0, 0, 0))) { return 5; }
    if (bad(syscall(21, page, 1, 2, 0, 0))) { return 6; }
    if (bad(syscall(21, page, 1, 0 - 1, 0, 0))) { return 7; }
    if (bad(syscall(21, p_high() & (0 - 4096), 1, 0, 0, 0))) { return 8; }
    if (bad(syscall(21, huge() & (0 - 4096), 256, 0, 0, 0))) { return 9; }
    if (bad(syscall(21, (1 << 63) + (1 << 62), 256, 0, 0, 0))) { return 10; }
    if (bad(syscall(21, p_unmapped(), 1, 0, 0, 0))) { return 11; }
    if (bad(syscall(21, p_sentinel(), 1, 0, 0, 0))) { return 12; }
    return 0;
}

int c_edit_pointers() {
    if (bad(syscall(22, 0, 0, 0, 0, 0))) { return 1; }
    if (bad(syscall(22, p_low(), 0, 0, 0, 0))) { return 2; }
    if (bad(syscall(22, p_high(), 0, 0, 0, 0))) { return 3; }
    if (bad(syscall(22, p_noncanon(), 0, 0, 0, 0))) { return 4; }
    return 0;
}

int c_open_arguments() {
    if (bad(syscall(23, 0, 0, 0, 0, 0))) { return 1; }
    if (bad(syscall(23, "test/et29.can", 2, 0, 0, 0))) { return 2; }
    if (bad(syscall(23, "test/et29.can", 0 - 1, 0, 0, 0))) { return 3; }
    if (bad(syscall(23, "test/et29.can", 1 << 62, 0, 0, 0))) { return 4; }
    if (bad(syscall(23, "no/such/file", 0, 0, 0, 0))) { return 5; }
    if (bad(syscall(23, "no/such/dir/x", 1, 0, 0, 0))) { return 6; }
    if (bad(syscall(23, "test", 0, 0, 0, 0))) { return 7; }
    if (bad(syscall(23, "", 0, 0, 0, 0))) { return 8; }
    return 0;
}

int c_open_exhaust() {
    int fds = alloc(16 * 8);
    int i = 0;
    int opened = 0;
    for (i = 0; i < 16; i += 1) {
        int fd = syscall(23, "test/et29.can", 0, 0, 0, 0);
        store64(fds + i * 8, fd);
        if (fd >= 0) { opened += 1; }
    }
    int refused = bad(syscall(23, "test/et29.can", 0, 0, 0, 0)) == 0;
    for (i = 0; i < 16; i += 1) {
        if (load64(fds + i * 8) >= 0) { syscall(26, load64(fds + i * 8), 0, 0, 0, 0); }
    }
    if (opened != 8) { return 1; }
    if (refused != 1) { return 2; }
    int fd = syscall(23, "test/et29.can", 0, 0, 0, 0);
    if (fd < 3) { return 3; }
    syscall(26, fd, 0, 0, 0, 0);
    return 0;
}

int c_bad_handles() {
    int b = alloc(64);
    int fd = syscall(23, "test/et29.can", 0, 0, 0, 0);
    int bads = alloc(11 * 8);
    store64(bads, 0 - 1);
    store64(bads + 8, 0);
    store64(bads + 16, 11);
    store64(bads + 24, 1 << 62);
    store64(bads + 32, 1 << 63);
    store64(bads + 40, fd + 1);
    store64(bads + 48, 3 + (1 << 32));
    store64(bads + 56, fd + (1 << 32));
    store64(bads + 64, fd + (1 << 63));
    store64(bads + 72, 3 + 8);
    store64(bads + 80, 2 + (1 << 40));
    int i = 0;
    for (i = 0; i < 11; i += 1) {
        int h = load64(bads + i * 8);
        if (bad(syscall(24, h, b, 16, 0, 0))) { return 1 + i; }
        if (bad(syscall(26, h, 0, 0, 0, 0))) { return 20 + i; }
    }
    if (bad(syscall(25, 0 - 1, b, 1, 0, 0))) { return 40; }
    if (bad(syscall(25, 0, b, 1, 0, 0))) { return 41; }
    if (bad(syscall(25, 11, b, 1, 0, 0))) { return 42; }
    if (bad(syscall(25, 1 << 62, b, 1, 0, 0))) { return 43; }
    if (bad(syscall(25, fd + (1 << 63), b, 1, 0, 0))) { return 44; }
    if (bad(syscall(25, fd, b, 1, 0, 0))) { return 45; }
    if (syscall(26, fd, 0, 0, 0, 0) != 0) { return 46; }
    if (bad(syscall(26, fd, 0, 0, 0, 0))) { return 47; }
    return 0;
}

int c_read_buffers_and_lengths() {
    int b = alloc(512);
    int fd = syscall(23, "test/et29.can", 0, 0, 0, 0);
    int r = 0;
    if (bad(syscall(24, fd, p_null() + 8, 16, 0, 0))) { r = 1; }
    if (r == 0 && bad(syscall(24, fd, p_low(), 16, 0, 0))) { r = 2; }
    if (r == 0 && bad(syscall(24, fd, p_high(), 16, 0, 0))) { r = 3; }
    if (r == 0 && bad(syscall(24, fd, p_noncanon(), 16, 0, 0))) { r = 4; }
    if (r == 0 && bad(syscall(24, fd, b, 0 - 1, 0, 0))) { r = 5; }
    if (r == 0 && bad(syscall(24, fd, b, 1 << 63, 0, 0))) { r = 6; }
    if (r == 0 && syscall(24, fd, b, huge(), 0, 0) != 256) { r = 7; }
    if (r == 0 && syscall(24, fd, b, huge(), 0, 0) != 0) { r = 8; }
    syscall(26, fd, 0, 0, 0, 0);
    return r;
}

int c_write_buffers_and_lengths() {
    int b = alloc(64);
    int fd = syscall(23, "test/et29.tmp", 1, 0, 0, 0);
    int r = 0;
    if (fd < 3) { return 1; }
    if (bad(syscall(25, fd, p_null() + 8, 8, 0, 0))) { r = 2; }
    if (r == 0 && bad(syscall(25, fd, p_low(), 8, 0, 0))) { r = 3; }
    if (r == 0 && bad(syscall(25, fd, p_high(), 8, 0, 0))) { r = 4; }
    if (r == 0 && bad(syscall(25, fd, p_noncanon(), 8, 0, 0))) { r = 5; }
    if (r == 0 && bad(syscall(25, fd, b, 0 - 1, 0, 0))) { r = 6; }
    if (r == 0 && bad(syscall(25, fd, b, 1 << 63, 0, 0))) { r = 7; }
    if (r == 0 && syscall(25, fd, b, 0, 0, 0) != 0) { r = 8; }
    if (r == 0 && syscall(25, fd, b, 8, 0, 0) != 8) { r = 9; }
    syscall(26, fd, 0, 0, 0, 0);
    syscall(30, "test/et29.tmp", 0, 0, 0, 0);
    return r;
}

