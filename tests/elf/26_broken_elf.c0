// expect: 1
// Writes test/broken.elf for verify_spawn_kill.sh, the four bytes every ELF
// starts with and then nothing an ELF loader can use, so start takes it for
// a program and elf_load refuses it. 1 when it was written.

int main() {
    int n = 128;
    int buf = alloc(n);
    if (!buf) { return 0; }
    int i = 0;
    for (i = 0; i < n; i += 1) { buf[i] = 0; }
    buf[0] = 127;
    buf[1] = 'E';
    buf[2] = 'L';
    buf[3] = 'F';
    if (writefile("test/broken.elf", buf, n) == n) { return 1; }
    return 0;
}
