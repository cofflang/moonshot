# What build.sh and the generators make. Everything in the repository is
# source, and the kernel, the ISO and every program are rebuilt from it.
build/
# Written by build.sh after a passing bootstrap audit. It describes binaries
# on this machine, not source (see README, Trust).
toolchain.sha256

# What the tests and the launchers make as they run.
out/
isoroot/
moonshot.iso
grub-mkrescue.log
serial.log
*.sock
*.wav
screenshots/

# The disk the launchers boot with, your own files.
disk.img
