                        for (k=0; k<16; k+=1) { int n=byte(); space=space*2-n; if (space < 0) { die("an oversubscribed JPEG tree"); } store8(t+k,n); count+=n; }
                        if (!count || count > 256 || pos+count > end) { die("an invalid JPEG symbol count"); }
                        for (k=0; k<count; k+=1) { store8(t+16+k,byte()); }
                        store64(jt+(id+cls*4)*8,t);
                    }
                } else {
                    if (marker == 221) { if (len != 4) { die("an invalid JPEG restart interval"); } restart=be16(); }
                    else {
                        if (marker == 218) { scans+=1; if (!component_count || scans > 128) { die("an invalid JPEG scan order"); } jpeg_scan(end); }
                        else { if (!((marker >= 224 && marker <= 239) || marker == 254)) { die("an unsupported JPEG marker"); } pos=end; }
                    }
                }
            }
        }
        if (marker != 218 && pos != end) { die("an invalid JPEG segment size"); }
    }
    if (!done || !scans || pos != size) { die("a JPEG without a complete end marker"); }
    for (i=0; i<component_count; i+=1) {
        if (load8(load64(jc+i*80+56)) == 255) { die("a JPEG without all DC components"); }
    }
    int ow=(width+7)/8; int oh=(height+7)/8;
    pixels=bounded_alloc(ow*oh*4);
    int y=0; int x=0;
    for (y=0; y<oh; y+=1) {
        for (x=0; x<ow; x+=1) {
            int values=bounded_alloc(3*8);
            for (i=0; i<component_count; i+=1) {
                int comp=jc+i*80; int hs=load64(comp+8); int vs=load64(comp+16); int q=load64(quant+load64(comp+24)*8);
                if (!q) { die("a missing JPEG quantization table"); }
                int bx=x*hs/maxh; int by=y*vs/maxv;
                int dc=load64(load64(comp+40)+(by*cols*hs+bx)*512);
                store64(values+i*8,clamp(128+dc*q/8));
            }
            int l=load64(values); int r=l; int g=l; int b=l;
            if (component_count == 3) {
                int cb=load64(values+8)-128; int cr=load64(values+16)-128;
                r=clamp(l+1436*cr/1024); g=clamp(l-(352*cb+731*cr)/1024); b=clamp(l+1815*cb/1024);
            }
            pixel(pixels+(y*ow+x)*4,r,g,b,255);
        }
    }
    width=ow; height=oh;
}

int gif_blocks() {
    if (!gif_buffer) { gif_buffer=bounded_alloc(size); }
    int data=gif_buffer; int count=0;
    while (1) {
        int n=byte(); if (!n) { break; }
        if (n > size-pos) { die("a truncated GIF subblock"); }
        int k=0; for (k=0; k<n; k+=1) { store8(data+count,byte()); count+=1; }
    }
    stream=data; stream_size=count; stream_pos=0; bits=0; bitcount=0;
    return data;
}
void gif() {
    pos=6; int w=le16(); int h=le16(); dimensions(w,h);
    int flags=byte(); int background=byte(); byte();
    int global=0; int global_n=0;
    if (flags&128) {
        global_n=1 << ((flags&7)+1); global=input+pos;
        if (pos+global_n*3 > size) { die("a truncated GIF palette"); } pos+=global_n*3;
    }
    int frames=0; int transparent=-1; int done=0; int total_pixels=0;
    while (pos < size) {
        int kind=byte();
        if (kind == 59) { done=1; break; }
        if (kind == 33) {
            int label=byte();
            if (label == 249) {
                if (byte() != 4) { die("an invalid GIF control block"); }
                int control=byte(); le16(); int index=byte(); transparent=-1;
                if (control&1) { transparent=index; }
                if (byte() != 0) { die("an unterminated GIF control block"); }
            } else { gif_blocks(); }
        } else {
            if (kind != 44) { die("an invalid GIF block"); }
            int left=le16(); int top=le16(); int fw=le16(); int fh=le16(); int info=byte();
            if (fw < 1 || fh < 1 || left+fw > width || top+fh > height) { die("an out of bounds GIF frame"); }
            int palette=global; int palette_n=global_n;
            if (info&128) {
                palette_n=1 << ((info&7)+1); palette=input+pos;
                if (pos+palette_n*3 > size) { die("a truncated GIF local palette"); } pos+=palette_n*3;
            }
            if (!palette) { die("a GIF without a palette"); }
            total_pixels+=fw*fh;
            if (total_pixels > 134217728) { die("the GIF decoded pixel budget"); }
            int minimum=byte(); if (minimum < 2 || minimum > 8) { die("an invalid GIF code width"); }
            gif_blocks();
            if (!frames) {
                pixels=bounded_alloc(width*height*4); int i=0;
                for (i=0; i<width*height; i+=1) {
                    int r=0; int g=0; int b=0; int a=0;
                    if (global && background < global_n && background != transparent) {
                        r=load8(global+background*3); g=load8(global+background*3+1); b=load8(global+background*3+2); a=255;
                    }
                    pixel(pixels+i*4,r,g,b,a);
                }
            }
            {
                if (!gif_prefix) { gif_prefix=bounded_alloc(4096*8); gif_suffix=bounded_alloc(4096); gif_stack=bounded_alloc(4096); }
                int prefix=gif_prefix; int suffix=gif_suffix; int stack=gif_stack;
                int clear=1 << minimum; int end=clear+1; int next=end+1; int nbits=minimum+1;
                int previous=-1; int first=0; int used=0; int ended=0; int row=0; int pass=0; int col=0;
                if (take_bits(nbits) != clear) { die("a GIF without an initial clear code"); }
                while (1) {
                    int code=take_bits(nbits);
                    if (code == end) { ended=1; break; }
                    if (code == clear) { next=end+1; nbits=minimum+1; previous=-1; continue; }
                    int original=code; int count=0;
                    if (code == next && previous >= 0) { store8(stack+count,first); count+=1; code=previous; }
                    else { if (code >= next) { die("an invalid GIF dictionary code"); } }
                    while (code >= clear) {
                        if (code >= next || count >= 4095) { die("a cyclic GIF dictionary"); }
                        store8(stack+count,load8(suffix+code)); count+=1; code=load64(prefix+code*8);
                    }
                    first=code; store8(stack+count,first); count+=1;
                    if (count > fw*fh-used) { die("excess GIF pixels"); }
                    while (count > 0) {
                        count-=1; int index=load8(stack+count);
                        if (index >= palette_n) { die("a GIF palette index overflow"); }
                        if (!frames) {
                        int p=pixels+((top+row)*width+left+col)*4;
                        pixel(p,load8(palette+index*3),load8(palette+index*3+1),load8(palette+index*3+2),255);
                        if (index == transparent) { store8(p+3,0); }
                        }
                        used+=1; col+=1;
                        if (col == fw) {
                            col=0;
                            if (info&64) {
                                int step=8; if (pass == 2) { step=4; } if (pass == 3) { step=2; }
                                row+=step;
                                while (row >= fh && pass < 3) {
                                    pass+=1; row=4; if (pass == 2) { row=2; } if (pass == 3) { row=1; }
                                }
                            } else { row+=1; }
                        }
                    }
                    if (previous >= 0 && next < 4096) {
                        store64(prefix+next*8,previous); store8(suffix+next,first); next+=1;
                        if (next == (1 << nbits) && nbits < 12) { nbits+=1; }
                    }
                    previous=original;
                }
                if (!ended || used != fw*fh) { die("an incomplete GIF frame"); }
            }
            frames+=1;
            if (frames > 4096) { die("the GIF frame budget"); }
            transparent=-1;
        }
    }
    if (!done || !frames || pos != size) { die("an incomplete GIF container"); }
}
int main() {
    if (argc() != 3) { die("arguments, expected input and output"); }
    int fd=open_read(argv(1)); if (fd < 0) { die("an unreadable image"); }
    input=bounded_alloc(67108865);
    while (size < 67108865) {
        int n=read(fd,input+size,67108865-size);
        if (n < 0) { close(fd); die("an image read error"); }
        if (!n) { break; } size+=n;
    }
    close(fd);
    if (size > 67108864) { die("the 64 MiB encoded image budget"); }
    if (size < 10) { die("a malformed image header"); }
    if (load8(input) == 255 && load8(input+1) == 216) { jpeg(); }
    else {
        if (load8(input) == 137 && load8(input+1) == 80 && load8(input+2) == 78 && load8(input+3) == 71 && load8(input+4) == 13 && load8(input+5) == 10 && load8(input+6) == 26 && load8(input+7) == 10) { png(); }
        else {
            if (load8(input) == 'G' && load8(input+1) == 'I' && load8(input+2) == 'F' && load8(input+3) == '8' && (load8(input+4) == '7' || load8(input+4) == '9') && load8(input+5) == 'a') { gif(); }
            else { die("a malformed or unsupported image header"); }
        }
    }
    int scale=1;
    while ((width+scale-1)/scale > 160 || (height+scale-1)/scale > 120) { scale+=1; }
    int ow=(width+scale-1)/scale; int oh=(height+scale-1)/scale;
    int out=bounded_alloc(24+ow*oh*4); store64(out,ow); store64(out+8,oh); store64(out+16,1);
    int y=0; int x=0; int k=0;
    for (y=0; y<oh; y+=1) {
        for (x=0; x<ow; x+=1) {
            for (k=0; k<4; k+=1) { store8(out+24+(y*ow+x)*4+k,load8(pixels+((y*scale)*width+x*scale)*4+k)); }
        }
    }
    int length=24+ow*oh*4;
    fd=open_write(argv(2)); if (fd < 0) { die("an unwritable sprite output"); }
    int used=0;
    while (used < length) {
        int n=write(fd,out+used,length-used);
        if (n <= 0) { close(fd); die("a sprite write error"); } used+=n;
    }
    close(fd); print("site image wrote a bounded sprite\n"); return 0;
}
