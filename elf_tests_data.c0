// Seeds every test ELF into directory `dir`. Any stale copy is removed
// first: disk.img survives reboots, so a rebuilt test would otherwise
// be silently ignored in favour of the previous run's bytes. Called on
// EVERY boot from jakel_init, not just the first -- see the fixture
// section there for why that placement is load-bearing.
void seed_elf_tests_install(int dir) {
    int stale_et01 = jakel_lookup(dir, "et01.elf");
    if (stale_et01 >= 0) { jakel_remove(stale_et01); }
    int f_et01 = jakel_make_file(dir, "et01.elf");
    if (f_et01 >= 0) {
        int b_et01 = kmalloc(853);
        if (b_et01 != 0) {
            seed_et01(b_et01);
            jakel_write(f_et01, 0, b_et01, 853);
            kfree(b_et01);
        }
    }
    int stale_et02 = jakel_lookup(dir, "et02.elf");
    if (stale_et02 >= 0) { jakel_remove(stale_et02); }
    int f_et02 = jakel_make_file(dir, "et02.elf");
    if (f_et02 >= 0) {
        int b_et02 = kmalloc(1935);
        if (b_et02 != 0) {
            seed_et02(b_et02);
            jakel_write(f_et02, 0, b_et02, 1935);
            kfree(b_et02);
        }
    }
    int stale_et03 = jakel_lookup(dir, "et03.elf");
    if (stale_et03 >= 0) { jakel_remove(stale_et03); }
    int f_et03 = jakel_make_file(dir, "et03.elf");
    if (f_et03 >= 0) {
        int b_et03 = kmalloc(514);
        if (b_et03 != 0) {
            seed_et03(b_et03);
            jakel_write(f_et03, 0, b_et03, 514);
            kfree(b_et03);
        }
    }
    int stale_et04 = jakel_lookup(dir, "et04.elf");
    if (stale_et04 >= 0) { jakel_remove(stale_et04); }
    int f_et04 = jakel_make_file(dir, "et04.elf");
    if (f_et04 >= 0) {
        int b_et04 = kmalloc(1003);
        if (b_et04 != 0) {
            seed_et04(b_et04);
            jakel_write(f_et04, 0, b_et04, 1003);
            kfree(b_et04);
        }
    }
    int stale_et05 = jakel_lookup(dir, "et05.elf");
    if (stale_et05 >= 0) { jakel_remove(stale_et05); }
    int f_et05 = jakel_make_file(dir, "et05.elf");
    if (f_et05 >= 0) {
        int b_et05 = kmalloc(605);
        if (b_et05 != 0) {
            seed_et05(b_et05);
            jakel_write(f_et05, 0, b_et05, 605);
            kfree(b_et05);
        }
    }
    int stale_et06 = jakel_lookup(dir, "et06.elf");
    if (stale_et06 >= 0) { jakel_remove(stale_et06); }
    int f_et06 = jakel_make_file(dir, "et06.elf");
    if (f_et06 >= 0) {
        int b_et06 = kmalloc(897);
        if (b_et06 != 0) {
            seed_et06(b_et06);
            jakel_write(f_et06, 0, b_et06, 897);
            kfree(b_et06);
        }
    }
    int stale_et07 = jakel_lookup(dir, "et07.elf");
    if (stale_et07 >= 0) { jakel_remove(stale_et07); }
    int f_et07 = jakel_make_file(dir, "et07.elf");
    if (f_et07 >= 0) {
        int b_et07 = kmalloc(748);
        if (b_et07 != 0) {
            seed_et07(b_et07);
            jakel_write(f_et07, 0, b_et07, 748);
            kfree(b_et07);
        }
    }
    int stale_et08 = jakel_lookup(dir, "et08.elf");
