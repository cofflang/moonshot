// WARRANTY; see the LICENSE file for the full text.
//
// lira -- the piano roll. A tavla with a grid of pitches (rows) against time
// (columns, one per step, four steps to a beat). The left button puts a note
// in, and dragging before letting go makes it longer. The right button takes
// a note away. A note's ends drag to make it shorter or longer, and its
// middle drags up and down for how loud it is and left and right for where
// it sits between the speakers. The pointer shows which, arrows left and
// right on an end, four ways on a middle. The instruments are buttons along
// the bottom, the one new notes get lit. Space plays the song through oljud
// and stops it, s saves it.
//
// It edits the file named on its command line (`start lira.elf NAME`, or a
// click on a song in hylla), a new song when there is none yet, in the noter
// format (noter.c0), and plays it with the synth (synth.c0). Without a name
// it is a new song with no name, and s asks for one along the bottom (a
// name without an ending gets .not). A save changes jakel in memory, and
// the shell's `sync` puts it on disk.
//
// Keys
//   , and .      quieter or louder new notes (velocity, in steps of 16)
//   1 to 4       the instrument new notes get, as its button does, square,
//                triangle, sawtooth or drum, each drawn in its own colour,
//                and the one m, o and p act on
//   m            mute that instrument, or hear it again
//   o            solo it, only it is heard, or everything again
//   p and P      pan it a step right or left, nine steps from hard left
//                to hard right, saved with the song
//   - and =      tempo down or up by 5 beats per minute
//   arrows       scroll up and down a semitone, left and right a beat
//   PgUp, PgDn   scroll an octave
//   Home         back to the start
//   space        play from the start, or stop
//   l            loop, playback starts over at the end instead of stopping
//   s            save
//   h            the help, the same list drawn over the grid
//   Esc          close the help, or quit
//
// At most eight notes may sound at once, the synth's limit, so a click that
// would make a ninth is refused with a message.
//
// Playing streams the song. Each frame, as long as less than PLAY_AHEAD bytes
// are waiting in oljud's queue, the next block is rendered and handed over.
// Keeping the queue short keeps the playhead close to what is heard, and stop
// empties oljud's queue with sound(0, -1), so the sound stops at once.
//
// Each note shows its velocity as a pale bar along its bottom edge, as long
// as the note is loud, so a full-length bar is velocity 127. The notes of an
// instrument that is not heard, muted or left out by a solo, are drawn in
// their darker edge colour.
//
// The song plays as 16-bit stereo (sound_format(2)), each instrument where
// its pan puts it.

include "noter.c0";
include "synth.c0";
include "moon.c0";

int SONG_CAP = 1024;            // notes, 32KB of song
int PLAY_BLOCK = 1024;          // samples rendered at a time
int PLAY_AHEAD = 5120;          // samples kept queued while playing
int FRAME = 4;                  // bytes of one stereo sample in oljud's queue

// --- drawing ---------------------------------------------------------------
//
// The frame is composited in lira's own buffer and handed over with one
// present(), like utsikt and Gnista, since a draw split over several syscalls is
// torn by the scheduler. The buffer is sized from win_max(), the largest
// window there can ever be, and strided at the window's current width,
// because that is the stride present() reads with.

int fb;
int fb_max_w;
int fb_max_h;
int view_w;
int view_h;
int cell_w;
int cell_h;
int font_cache;

int COL_BG_WHITE = 0x2c2c32;    // rows of white keys
int COL_BG_BLACK = 0x222227;    // rows of black keys
int COL_STEP = 0x34343c;        // the line between two steps
int COL_BEAT = 0x484852;        // the line at each beat
int COL_BAR = 0x6c6c7a;         // the line at each bar (four beats)
int COL_NOTE = 0xe8a23c;        // a square-wave note
int COL_NOTE_EDGE = 0x8a5a18;

// A note's fill and edge colours, by instrument. The square, the default,
// has lira's plain note colour.
int note_colour(int inst) {
    if (inst == 1) { return 0x5ad07a; }
    if (inst == 2) { return 0x5aa0f0; }
    if (inst == 3) { return 0xc08ae0; }
    return COL_NOTE;
}

int note_edge(int inst) {
    if (inst == 1) { return 0x2a6a3a; }
    if (inst == 2) { return 0x2a4a80; }
    if (inst == 3) { return 0x604070; }
    return COL_NOTE_EDGE;
}

int instrument_name(int inst) {
    if (inst == 1) { return "triangle"; }
    if (inst == 2) { return "saw"; }
    if (inst == 3) { return "drum"; }
    return "square";
}
int COL_VEL = 0xffe2b0;         // the velocity bar inside a note
int COL_HEAD = 0xf05a5a;        // where playback is
int COL_TEXT = 0xd0d0c8;
int COL_DIM = 0x8a8a92;
int COL_PANEL = 0x18181c;

void put_px(int addr, int color) {
    store32(addr, color & 0xFFFFFF);
    return;
}

void fill_rect(int x, int y, int w, int h, int color) {
    int x0 = x;
    int y0 = y;
    int x1 = x + w;
    int y1 = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > view_w) { x1 = view_w; }
    if (y1 > view_h) { y1 = view_h; }
    if (x1 <= x0 || y1 <= y0) { return; }
    int pair = (color << 32) | color;
    int row = 0;
    for (row = y0; row < y1; row += 1) {
        int col = x0;
        int base = fb + (row * view_w + col) * 4;
        // Paired 8-byte stores need an even pixel index to stay aligned.
        if ((row * view_w + col) % 2 == 1) {
            put_px(base, color);
            col += 1;
            base += 4;
        }
        while (col + 1 < x1) {
            store64(base, pair);
            col += 2;
            base += 8;
        }
        while (col < x1) {
            put_px(base, color);
            col += 1;
            base += 4;
        }
    }
    return;
}

// The kernel's font, asked for once, the way utsikt does it.
int font_init() {
    int d = glyph('M', 0);
    if (d <= 0) { return 0; }
    cell_w = d >> 16;
    cell_h = d & 65535;
    if (cell_w <= 0 || cell_w > 8 || cell_h <= 0 || cell_h > 32) { return 0; }
    font_cache = alloc(128 * cell_h);
    if (!font_cache) { return 0; }
    int c = 0;
    for (c = 0; c < 128; c += 1) {
        if (glyph(c, font_cache + c * cell_h) != d) { return 0; }
    }
    return 1;
}

// One character, lit pixels only. Bit 7 of each row byte is the leftmost.
void draw_char(int x, int y, int ch, int color) {
    if (ch < 0 || ch > 127) { return; }
    int row = 0;
    for (row = 0; row < cell_h; row += 1) {
        int b = load8(font_cache + ch * cell_h + row);
        int col = 0;
        int bit = 128;
        while (col < cell_w) {
            if ((b / bit) % 2 == 1) {
                int px = x + col;
                int py = y + row;
                if (px >= 0 && py >= 0 && px < view_w && py < view_h) {
                    put_px(fb + (py * view_w + px) * 4, color);
                }
            }
            bit /= 2;
            col += 1;
        }
    }
    return;
}

// Draws a NUL-terminated string and returns the x just past it.
int draw_text(int x, int y, int s, int color) {
    int i = 0;
    for (i = 0; load8(s + i) != 0; i += 1) {
        draw_char(x, y, load8(s + i), color);
        x += cell_w;
    }
    return x;
}

// Text is built up in one line buffer, then drawn.
int line;
int line_n;

void line_reset() { line_n = 0; store8(line, 0); return; }

void line_add(int s) {
    int i = 0;
    for (i = 0; load8(s + i) != 0 && line_n < 255; i += 1) {
        store8(line + line_n, load8(s + i));
        line_n += 1;
    }
    store8(line + line_n, 0);
    return;
}

void line_num(int n) {
    if (n < 0) { line_add("-"); }
    int digits = alloc(24);
    int k = 0;
    if (!n) { store8(digits, '0'); k = 1; }
    while (n != 0) {
        int d = n % 10;
        if (d < 0) { d = 0 - d; }
        store8(digits + k, '0' + d);
        n /= 10;
        k += 1;
    }
    while (k > 0) {
        k -= 1;
        if (line_n < 255) { store8(line + line_n, load8(digits + k)); line_n += 1; }
    }
    store8(line + line_n, 0);
    dealloc(digits);
    return;
}

// --- the song and the view --------------------------------------------------

int song;
int song_name;
int top_pitch;        // the pitch of the top row
int first_step;       // the step in the leftmost column
int note_len = 4;     // steps a new note gets
int note_vel = 100;   // velocity a new note gets
int note_inst = 0;    // instrument a new note gets
int muted = 0;        // instruments muted, one bit each
int solo = -1;        // the instrument soloed, or -1
int shift = 0;

// Tells the synth who is heard, from the mutes and the solo.
void update_heard() {
    if (solo >= 0) {
        synth_muted = 15 - (1 << solo);
    } else {
        synth_muted = muted;
    }
    return;
}

int heard(int inst) { return ((synth_muted >> inst) & 1) == 0; }
int looping = 0;      // 1 means playback starts over at the end
int fitted = 0;       // 1 once the view has been centred on the song
int message;          // the status line's message, or 0
int help_open;        // 1 while the help is drawn over the grid
int dirty = 1;

int playing = 0;
int play_at = 0;      // the next sample to render, within the song
int play_done = 0;    // samples rendered since play started, loops included
int play_len = 0;
int play_out;
int play_mix;
int head_x;           // where the playhead was last drawn, or -1

int ROW_H;
int COL_W = 12;
int LABEL_W;
int HEAD_H;
int PANEL_H;

int grid_rows() {
    int r = (view_h - HEAD_H - PANEL_H) / ROW_H;
    if (r < 0) { r = 0; }
    return r;
}

int grid_cols() {
    int c = (view_w - LABEL_W) / COL_W;
    if (c < 0) { c = 0; }
    return c;
}

// 1 for the pitches that are black keys on a piano.
int is_black(int pitch) {
    int n = pitch % 12;
    if (n == 1 || n == 3 || n == 6 || n == 8 || n == 10) { return 1; }
    return 0;
}

// Adds a pitch's name ("C4", "F#5") to the line buffer. MIDI 60 is C4.
void line_pitch(int pitch) {
    int n = pitch % 12;
    if (!n) { line_add("C"); }
    if (n == 1) { line_add("C#"); }
    if (n == 2) { line_add("D"); }
    if (n == 3) { line_add("D#"); }
    if (n == 4) { line_add("E"); }
    if (n == 5) { line_add("F"); }
    if (n == 6) { line_add("F#"); }
    if (n == 7) { line_add("G"); }
    if (n == 8) { line_add("G#"); }
    if (n == 9) { line_add("A"); }
    if (n == 10) { line_add("A#"); }
    if (n == 11) { line_add("B"); }
    line_num(pitch / 12 - 1);
    return;
}

// The x where a step's column starts, which may be off either edge.
int step_x(int step) {
    return LABEL_W + (step - first_step) * COL_W;
}

// Centres the view on the song's range of pitches, once the window's height
// is known. An empty song is centred on middle C.
void view_fit() {
    int hi = 0 - 1;
    int lo = 128;
    int i = 0;
    for (i = 0; i < noter_count(song); i += 1) {
        int r = noter_note(song, i);
        if (r.nn_pitch > hi) { hi = r.nn_pitch; }
        if (r.nn_pitch < lo) { lo = r.nn_pitch; }
    }
    if (hi < 0) { hi = 60; lo = 60; }
    top_pitch = (hi + lo) / 2 + grid_rows() / 2;
    // A song taller than the window keeps its highest note in view.
    if (top_pitch > hi + 2 && hi - lo + 1 > grid_rows()) { top_pitch = hi + 2; }
    if (top_pitch > 127) { top_pitch = 127; }
    if (top_pitch < 0) { top_pitch = 0; }
    first_step = 0;
    return;
}

// The playhead's sample, as far as can be told from here, what has been
// rendered, less what is still waiting in oljud's queue.
int play_sample() {
    int waiting = sound(0, 0) / FRAME;
    if (waiting < 0) { waiting = 0; }
    int at = play_done - waiting;
    if (at < 0) { at = 0; }
    if (play_len > 0) { at %= play_len; }
    return at;
}

// The playhead's x, -1 when it is not playing or not on screen.
int play_x() {
    if (!playing) { return 0 - 1; }
    // Samples to steps without rounding twice, x in pixels straight from
    // the sample, so the line moves smoothly within a step.
    int px = play_sample() * song.nh_tempo * song.nh_steps * COL_W
             / (SYNTH_RATE * 60);
    int x = LABEL_W + px - first_step * COL_W;
    if (x < LABEL_W || x >= LABEL_W + grid_cols() * COL_W) { return 0 - 1; }
    return x;
}

void render() {
    fill_rect(0, 0, view_w, view_h, COL_PANEL);
    int rows = grid_rows();
    int cols = grid_cols();
    int gw = cols * COL_W;
    int gh = rows * ROW_H;

    // Rows, with their names on the left. C gets its name in full colour,
    // so the octaves are easy to find.
    int r = 0;
    for (r = 0; r < rows; r += 1) {
        int pitch = top_pitch - r;
        if (pitch < 0) { break; }
        int y = HEAD_H + r * ROW_H;
        int bg = COL_BG_WHITE;
        if (is_black(pitch) == 1) { bg = COL_BG_BLACK; }
        fill_rect(LABEL_W, y, gw, ROW_H - 1, bg);
        line_reset();
        line_pitch(pitch);
        int c = COL_DIM;
        if (pitch % 12 == 0) { c = COL_TEXT; }
        draw_text(3, y + (ROW_H - cell_h) / 2, line, c);
    }

    // Columns, a faint line between steps, stronger at beats and bars, and
    // the bar number above each bar.
    int k = 0;
    for (k = 0; k <= cols; k += 1) {
        int step = first_step + k;
        int x = LABEL_W + k * COL_W;
        int lc = COL_STEP;
        if (step % song.nh_steps == 0) { lc = COL_BEAT; }
        if (step % (song.nh_steps * 4) == 0) {
            lc = COL_BAR;
            line_reset();
            line_num(step / (song.nh_steps * 4) + 1);
            draw_text(x + 2, (HEAD_H - cell_h) / 2, line, COL_DIM);
        }
        fill_rect(x, HEAD_H, 1, gh, lc);
    }

    // Notes.
    int i = 0;
    for (i = 0; i < noter_count(song); i += 1) {
        int n = noter_note(song, i);
        int row = top_pitch - n.nn_pitch;
        if (row >= 0 && row < rows) {
            int x0 = step_x(n.nn_start);
            int x1 = step_x(n.nn_start + n.nn_length);
            if (x0 < LABEL_W) { x0 = LABEL_W; }
            if (x1 > LABEL_W + gw) { x1 = LABEL_W + gw; }
            if (x1 > x0) {
                int y = HEAD_H + row * ROW_H;
                fill_rect(x0 + 1, y + 1, x1 - x0 - 1, ROW_H - 3, note_edge(n.nn_instrument));
                int fillc = note_colour(n.nn_instrument);
                if (!heard(n.nn_instrument)) { fillc = note_edge(n.nn_instrument); }
                fill_rect(x0 + 2, y + 2, x1 - x0 - 3, ROW_H - 5, fillc);
                // The velocity bar, along the bottom two rows of the note,
                // measured against the note's whole length even when part
                // of it is scrolled off the left edge.
                int full = step_x(n.nn_start + n.nn_length) - step_x(n.nn_start) - 3;
                int vx = step_x(n.nn_start) + 2;
                int vw = full * n.nn_velocity / 127;
                int vx1 = vx + vw;
                if (vx < x0 + 2) { vx = x0 + 2; }
                if (vx1 > x1 - 1) { vx1 = x1 - 1; }
                if (vx1 > vx) { fill_rect(vx, y + ROW_H - 5, vx1 - vx, 2, COL_VEL); }
                // A note moved between the speakers has a mark along its
                // top, at the place it sits, left end hard left.
                if (n.nn_pan != NOTER_PAN_MIDDLE) {
                    int px2 = step_x(n.nn_start) + 2 + full * n.nn_pan / NOTER_PAN_MAX - 1;
                    // Kept inside the note, so hard left and hard right show too.
                    if (px2 < step_x(n.nn_start) + 2) { px2 = step_x(n.nn_start) + 2; }
                    if (px2 + 2 > step_x(n.nn_start) + 2 + full) { px2 = step_x(n.nn_start) + full; }
                    if (px2 >= x0 + 2 && px2 + 2 <= x1 - 1) { fill_rect(px2, y + 2, 2, 3, COL_HEAD); }
                }
            }
        }
    }

    head_x = play_x();
    if (head_x >= 0) { fill_rect(head_x, HEAD_H, 2, gh, COL_HEAD); }

    // The panel along the bottom, the instrument buttons and under them the
    // status line.
    draw_buttons();
    int py = view_h - cell_h - 4;
    line_reset();
    line_add(song_name);
    line_add("  ");
    line_num(song.nh_tempo);
    line_add(" bpm  vel ");
    line_num(note_vel);
    line_add("  ");
    line_add(instrument_name(note_inst));
    // Where it sits, C in the middle, L4 hard left to R4 hard right.
    line_add(" pan ");
    line_pan(noter_pan(song, note_inst) - NOTER_PAN_MIDDLE);
    if (solo == note_inst) { line_add(" solo"); }
    else if (!heard(note_inst)) { line_add(" muted"); }
    line_add("  ");
    line_num(noter_count(song));
    line_add(" notes");
    if (looping == 1) { line_add("  loop"); }
    if (playing == 1) { line_add("  playing"); }
    if (naming) {
        nbuf[nlen] = 0;
        line_reset();
        line_add("save as ");
        line_add(nbuf);
        line_add("_    Enter saves, Esc keeps working");
    }
    // The help hint first, so a narrow window never cuts it off.
    int x = draw_text(4, py, "h help", COL_DIM);
    x = draw_text(x + cell_w * 2, py, line, COL_TEXT);
    if (message != 0) { draw_text(x + cell_w * 2, py, message, COL_HEAD); }
    if (help_open == 1) { draw_help(); }
    return;
}

// The help, drawn over the grid in a box. Everything a person needs to make
// a first song, since the keys are not written anywhere else they can see.
void draw_help() {
    int lines = alloc(32 * 8);
    int n = 0;
    store64(lines + n * 8, "lira, the piano roll"); n += 1;
    store64(lines + n * 8, ""); n += 1;
    store64(lines + n * 8, "Rows are pitches, the C of each octave named"); n += 1;
    store64(lines + n * 8, "in full colour. Columns are steps, four steps"); n += 1;
    store64(lines + n * 8, "to a beat and four beats to a numbered bar."); n += 1;
    store64(lines + n * 8, ""); n += 1;
    store64(lines + n * 8, "left       put a note in, drag to lengthen"); n += 1;
    store64(lines + n * 8, "right      take a note out"); n += 1;
    store64(lines + n * 8, "drag ends  a note shorter or longer"); n += 1;
    store64(lines + n * 8, "drag middle up/down loudness, sideways pan"); n += 1;
    store64(lines + n * 8, "buttons    the instrument, or 1 2 3 4"); n += 1;
    store64(lines + n * 8, "m o        mute or solo that instrument"); n += 1;
    store64(lines + n * 8, "p P        pan it right or left"); n += 1;
    store64(lines + n * 8, ", .        quieter or louder new notes"); n += 1;
    store64(lines + n * 8, "- =        slower or faster"); n += 1;
    store64(lines + n * 8, "arrows     a semitone or a beat"); n += 1;
    store64(lines + n * 8, "PgUp PgDn  an octave"); n += 1;
    store64(lines + n * 8, "Home       back to the start"); n += 1;
    store64(lines + n * 8, "space      play, or stop"); n += 1;
    store64(lines + n * 8, "l          loop on or off"); n += 1;
    store64(lines + n * 8, "s          save"); n += 1;
    store64(lines + n * 8, "h          this help"); n += 1;
    store64(lines + n * 8, "Esc        close this, or quit lira"); n += 1;
    store64(lines + n * 8, ""); n += 1;
    store64(lines + n * 8, "The bottom shows what new notes get."); n += 1;
    store64(lines + n * 8, "s saves to the name at its start. Type sync"); n += 1;
    store64(lines + n * 8, "in the shell to keep it after a restart."); n += 1;
    int w = 46 * cell_w + 16;
    int h = n * (cell_h + 2) + 14;
    int x = (view_w - w) / 2;
    int y = (view_h - h) / 2;
    if (x < 0) { x = 0; }
    if (y < 0) { y = 0; }
    fill_rect(x, y, w, h, COL_BAR);
    fill_rect(x + 1, y + 1, w - 2, h - 2, COL_PANEL);
    int i = 0;
    for (i = 0; i < n; i += 1) {
        int c = COL_TEXT;
        if (i == 0) { c = COL_NOTE; }
        draw_text(x + 8, y + 7 + i * (cell_h + 2), load64(lines + i * 8), c);
    }
    dealloc(lines);
    return;
}

// --- actions ----------------------------------------------------------------

// What the left button is doing while it is held. DRAG_NONE when it is not.
int DRAG_NONE = 0;
int DRAG_END = 1;     // the note's end, its length
int DRAG_START = 2;   // the note's start, its end stays
int DRAG_BODY = 3;    // its middle, loudness or pan, whichever way it moves first
int drag = 0;
int drag_note = 0 - 1;     // the note's pitch and start, which find it again
int drag_pitch = 0;
int drag_start = 0;
int drag_x = 0;            // where the press was
int drag_y = 0;
int drag_axis = 0;         // 1 up and down, 2 left and right, 0 not yet
int drag_moved = 0;        // 1 once the pointer has gone a few pixels
int drag_vel = 0;          // the note's loudness and pan when it was pressed
int drag_pan = 0;
int pointer_now = 0;       // the shape last asked for

// The grid cell at window point (mx, my), as pitch and step, or -1 and -1.
(int, int) cell_at(int mx, int my) {
    if (mx < LABEL_W || my < HEAD_H) { return 0 - 1, 0 - 1; }
    int col = (mx - LABEL_W) / COL_W;
    int row = (my - HEAD_H) / ROW_H;
    if (col >= grid_cols() || row >= grid_rows()) { return 0 - 1, 0 - 1; }
    int pitch = top_pitch - row;
    if (pitch < 0 || pitch > 127) { return 0 - 1, 0 - 1; }
    return pitch, first_step + col;
}

// The note at window point (mx, my) and which part of it, DRAG_END or
// DRAG_START within a few pixels of an end, else DRAG_BODY. -1 and 0 when
// there is none.
(int, int) note_at(int mx, int my) {
    int pitch = 0;
    int step = 0;
    pitch, step = cell_at(mx, my);
    if (pitch < 0) { return 0 - 1, 0; }
    int hit = noter_find(song, pitch, step);
    if (hit < 0) { return 0 - 1, 0; }
    int n = noter_note(song, hit);
    int x0 = step_x(n.nn_start);
    int x1 = step_x(n.nn_start + n.nn_length);
    int grip = 4;
    if (x1 - x0 < 12) { grip = 2; }
    if (mx >= x1 - grip) { return hit, DRAG_END; }
    if (mx < x0 + grip && n.nn_length > 1) { return hit, DRAG_START; }
    return hit, DRAG_BODY;
}

// The pointer for what is under (mx, my).
void hover(int mx, int my) {
    int shape = POINTER_BLOCK;
    if (drag == DRAG_END || drag == DRAG_START) { shape = POINTER_STRETCH; }
    else if (drag == DRAG_BODY) { shape = POINTER_DRAG; }
    else {
        int hit = 0;
        int part = 0;
        hit, part = note_at(mx, my);
        if (hit >= 0) {
            shape = POINTER_DRAG;
            if (part != DRAG_BODY) { shape = POINTER_STRETCH; }
        }
    }
    if (shape != pointer_now) {
        pointer_now = shape;
        pointer(shape);
    }
    return;
}

// The note being dragged, found again by its pitch and start, since adding
// and removing notes moves the others in the list.
int dragged() { return noter_find(song, drag_pitch, drag_start); }

// Puts a note back with new fields, where its start may have moved.
void replace_note(int i, int start, int length) {
    int n = noter_note(song, i);
    int pitch = n.nn_pitch;
    int vel = n.nn_velocity;
    int inst = n.nn_instrument;
    int pan = n.nn_pan;
    noter_remove(song, i);
    int k = noter_add_with(song, SONG_CAP, pitch, start, length, vel, inst);
    if (k >= 0) {
        int r = noter_note(song, k);
        r.nn_pan = pan;
    }
    drag_start = start;
    return;
}

// Adds a note at the press. It is dragged by its end straight away, so
// holding the button and moving right makes it longer.
void place(int mx, int my) {
    int pitch = 0;
    int step = 0;
    pitch, step = cell_at(mx, my);
    if (pitch < 0) { return; }
    if (noter_voices(song, step, note_len) >= 8) {
        message = "eight notes already sound there";
        return;
    }
    if (noter_add_with(song, SONG_CAP, pitch, step, note_len, note_vel, note_inst) < 0) {
        message = "the song is full";
        return;
    }
    drag = DRAG_END;
    drag_pitch = pitch;
    drag_start = step;
    drag_x = mx;
    drag_y = my;
    drag_moved = 0;
    message = 0;
    return;
}

void press(int mx, int my) {
    if (my >= view_h - PANEL_H) { panel_click(mx, my); return; }
    int hit = 0;
    int part = 0;
    hit, part = note_at(mx, my);
    if (hit < 0) {
        place(mx, my);
        return;
    }
    int n = noter_note(song, hit);
    drag = part;
    drag_pitch = n.nn_pitch;
    drag_start = n.nn_start;
    drag_x = mx;
    drag_y = my;
    drag_axis = 0;
    drag_moved = 0;
    drag_vel = n.nn_velocity;
    drag_pan = n.nn_pan;
    message = 0;
    return;
}

// The button held and the pointer at (mx, my).
void move(int mx, int my) {
    // A press that has not gone anywhere yet is a click, nothing to drag.
    if (!drag_moved) {
        int ddx = mx - drag_x;
        int ddy = my - drag_y;
        if (ddx < 3 && ddx > 0 - 3 && ddy < 3 && ddy > 0 - 3) { return; }
        drag_moved = 1;
    }
    int i = dragged();
    if (i < 0) { drag = DRAG_NONE; return; }
    int n = noter_note(song, i);
    // The step under the pointer, even past the grid's edges.
    int step = first_step + (mx - LABEL_W) / COL_W;
    if (mx < LABEL_W) { step = first_step - 1; }
    if (drag == DRAG_END) {
        int len = step - n.nn_start + 1;
        if (len < 1) { len = 1; }
        if (len != n.nn_length) {
            n.nn_length = len;
            note_len = len;
        }
        return;
    }
    if (drag == DRAG_START) {
        int end = n.nn_start + n.nn_length;
        int start = step;
        if (start < 0) { start = 0; }
        if (start > end - 1) { start = end - 1; }
        if (start != n.nn_start) { replace_note(i, start, end - start); }
        return;
    }
    // The middle. Whichever way it moves first, a few pixels, is the one.
    int dx = mx - drag_x;
    int dy = my - drag_y;
    if (drag_axis == 0) {
        int ax = dx;
        if (ax < 0) { ax = 0 - ax; }
        int ay = dy;
        if (ay < 0) { ay = 0 - ay; }
        if (ay >= 4 && ay >= ax) { drag_axis = 1; }
        else if (ax >= 4) { drag_axis = 2; }
    }
    if (drag_axis == 1) {
        int v = drag_vel - dy;
        if (v < 1) { v = 1; }
        if (v > 127) { v = 127; }
        n.nn_velocity = v;
        line_reset();
        line_add("velocity ");
        line_num(v);
        message = line_copy();
    }
    if (drag_axis == 2) {
        int pan = drag_pan + dx / 8;
        if (pan < 0) { pan = 0; }
        if (pan > NOTER_PAN_MAX) { pan = NOTER_PAN_MAX; }
        n.nn_pan = pan;
        line_reset();
        line_add("note pan ");
        line_pan(pan - NOTER_PAN_MIDDLE);
        message = line_copy();
    }
    return;
}

// The right button, which takes away the note under it.
void erase(int mx, int my) {
    int pitch = 0;
    int step = 0;
    pitch, step = cell_at(mx, my);
    if (pitch < 0) { return; }
    int hit = noter_find(song, pitch, step);
    if (hit >= 0) {
        noter_remove(song, hit);
        message = 0;
    }
    return;
}

// --- the instrument buttons ---------------------------------------------------

int button_w(int inst) { return (len(instrument_name(inst)) + 4) * cell_w; }
int buttons_y() { return view_h - PANEL_H + 4; }

void draw_buttons() {
    int x = 4;
    int y = buttons_y();
    int inst = 0;
    for (inst = 0; inst < NOTER_INSTRUMENTS; inst += 1) {
        int w = button_w(inst);
        int edge = COL_STEP;
        if (inst == note_inst) { edge = COL_TEXT; }
        fill_rect(x, y, w, cell_h + 6, edge);
        fill_rect(x + 1, y + 1, w - 2, cell_h + 4, COL_BG_BLACK);
        fill_rect(x + 4, y + 4, cell_w, cell_h - 2, note_colour(inst));
        int c = COL_DIM;
        if (inst == note_inst) { c = COL_TEXT; }
        if (!heard(inst)) { c = note_edge(inst); }
        draw_text(x + 4 + cell_w * 2, y + 3, instrument_name(inst), c);
        x += w + 6;
    }
    return;
}

void panel_click(int mx, int my) {
    int y = buttons_y();
    if (my < y || my >= y + cell_h + 6) { return; }
    int x = 4;
    int inst = 0;
    for (inst = 0; inst < NOTER_INSTRUMENTS; inst += 1) {
        int w = button_w(inst);
        if (mx >= x && mx < x + w) { note_inst = inst; return; }
        x += w + 6;
    }
    return;
}

int len(int s) {
    int n = 0;
    while (s[n] != 0) { n += 1; }
    return n;
}

// The line, copied into the one buffer drag messages share, for a message
// that outlives the line.
int msgbuf = 0;
int line_copy() {
    if (!msgbuf) { msgbuf = alloc(128); }
    if (!msgbuf) { return 0; }
    int i = 0;
    for (i = 0; i <= line_n && i < 127; i += 1) { msgbuf[i] = load8(line + i); }
    msgbuf[127] = 0;
    return msgbuf;
}

// A pan from the middle, C, L1 to L4 or R1 to R4.
void line_pan(int pan) {
    if (!pan) { line_add("C"); }
    else if (pan < 0) { line_add("L"); line_num(0 - pan); }
    else { line_add("R"); line_num(pan); }
    return;
}

void play_start() {
    play_len = synth_length(song);
    play_at = 0;
    play_done = 0;
    playing = 1;
    if (!play_len) { playing = 0; return; }
    if (sound(0, 0) < 0) {
        playing = 0;
        message = "no sound card";
    }
    return;
}

// Stops at once, and what is still queued in oljud is thrown away.
void play_stop() {
    playing = 0;
    sound(0, 0 - 1);
    return;
}

// Keeps oljud's queue topped up to PLAY_AHEAD while playing, and notices
// when the song is over.
void play_feed() {
    if (!playing) { return; }
    while (sound(0, 0) / FRAME + PLAY_BLOCK <= PLAY_AHEAD) {
        // At the end of the song a loop starts over. The synth keeps no
        // state between blocks, so the start follows the end seamlessly.
        if (play_at >= play_len) {
            if (!looping) { break; }
            play_at = 0;
        }
        int n = PLAY_BLOCK;
        if (play_len - play_at < n) { n = play_len - play_at; }
        synth_render16(song, play_at, n, play_out, play_mix);
        int sent = 0;
        while (sent < n * FRAME) {
            int got = sound(play_out + sent, n * FRAME - sent);
            if (got < 0) { playing = 0; return; }
            sent += got;
        }
        play_at += n;
        play_done += n;
    }
    if (looping == 0 && play_at >= play_len && sound(0, 0) == 0) {
        playing = 0;
        dirty = 1;
    }
    return;
}

// The file a save writes, the one named on the command line or asked for,
// or 0 before there is one.
int save_name = 0;
int naming = 0;       // 1 while the bottom line asks for a name to save as
int nbuf;
int nlen = 0;

// A key while the bottom line asks for a name.
void naming_key(int make) {
    if (make == 1) { naming = 0; return; }
    if (make == 14) { if (nlen > 0) { nlen -= 1; } return; }
    if (make == 28) {
        if (nlen == 0) { return; }
        int dot = 0;
        int i = 0;
        for (i = 0; i < nlen; i += 1) { if (nbuf[i] == '.') { dot = 1; } }
        int n = alloc(nlen + 5);
        if (!n) { return; }
        for (i = 0; i < nlen; i += 1) { n[i] = nbuf[i]; }
        n[nlen] = 0;
        if (!dot) {
            int ending = ".not";
            for (i = 0; i < 5; i += 1) { n[nlen + i] = ending[i]; }
        }
        save_name = n;
        naming = 0;
        save();
        return;
    }
    int ch = key_char(make, shift);
    if (ch > 32 && ch < 127 && nlen < 60) { nbuf[nlen] = ch; nlen += 1; }
    return;
}

void save() {
    if (!save_name) {
        naming = 1;
        nlen = 0;
        return;
    }
    if (noter_save(song, save_name) == 1) {
        song_name = save_name;
        message = "saved, sync to keep";
    } else {
        message = "could not save";
    }
    return;
}

int main() {
    int mx_max = win_max();
    fb_max_w = mx_max >> 16;
    fb_max_h = mx_max & 65535;
    fb = alloc(fb_max_w * fb_max_h * 4);
    if (!fb) { print("lira: cannot allocate a frame buffer\n"); return 2; }
    if (font_init() == 0) { print("lira: the kernel would not hand over its font\n"); return 3; }
    line = alloc(256);
    play_out = alloc(PLAY_BLOCK * FRAME);
    play_mix = alloc(PLAY_BLOCK * 16);
    // A machine with no sound card says no, and play_start tells the user.
    sound_format(2);
    if (line == 0 || play_out == 0 || !play_mix) { print("lira: out of memory\n"); return 4; }
    head_x = 0 - 1;
    ROW_H = cell_h + 4;
    LABEL_W = cell_w * 4 + 6;
    HEAD_H = cell_h + 6;
    PANEL_H = cell_h * 2 + 16;

    // `start lira.elf NAME` edits NAME, a new song when there is none yet,
    // and saves to it. Without a name, a new song with none.
    nbuf = alloc(64);
    if (!nbuf) { print("lira: out of memory\n"); return 4; }
    song_name = "unnamed";
    if (argc() >= 2) {
        save_name = argv(1);
        song_name = save_name;
        song = noter_load(save_name, SONG_CAP);
    }
    if (!song) { song = noter_new(SONG_CAP, 4, 120); }
    if (!song) { print("lira: out of memory\n"); return 5; }
    // Nothing may be printed past this point, since a task with a window has its
    // prints drawn into that window, over the grid.

    int last_w = 0;
    int last_h = 0;
    int last_left = 0;
    int last_right = 0;
    while (1) {
        int wi = win_info();
        int ww = wi >> 16;
        int wh = wi & 65535;
        if (ww > fb_max_w) { ww = fb_max_w; }
        if (wh > fb_max_h) { wh = fb_max_h; }
        if (ww != last_w || wh != last_h) { last_w = ww; last_h = wh; dirty = 1; }
        view_w = ww;
        view_h = wh;
        if (fitted == 0 && grid_rows() > 0) { view_fit(); fitted = 1; dirty = 1; }

        // A press is the edge, not the held state, or one click would add
        // and remove the same note on alternate frames.
        int mp = mouse_poll();
        if (mp >= 0) {
            int buttons = mp % 8;
            int packed = mp / 8;
            int mx = packed / 1024;
            int my = packed % 1024;
            int left = buttons % 2;
            int right = (buttons / 2) % 2;
            if (left && !last_left) {
                if (help_open == 1) { help_open = 0; } else { press(mx, my); }
                dirty = 1;
            } else if (left && drag != DRAG_NONE) {
                move(mx, my);
                dirty = 1;
            }
            if (!left && drag != DRAG_NONE) {
                drag = DRAG_NONE;
                dirty = 1;
            }
            if (right && !last_right && help_open == 0) {
                erase(mx, my);
                dirty = 1;
            }
            last_left = left;
            last_right = right;
            hover(mx, my);
        }

        int key = key_poll();
        while (key >= 0) {
            int make = key / 2;
            if (make == 42 || make == 54) { shift = key % 2 == 0; }
            if (key % 2 == 0 && naming) {
                dirty = 1;
                naming_key(make);
            } else if (key % 2 == 0) {
                dirty = 1;
                if (make == 1 && help_open == 1) {                            // Esc
                    help_open = 0;
                    make = 0;
                }
                if (make == 1) { play_stop(); return 0; }
                if (make == 35) { help_open = 1 - help_open; }               // h
                if (make == 57) {                                             // space
                    if (playing == 1) { play_stop(); } else { play_start(); }
                }
                if (make == 38) { looping = 1 - looping; }                    // l
                if (make == 51 && note_vel > 15) { note_vel -= 16; } // ,
                if (make == 52 && note_vel < 127) { note_vel += 16; } // .
                if (note_vel > 127) { note_vel = 127; }
                if (make >= 2 && make <= 5) { note_inst = make - 2; }        // 1 to 4
                if (make == 50) { muted = muted ^ (1 << note_inst); update_heard(); }  // m
                if (make == 24) {                                             // o
                    if (solo == note_inst) { solo = -1; } else { solo = note_inst; }
                    update_heard();
                }
                if (make == 25) {                                             // p, P
                    int d = 1;
                    if (shift) { d = -1; }
                    noter_set_pan(song, note_inst, noter_pan(song, note_inst) + d);
                }
                if (make == 31) { save(); }                                   // s
                if (make == 12 && song.nh_tempo > 40) { song.nh_tempo -= 5; }  // -
                if (make == 13 && song.nh_tempo < 300) { song.nh_tempo += 5; } // =
                if (make == 72 && top_pitch < 127) { top_pitch += 1; }  // up
                if (make == 80 && top_pitch > 0) { top_pitch -= 1; }    // down
                if (make == 73) { top_pitch += 12; }                    // PgUp
                if (make == 81) { top_pitch -= 12; }                    // PgDn
                if (make == 75) { first_step -= song.nh_steps; }       // left
                if (make == 77) { first_step += song.nh_steps; }       // right
                if (make == 71) { first_step = 0; }                                // Home
                if (top_pitch > 127) { top_pitch = 127; }
                if (top_pitch < 0) { top_pitch = 0; }
                if (first_step < 0) { first_step = 0; }
            }
            key = key_poll();
        }

        play_feed();
        if (playing == 1) {
            // Follow the playhead. When it runs off the right edge, turn the
            // page so it starts again from the left.
            int ps = play_sample() * song.nh_tempo * song.nh_steps / (SYNTH_RATE * 60);
            if (ps >= first_step + grid_cols() || ps < first_step) {
                first_step = ps - ps % (song.nh_steps * 4);
                dirty = 1;
            }
            if (play_x() != head_x) { dirty = 1; }
        }

        if (dirty == 1 && view_w > 0 && view_h > 0) {
            render();
            present(fb);
            dirty = 0;
        } else {
            // Nothing changed, so give the CPU away for a tick rather than
            // poll again at once. A tick (10ms) is well inside what the
            // playback queue holds (PLAY_AHEAD, about 0.23 s).
            sleep(1);
        }
    }
    return 0;
}
