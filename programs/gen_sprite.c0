//
// Generates a small 2-frame circular sprite (12x12, BGR0 pixel format,
// colour 0 = transparent, matching Moonshot's SYS_BLIT expectation) as a
// c0 seed_sprite_demo(buf) function, the same store64/store8-literal
// pattern bake uses for whole ELF binaries. Build and run it from this
// directory with coff1 and smed, which writes sprite_demo_data.c0 (or the
// path given as the first argument).
//
// This replaced gen_sprite.py: the sprite is compiled into
// the Gnista demo, which is baked into the kernel, so the script that drew
// it was python on the path from source to moonshot.elf. The circle test
// used half-pixel centres; doubling every coordinate makes it exact in
// integers, and the output is byte-identical to what the script wrote.

int W = 12;
int H = 12;
int FRAMES = 2;

int out = 0;
int outpos = 0;

void emit_ch(int c) { store8(out + outpos, c); outpos = outpos + 1; return; }

void emit(int s) {
    int i = 0;
    while (s[i] != 0) { emit_ch(s[i]); i = i + 1; }
    return;
}

void emit_int(int v) {
    int buf = alloc(24);
    int i = 23;
    int n = v;
    if (n == 0) { emit("0"); return; }
    buf[i] = 0;
    while (n > 0) {
        i = i - 1;
        buf[i] = 48 + (n - (n / 10) * 10);
        n = n / 10;
    }
    emit(buf + i);
    return;
}

void emit_hex16(int v) {
    int buf = alloc(20);
    int i = 16;
    int u = v;
    int q = 0;
    int d = 0;
    buf[16] = 0;
    while (i > 0) {
        i = i - 1;
        q = u / 16;
        d = u - q * 16;
        if (d < 0) { d = d + 16; q = q - 1; }
        if (d < 10) { buf[i] = 48 + d; } else { buf[i] = 87 + d; }
        u = q;
    }
    emit(buf);
    return;
}

// One frame of W*H BGR0 pixels: a disc of the given colour, transparent
// outside it. The centre is at (W-1)/2 and the radius W/2 - 0.5, both
// half-integers, so with every distance doubled the test is
// (2x - (W-1))^2 + (2y - (H-1))^2 <= (W - 1)^2 in whole numbers.
void frame_pixels(int data, int off, int b, int g, int r) {
    int x = 0;
    int y = 0;
    int dx = 0;
    int dy = 0;
    int p = off;
    while (y < H) {
        x = 0;
        while (x < W) {
            dx = 2 * x - (W - 1);
            dy = 2 * y - (H - 1);
            if (dx * dx + dy * dy <= (W - 1) * (W - 1)) {
                store8(data + p, b); store8(data + p + 1, g); store8(data + p + 2, r); store8(data + p + 3, 0);
            } else {
                store8(data + p, 0); store8(data + p + 1, 0); store8(data + p + 2, 0); store8(data + p + 3, 0);
            }
            p = p + 4;
            x = x + 1;
        }
        y = y + 1;
    }
    return;
}

int main() {
    int n = W * H * 4 * FRAMES;
    int data = alloc(n);
    int path = "sprite_demo_data.c0";
    int fd = 0;
    int i = 0;
    int k = 0;
    int w = 0;
    if (argc() > 1) { path = argv(1); }
    out = alloc(65536);

    // frame 0: orange disc. frame 1: yellow disc (a simple two-colour twinkle).
    frame_pixels(data, 0, 0, 140, 255);
    frame_pixels(data, W * H * 4, 0, 220, 255);

    emit("// sprite_demo_data.c0 — part of gnista, a game engine for the moonshot operating system.\n");
    emit("//\n");
    emit("// Copyright (C) 2026 tavro\n");
    emit("//\n");
    emit("// This file is part of gnista, a game engine written in c0 for moonshot.\n");
    emit("// gnista is free software, distributed under the GNU General Public\n");
    emit("// License version 3 or (at your option) any later version, WITHOUT ANY\n");
    emit("// WARRANTY; see the LICENSE file for the full text.\n");
    emit("//\n");
    emit("// GENERATED by gen_sprite.c0 -- do not edit by hand. A "); emit_int(W); emit("x"); emit_int(H);
    emit(", "); emit_int(FRAMES); emit("-frame\n");
    emit("// circular sprite (BGR0 pixels, color 0 = transparent), baked into the\n");
    emit("// program's own compiled ELF rather than loaded from a file at runtime,\n");
    emit("// the same way the kernel bakes in the programs themselves.\n");
    emit("int seed_sprite_demo_size() { return "); emit_int(n); emit("; }\n");
    emit("void seed_sprite_demo(int buf) {\n");
    emit("    int p = 0;\n");
    while (i + 8 <= n) {
        w = 0;
        k = 8;
        while (k > 0) { k = k - 1; w = w * 256 + data[i + k]; }
        emit("    store64(buf + p, 0x"); emit_hex16(w); emit("); p = p + 8;\n");
        i = i + 8;
    }
    while (i < n) {
        emit("    store8(buf + p, "); emit_int(data[i]); emit("); p = p + 1;\n");
        i = i + 1;
    }
    emit("}\n");

    fd = open_write(path);
    if (fd < 0) { print("gen_sprite: cannot write "); print(path); print("\n"); exit(1); }
    write(fd, out, outpos);
    close(fd);
    print("wrote "); print(path); print(": "); print_int(n); print(" bytes ("); print_int(W); print("x"); print_int(H); print("x"); print_int(FRAMES); print(" BGR0)\n");
    return 0;
}

void print_int(int v) {
    int buf = alloc(24);
    int i = 23;
    int n = v;
    if (n == 0) { print("0"); return; }
    buf[i] = 0;
    while (n > 0) {
        i = i - 1;
        buf[i] = 48 + (n - (n / 10) * 10);
        n = n / 10;
    }
    print(buf + i);
    return;
}
