// expect: 11
// lager -- alloc() and dealloc() (SYS_ALLOC 6, SYS_DEALLOC 13) on real
// moonshot. Each check that holds adds one, so the exit code counts them and
// any number below 11 says how many failed.
//
// Nothing in this program allocates before main, so the first block handed
// out is the first block in the heap, and the first-fit checks below can
// name exactly which address should come back.
int main() {
    int ok = 0;

    // 1. A freed block is handed out again (first fit, split).
    int a = alloc(64);
    int b = alloc(64);
    store64(a, 99);
    if (dealloc(a) == 0) { ok += 1; }
    int c = alloc(32);
    if (c == a) { ok += 1; }

    // 2. ...and comes back zeroed, though it held 99 a moment ago.
    if (load64(c) == 0) { ok += 1; }

    // 3. A second dealloc of the same block is refused, not obeyed.
    if (dealloc(b) == 0) { ok += 1; }
    if (dealloc(b) == 0 - 1) { ok += 1; }

    // 4. So is a pointer into the middle of a live block.
    if (dealloc(c + 8) == 0 - 1) { ok += 1; }

    // 5. Freeing three neighbours in the order outer, outer, middle merges
    //    them into one block big enough for all three. The 8-byte guard keeps
    //    them from merging with the free space at the end instead.
    int x = alloc(48);
    int y = alloc(48);
    int z = alloc(48);
    int guard = alloc(8);
    dealloc(x);
    dealloc(z);
    dealloc(y);
    if (alloc(144) == x) { ok += 1; }

    // 6. A free block at the very end grows in place rather than being
    //    left behind as a hole.
    int m = alloc(16);
    dealloc(m);
    if (alloc(4096) == m) { ok += 1; }

    // 7. dealloc(0) is a harmless no-op, like free(NULL).
    if (dealloc(0) == 0) { ok += 1; }

    // 8. What a document reload does, a thousand times over, 100KB each,
    //    about 100MB in total through a 32MB heap. Without reuse this runs
    //    out of heap after about 320 rounds.
    int i = 0;
    int all = 1;
    while (i < 1000) {
        int p = alloc(100000);
        if (!p) { all = 0; }
        else {
            store64(p, i);
            dealloc(p);
        }
        i += 1;
    }
    if (all == 1 && guard != 0) { ok += 1; }

    // 9. Fifty thousand blocks alive at once, as a compiler holds its tokens
    //    and tree, then all given back. Each is its own entry in lager's
    //    table, which grows a page at a time rather than stopping at what
    //    the kernel heap could spare. They go back newest first, since
    //    freeing the oldest first moves the rest of the table down a slot
    //    each time.
    int many = alloc(50000 * 8);
    all = 1;
    for (i = 0; i < 50000; i += 1) {
        int q = alloc(16);
        if (!q) { all = 0; }
        store64(many + i * 8, q);
    }
    for (i = 49999; i >= 0; i -= 1) {
        if (dealloc(load64(many + i * 8)) != 0) { all = 0; }
    }
    if (all == 1) { ok += 1; }

    return ok;
}
