//
// expect: 0
// What form's grid snap and copy made of copy.form, in the root, for
// verify_form_copy.sh, which shrinks the first side of a new cube, puts it
// on the grid and copies it. 1 when there are not 14 faces, 2 when not 12
// corners, 3 when a coordinate is off the 1/16 grid, 4 when the two new
// faces are not the side's two moved half a unit along x or z, corner by
// corner in the same order. Otherwise 50. There is no copy.form when the
// ELF tests run on their own, so then it is 0.
include "djup.c0";

int main() {
    int m = djup_load("/copy.form", 512, 1024);
    if (!m) { return 0; }
    if (m.dh_faces != 14) { return 1; }
    if (m.dh_verts != 12) { return 2; }
    int i = 0;
    for (i = 0; i < m.dh_verts; i += 1) {
        int k = 0;
        for (k = 0; k < 3; k += 1) {
            if (load64(djup_vert(m, i) + k * 8) % 4096 != 0) { return 3; }
        }
    }
    int dx = load64(djup_vert(m, load64(djup_face(m, 12)))) - load64(djup_vert(m, load64(djup_face(m, 0))));
    int dz = load64(djup_vert(m, load64(djup_face(m, 12))) + 16) - load64(djup_vert(m, load64(djup_face(m, 0))) + 16);
    if (dx * dx + dz * dz != 32768 * 32768 || dx * dz != 0) { return 4; }
    int f = 0;
    for (f = 0; f < 2; f += 1) {
        int c = 0;
        for (c = 0; c < 3; c += 1) {
            int p = djup_vert(m, load64(djup_face(m, f) + c * 8));
            int q = djup_vert(m, load64(djup_face(m, 12 + f) + c * 8));
            if (load64(q) != load64(p) + dx || load64(q + 8) != load64(p + 8)
                || load64(q + 16) != load64(p + 16) + dz) {
                return 4;
            }
        }
    }
    return 50;
}
