//
// engine -- Gnista's engine layer for full-frame, scrolling games.
//
// A camera, a world larger than the screen, and a whole frame composited
// each tick and handed over in one call. A scrolling game
// needs it -- when the view moves, every pixel changes, so incremental
// redraw saves nothing.
//
// Measured on real Moonshot (see
// fps_probe.c0), a full tavla-sized frame costs ~22ms with the two fast
// paths below and ~81ms without them. Both matter, and neither is worth
// anything without the other.
//
//   * SPANS ARE WRITTEN TWO PIXELS AT A TIME. One store64 per pixel pair
//     instead of four store8 per pixel. c0 has no optimizer, so per-pixel
//     work is genuinely expensive; per-pixel code belongs only where sprites
//     actually are, never across a background.
//   * PRESENTING USES present(), NOT blit(). blit() checks every pixel
//     against colour 0 so sprites can have holes, and rebuilds each pixel
//     from four bytes to do it. A full frame has no holes, so present()
//     copies whole rows and skips all of it.
//
// Two pixels are packed into one 64-bit word by shifting the high one into
// the upper half.

layout Entity {
    int x;          // world coordinates, top-left
    int y;
    int w;
    int h;
    int vx;
    int vy;
    int kind;       // game-defined; the engine only checks `alive`
    int alive;      // 0 = free slot, reusable by pool_spawn
    int color;
    int a1;         // game-defined scratch (infection, cooldown, ...)
    int a2;
    int a3;
}

// The frame being built, plus where in the world it is looking.
layout View {
    int buf;        // vw * vh pixels, framebuffer order
    int vw;
    int vh;
    int cam_x;      // world coordinate at the view's left edge
    int cam_y;
}

// --- the entity pool ------------------------------------------------------
//
// A flat allocation of `cap` Entity records addressed by index. c0 has no
// arrays and no pointer types, so an entity reference is just the address of
// its record -- which is exactly what `layout` field access wants -- and the
// pool is one alloc and a multiply.
//
// Slots are RECYCLED. `alive` marks a slot free and pool_spawn hands the
// first free one back. Infecteria needs it, because factories emit
// mini-bacteria continuously and each one dies on contact. Moonshot's lager
// can take memory back, but a slot reused in place costs nothing, where an
// alloc and a dealloc per bacterium would cost two syscalls.

int pool_alloc(int cap) {
    return alloc(cap * sizeof(Entity));
}

int pool_at(int pool, int i) {
    return pool + i * sizeof(Entity);
}

void pool_clear(int pool, int cap) {
    int i = 0;
    for (i = 0; i < cap; i += 1) {
        int e = pool_at(pool, i);
        e.alive = 0;
    }
    return;
}

// Returns a fresh entity, or 0 when the pool is full. Callers must cope with
// 0 rather than assume -- a game that spawns on a timer will hit a full pool
// eventually, and that is normal, not an error.
int pool_spawn(int pool, int cap) {
    int i = 0;
    for (i = 0; i < cap; i += 1) {
        int e = pool_at(pool, i);
        if (e.alive == 0) {
            e.alive = 1;
            e.x = 0; e.y = 0; e.w = 0; e.h = 0;
            e.vx = 0; e.vy = 0;
            e.kind = 0; e.color = 0;
            e.a1 = 0; e.a2 = 0; e.a3 = 0;
            return e;
        }
    }
    return 0;
}

void pool_kill(int e) {
    e.alive = 0;
    return;
}

// --- collision ------------------------------------------------------------

// Axis-aligned overlap between any two entities. Touching edges do not count
// (strict <), so two things resting exactly against each other are not
// reported as colliding forever.
int aabb_hit(int a, int b) {
    if (a.x + a.w <= b.x) { return 0; }
    if (b.x + b.w <= a.x) { return 0; }
    if (a.y + a.h <= b.y) { return 0; }
    if (b.y + b.h <= a.y) { return 0; }
    return 1;
}

// True when b's centre is inside a. Used for "am I inside this cell", which
// wants the mover's middle rather than any overlap at all -- clipping a
// corner of a cell should not count as being in it.
int centre_inside(int a, int b) {
    int cx = b.x + b.w / 2;
    int cy = b.y + b.h / 2;
    if (cx < a.x || cx >= a.x + a.w) { return 0; }
    if (cy < a.y || cy >= a.y + a.h) { return 0; }
    return 1;
}

// Squared distance between two entities' centres. Squared, because c0 has no
// square root and comparisons against a squared threshold work identically.
int dist2(int a, int b) {
    int ax = a.x + a.w / 2;
    int ay = a.y + a.h / 2;
    int bx = b.x + b.w / 2;
    int by = b.y + b.h / 2;
    int dx = ax - bx;
    int dy = ay - by;
    return dx * dx + dy * dy;
}

// --- rendering ------------------------------------------------------------

// --- surviving a resize ---------------------------------------------------
//
// A kakel tile is not a fixed size. Every `split`, `close` and `spawn3`
// reflows the layout, and a window a program is drawing into can get wider,
// narrower, taller or shorter while it runs. Nothing tells the program; it has
// to look. win_info() reports the CURRENT size on every call, so looking is
// one syscall per frame -- nothing next to a full-frame present().
//
// What a program cannot do is grow its buffer in place. There is no realloc,
// and a full-size frame freed and allocated again on every resize would be a
// lot of copying for nothing. That is what win_max() is for. Allocate once for the
// largest window this machine can ever give out, then treat vw/vh as a
// sub-rectangle of that allocation. Every renderer in this file already reads
// vw/vh for its clipping and strides, so moving those two numbers is the whole
// of the adaptation -- nothing else has to know a resize happened.
//
// Returns 1 if the size changed (a caller may want to re-derive anything it
// cached from the view's dimensions), 0 if it did not.
int view_alloc_max(int v) {
    int m = win_max();
    if (!m) { return 0; }
    int mw = m >> 16;
    int mh = m & 65535;
    v.buf = alloc(mw * mh * 4);
    return v.buf;
}

int view_poll_resize(int v) {
    int wi = win_info();
    if (!wi) { return 0; }
    int w = wi >> 16;
    int h = wi & 65535;
    if (w == v.vw && h == v.vh) { return 0; }
    v.vw = w;
    v.vh = h;
    return 1;
}

// Fills the WHOLE frame with one colour, two pixels per store64. This is the
// single most important loop in the renderer, since it touches every pixel every
// frame, and doing it per-pixel measured 3.6x slower overall.
// Safe to write in 8-byte pairs without a remainder check, since kakel geometry is
// cell-aligned, so vw and vh are both multiples of FONT_W/FONT_H (8) and the
// pixel count is always even.
void view_clear(int v, int color) {
    int buf = v.buf;
    int nbytes = v.vw * v.vh * 4;
    int pair = (color << 32) | color;
    int off = 0;
    for (off = 0; off < nbytes; off += 8) {
        store64(buf + off, pair);
    }
    return;
}

// One horizontal run of pixels in VIEW coordinates, clipped. Pairs writes
// where it can and falls back to single pixels only at unaligned ends.
void view_span(int v, int x, int y, int len, int color) {
    if (y < 0 || y >= v.vh) { return; }
    int x0 = x;
    int x1 = x + len;
    if (x0 < 0) { x0 = 0; }
    if (x1 > v.vw) { x1 = v.vw; }
    if (x0 >= x1) { return; }
    int base = v.buf + (y * v.vw + x0) * 4;
    int n = x1 - x0;
    int i = 0;
    int pair = (color << 32) | color;
    // No alignment dance, since x86 permits unaligned 64-bit stores, so pairing can
    // start anywhere. Only the odd LAST pixel needs the slow path.
    while (i + 1 < n) {
        store64(base + i * 4, pair);
        i += 2;
    }
    while (i < n) {
        store32_le_px(base + i * 4, color);
        i += 1;
    }
    return;
}

// One pixel in the framebuffer's order, 0xRRGGBB with the top byte zero.
void store32_le_px(int addr, int color) {
    store32(addr, color & 0xFFFFFF);
    return;
}

int load_px(int addr) {
    return load32(addr) & 0xFFFFFF;
}

// Filled rectangle in WORLD coordinates -- the camera offset is applied here,
// so game code never converts by hand.
void view_rect(int v, int wx, int wy, int w, int h, int color) {
    int sx = wx - v.cam_x;
    int sy = wy - v.cam_y;
    int r = 0;
    for (r = 0; r < h; r += 1) {
        view_span(v, sx, sy + r, w, color);
    }
    return;
}

// Filled circle in WORLD coordinates. Per-pixel, but only across the
// circle's own bounding box, which is the rule. Per-pixel work belongs where
// the shape is, never across the background.
//
// No square root anywhere -- a pixel is inside when dx*dx + dy*dy <= r*r.
void view_circle(int v, int wx, int wy, int d, int color) {
    int r = d / 2;
    int cx = wx - v.cam_x + r;
    int cy = wy - v.cam_y + r;
    int rr = r * r;
    int dy = 0;
    for (dy = 0 - r; dy <= r; dy += 1) {
        int y = cy + dy;
        if (y >= 0 && y < v.vh) {
            // Widest x at this row, found by walking in rather than by a
            // square root. The circles here are small, so this is cheap.
            int dx = 0;
            for (dx = 0 - r; dx <= r; dx += 1) {
                if (dx * dx + dy * dy <= rr) { break; }
            }
            if (dx <= 0) {
                view_span(v, cx + dx, y, (0 - dx) * 2 + 1, color);
            }
        }
    }
    return;
}

// Half-transparent filled circle. Each covered pixel becomes the average of
// what is already there and `color`. This is how Infecteria's cells let you
// see yourself underneath them.
//
// Done here in the game's own frame buffer rather than in the kernel, since SYS_BLIT
// only knows fully transparent (colour 0) and fully opaque, and teaching it
// blending would put per-pixel arithmetic back in the syscall that
// SYS_PRESENT exists to avoid. Blending a handful of small circles costs far
// less than blending everything.
void view_circle_blend(int v, int wx, int wy, int d, int color) {
    int r = d / 2;
    int cx = wx - v.cam_x + r;
    int cy = wy - v.cam_y + r;
    int rr = r * r;
    int sb = color & 255;
    int sg = (color >> 8) & 255;
    int sr = (color >> 16) & 255;
    int dy = 0;
    for (dy = 0 - r; dy <= r; dy += 1) {
        int y = cy + dy;
        if (y >= 0 && y < v.vh) {
            int dx = 0;
            for (dx = 0 - r; dx <= r; dx += 1) {
                int x = cx + dx;
                if (x >= 0 && x < v.vw && dx * dx + dy * dy <= rr) {
                    int addr = v.buf + (y * v.vw + x) * 4;
                    int db = load8(addr);
                    int dg = load8(addr + 1);
                    int dr = load8(addr + 2);
                    store8(addr, (db + sb) / 2);
                    store8(addr + 1, (dg + sg) / 2);
                    store8(addr + 2, (dr + sr) / 2);
                }
            }
        }
    }
    return;
}

// --- loading a sprite -----------------------------------------------------
//
// A sprite file is three 64-bit numbers -- width, height, frame count -- and
// then the pixels, which is deliberately the shape this layout already has.
// Loading is three reads and a pointer into the buffer rather than a parse,
// and it is the format pensel writes, so a sprite drawn on the machine itself
// loads with no conversion step anywhere.
layout Sprite {
    int sp_w;
    int sp_h;
    int sp_frames;
    int sp_pixels;
}

// Returns 0 when the file is missing or malformed, which every caller treats
// as "use the baked-in default" rather than as an error. A game that refuses
// to start because nobody has drawn anything is a worse game.
int sprite_from_file(int name) {
    int size = readfile(name, 0, 0);
    // The header plus at least one pixel.
    if (size < 28) { return 0; }
    int buf = alloc(size);
    if (!buf) { return 0; }
    if (readfile(name, buf, size) != size) { return 0; }
    int s = alloc(sizeof(Sprite));
    if (!s) { return 0; }
    s.sp_w = load64(buf);
    s.sp_h = load64(buf + 8);
    s.sp_frames = load64(buf + 16);
    s.sp_pixels = buf + 24;
    if (s.sp_w <= 0 || s.sp_h <= 0 || s.sp_frames <= 0) { return 0; }
    // A header claiming more pixels than the file holds would have the
    // renderer read past the allocation, so it is refused here rather than
    // clipped later.
    if (24 + s.sp_w * s.sp_h * s.sp_frames * 4 > size) { return 0; }
    return s;
}

// The frame to show for a two-frame sprite at animation phase `phase`, and
// frame 0 for anything with only one. Every animated thing in a game this
// size can share one clock, so the phase is computed once per frame from the
// tick counter rather than tracked per entity.
int sprite_frame(int s, int phase) {
    if (s.sp_frames <= 1) { return 0; }
    return phase % s.sp_frames;
}

// One frame of an animation clip at time `t` (ticks). A sprite file can hold
// several clips one after another, an idle loop in frames 0-1 and a run in
// frames 2-5 say, and a clip is named by its first frame and its length. It
// advances one frame every `rate` ticks.
//
// Every entity passes its own `t`, usually the clock plus something of its
// own (its pool slot times a few ticks), so that a crowd of the same thing
// does not move in lockstep. sprite_frame above is the simpler single clock, and
// stays for games that want exactly that.
//
// A sprite that does not have the clip's frames, say a one-frame sprite
// someone drew in pensel to replace a four-frame default, shows what it has.
// the clip is cut to the frames that exist, and frame 0 when none do.
int anim_frame(int s, int first, int count, int rate, int t) {
    if (first >= s.sp_frames) { return 0; }
    if (first + count > s.sp_frames) { count = s.sp_frames - first; }
    if (count <= 1 || rate <= 0) { return first; }
    if (t < 0) { t = 0; }
    return first + (t / rate) % count;
}

// --- sprites --------------------------------------------------------------
//
// A sprite here is just w*h*4 bytes of BGR0, the same shape SYS_BLIT and
// pensel already use, with colour 0 meaning transparent. Frames sit one
// after another in the same allocation, so frame f starts at f * w * h * 4.
//
// These two draw into the game's own frame buffer rather than calling
// SYS_BLIT, for the reason the whole View exists. A scrolling game composites
// one frame and presents it with a single syscall, and a blit straight to the
// framebuffer would both tear and ignore the camera.

// One frame of a sprite, in WORLD coordinates, clipped to the view. Colour 0
// is a hole, which is what lets a round organism sit on a background without
// a square of dead pixels around it.
void view_sprite(int v, int wx, int wy, int w, int h, int pixels, int frame) {
    int sx = wx - v.cam_x;
    int sy = wy - v.cam_y;
    // Whole-sprite rejection before the per-pixel loops. Without it a world
    // full of cells costs w*h loop iterations each even when every one of
    // them is off screen, which is most of them in a world several times the
    // size of the view.
    if (sx >= v.vw || sy >= v.vh || sx + w <= 0 || sy + h <= 0) { return; }
    int src = pixels + frame * w * h * 4;
    int row = 0;
    for (row = 0; row < h; row += 1) {
        int y = sy + row;
        if (y >= 0 && y < v.vh) {
            int col = 0;
            for (col = 0; col < w; col += 1) {
                int x = sx + col;
                if (x >= 0 && x < v.vw) {
                    int s = src + (row * w + col) * 4;
                    int c = load_px(s);
                    if (c != 0) {
                        store32_le_px(v.buf + (y * v.vw + x) * 4, c);
                    }
                }
            }
        }
    }
    return;
}

// The same, half-transparent. Every covered pixel becomes the average of what
// is already there and the sprite's own colour. This is the sprite equivalent
// of view_circle_blend, and it is what lets Infecteria's cells show the
// player underneath them once a cell is a drawn membrane rather than a disc.
void view_sprite_blend(int v, int wx, int wy, int w, int h, int pixels, int frame) {
    int sx = wx - v.cam_x;
    int sy = wy - v.cam_y;
    // Whole-sprite rejection before the per-pixel loops. Without it a world
    // full of cells costs w*h loop iterations each even when every one of
    // them is off screen, which is most of them in a world several times the
    // size of the view.
    if (sx >= v.vw || sy >= v.vh || sx + w <= 0 || sy + h <= 0) { return; }
    int src = pixels + frame * w * h * 4;
    int row = 0;
    for (row = 0; row < h; row += 1) {
        int y = sy + row;
        if (y >= 0 && y < v.vh) {
            int col = 0;
            for (col = 0; col < w; col += 1) {
                int x = sx + col;
                if (x >= 0 && x < v.vw) {
                    int s = src + (row * w + col) * 4;
                    int c = load_px(s);
                    if (c != 0) {
                        int addr = v.buf + (y * v.vw + x) * 4;
                        store8(addr, (load8(addr) + load8(s)) / 2);
                        store8(addr + 1, (load8(addr + 1) + load8(s + 1)) / 2);
                        store8(addr + 2, (load8(addr + 2) + load8(s + 2)) / 2);
                    }
                }
            }
        }
    }
    return;
}

// Tints a sprite as it draws. Every non-transparent pixel keeps its own
// brightness but takes the given hue, by scaling each channel of `color` by
// the sprite pixel's green channel. Infecteria uses it so one drawn cell
// serves as the clean cell, the infected cell and the factory, instead of
// three near-identical sprites that would all have to be redrawn together.
void view_sprite_tint(int v, int wx, int wy, int w, int h, int pixels,
                      int frame, int color, int blend) {
    int sx = wx - v.cam_x;
    int sy = wy - v.cam_y;
    // Whole-sprite rejection before the per-pixel loops. Without it a world
    // full of cells costs w*h loop iterations each even when every one of
    // them is off screen, which is most of them in a world several times the
    // size of the view.
    if (sx >= v.vw || sy >= v.vh || sx + w <= 0 || sy + h <= 0) { return; }
    int src = pixels + frame * w * h * 4;
    int tb = color & 255;
    int tg = (color >> 8) & 255;
    int tr = (color >> 16) & 255;
    int row = 0;
    for (row = 0; row < h; row += 1) {
        int y = sy + row;
        if (y >= 0 && y < v.vh) {
            int col = 0;
            for (col = 0; col < w; col += 1) {
                int x = sx + col;
                if (x >= 0 && x < v.vw) {
                    int s = src + (row * w + col) * 4;
                    if (load_px(s) != 0) {
                        // The green channel is the sprite's shading, since the art
                        // is drawn in greys where it is meant to be tinted,
                        // so this reads as "how lit is this pixel".
                        int lum = load8(s + 1);
                        int nb = tb * lum / 255;
                        int ng = tg * lum / 255;
                        int nr = tr * lum / 255;
                        int addr = v.buf + (y * v.vw + x) * 4;
                        if (blend == 1) {
                            store8(addr, (load8(addr) + nb) / 2);
                            store8(addr + 1, (load8(addr + 1) + ng) / 2);
                            store8(addr + 2, (load8(addr + 2) + nr) / 2);
                        } else {
                            store8(addr, nb);
                            store8(addr + 1, ng);
                            store8(addr + 2, nr);
                        }
                    }
                }
            }
        }
    }
    return;
}

// A progress bar above a world rectangle, a dark trough, bright fill, 0..100.
void view_bar(int v, int wx, int wy, int w, int pct, int color) {
    int h = 4;
    view_rect(v, wx, wy - h - 2, w, h, 0x202020);
    int fill = w * pct / 100;
    if (fill > 0) { view_rect(v, wx, wy - h - 2, fill, h, color); }
    return;
}

// Centres the camera on an entity and clamps it so the view never runs off
// the world. Clamping is what makes the edges feel solid rather than showing
// emptiness beyond them.
void view_follow(int v, int e, int world_w, int world_h) {
    int cx = e.x + e.w / 2 - v.vw / 2;
    int cy = e.y + e.h / 2 - v.vh / 2;
    if (cx < 0) { cx = 0; }
    if (cy < 0) { cy = 0; }
    if (cx > world_w - v.vw) { cx = world_w - v.vw; }
    if (cy > world_h - v.vh) { cy = world_h - v.vh; }
    v.cam_x = cx;
    v.cam_y = cy;
    return;
}

// --- misc -----------------------------------------------------------------

// A linear congruential generator, because c0 has no random(). The constants
// are the usual Numerical Recipes ones; the values only need to look
// scattered, nothing here is cryptographic.
int rng_next(int state_addr) {
    int s = load64(state_addr);
    s = (s * 1664525 + 1013904223) % 2147483648;
    store64(state_addr, s);
    return s;
}

int rng_range(int state_addr, int lo, int hi) {
    int span = hi - lo;
    if (span <= 0) { return lo; }
    // One draw, held in a local, since calling rng_next twice would advance the
    // state between the two uses and give a value outside [lo, hi).
    int r = rng_next(state_addr);
    return lo + r % span;
}

// --- text -----------------------------------------------------------------
//
// The kernel's own font, asked for once with glyph() and cached, so a game's
// text and the shell's are one face. Drawn in SCREEN coordinates, not world
// ones. Text is a title, a score, a message, never something in the world
// the camera moves past.

int gn_font = 0;
int gn_cw = 0;
int gn_ch = 0;

// Returns 1 when the font is ready. Every text call below does nothing until
// it is, so a game that never draws text never pays for the font.
int text_init() {
    if (gn_font != 0) { return 1; }
    int d = glyph('M', 0);
    if (d <= 0) { return 0; }
    gn_cw = d >> 16;
    gn_ch = d & 65535;
    if (gn_cw <= 0 || gn_cw > 8 || gn_ch <= 0 || gn_ch > 32) { return 0; }
    int f = alloc(128 * gn_ch);
    if (!f) { return 0; }
    int c = 0;
    for (c = 0; c < 128; c += 1) {
        if (glyph(c, f + c * gn_ch) != d) { return 0; }
    }
    gn_font = f;
    return 1;
}

// How wide `s` is at `scale`, in pixels, which is what centring needs.
int text_width(int s, int scale) {
    int n = 0;
    while (load8(s + n) != 0) { n += 1; }
    return n * gn_cw * scale;
}

// Draws `s` with its top-left at screen (x, y), each font pixel a
// scale-by-scale square. Lit pixels only, so text sits on whatever is there.
void view_text(int v, int x, int y, int s, int color, int scale) {
    if (!gn_font) { return; }
    int i = 0;
    for (i = 0; load8(s + i) != 0; i += 1) {
        int ch = load8(s + i);
        int row = 0;
        for (row = 0; row < gn_ch; row += 1) {
            int b = load8(gn_font + ch * gn_ch + row);
            int col = 0;
            int bit = 128;
            while (col < gn_cw) {
                if ((b / bit) % 2 == 1) {
                    // view_rect is in world coordinates; adding the camera
                    // back makes this screen-fixed.
                    view_rect(v, v.cam_x + x + col * scale, v.cam_y + y + row * scale,
                              scale, scale, color);
                }
                bit /= 2;
                col += 1;
            }
        }
        x += gn_cw * scale;
    }
    return;
}

// Draws `s` centred across the view at height y.
void view_text_centred(int v, int y, int s, int color, int scale) {
    view_text(v, (v.vw - text_width(s, scale)) / 2, y, s, color, scale);
    return;
}

// --- scenes ---------------------------------------------------------------
//
// A game is more than its playing field. It has a title to start from, the field,
// a screen for when it is over, and back again. A scene is one of those, and
// here it is a plain function that takes the game's own state (whatever the
// game keeps in one block of memory), runs its own loop for as long as it is
// on screen, and returns the scene to run next, or 0 to end the game.
//
// That is the whole contract, and it is deliberately not a framework with
// enter/update/draw hooks, since each scene keeps its loop and its locals where
// they are readable, and moving between scenes is a return value.
void scene_run(int first, int game) {
    int scene = first;
    while (scene != 0) {
        scene = scene(game);
    }
    return;
}

// Reads the waiting key events and returns 1 if one was a press of key `a`
// (by make code), 2 if one was a press of `b`, and 0 otherwise. Releases are
// skipped. For scenes that wait on a key, such as a title screen's "space to
// start"; a game in play tracks held keys itself.
int key_pressed(int a, int b) {
    int key = key_poll();
    while (key >= 0) {
        int make = key / 2;
        if (key % 2 == 0) {
            if (make == a) { return 1; }
            if (make == b) { return 2; }
        }
        key = key_poll();
    }
    return 0;
}
