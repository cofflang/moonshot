// expect: 11
// djup, gnista's 3D (djup.c0). Each check that holds adds one.
include "djup.c0";

int near(int a, int b, int d) { return a - b <= d && b - a <= d; }

int main() {
    int ok = 0;
    djup_init();
    // 1. The sine table, at a quarter, an eighth and nothing.
    if (djup_sin(0) == 0 && near(djup_sin(256), 65536, 2) && near(djup_sin(128), 46341, 2)
        && near(djup_cos(0), 65536, 2) && near(djup_sin(768), 0 - 65536, 2)) { ok += 1; }
    // 2. Square roots.
    if (djup_isqrt(144) == 12 && djup_isqrt(145) == 12 && djup_isqrt(4294967296) == 65536) { ok += 1; }

    // 3. A cube seen from the front fills the middle of a 64 by 64 frame and
    // leaves the corners alone.
    int m = djup_new(64, 64);
    djup_add_cube(m, 0, 0, 0, DJUP_ONE, 0xff0000);
    int cam = alloc(sizeof(DjupCam));
    cam.dc_yaw = 64;
    cam.dc_pitch = 48;
    cam.dc_dist = 6 * DJUP_ONE;
    cam.dc_x = 0;
    cam.dc_y = 0;
    cam.dc_z = 0;
    int w = 64;
    int fb = alloc(w * w * 4);
    int z = alloc(w * w * 4);
    int id = alloc(w * w * 4);
    int i = 0;
    for (i = 0; i < w * w; i += 1) { store32(fb + i * 4, 0); }
    djup_render(m, fb, w, w, cam, z, id);
    int filled = 0;
    for (i = 0; i < w * w; i += 1) { if (load32(fb + i * 4) != 0) { filled += 1; } }
    if (load32(fb + (32 * w + 32) * 4) != 0 && load32(fb) == 0
        && load32(fb + (w * w - 1) * 4) == 0) { ok += 1; }
    if (filled > 300 && filled < 2500) { ok += 1; }
    // 4. Each pixel knows its face, and the faces seen are the near ones.
    int f = load32(id + (32 * w + 32) * 4);
    if (f >= 1 && f <= 12) { ok += 1; }
    // 5. Sides lit differently, so the cube looks like one.
    int shades = 0;
    int seen = alloc(16 * 8);
    for (i = 0; i < w * w; i += 1) {
        int c = load32(fb + i * 4);
        if (c != 0) {
            int k = 0;
            int found = 0;
            for (k = 0; k < shades; k += 1) { if (load64(seen + k * 8) == c) { found = 1; } }
            if (!found && shades < 16) { store64(seen + shades * 8, c); shades += 1; }
        }
    }
    if (shades >= 2 && shades <= 3) { ok += 1; }
    // 9. The camera looks down from above (a positive pitch), so a point
    // over the target is nearer to it than the target.
    int pq = alloc(48);
    djup_project_point(cam, w, w, 0, 0, 0, pq);
    int z_mid = load64(pq + 16);
    djup_project_point(cam, w, w, 0, DJUP_ONE, 0, pq);
    if (load64(pq + 16) < z_mid) { ok += 1; }
    // 10. The faces drawn are the camera's side of the cube. The one in the
    // middle of the frame is nearer than the cube's middle, and the top,
    // whose corners are all at y = 1, is drawn somewhere.
    int near_ok = 0;
    if (f >= 1 && f <= 12) {
        int fc = djup_face(m, f - 1);
        int sum = 0;
        int k2 = 0;
        for (k2 = 0; k2 < 3; k2 += 1) {
            djup_project(m, cam, w, w, load64(fc + k2 * 8), pq);
            sum += load64(pq + 16);
        }
        if (sum / 3 < z_mid) { near_ok = 1; }
    }
    int top = 0;
    for (i = 0; i < w * w; i += 1) {
        int t = load32(id + i * 4);
        if (t >= 1) {
            int ft = djup_face(m, t - 1);
            if (load64(djup_vert(m, load64(ft)) + 8) == DJUP_ONE
                && load64(djup_vert(m, load64(ft + 8)) + 8) == DJUP_ONE
                && load64(djup_vert(m, load64(ft + 16)) + 8) == DJUP_ONE) { top = 1; }
        }
    }
    if (near_ok && top) { ok += 1; }
    // 6. A face can be taken away.
    djup_remove_face(m, 0);
    if (m.dh_faces == 11) { ok += 1; }
    // 7. Saved and read back, the same mesh.
    if (djup_save(m, "test/cube.form") == 1) {
        int l = djup_load("test/cube.form", 64, 64);
        if (l && l.dh_verts == 8 && l.dh_faces == 11
            && load64(djup_vert(l, 7) + 16) == DJUP_ONE
            && load64(djup_face(l, 10) + 24) == 0xff0000) { ok += 1; }
    }
    // 8. A file whose face names a missing vertex is refused.
    store64(djup_face(m, 0), 99);
    djup_save(m, "test/bad.form");
    if (djup_load("test/bad.form", 64, 64) == 0) { ok += 1; }
    return ok;
}
