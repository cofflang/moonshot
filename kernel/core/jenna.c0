// jenna.c0 -- memory management, the physical-page allocator (a bump
// allocator with an intrusive LIFO free-list) and the 4-level page tables
// c0 builds and switches to.

// Paging. PRESENT_WRITE (0x3) is the present|writable flag pair every
// entry carries; since page frames are 4096-aligned the low 12 bits are
// pure flags. IDMAP_PAGES is a page *count*, not an address/flag, so it
// stays decimal (4096 * 4096 bytes = 16MB the c0-built tables
// identity-map -- ample for the kernel, its stack, every page-table
// frame, jenna's arena, and GRUB's own low-memory structures).
// SENTINEL_VIRT is a high virtual address deliberately ABOVE boot.s's 1GB
// identity map, mapped a second time to a sentinel page as a liveness
// proof (see paging_init) -- 4GB, hence 0x100000000. SENTINEL_VALUE stays
// decimal. It is an arbitrary human-recognizable magic number for
// eyeballing in the serial log, not a hardware-meaningful constant.
int PRESENT_WRITE = 0x3;
int IDMAP_PAGES = 4096;
// The identity map reaches as far as the memory jenna hands out, up to
// this ceiling (256MB). A smaller map than pmm's range would make every
// place that touches a frame by its physical address (zero_page when a
// ring-3 heap grows, for one) fault on the first frame above it. The ceiling
// keeps a machine with gigabytes from spending its boot building page
// tables, and pmm_limit is clamped to it so no frame is ever handed out that
// the kernel cannot reach.
int IDMAP_MAX_PAGES = 65536;
int SENTINEL_VIRT = 0x100000000;
int SENTINEL_VALUE = 1234567890;
int pml4_phys = 0;

// PRESENT_WRITE_USER additionally sets bit 2 (U/S) -- present|writable|user.
//
// USER_VIRT_BASE (2GB) is the private per-process virtual range every
// pt_create()'d address space gets. Two constraints pin it here.
//
// 1. It must be < 4GB. The existing ring-3 test binary (ring3_test_code)
//    passes its syscall string argument via `mov edi, imm32` -- a 32-bit
//    immediate, zero-extended into rdi -- so any virtual address at or
//    above 4GB is simply unrepresentable by it. 512GB (a PML4 index the
//    kernel never touches at all) would fault for
//    exactly this reason, since the patched immediate would truncate.
// 2. Since every representable address is < 4GB, it unavoidably falls
//    inside PML4 index 0 -- the SAME top-level entry the kernel's own 16MB
//    identity map lives in (one PML4 entry spans 512GB). pt_create()
//    copies that entry by value, so the copy is a shared POINTER to the
//    kernel's own PDPT frame, present but WITHOUT the U bit (it was built
//    by paging_init via plain map_page/next_table, kernel-only). The first
//    attempt at 2GB below index 0 still faulted (present-but-protection-
//    violation on the very first ring-3 instruction fetch) until
//    next_table_user (below) was taught to upgrade an already-present
//    entry's permissions in place rather than trusting it as-is.
//
// 2GB (PDPT index 2 within that shared PML4[0]) is chosen specifically
// clear of the kernel's actual populated ranges. The 16MB identity map
// (PDPT index 0), the 4GB sentinel and 5GB demand-paging test address
// (both >= 4GB, excluded by constraint 1 anyway). Setting U on the shared
// PML4[0] entry is safe -- it is a permission CEILING, not a grant, and the
// kernel's own leaf PTEs (built via plain map_page, never map_page_user)
// keep U unset, so kernel pages stay inaccessible from ring 3 regardless.
// Only the fresh, process-private PDPT[2]/PD/PT chain map_page_user builds
// underneath it is ever actually user-accessible.
int PRESENT_WRITE_USER = 0x7;

// The physical address bits of a page-table entry. Bit 63 is NX, so an entry
// for a non-executable page is negative, and dividing it by 4096 would round
// the wrong way.
int PTE_ADDR = 0xFFFFFFFFFF000;
int USER_VIRT_BASE = 0x80000000;

// Demand-paging test (see page_fault_handler/knekt.c0's kernel_post_init).
// a virtual address deliberately left unmapped (5GB, hence 0x140000000 --
// above the 16MB identity map and the 4GB paging sentinel, so touching it
// is a guaranteed page fault), and the value the fault handler seeds the
// freshly-mapped page with so the recovered read is verifiable.
// FAULT_SENTINEL stays decimal for the same eyeballing reason as
// SENTINEL_VALUE above.
int FAULT_TEST_VIRT = 0x140000000;
int FAULT_SENTINEL = 2020202020;

int pmm_start = 0;
int pmm_next = 0;
int pmm_limit = 0;
// Head of the intrusive free-list (0 = empty). Freed pages are linked
// through their own first 8 bytes, so no separate bookkeeping array is
// needed -- see pmm_free_page/pmm_alloc_page.
int pmm_free_head = 0;

// Tracks how many pages currently sit on the free list, for the on-screen
// status bar. Incremented by pmm_free_page, decremented by the free-list pop
// in pmm_alloc_page. Does NOT count pages that simply have not been bumped
// yet — those are "available" rather than "freed."
int pmm_free_count = 0;

// Walks the Multiboot memory map (a variable-length list of {size, addr,
// len, type} entries, `size` NOT counting itself -- next entry is at
// `entry + size + 4`) and picks the first available (type 1) region that
// can actually hold something at-or-after kernel_end, as jenna's initial
// physical-memory arena. Prints every region regardless of type/fit, so
// the full map is visible over serial, not just whichever one got picked.
//
// addr/len are real 64-bit fields (unlike Multiboot's other u32 fields),
// so this uses load64 directly -- no load32 reconstruction needed here.
void pmm_init(int mb_info) {
    int flags = load32(mb_info);
    // bit 6 of flags means mmap_addr/mmap_length valid. Same isolate-one-bit
    // arithmetic as the mem_lower/upper check in knekt.c0's main() (bit 0),
    // just shifted, so (flags/64) - (flags/128)*2 keeps only bit 6.
    int has_mmap = (flags / 64) - (flags / 128) * 2;
    if (has_mmap != 1) {
        serial_print("No memory map from bootloader\n");
        return;
    }

    int mmap_length = load32(mb_info + 44);
    int mmap_addr = load32(mb_info + 48);
    int entry = mmap_addr;
    int end = mmap_addr + mmap_length;

    serial_print("Memory map:\n");
    while (entry < end) {
        int size = load32(entry);
        int base = load64(entry + 4);
        int len = load64(entry + 12);
        int type = load32(entry + 20);

        serial_print("  base=");
        serial_print_int(base);
        serial_print(" len=");
        serial_print_int(len);
        serial_print(" type=");
        serial_print_int(type);
        serial_print("\n");

        if (type == 1 && !pmm_start) {
            int region_start = base;
            if (region_start < _kernel_end) { region_start = _kernel_end; }
            // Round up to a 4096-byte page boundary (same no-bitwise-ops
            // idiom as everywhere else, only round up if not already
            // aligned, using the remainder from integer division).
            int rem = region_start % 4096;
            int aligned = region_start;
            if (rem != 0) { aligned = region_start + (4096 - rem); }
            if (aligned + 4096 <= base + len) {
                pmm_start = aligned;
                pmm_next = aligned;
                pmm_limit = base + len;
            }
        }

        entry += size + 4;
    }

    serial_print("Allocator range: ");
    serial_print_int(pmm_start);
    serial_print(" .. ");
    serial_print_int(pmm_limit);
    serial_print("\n");
    return;
}

// Returns a 4096-byte physical page to the allocator by pushing it onto an
// intrusive free-list. The page is free, so its own first 8 bytes are ours
// to reuse as the link to the previous free-list head -- no separate
// bookkeeping array or bitmap needed. LIFO, so the most recently freed page
// is the next one handed back out (pmm_alloc_page pops from this same head).
void pmm_free_page(int addr) {
    store64(addr, pmm_free_head);
    pmm_free_head = addr;
    pmm_free_count += 1;
    return;
}

// Allocates one 4096-byte physical page. Checks the free-list first --
// popping the most recently freed page, whose stored link becomes the new
// head -- and only bumps the watermark upward through the region when the
// free-list is empty. This is what makes jenna a real allocator rather than
// a pure bump arena, since freed pages actually get reused. Returns 0 on true
// exhaustion (free-list empty AND the watermark has reached the region
// limit); a richer out-of-memory story (spanning multiple regions, eviction)
// is a later problem.
int pmm_alloc_page() {
    int p = pmm_free_head;
    if (p != 0) {
        pmm_free_head = load64(p);
        pmm_free_count -= 1;
        return p;
    }
    if (pmm_next + 4096 > pmm_limit) {
        serial_print("pmm: out of memory\n");
        return 0;
    }
    p = pmm_next;
    pmm_next += 4096;
    return p;
}

// Allocates n physically contiguous pages from the top of pmm's range,
// never from the free list, whose pages can come from anywhere. Returns the
// first page, or 0 when the range is used up. Task stacks are the one thing
// that needs this (see task_spawn).
int pmm_alloc_run(int n) {
    if (pmm_next + n * 4096 > pmm_limit) {
        serial_print("pmm: out of memory\n");
        return 0;
    }
    int p = pmm_next;
    pmm_next += n * 4096;
    return p;
}

// Returns the count of pages currently on the intrusive free list -- the
// pages that have been freed and can be reallocated. Does not include pages
// that simply have not been bumped past pmm_next yet (those are "available"
// rather than "freed"). pmm_available_pages counts both.
int pmm_free_pages() {
    return pmm_free_count;
}

// Every page that can still be handed out, the freed ones on the list plus
// the ones never bumped past yet. What the status bar calls free.
int pmm_available_pages() {
    return pmm_free_count + (pmm_limit - pmm_next) / 4096;
}

// Returns the total number of 4096-byte pages in the arena [pmm_start,
// pmm_limit). This is a compile-time constant for any given boot, since
// pmm_init carves one fixed region from the Multiboot memory map.
int pmm_total_pages() {
    return (pmm_limit - pmm_start) / 4096;
}

// Fresh PMM pages hold arbitrary bytes -- jenna hands out raw physical RAM,
// unlike the userspace alloc() builtin which relied on the kernel zeroing
// brk pages -- so every page used as a page table MUST be zeroed first, or
// its garbage entries would be read as present mappings to nonsense frames.
// Writes 512 zero quads (one 4096-byte page).
void zero_page(int addr) {
    int i = 0;
    for (i = 0; i < 512; i += 1) {
        store64(addr + i * 8, 0);
    }
    return;
}

// --- Kernel heap, kmalloc / kfree -------------------------------------
// The first thing in Moonshot that hands out sub-page, variable-size memory
// -- pmm_alloc_page only ever gives whole 4096-byte pages, which is too
// coarse the moment anything wants many small, differently-sized pieces
// (shell line/argument buffers now; a filesystem's nodes later). A plain
// first-fit allocator over one contiguous arena carved from jenna.
//
// Layout. The arena is a packed sequence of blocks, each an implicit-list
// node with a 16-byte header -- [block+0] = payload size in bytes,
// [block+8] = free flag (1 free / 0 used) -- immediately followed by its
// payload. The NEXT block always sits at (block + 16 + size), so no explicit
// next-pointer is stored, since the list is walked by address. That address-order
// walk is also what lets kfree coalesce neighbours (a separate free-list
// would throw away the adjacency information). Payloads stay 8-aligned
// because heap_start is page-aligned, the header is 16 bytes, and every
// requested size is rounded up to a multiple of 8.
// Callers use sizeof(HeapBlock) directly rather than a separate HEAP_HDR
// constant, so the header size cannot drift out of sync with this shape.
layout HeapBlock {
    int size;
    int free;
}
int heap_start = 0;
int heap_end = 0;

// Lays `num_pages` contiguous pages out of jenna as one big free block and
// returns the first page. MUST be called early, while pmm's free-list is
// still empty, so pmm_alloc_page takes its bump path and returns physically
// contiguous pages -- an arena's implicit list requires one unbroken address
// range. Contiguity is asserted, not assumed, and a loud serial warning fires if
// it ever stops holding. `who` names the arena in that warning.
int arena_carve(int num_pages, int who) {
    int first = pmm_alloc_page();
    int expect = first + 4096;
    int i = 1;
    for (i = 1; i < num_pages; i += 1) {
        int pg = pmm_alloc_page();
        if (pg != expect) {
            serial_print(who);
            serial_print(": NON-CONTIGUOUS pmm page, arena broken\n");
        }
        expect += 4096;
    }
    int end = first + num_pages * 4096;
    first.size = end - first - sizeof(HeapBlock); // one big block...
    first.free = 1;                               // ...marked free
    return first;
}

// The kernel heap is one arena. jakel's file data is another (see
// jakel_arena_init), kept apart so a big file cannot starve the kernel.
void heap_init(int num_pages) {
    heap_start = arena_carve(num_pages, "heap_init");
    heap_end = heap_start + num_pages * 4096;
    return;
}

// Allocates `n` usable bytes (rounded up to 8), first-fit across the arena
// [start, end). When the chosen block is big enough to ALSO hold another
// header plus a minimal 8-byte payload, it splits, leaving the remainder as
// a smaller free block so the slack stays reusable instead of being lost to
// internal fragmentation. Returns the payload address, or 0 if nothing fits
// -- an arena is fixed in size.
int arena_alloc(int start, int end, int n) {
    if (n <= 0) { return 0; }
    n = ((n + 7) / 8) * 8;
    int b = start;
    while (b < end) {
        int size = b.size;
        int free = b.free;
        if (free == 1 && size >= n) {
            if (size >= n + sizeof(HeapBlock) + 8) {
                int rem = b + sizeof(HeapBlock) + n;
                rem.size = size - n - sizeof(HeapBlock);
                rem.free = 1;
                b.size = n;
            }
            b.free = 0;
            return b + sizeof(HeapBlock);
        }
        b += sizeof(HeapBlock) + size;
    }
    return 0;
}

// Returns 0 when the 1MB kernel heap has no room, and a number of callers
// never check, so running out is said here, where every one of them passes.
// Bytes handed out from the arena [start, end), blocks in use only.
int arena_used(int start, int end) {
    int used = 0;
    int b = start;
    while (b < end) {
        if (b.free != 1) { used += b.size + sizeof(HeapBlock); }
        b += sizeof(HeapBlock) + b.size;
    }
    return used;
}

int kmalloc(int n) {
    int p = arena_alloc(heap_start, heap_end, n);
    if (p == 0 && n > 0) {
        serial_print("[jenna] kmalloc: no room for ");
        serial_print_int(n);
        serial_print(" bytes in the kernel heap\n");
    }
    return p;
}

// Merges every run of adjacent free blocks into one, walking the arena once
// in address order. Called after each free so freed neighbours recombine
// into blocks big enough for later, larger requests -- without it, repeated
// split/free would ratchet the arena into ever-smaller unusable fragments.
// Absorbing a block deliberately does NOT advance the cursor, so a whole run
// of adjacent free blocks collapses in this single pass.
void arena_coalesce(int start, int end) {
    int b = start;
    while (b < end) {
        int size = b.size;
        int free = b.free;
        int nxt = b + sizeof(HeapBlock) + size;
        if (free == 1 && nxt < end && nxt.free == 1) {
            b.size = size + sizeof(HeapBlock) + nxt.size;
        } else {
            b = nxt;
        }
    }
    return;
}

void heap_coalesce() {
    arena_coalesce(heap_start, heap_end);
    return;
}

// Frees a block returned by arena_alloc -- its header sits just below the
// payload -- then coalesces. A null pointer is a safe no-op, same as
// free(NULL) in C. `who` prefixes the refusal messages below.
void arena_free(int start, int end, int ptr, int who) {
    if (!ptr) { return; }
    // Two guards, both of which exist because of one bug and the day it cost.
    //
    // The write below stores the number 1 eight bytes before `ptr`. If `ptr`
    // is not a pointer this allocator handed out, that store lands wherever
    // the bad value happens to point, and the symptom is a wrong value in
    // something entirely unrelated, later. The REPL freed a for loop's body
    // twice (see repl.c0's `layout Node`), and the second free read its
    // fields out of a header that coalescing had already overwritten -- so
    // the "pointers" it then freed were whatever those bytes now held. A
    // wild store of the number 1 is a very good way to turn -(5 + 3) into
    // -(5 + 1), which is -6, which is what the REPL once answered.
    //
    // Neither guard makes a double free correct. They make it LOUD. An
    // allocator that refuses a pointer it never handed out turns a silent
    // corruption at a distance into a line in the serial log naming the
    // caller's bad value, which is the difference between an afternoon and
    // a month.
    if (ptr < start + sizeof(HeapBlock) || ptr >= end) {
        serial_print(who);
        serial_print(": pointer outside the heap, refusing: ");
        serial_print_int(ptr);
        serial_print("\n");
        return;
    }
    int b = ptr - sizeof(HeapBlock);
    if (b.free == 1) {
        serial_print(who);
        serial_print(": double free at ");
        serial_print_int(ptr);
        serial_print("\n");
        return;
    }
    b.free = 1;
    arena_coalesce(start, end);
    return;
}

// 1 when `ptr` is a block of the kernel heap, so a caller holding either a
// kmalloc'd string or a constant one knows which it may free.
int kheap_owns(int ptr) {
    return ptr >= heap_start + sizeof(HeapBlock) && ptr < heap_end;
}

void kfree(int ptr) {
    arena_free(heap_start, heap_end, ptr, "[jenna] kfree");
    return;
}

// Returns the physical address of the next-level table reached through
// table[index], creating and zeroing a fresh one (allocated from jenna) if
// that slot is not present yet. Entries are phys_addr + PRESENT_WRITE; since
// phys is 4096-aligned the low bits are pure flags, so (e / 4096) * 4096
// recovers the address and (e - (e / 2) * 2) isolates the present bit --
// same no-bitwise-ops arithmetic as the rest of this file.
int next_table(int table, int index) {
    int e = load64(table + index * 8);
    int present = e % 2;
    if (present == 1) {
        return (e / 4096) * 4096;
    }
    int frame = pmm_alloc_page();
    zero_page(frame);
    store64(table + index * 8, frame + PRESENT_WRITE);
    return frame;
}

// Maps one 4096-byte virtual page `virt` to physical page `phys` in the
// 4-level hierarchy rooted at `pml4` (a physical address), creating any
// missing PDPT/PD/PT tables along the way. Index extraction is pure
// arithmetic (no shifts/masks). The linear page number split into five
// 9-bit (0..511) fields by repeated divide-and-remainder, the same idiom
// serial_print_int uses for decimal digits.
void map_page(int pml4, int virt, int phys) {
    int page = virt / 4096;
    int pt_i = page % 512;
    int pd_n = page / 512;
    int pd_i = pd_n % 512;
    int pdpt_n = pd_n / 512;
    int pdpt_i = pdpt_n % 512;
    int pml4_i = pdpt_n / 512;

    int pdpt = next_table(pml4, pml4_i);
    int pd = next_table(pdpt, pdpt_i);
    int pt = next_table(pd, pd_i);
    store64(pt + pt_i * 8, phys + PRESENT_WRITE);
    return;
}

// Same as next_table, but every table on this path is user-accessible, since a
// freshly-created intermediate table gets U/S set (PRESENT_WRITE_USER)
// instead of kernel-only PRESENT_WRITE, AND an already-present entry that
// does NOT yet have U set gets upgraded in place. The CPU checks U/S at
// EVERY level of a page-table walk, not just the leaf PTE, so a single
// kernel-only entry anywhere in the chain -- including one this process's
// table merely shares a pointer to via pt_create()'s top-level copy -- would
// deny the whole walk even if every level below it is correctly marked
// user. The upgrade is safe as a general policy, since it only ever raises an
// intermediate directory's permission CEILING, never touches a leaf PTE, so
// it cannot expose any actual page that was not already reachable through a
// user-marked leaf entry elsewhere. See USER_VIRT_BASE's comment for why
// the user range shares index 0 with the kernel.
int next_table_user(int table, int index) {
    int e = load64(table + index * 8);
    int present = e % 2;
    if (present == 1) {
        int us = (e >> 2) & 1;
        if (!us) {
            e += 4;
            store64(table + index * 8, e);
        }
        return (e / 4096) * 4096;
    }
    int frame = pmm_alloc_page();
    zero_page(frame);
    store64(table + index * 8, frame + PRESENT_WRITE_USER);
    return frame;
}

// Maps one 4096-byte virtual page as user-accessible (present|write|user at
// every level) in the 4-level hierarchy rooted at `pml4`. Used exclusively
// for a process's own pt_create()'d private range (USER_VIRT_BASE and up) --
// mapping a page here never touches the kernel's own pml4_phys tables, since
// pt_create() only shares kernel entries by VALUE (a copy), not by walking
// into them.
void map_page_user(int pml4, int virt, int phys) {
    int page = virt / 4096;
    int pt_i = page % 512;
    int pd_n = page / 512;
    int pd_i = pd_n % 512;
    int pdpt_n = pd_n / 512;
    int pdpt_i = pdpt_n % 512;
    int pml4_i = pdpt_n / 512;

    int pdpt = next_table_user(pml4, pml4_i);
    int pd = next_table_user(pdpt, pdpt_i);
    int pt = next_table_user(pd, pd_i);
    store64(pt + pt_i * 8, phys + PRESENT_WRITE_USER);
    return;
}

// map_page_user for a page that holds data, the heap and the stack, which is
// not executable (bit 63, NX). The only way to run code from one is
// SYS_PROTECT, which makes it read-only first.
void map_page_user_data(int pml4, int virt, int phys) {
    map_page_user(pml4, virt, phys);
    int leaf = pt_leaf(pml4, virt);
    if (leaf) { store64(leaf, phys | PRESENT_WRITE_USER | (1 << 63)); }
    return;
}

// Creates a fresh, process-private PML4. Starts as a shallow copy of all 512
// top-level entries from the kernel's own page tables (pml4_phys) BY VALUE
// -- every process shares the kernel's mappings (the 16MB identity map,
// the scratch buffers, IDT, dispatch, the heap, the 4GB sentinel) without re-walking or
// re-allocating a single frame for them, since copying a PML4 entry copies
// only a pointer to the existing PDPT frame, not its contents.
//
// PML4 index 0 then gets special treatment, and this is NOT optional the
// way it might look. USER_VIRT_BASE has to sit under 4GB (see its own
// comment), which puts it inside this exact same index 0 the kernel's
// identity map lives in. A plain pointer copy, like every other index gets,
// would leave every process sharing the SAME physical PDPT frame for index
// 0 -- meaning USER_VIRT_BASE's own PDPT slot underneath it would be shared
// too, not private. The second process's map_page_user call would find
// the first one's PD frame already present at that PDPT slot and silently
// reuse it instead of building its own -- both processes' "private" code
// page would live in the same page table. So index 0 gets its own private PDPT frame
// here, seeded with the SAME 512 entries the kernel's PDPT has (so the
// identity map, sentinel, and fault-test region all stay reachable) except
// for USER_VIRT_BASE's own slot, deliberately left absent so map_page_user
// builds a fresh, PRIVATE PD/PT chain there -- once per process, not once
// ever.
int pt_create() {
    int new_pml4 = pmm_alloc_page();
    int i = 0;
    for (i = 0; i < 512; i += 1) {
        store64(new_pml4 + i * 8, load64(pml4_phys + i * 8));
    }

    int kernel_pdpt0 = (load64(pml4_phys) / 4096) * 4096;
    int priv_pdpt0 = pmm_alloc_page();
    int j = 0;
    for (j = 0; j < 512; j += 1) {
        store64(priv_pdpt0 + j * 8, load64(kernel_pdpt0 + j * 8));
    }
    int user_page = USER_VIRT_BASE / 4096;
    int user_pdpt_i = user_page / 512 / 512;
    store64(priv_pdpt0 + user_pdpt_i * 8, 0);
    store64(new_pml4, priv_pdpt0 + PRESENT_WRITE);
    return new_pml4;
}

// The address of the 4K leaf entry that maps `virt` under `pml4`, or 0 when
// a level on the way is missing or maps a large page instead.
int pt_leaf(int pml4, int virt) {
    int page = virt >> 12;
    int t = pml4;
    int shift = 27;
    int level = 0;
    for (level = 0; level < 3; level += 1) {
        int e = load64(t + ((page >> shift) & 511) * 8);
        if ((e & 1) == 0 || (e & 128) != 0) { return 0; }
        t = e & PTE_ADDR;
        shift -= 9;
    }
    int leaf = t + (page & 511) * 8;
    if ((load64(leaf) & 1) == 0) { return 0; }
    return leaf;
}

// Gives back everything private to an address space pt_create built. The
// frames the user range maps (code, stack, heap, all of them the process's
// own), the page tables above them, its own copy of PDPT 0 and the PML4
// itself. Entries of that PDPT that point where the kernel's do are the
// kernel's and stay. The caller must not be running on this address space.
// Returns how many pages went back to pmm.
int pt_free(int pml4) {
    if (pml4 == 0 || pml4 == pml4_phys) { return 0; }
    int freed = 0;
    int kernel_pdpt0 = (load64(pml4_phys) / 4096) * 4096;
    int pdpt0 = (load64(pml4) / 4096) * 4096;
    int j = 0;
    for (j = 0; j < 512; j += 1) {
        int e = load64(pdpt0 + j * 8);
        int pd = (e / 4096) * 4096;
        if ((e & 1) == 1 && pd != (load64(kernel_pdpt0 + j * 8) / 4096) * 4096) {
            int k = 0;
            for (k = 0; k < 512; k += 1) {
                int pde = load64(pd + k * 8);
                if ((pde & 1) == 1) {
                    int pt = (pde / 4096) * 4096;
                    int m = 0;
                    for (m = 0; m < 512; m += 1) {
                        int pte = load64(pt + m * 8);
                        if ((pte & 1) == 1) {
                            pmm_free_page(pte & PTE_ADDR);
                            freed += 1;
                        }
                    }
                    pmm_free_page(pt);
                    freed += 1;
                }
            }
            pmm_free_page(pd);
            freed += 1;
        }
    }
    pmm_free_page(pdpt0);
    pmm_free_page(pml4);
    return freed + 2;
}

// Builds a fresh 4-level page table (4KB granularity) entirely from
// jenna-allocated frames. Identity-maps the low physical memory the kernel
// actually runs on (its code/data/stack, every fixed hand-off slot, all the
// page-table frames allocated right here, and jenna's arena -- all well
// under 16MB), deliberately re-creating at 4KB granularity what boot.s set
// up statically with 2MB pages. The point is not a different map, it is that
// from here on the kernel runs on tables IT built dynamically from
// allocated frames -- the foundation every later VM feature (higher-half
// kernel, per-process spaces, on-demand mapping) needs.
void paging_init() {
    pml4_phys = pmm_alloc_page();
    zero_page(pml4_phys);

    int pages = pmm_limit / 4096;
    if (pages > IDMAP_MAX_PAGES) {
        pages = IDMAP_MAX_PAGES;
        pmm_limit = pages * 4096;
    }
    if (pages < IDMAP_PAGES) { pages = IDMAP_PAGES; }
    int i = 0;
    for (i = 0; i < pages; i += 1) {
        int p = i * 4096;
        map_page(pml4_phys, p, p);
    }
    serial_print("Paging: identity map covers ");
    serial_print_int(pages * 4);
    serial_print(" KB\n");

    // Liveness proof. Stash a sentinel in a fresh physical page, then map
    // that page a SECOND time at a high virtual address boot.s's 1GB
    // identity map does not cover. If paging_verify() (run by boot.s right
    // after it switches CR3) can read the sentinel back through
    // SENTINEL_VIRT, the CPU is provably using THESE tables -- a read
    // through 4GB would fault on boot.s's map.
    int sentinel_phys = pmm_alloc_page();
    store64(sentinel_phys, SENTINEL_VALUE);
    map_page(pml4_phys, SENTINEL_VIRT, sentinel_phys);

    // Hand the new PML4's physical address to boot.s, which does the actual
    // `mov cr3` (c0 cannot execute it) -- same fixed-slot technique as the
    // IDTR. See linker.ld's .cr3info.
    store64(CR3INFO_ADDR, pml4_phys);

    serial_print("Paging: built c0 page tables, PML4 at ");
    serial_print_int(pml4_phys);
    serial_print("\n");
    return;
}

// Called from boot.s immediately after it loads CR3 with the c0-built PML4.
// Reads the sentinel back through the high virtual address that only exists
// in these tables, so returning without faulting AND matching the value proves
// the switch to c0-built paging is live. boot.s runs this before enabling
// interrupts, so nothing else is competing for the serial port.
void paging_verify() {
    int v = load64(SENTINEL_VIRT);
    if (v == SENTINEL_VALUE) {
        serial_print("Paging: live on c0 tables (sentinel via 4GB OK)\n");
    } else {
        serial_print("Paging: sentinel mismatch\n");
    }
    return;
}

// Installed at IDT vector 14 (see knekt.c0's main) and reached through the
// shared ISR trampoline + dispatch table like any other handler. This is a
// RECOVERING handler, not a panic. It demand-maps the faulting page and
// returns, so the instruction that faulted re-executes and succeeds. `cr2`
// is the faulting linear address (read off CR2 by boot.s's isr_common and
// handed in); `errcode` is the CPU's page-fault error code. The page is
// aligned down to a 4KB boundary, backed by a fresh zeroed frame from
// jenna, seeded with FAULT_SENTINEL so the recovered read is independently
// verifiable, and mapped into the live c0 page tables (pml4_phys). No
// explicit TLB flush is needed, since x86 never caches a non-present translation,
// so the re-walk after iretq sees the new entry. A real kernel would
// consult a VMA list to decide map-vs-kill here; this always-map path
// proves the fault path and recovery mechanics that any real demand-paging
// policy would build on.
void page_fault_handler(int vector, int errcode, int cr2, int rip) {
    serial_print("page fault: addr=");
    serial_print_int(cr2);
    serial_print(" errcode=");
    serial_print_int(errcode);
    serial_print("\n");
    int page_base = (cr2 / 4096) * 4096;

    // A ring-3 program has no demand paging, its pages are all mapped when
    // it is loaded or asks for memory. So any fault it takes is a bad
    // address of its own, and it ends the program, not the machine. The
    // demand paging below maps into the kernel's tables, which would not
    // even help a program running on its own.
    if (sched_kill_faulted(vector, errcode, cr2, rip) == 1) { return; }

    // Check errcode bit 0. If the page was NOT present, this is a genuine
    // demand-paging request — allocate a frame and map it. If the page WAS
    // present, the fault is a permission violation. Do NOT allocate on a
    // present page — overwriting it with a fresh zeroed frame would destroy
    // whatever was there (e.g., JIT-compiled code).
    int bit0 = errcode % 2;
    if (!bit0) {
        int frame = pmm_alloc_page();
        zero_page(frame);
        store64(frame, FAULT_SENTINEL);
        map_page(pml4_phys, page_base, frame);
        return;
    }

    // Page IS present — permission fault. Halt (do not return — returning
    // would re-execute the faulting instruction and loop forever).
    serial_print("page fault: present page, halting\n");
    while (1) { halt(); }
    return;
}
