//
// utsikt -- a browser engine for Moonshot, written in c0.
//
// It reads an HTML file off the filesystem, builds a DOM, applies a
// subset of CSS, lays the result out as block and inline boxes, and paints it
// into a window. Links are followed with the mouse, and Backspace goes back.
// There is no networking, and that is deliberate. Everything that fetches
// bytes goes through
// load_document() below and nothing else does, so the day there is a network
// stack, one function changes. A link target is therefore a name on jakel,
// resolved from the root, and a href naming a host is left alone rather than
// failing.
//
// It runs as a tavla, an ordinary ring-3 program in a kakel window, spawned
// with `spawn3 utsikt.elf`, composited into its own buffer and
// presented in one syscall. The pieces are
//
//   paint.c0   pixels, the font, and the string helpers
//   dom.c0     HTML -> a tree
//   style.c0   CSS -> rules, and the cascade that computes a style per node
//   flow.c0    the tree -> boxes and lines, measured then painted
//
// The order of these includes is the dependency order, and c0 `include` is
// textual substitution, so it is also the order the compiler sees. flow.c0
// uses the constants style.c0 defines; style.c0 uses paint.c0's cell size.

include "paint.c0";
include "moon.c0";
include "dom.c0";
include "style.c0";
include "flow.c0";
include "script.c0";
include "engine_test.c0";
include "glimt.c0";

// The document utsikt opens first. A function rather than a global because
// a global initialiser is a constant, and a string literal is an address the
// linker fills in.
int page_file() { return "index.html"; }

// The document on screen now. Following a link moves this; the reload key
// re-reads THIS rather than the start page, or reloading would quietly be a
// second home key.
int current_page;

// Where following a link came from. A plain stack of names, not of parsed
// documents, since re-reading and re-parsing a page costs a fraction of what
// keeping every document ever visited would.
//
// Every name here, and current_page, is utsikt's own copy (name_keep). A
// link's href lives inside the document it was clicked in, and that document
// is given back once the next one is built, so a name that pointed into it
// would point at nothing.
//
// Going back therefore loses the scroll position, which is a real cost and
// the honest one to pay here.
int HIST_MAX = 32;
int history;
int history_n;

void history_push(int name) {
    if (history_n >= HIST_MAX) {
        // Drop the oldest rather than refuse to navigate. A browser that
        // stops following links after enough of them is worse than one whose
        // memory of the way back is finite.
        dealloc(load64(history));
        int k = 1;
        for (k = 1; k < HIST_MAX; k += 1) {
            store64(history + (k - 1) * 8, load64(history + k * 8));
        }
        history_n = HIST_MAX - 1;
    }
    store64(history + history_n * 8, name);
    history_n += 1;
    return;
}

int history_pop() {
    if (history_n <= 0) { return 0; }
    history_n -= 1;
    return load64(history + history_n * 8);
}

// Whether a link target is something this engine can open at all. There is
// no network and there are no fragments, so a href naming either is not a
// broken link, it is a link to somewhere that does not exist here yet.
// Refusing it leaves the current page alone, which is the one behaviour that
// cannot lose what the reader was looking at.
int followable(int href) {
    if (!href) { return 0; }
    if (href[0] == 0) { return 0; }
    if (href[0] == '#') { return 0; }
    int i = 0;
    for (i = 0; href[i] != 0; i += 1) {
        if (href[i] == ':') { return 0; }
    }
    return 1;
}

// The page shown when there is no index.html on the filesystem. Same role as
// Gnista's baked-in sprite. The program has to do something visible on a
// machine where nobody has put a file there yet, and a blank window is
// indistinguishable from a program that crashed.
//
// It also doubles as the one page that is always available to test against,
// which is why it uses every feature the engine has rather than saying
// something short and friendly.
int builtin_page() {
    return "<!DOCTYPE html>
<html><head><title>utsikt</title>
<style>
body { background: #f0efe8; color: #202020; padding: 10px; }
h1 { color: #202060; text-align: center; }
.note { background: #e0e8e0; padding: 6px; margin: 6px; }
.quiet { color: #707070; }
</style></head>
<body>
<h1>utsikt</h1>
<p>No <code>index.html</code> was found, so this is the page built into the
engine. It is here so that an empty filesystem looks different from a
crash.</p>
<h2>What renders</h2>
<ul>
<li>Block and inline boxes, with margins and padding.</li>
<li>Text that <b>wraps</b> at the window edge and re-wraps when the window
is resized.</li>
<li>Colours, backgrounds, three text sizes and alignment.</li>
<li>Links, clicked with the mouse. There is no page here to go to, since
this is the page that exists when the filesystem has none.</li>
</ul>
<div class=\"note\">A div with a class, a background and its own padding.</div>
<hr>
<p class=\"quiet\">Arrow keys and PageUp/PageDown scroll. Click a link to
follow it and Backspace to come back. r re-reads the page. Esc quits.
alt+w closes the window.</p>
</body></html>";
}

// The only place bytes enter the engine. It reads a file, and it is the one
// function a network stack would change and the reason nothing else calls
// readfile().
//
// Returns 0 when there is no such file, which the caller turns into the
// built-in page rather than into an error, since a browser with nothing to show is
// still a browser.
int load_document(int name) {
    int size = readfile(name, 0, 0);
    if (size <= 0) { return 0; }
    int buf = doc_alloc(size + 1);
    if (!buf) { return 0; }
    int n = readfile(name, buf, size);
    if (n <= 0) { return 0; }
    buf[n] = 0;
    return buf;
}

// Parses a document and computes every node's style. Separate from main so
// that reloading is the same code path as loading, which is the only way a
// reload key can be trusted to show what a fresh start would have shown.
int build_page(int html) {
    rules = 0;
    rules_tail = 0;
    css_parse(default_css());
    int root = html_parse(html);
    if (!root) { return 0; }
    int b = style_blocks;
    while (b != 0) {
        css_parse(b.sb_text);
        b = b.sb_next;
    }
    style_tree(root, 0);
    int bg = find_page_bg(root);
    if (bg < 0) { bg = 0xFFFFFF; }
    page_bg = bg;
    // Scripts run once the page is styled, before it is first laid out, so
    // the first frame already shows what they did.
    scripts_run(root);
    return root;
}

// --- what a document owns -------------------------------------------------
//
// Everything allocated while a document is read and parsed -- its source
// text, every node, every string, every style record, every CSS rule -- goes
// through doc_alloc and is written down in a record. Building the next
// document starts a new record (doc_begin). Once that build has worked,
// doc_commit gives back everything the previous document owned in one sweep.
// If it failed, doc_abort gives back the half-built one and the page on
// screen stays as it was. Recording each allocation is simpler and much
// harder to get wrong than teaching the DOM to free itself node by node,
// with strings shared between nodes and rules.
//
// Small pieces are cut from chunks of DOC_CHUNK bytes and only the chunks
// are recorded, since a page is hundreds of nodes and strings and asking
// the kernel for each one would make a page load cost tens of milliseconds. A
// chunk comes zeroed and nothing in it is handed out twice, so what
// doc_alloc returns is zeroed the same as alloc's. Anything bigger than a
// quarter chunk, such as the source text or an image, gets its own block.
int DOC_CHUNK = 16384;
int doc_cur = 0;      // record of the document on screen, an array of pointers
int doc_cur_n = 0;
int doc_cur_cap = 0;
int doc_building = 0; // 1 between doc_begin and doc_commit or doc_abort
int doc_new = 0;      // record of the document being built
int doc_new_n = 0;
int doc_new_cap = 0;
int doc_chunk_at = 0;    // next free byte in the current chunk
int doc_chunk_left = 0;  // bytes left in it

int doc_alloc(int n) {
    if (n <= 0) { return 0; }
    n = (n + 7) & (0 - 8);
    if (n <= DOC_CHUNK / 4) {
        if (n > doc_chunk_left) {
            int c = doc_record(DOC_CHUNK);
            if (!c) { return 0; }
            doc_chunk_at = c;
            doc_chunk_left = DOC_CHUNK;
        }
        int q = doc_chunk_at;
        doc_chunk_at += n;
        doc_chunk_left -= n;
        return q;
    }
    return doc_record(n);
}

// A block of its own from the kernel, written down in the record. While a
// document is being built that is the new document's record. Once it has
// been committed or abandoned, it is the record of the page on screen, so
// what a script or a click allocates later goes away with that page rather
// than with whichever document is built next.
int doc_record(int n) {
    int p = alloc(n);
    if (!p) { return 0; }
    if (!doc_building) { doc_swap(); }
    int ok = doc_push(p);
    if (!doc_building) { doc_swap(); }
    if (!ok) { dealloc(p); return 0; }
    return p;
}

// Appends p to the new document's record, growing it. Returns 0 when the
// record cannot grow.
int doc_push(int p) {
    if (doc_new_n == doc_new_cap) {
        int cap = 256;
        if (doc_new_cap > 0) { cap = doc_new_cap * 2; }
        int grown = alloc(cap * 8);
        if (!grown) { return 0; }
        int i = 0;
        for (i = 0; i < doc_new_n; i += 1) {
            store64(grown + i * 8, load64(doc_new + i * 8));
        }
        if (doc_new != 0) { dealloc(doc_new); }
        doc_new = grown;
        doc_new_cap = cap;
    }
    store64(doc_new + doc_new_n * 8, p);
    doc_new_n += 1;
    return 1;
}

// Exchanges the two records, so doc_push can add to either.
void doc_swap() {
    int t = doc_new;
    doc_new = doc_cur;
    doc_cur = t;
    t = doc_new_n;
    doc_new_n = doc_cur_n;
    doc_cur_n = t;
    t = doc_new_cap;
    doc_new_cap = doc_cur_cap;
    doc_cur_cap = t;
    return;
}

void doc_release(int record, int n) {
    int i = 0;
    for (i = 0; i < n; i += 1) {
        dealloc(load64(record + i * 8));
    }
    if (record != 0) { dealloc(record); }
    return;
}

void doc_begin() {
    doc_new = 0;
    doc_new_n = 0;
    doc_new_cap = 0;
    doc_chunk_at = 0;
    doc_chunk_left = 0;
    doc_building = 1;
    return;
}

void doc_commit() {
    doc_release(doc_cur, doc_cur_n);
    doc_cur = doc_new;
    doc_cur_n = doc_new_n;
    doc_cur_cap = doc_new_cap;
    doc_begin();
    doc_building = 0;
    return;
}

void doc_abort() {
    doc_release(doc_new, doc_new_n);
    doc_begin();
    doc_building = 0;
    return;
}

// A page name of utsikt's own, independent of any document. See history.
int name_keep(int name) {
    int n = 0;
    while (name[n] != 0) { n += 1; }
    int s = alloc(n + 1);
    if (!s) { return 0; }
    int i = 0;
    for (i = 0; i <= n; i += 1) {
        s[i] = name[i];
    }
    return s;
}

// Loads a document by name, parses it, and makes it the page on screen.
// Returns the new root, or 0 if the name does not resolve to a file -- in
// which case the caller keeps whatever was already there.
int goto_page(int name) {
    doc_begin();
    int html = load_document(name);
    if (!html) { doc_abort(); return 0; }
    int r = build_page(html);
    if (!r) { doc_abort(); return 0; }
    // Copied before doc_commit, which gives back the page the link was in.
    int keep = name_keep(name);
    if (!keep) { doc_abort(); return 0; }
    doc_commit();
    current_page = keep;
    scroll_y = 0;
    return r;
}

int main() {
    int winfo = win_info();
    if (winfo <= 0) {
        print("utsikt: no window -- spawn me with spawn3, not run3\n");
        return 2;
    }
    int winmax = win_max();
    if (winmax <= 0) {
        print("utsikt: win_max unavailable\n");
        return 3;
    }
    fb_max_w = winmax >> 16;
    fb_max_h = winmax & 65535;
    // Sized for the largest window this machine can hand out, once. There
    // is no realloc, so a buffer cut to today's window could not grow with
    // it, and present() copies what the window measures NOW.
    fb = alloc(fb_max_w * fb_max_h * 4);
    if (!fb) {
        print("utsikt: cannot allocate a frame buffer\n");
        return 4;
    }
    if (font_init() == 0) {
        print("utsikt: the kernel would not hand over its font\n");
        return 5;
    }
    if (flow_init() == 0) {
        print("utsikt: cannot allocate a line buffer\n");
        return 6;
    }
    // The scripting engines. See script.c0 for how one is plugged in.
    test_engine_register();
    glimt_register();
    history = alloc(HIST_MAX * 8);
    if (!history) {
        print("utsikt: cannot allocate the history stack\n");
        return 8;
    }
    history_n = 0;

    // The page named on the command line, `start utsikt.elf about.html`,
    // or index.html.
    int first = page_file();
    if (argc() >= 2) { first = argv(1); }
    current_page = name_keep(first);
    doc_begin();
    int html = load_document(first);
    if (!html) {
        print("utsikt: no index.html -- showing the built-in page\n");
        html = builtin_page();
    }
    int root = build_page(html);
    if (root == 0 || !current_page) {
        print("utsikt: out of memory parsing the document\n");
        return 7;
    }
    doc_commit();

    // Nothing may be printed past this point. print() is SYS_DEBUG_PRINT,
    // and for a task that owns a window the kernel routes it INTO that
    // window as text -- which would draw over the page. Diagnostics belong
    // before the first frame or nowhere.

    scroll_y = 0;
    int dirty = 1;
    int last_w = 0;
    int last_h = 0;
    int last_left = 0;
    while (1) {
        int wi = win_info();
        int ww = wi >> 16;
        int wh = wi & 65535;
        if (ww > fb_max_w) { ww = fb_max_w; }
        if (wh > fb_max_h) { wh = fb_max_h; }
        if (ww != last_w || wh != last_h) {
            // The window changed under us. Re-laying out rather than scaling
            // is the whole point of having a layout engine. Text re-wraps to
            // the new width instead of being squeezed.
            last_w = ww;
            last_h = wh;
            dirty = 1;
        }
        view_w = ww;
        // The address line's height comes off the document's, here and not
        // at paint time, so that every height-dependent thing downstream
        // agrees. PageDown pages by what is actually visible, End stops
        // where the last line really is, and the layout clips to the same
        // rectangle it was measured against.
        view_h = wh - bar_height();
        if (view_h < 0) { view_h = 0; }

        // Links. mouse_poll() is state rather than events, so following one
        // means finding the PRESS EDGE here, the frame where a button is
        // down and was not down before. Acting on the state itself would
        // follow the same link on every frame the button stayed held, which
        // at this frame rate is a page load per few milliseconds.
        int mp = mouse_poll();
        int buttons = 0;
        if (mp >= 0) {
            int packed = mp / 8;
            buttons = mp - packed * 8;
            int mx = packed / 1024;
            int my = packed - mx * 1024;
            int left = buttons % 2;
            if (left == 1 && !last_left) {
                int href = link_hit(mx, my);
                if (!href && script_click(mx, my) == 1) { dirty = 1; }
                if (followable(href) == 1) {
                    int prev = current_page;
                    int r3 = goto_page(href);
                    if (r3 != 0) {
                        history_push(prev);
                        root = r3;
                        dirty = 1;
                    }
                }
            }
        }
        // A pointer that has left the window reports -1, which is not the
        // same as a button being released. Treating it as released is right
        // anyway, because a press that happened somewhere else is not this window's
        // press, and the next one inside the window has to read as new.
        last_left = buttons % 2;

        int key = key_poll();
        while (key >= 0) {
            int make = key / 2;
            int is_break = key - make * 2;
            if (!is_break) {
                if (make == 1) { return 0; }                      // Esc
                if (make == 72) { scroll_y -= cell_h * 3; dirty = 1; }
                if (make == 80) { scroll_y += cell_h * 3; dirty = 1; }
                if (make == 73) { scroll_y = scroll_y - view_h + cell_h * 2; dirty = 1; }
                if (make == 81) { scroll_y += view_h - cell_h * 2; dirty = 1; }
                if (make == 71) { scroll_y = 0; dirty = 1; }      // Home
                if (make == 79) { scroll_y = doc_h; dirty = 1; }  // End
                if (make == 14) {
                    // Backspace -- back. Without it a link is a one-way
                    // door, since the reload key re-reads the page that
                    // was followed to rather than the one it started on.
                    int back = history_pop();
                    if (back != 0) {
                        int was = current_page;
                        int r4 = goto_page(back);
                        if (r4 != 0) { root = r4; dirty = 1; dealloc(was); }
                        // goto_page kept its own copy, so the popped name
                        // goes either way.
                        dealloc(back);
                    }
                }
                if (make == 19) {
                    // r -- re-read the file and rebuild. The old document is
                    // given back once the new one is built, so a reload
                    // costs nothing that stays.
                    doc_begin();
                    int fresh = load_document(current_page);
                    if (!fresh) { fresh = builtin_page(); }
                    int r2 = build_page(fresh);
                    if (r2 != 0) {
                        doc_commit();
                        root = r2;
                        scroll_y = 0;
                    } else {
                        doc_abort();
                    }
                    dirty = 1;
                }
            }
            key = key_poll();
        }

        if (script_dirty == 1) { dirty = 1; script_dirty = 0; }
        if (scroll_y < 0) { scroll_y = 0; }
        if (dirty == 1 && view_w > 0 && view_h > 0) {
            render_page(root);
            draw_address_bar(wh, current_page);
            present(fb);
            dirty = 0;
        } else {
            // Nothing to redraw, so give the CPU away for a tick (10ms) instead
            // of polling the mouse and keyboard again at once.
            sleep(1);
        }
    }
    return 0;
}
