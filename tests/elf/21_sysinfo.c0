// expect: 9
// SYS_INFO (34), what insyn reads. Each check that holds adds one.
include "moon.c0";

int has(int s, int part) {
    int i = 0;
    while (s[i] != 0) {
        int j = 0;
        while (part[j] != 0 && s[i + j] == part[j]) { j += 1; }
        if (part[j] == 0) { return 1; }
        i += 1;
    }
    return 0;
}

int main() {
    int ok = 0;
    int b = alloc(4096);

    // 1. The machine. Time runs, at 100 ticks a second, and memory adds up.
    if (sysinfo(0, b, 128) == 128) { ok += 1; }
    if (load64(b) > 0 && load64(b + 8) == 100 && load64(b + 24) < load64(b + 16)
        && load64(b + 40) > 0 && load64(b + 40) <= load64(b + 32)) { ok += 1; }
    // 2. The screen and the task table's size.
    if (load64(b + 96) == 1024 && load64(b + 104) == 768 && load64(b + 112) == 8) { ok += 1; }
    // 3. System calls are counted, and this one is among them.
    int calls = load64(b + 64);
    sysinfo(0, b, 128);
    if (load64(b + 64) > calls) { ok += 1; }

    // 4. Every task slot, and this program running among them by name.
    int n = sysinfo(1, b, 4096) / 96;
    if (n == 8) { ok += 1; }
    int me = 0;
    int t = 0;
    for (t = 0; t < n; t += 1) {
        int r = b + t * 96;
        if (load64(r) == 1 && has(r + 48, "et21") && load64(r + 16) >= 4096) { me += 1; }
    }
    if (me == 1) { ok += 1; }

    // 5. The hardware, a CPU vendor and a brand.
    if (sysinfo(2, b, 128) == 128 && load8(b) != 0 && load8(b + 16) != 0) { ok += 1; }

    // 6. Refused, a kernel address, a buffer running past the heap, and an
    // unknown view.
    if (sysinfo(0, 4096, 128) == 0 - 1 && sysinfo(0, b, 1 << 40) == 0 - 1) { ok += 1; }
    if (sysinfo(7, b, 128) == 0 - 1) { ok += 1; }
    return ok;
}
