//
// infecteria -- a game for Moonshot, built on Gnista's engine layer.
//
// You are a bacterium. You move with the arrow keys through a world larger
// than the screen, so the view follows you and you have to explore to find
// anything. Scattered around are cells, half-transparent, twice your size,
// and you can see yourself through them when you are inside one. Being
// inside a cell slows you slightly and slowly infects it, shown by a bar
// above it. Once a cell is fully infected you choose what it becomes.
//
//   e -- absorb it. The cell is consumed and gone.
//   q -- convert it into a factory, which periodically emits mini-bacteria.
//
// Mini-bacteria are the point of factories. They seek out uninfected cells on
// their own, add a little infection, and are spent on arrival. If one meets
// an antibacterium it goes for that instead -- they are the only thing that
// can hurt one.
//
// Antibacteria hunt YOU. They are slower than you are, so you can always
// outrun them, but touching one kills you. You cannot fight back directly;
// the only counterplay is to build factories and let the mini-bacteria do it.
//
// Everything is drawn from sprites. Five of them ship compiled into this
// binary, drawn by gen_art.c0, and every one can be replaced by drawing over
// it in pensel and saving as player.spr, cell.spr, factory.spr, anti.spr or
// mini.spr -- the game looks for those on the filesystem at startup and uses
// what it finds. Draw them at the sizes the game uses (16x16 for the player,
// 32x32 for a cell or factory, 18x18 for an antibacterium, 8x8 for a
// mini-bacterium). A sprite of the wrong size is ignored rather than
// stretched or allowed to change what collides with what, because how big a
// thing is is a rule of the game and not a property of its picture.
//
// The cell and the factory are drawn in GREY and tinted as they are drawn.
// That is what lets one drawn cell be the clean cell, the infected cell and
// the factory, instead of three sprites that have to be redrawn together.

include "engine.c0";
include "infecteria_art.c0";
include "moon.c0";

// NOTHING here is a global. Every constant lives as a local in main and
// is passed down.
//
// Entity kinds, as used below, are 1 player, 2 cell, 3 factory, 4 mini, 5 anti.
//
// Per-kind meaning of the engine's scratch fields, so the reads are not a
// guessing game.
//   cell / factory:  a1 = infection 0..100, a2 = emit cooldown (factory)
//   mini:            a1 = lifetime left in ticks
//   anti:            a1 = health, dropped by mini-bacteria
//   player:          a1 = 1 once dead

// Moves one step toward a target, one axis at a time. Deliberately not
// normalised, since c0 has no square root, and diagonal movement being slightly
// faster is not something this game notices.
void step_toward(int e, int target, int speed) {
    int ex = e.x + e.w / 2;
    int ey = e.y + e.h / 2;
    int tx = target.x + target.w / 2;
    int ty = target.y + target.h / 2;
    if (tx > ex) { e.x = e.x + speed; }
    if (tx < ex) { e.x = e.x - speed; }
    if (ty > ey) { e.y = e.y + speed; }
    if (ty < ey) { e.y = e.y - speed; }
    return;
}

// Nearest living entity of `kind`, or 0. O(n) per searcher, which at this
// entity count is not worth improving -- a spatial index would be real code
// and real risk to save comparisons nobody can feel.
int nearest_of_kind(int pool, int cap, int from, int kind) {
    int best = 0;
    int bestd = 0;
    int i = 0;
    while (i < cap) {
        int e = pool_at(pool, i);
        if (e.alive == 1 && e.kind == kind && e != from) {
            int d = dist2(from, e);
            if (best == 0 || d < bestd) { best = e; bestd = d; }
        }
        i = i + 1;
    }
    return best;
}

// The cell the player's centre is inside, or 0.
int cell_under(int pool, int cap, int p, int kind) {
    int i = 0;
    while (i < cap) {
        int c = pool_at(pool, i);
        if (c.alive == 1 && c.kind == kind) {
            if (centre_inside(c, p) == 1) { return c; }
        }
        i = i + 1;
    }
    return 0;
}

void clamp_world(int e, int world_w, int world_h) {
    if (e.x < 0) { e.x = 0; }
    if (e.y < 0) { e.y = 0; }
    if (e.x > world_w - e.w) { e.x = world_w - e.w; }
    if (e.y > world_h - e.h) { e.y = world_h - e.h; }
    return;
}

// A drawn sprite when one is there and it is the size the game uses, and the
// default drawn by infecteria_art.c0 otherwise. The size check is the reason
// this exists rather than a bare sprite_from_file. An entity's dimensions
// decide what it collides with, so a 40x40 player drawn in pensel must not
// silently become a 40x40 hitbox, and stretching the picture to fit would be
// worse than ignoring it.
//
// `draw_fn` is a function reference. A bare function name in c0 is its
// address, so the default is passed in rather than chosen here by name, and
// the two halves of "where does this sprite come from" stay in one place per
// sprite at the call site.
// Where the world's random layout comes from. infecteria.seed, if there is
// one, holds a number in decimal and the same number always builds the same
// world. A layout worth replaying can be kept, and a test can know where
// everything starts. Without the file the layout comes from the clock, as it
// always did.
int world_seed() {
    int buf = alloc(32);
    int n = readfile("infecteria.seed", buf, 31);
    int v = 0;
    int digits = 0;
    int i = 0;
    while (i < n) {
        int c = load8(buf + i);
        if (c >= '0' && c <= '9') {
            v = v * 10 + (c - '0');
            digits = digits + 1;
        } else {
            if (digits > 0) { i = n; }
        }
        i = i + 1;
    }
    dealloc(buf);
    if (digits == 0) { return ticks() + 12345; }
    return v;
}

int art_load(int name, int w, int h, int draw_fn) {
    int s = sprite_from_file(name);
    if (s != 0 && s.sp_w == w && s.sp_h == h) { return s; }
    return draw_fn();
}

// What the scenes share, everything made once at startup, and the last game's
// result for the screen that shows it.
layout Game {
    int g_v;
    int g_seed;
    int g_pool;
    int g_sp_player;
    int g_sp_cell;
    int g_sp_factory;
    int g_sp_anti;
    int g_sp_mini;
    int g_ticks;        // how long the last game lasted, in ticks
    int g_absorbed;     // cells absorbed with e
    int g_factories;    // cells turned into factories with q
    int g_killed;       // antibacteria destroyed by mini-bacteria
}

// The playing field. It
// builds a fresh world on every call, so "play again" is just calling it
// again. Returns over_scene when the player dies and 0 on Esc.
int play_scene(int g) {
    int v;
    int pool;
    int player;
    int winfo;
    int seed;
    int i;
    int key;
    int make_code;
    int is_break;
    int t;
    int prev;
    int dt;
    int up; int down; int left; int right;
    int e;
    int here;
    int target;
    int speed;
    int spawned;
    int K_PLAYER; int K_CELL; int K_FACTORY; int K_MINI; int K_ANTI;
    int WORLD_W; int WORLD_H;
    int PLAYER_D; int CELL_D; int MINI_D; int ANTI_D;
    int POOL_CAP; int NUM_CELLS; int NUM_ANTI;
    int SPD_PLAYER; int SPD_PLAYER_SLOW; int SPD_MINI; int SPD_ANTI;
    int INFECT_PER_TICK; int INFECT_PER_MINI; int MINI_LIFETIME;
    int FACTORY_PERIOD; int ANTI_HEALTH; int ANTI_MIN_SPAWN;
    int PLAYER_MAX_HP; int ANTI_DPS; int ABSORB_HEAL; int MINI_DAMAGE;
    int COL_HP;
    int COL_BG; int COL_PLAYER; int COL_CELL; int COL_INFECT;
    int COL_FACTORY; int COL_MINI; int COL_ANTI; int COL_BAR;
    int col;
    int bc;
    int COL_READY;
    int sp_player; int sp_cell; int sp_factory; int sp_anti; int sp_mini;
    int phase;
    int moving;
    int started;

    K_PLAYER = 1; K_CELL = 2; K_FACTORY = 3; K_MINI = 4; K_ANTI = 5;
    WORLD_W = 2400; WORLD_H = 1800;
    PLAYER_D = 16; CELL_D = 32; MINI_D = 8; ANTI_D = 18;
    POOL_CAP = 160; NUM_CELLS = 46; NUM_ANTI = 5;
    // Antibacteria are strictly slower than the player, so you can always
    // outrun them -- that is the whole counterplay, since you cannot fight.
    SPD_PLAYER = 3; SPD_PLAYER_SLOW = 2; SPD_MINI = 2; SPD_ANTI = 2;
    INFECT_PER_TICK = 1; INFECT_PER_MINI = 12; MINI_LIFETIME = 900;
    // A screen is about 1000 px wide, so an antibacterium that starts closer
    // than this is one you can see hunting you before you have moved.
    FACTORY_PERIOD = 120; ANTI_HEALTH = 100; ANTI_MIN_SPAWN = 1100;
    // Health is counted in 400ths rather than 100ths, and that is the whole
    // of the damage change. Contact drains ANTI_DPS per tick and a tick is a
    // hundredth of a second, so a hundred-point player died one second after
    // being touched -- long enough to notice and far too short to do anything
    // about, with an antibacterium that follows you forever and a world where
    // running into a second one while fleeing the first is ordinary. c0 has
    // no fractions, so the way to make a hit cost less is to make the pool
    // deeper. Four hundred is four seconds of being held, which is time to
    // turn and outrun it, and the bar still reads 0 to 100.
    PLAYER_MAX_HP = 400; ANTI_DPS = 1; ABSORB_HEAL = 100; MINI_DAMAGE = 20;
    COL_BG = 0x101820; COL_PLAYER = 0x40FF80; COL_CELL = 0x6080C0;
    COL_INFECT = 0xC06040; COL_FACTORY = 0xE0A030; COL_MINI = 0x80FFC0;
    COL_ANTI = 0xE04040; COL_BAR = 0x40E060; COL_READY = 0xFFFFA0;
    COL_HP = 0x40C0FF;

    v = g.g_v;
    seed = g.g_seed;
    pool = g.g_pool;
    sp_player = g.g_sp_player;
    sp_cell = g.g_sp_cell;
    sp_factory = g.g_sp_factory;
    sp_anti = g.g_sp_anti;
    sp_mini = g.g_sp_mini;
    g.g_absorbed = 0;
    g.g_factories = 0;
    g.g_killed = 0;

    // A new world every game, from the seed file when there is one, so a
    // playtest can replay the same world as often as it likes.
    store64(seed, world_seed());
    pool_clear(pool, POOL_CAP);

    // The player starts in the middle of the world.
    player = pool_spawn(pool, POOL_CAP);
    player.kind = K_PLAYER;
    player.w = PLAYER_D;
    player.h = PLAYER_D;
    player.x = WORLD_W / 2;
    player.y = WORLD_H / 2;
    player.color = COL_PLAYER;
    player.a1 = PLAYER_MAX_HP;   // a1 is the player's health

    // One cell placed deliberately just below the start, so the core
    // mechanic is met immediately rather than after a hunt -- and so a
    // scripted run can reach it without searching.
    e = pool_spawn(pool, POOL_CAP);
    if (e != 0) {
        e.kind = K_CELL;
        e.w = CELL_D; e.h = CELL_D;
        e.x = WORLD_W / 2 - CELL_D / 2 + PLAYER_D / 2;
        e.y = WORLD_H / 2 + 40;
        e.color = COL_CELL;
        e.a1 = 0;
    }

    // The rest, scattered. No overlap test, since cells sitting on each other is not
    // harmful here, and rejection sampling would be a loop that can fail to
    // terminate on a crowded world.
    i = 0;
    while (i < NUM_CELLS) {
        e = pool_spawn(pool, POOL_CAP);
        if (e != 0) {
            e.kind = K_CELL;
            e.w = CELL_D;
            e.h = CELL_D;
            e.x = rng_range(seed, 0, WORLD_W - CELL_D);
            e.y = rng_range(seed, 0, WORLD_H - CELL_D);
            e.color = COL_CELL;
            e.a1 = 0;
        }
        i = i + 1;
    }

    // Antibacteria, kept away from the player's starting position so the
    // first seconds are not an ambush.
    i = 0;
    while (i < NUM_ANTI) {
        e = pool_spawn(pool, POOL_CAP);
        if (e != 0) {
            e.kind = K_ANTI;
            e.w = ANTI_D;
            e.h = ANTI_D;
            e.x = rng_range(seed, 0, WORLD_W - ANTI_D);
            e.y = rng_range(seed, 0, WORLD_H - ANTI_D);
            e.color = COL_ANTI;
            e.a1 = ANTI_HEALTH;
            // Keep it at least a full screen away from where the player
            // starts. A bounded re-roll rather than one corrective push, since the
            // push moved a half-world and wrapped, which lands inside the
            // exclusion zone again whenever the first roll was roughly a
            // half-world away to begin with, and the only thing stopping that
            // from being common was luck. Sixteen tries is not a loop that
            // can hang, and the push is kept as the last resort so the
            // outcome is bounded even in the case where every try was bad.
            //
            // The earlier version of this guard mirrored the point about the
            // world centre, which does nothing at all here, because the
            // player starts AT the centre and reflecting a nearby point
            // across it leaves the distance identical. It looked like a guard
            // and was a no-op, and the player was being killed within seconds
            // of starting.
            int tries = 0;
            while (dist2(e, player) < ANTI_MIN_SPAWN * ANTI_MIN_SPAWN
                   && tries < 16) {
                e.x = rng_range(seed, 0, WORLD_W - ANTI_D);
                e.y = rng_range(seed, 0, WORLD_H - ANTI_D);
                tries = tries + 1;
            }
            if (dist2(e, player) < ANTI_MIN_SPAWN * ANTI_MIN_SPAWN) {
                e.x = e.x + WORLD_W / 2;
                if (e.x > WORLD_W - ANTI_D) { e.x = e.x - (WORLD_W - ANTI_D); }
                e.y = e.y + WORLD_H / 2;
                if (e.y > WORLD_H - ANTI_D) { e.y = e.y - (WORLD_H - ANTI_D); }
            }
        }
        i = i + 1;
    }

    print("infecteria: running\n");
    prev = ticks();
    started = prev;
    up = 0; down = 0; left = 0; right = 0;

    while (1) {
        // --- input ---------------------------------------------------------
        // Arrow keys are tracked as HELD state via make/break, not as
        // one-shot events, since the player should keep moving while a key is down.
        key = key_poll();
        while (key >= 0) {
            make_code = key / 2;
            is_break = key - make_code * 2;
            if (make_code == 72) { up = 1 - is_break; }
            if (make_code == 80) { down = 1 - is_break; }
            if (make_code == 75) { left = 1 - is_break; }
            if (make_code == 77) { right = 1 - is_break; }
            if (is_break == 0) {
                if (make_code == 1) { return 0; }        // Esc quits
                // e / q act on the cell you are standing in, and only once it
                // is fully infected.
                if (make_code == 18 || make_code == 16) {
                    here = cell_under(pool, POOL_CAP, player, K_CELL);
                    if (here != 0 && here.a1 >= 100) {
                        if (make_code == 18) {
                            // Absorbing is the only way to heal, which is
                            // what makes infecting cells worth the risk of
                            // standing still near an antibacterium.
                            player.a1 = player.a1 + ABSORB_HEAL;
                            if (player.a1 > PLAYER_MAX_HP) { player.a1 = PLAYER_MAX_HP; }
                            pool_kill(here);              // e absorbs
                            g.g_absorbed = g.g_absorbed + 1;
                        } else {
                            here.kind = K_FACTORY;        // q converts
                            here.color = COL_FACTORY;
                            here.a2 = FACTORY_PERIOD;
                            g.g_factories = g.g_factories + 1;
                        }
                    }
                }
            }
            key = key_poll();
        }

        t = ticks();
        dt = t - prev;
        if (dt <= 0) {
            // Nothing to do until the clock moves -- and specifically, do NOT
            // poll input here. Calling key_poll() and throwing the result away
            // would silently eat one event per spin. When the eaten event is a
            // key RELEASE, the direction flag stays set and the player keeps
            // moving on its own, a stuck key. It would also drift you out of
            // the cell you are trying to stand still in, so infections would
            // never complete and e/q would appear to do nothing.
            //
            // Sleeping the tick out gives the CPU to everything else instead
            // of spinning on ticks() until it moves.
            sleep(1);
        } else {
            prev = t;

            // --- player ----------------------------------------------------
            here = cell_under(pool, POOL_CAP, player, K_CELL);
            speed = SPD_PLAYER;
            if (here != 0) { speed = SPD_PLAYER_SLOW; }
            if (up == 1) { player.y = player.y - speed; }
            if (down == 1) { player.y = player.y + speed; }
            if (left == 1) { player.x = player.x - speed; }
            if (right == 1) { player.x = player.x + speed; }
            clamp_world(player, WORLD_W, WORLD_H);

            // Standing in a cell infects it.
            if (here != 0 && here.kind == K_CELL && here.a1 < 100) {
                here.a1 = here.a1 + INFECT_PER_TICK * dt;
                if (here.a1 >= 100) {
                    here.a1 = 100;
                }
            }

            // --- everything else -------------------------------------------
            i = 0;
            while (i < POOL_CAP) {
                e = pool_at(pool, i);
                if (e.alive == 1) {
                    if (e.kind == K_FACTORY) {
                        // By dt, not by 1, since the update runs once per FRAME,
                        // and a frame is several ticks at this frame rate.
                        // Decrementing by one made every constant below mean
                        // "frames" while being named in ticks, and the first
                        // factory came within a frame or two of never
                        // emitting at all inside a seven-second test.
                        e.a2 = e.a2 - dt;
                        if (e.a2 <= 0) {
                            e.a2 = FACTORY_PERIOD;
                            spawned = pool_spawn(pool, POOL_CAP);
                            if (spawned != 0) {
                                spawned.kind = K_MINI;
                                spawned.w = MINI_D;
                                spawned.h = MINI_D;
                                spawned.x = e.x + CELL_D / 2;
                                spawned.y = e.y + CELL_D / 2;
                                spawned.color = COL_MINI;
                                spawned.a1 = MINI_LIFETIME;
                            }
                        }
                    }
                    if (e.kind == K_MINI) {
                        // Antibacteria first, since a mini that finds one goes for
                        // it instead of looking for a cell.
                        target = nearest_of_kind(pool, POOL_CAP, e, K_ANTI);
                        if (target != 0 && dist2(e, target) < 260 * 260) {
                            step_toward(e, target, SPD_MINI);
                            if (aabb_hit(e, target) == 1) {
                                target.a1 = target.a1 - MINI_DAMAGE;
                                if (target.a1 <= 0) {
                                    pool_kill(target);
                                    g.g_killed = g.g_killed + 1;
                                }
                                pool_kill(e);
                            }
                        } else {
                            target = nearest_of_kind(pool, POOL_CAP, e, K_CELL);
                            if (target != 0) {
                                step_toward(e, target, SPD_MINI);
                                if (centre_inside(target, e) == 1) {
                                    target.a1 = target.a1 + INFECT_PER_MINI;
                                    if (target.a1 > 100) { target.a1 = 100; }
                                    // Spent on arrival.
                                    pool_kill(e);
                                }
                            }
                        }
                        e.a1 = e.a1 - dt;
                        if (e.a1 <= 0) { pool_kill(e); }
                        clamp_world(e, WORLD_W, WORLD_H);
                    }
                    if (e.kind == K_ANTI) {
                        step_toward(e, player, SPD_ANTI);
                        clamp_world(e, WORLD_W, WORLD_H);
                        // Contact drains health rather than killing outright.
                        // Instant death made a single mistake fatal, and with
                        // an antibacterium that follows you forever there was
                        // no way to recover from being caught once.
                        if (aabb_hit(e, player) == 1) {
                            player.a1 = player.a1 - ANTI_DPS * dt;
                            if (player.a1 <= 0) {
                                g.g_ticks = t - started;
                                return over_scene;
                            }
                        }
                    }
                }
                i = i + 1;
            }

            // --- render ----------------------------------------------------
            // Check the window BEFORE anything reads vw/vh this frame. A tile
            // can be resized by something typed in another window at any
            // moment, and the whole frame -- camera clamp, clear, every clip
            // test -- has to agree on one size. view_follow immediately below
            // is the first reader.
            view_poll_resize(v);
            view_follow(v, player, WORLD_W, WORLD_H);
            view_clear(v, COL_BG);

            // Every animated thing runs its own clip on the shared clock,
            // offset by its pool slot so that a crowd does not pulse in
            // lockstep. The player's tail beats fast while it swims and
            // slowly while it waits.
            moving = up + down + left + right;
            phase = 24;
            if (moving > 0) { phase = 6; }

            // Opaque things first, so the half-transparent cells blend over
            // them and you can see yourself underneath.
            view_sprite(v, player.x, player.y, PLAYER_D, PLAYER_D,
                        sp_player.sp_pixels, anim_frame(sp_player, 0, 4, phase, t));
            view_bar(v, player.x, player.y, PLAYER_D,
                     player.a1 * 100 / PLAYER_MAX_HP, COL_HP);
            i = 0;
            while (i < POOL_CAP) {
                e = pool_at(pool, i);
                if (e.alive == 1) {
                    if (e.kind == K_MINI) {
                        view_sprite(v, e.x, e.y, MINI_D, MINI_D,
                                    sp_mini.sp_pixels, anim_frame(sp_mini, 0, 2, 12, t + i * 5));
                    }
                    if (e.kind == K_ANTI) {
                        view_sprite(v, e.x, e.y, ANTI_D, ANTI_D,
                                    sp_anti.sp_pixels, anim_frame(sp_anti, 0, 2, 20, t + i * 7));
                        view_bar(v, e.x, e.y, ANTI_D, e.a1 * 100 / ANTI_HEALTH, COL_ANTI);
                    }
                }
                i = i + 1;
            }

            // Then the cells and factories, with their infection bars on top.
            // A cell is blended so you can see yourself inside one, which is
            // the feedback that tells you the infection is running. A factory
            // is not. It has stopped being something you can be inside and
            // become a thing that stands there, and looking solid is how it
            // says so without a label.
            i = 0;
            while (i < POOL_CAP) {
                e = pool_at(pool, i);
                if (e.alive == 1 && (e.kind == K_CELL || e.kind == K_FACTORY)) {
                    col = COL_CELL;
                    if (e.kind == K_FACTORY) { col = COL_FACTORY; }
                    else if (e.a1 > 0) { col = COL_INFECT; }
                    if (e.kind == K_FACTORY) {
                        view_sprite_tint(v, e.x, e.y, CELL_D, CELL_D,
                                         sp_factory.sp_pixels, 0, col, 0);
                    } else {
                        view_sprite_tint(v, e.x, e.y, CELL_D, CELL_D,
                                         sp_cell.sp_pixels, 0, col, 1);
                    }
                    if (e.kind == K_CELL && e.a1 > 0) {
                        // A full bar gets its own colour, since without it there is
                        // no way to tell that e/q have become available, and
                        // pressing them early does nothing at all.
                        bc = COL_BAR;
                        if (e.a1 >= 100) { bc = COL_READY; }
                        view_bar(v, e.x, e.y, CELL_D, e.a1, bc);
                    }
                }
                i = i + 1;
            }

            present(v.buf);
        }
    }
    return 0;
}

// --- the other scenes -------------------------------------------------------

int COL_TITLE = 0x40FF80;
int COL_TEXT = 0xC8D8E0;
int COL_DIM_TEXT = 0x7890A0;
int COL_SCREEN = 0x101820;

// Shared by the title and the end screen. It clears, follows resizes, and
// draws a slowly swimming player in the middle.
void card_begin(int g, int t) {
    int v = g.g_v;
    view_poll_resize(v);
    v.cam_x = 0;
    v.cam_y = 0;
    view_clear(v, COL_SCREEN);
    int sp = g.g_sp_player;
    view_sprite(v, v.vw / 2 - 8, v.vh / 2 - 8, 16, 16, sp.sp_pixels,
                anim_frame(sp, 0, 4, 10, t));
    return;
}

int title_scene(int g) {
    int v = g.g_v;
    int last = 0 - 1;
    while (1) {
        int k = key_pressed(57, 1);                   // space, Esc
        if (k == 1) { return play_scene; }
        if (k == 2) { return 0; }
        int t = ticks();
        if (t == last) { sleep(1); }
        if (t != last) {
            last = t;
            card_begin(g, t);
            view_text_centred(v, v.vh / 2 - 80, "INFECTERIA", COL_TITLE, 4);
            view_text_centred(v, v.vh / 2 + 30, "arrows move   e absorb a cell   q make it a factory", COL_TEXT, 1);
            view_text_centred(v, v.vh / 2 + 50, "outrun the red ones: only your factories can hurt them", COL_DIM_TEXT, 1);
            view_text_centred(v, v.vh / 2 + 80, "space to start   esc to quit", COL_TEXT, 1);
            present(v.buf);
        }
    }
    return 0;
}

// Appends the decimal digits of n to the text at buf, from position at, and
// returns the new end.
int put_num(int buf, int at, int n) {
    int d = alloc(24);
    int k = 0;
    if (n == 0) { store8(d, '0'); k = 1; }
    while (n > 0) { store8(d + k, '0' + n % 10); n = n / 10; k = k + 1; }
    while (k > 0) { k = k - 1; store8(buf + at, load8(d + k)); at = at + 1; }
    store8(buf + at, 0);
    dealloc(d);
    return at;
}

int put_str(int buf, int at, int s) {
    int i = 0;
    while (load8(s + i) != 0) { store8(buf + at, load8(s + i)); at = at + 1; i = i + 1; }
    store8(buf + at, 0);
    return at;
}

int over_scene(int g) {
    int v = g.g_v;
    int line = alloc(96);
    int n = put_str(line, 0, "you lasted ");
    n = put_num(line, n, g.g_ticks / 100);
    n = put_str(line, n, " seconds");
    int line2 = alloc(96);
    int m = put_num(line2, 0, g.g_absorbed);
    m = put_str(line2, m, " absorbed   ");
    m = put_num(line2, m, g.g_factories);
    m = put_str(line2, m, " factories   ");
    m = put_num(line2, m, g.g_killed);
    m = put_str(line2, m, " antibacteria destroyed");
    int last = 0 - 1;
    int next = 0 - 1;
    while (next < 0) {
        int k = key_pressed(57, 1);                   // space, Esc
        if (k == 1) { next = play_scene; }
        if (k == 2) { next = 0; }
        int t = ticks();
        if (next < 0 && t == last) { sleep(1); }
        if (next < 0 && t != last) {
            last = t;
            card_begin(g, t);
            view_text_centred(v, v.vh / 2 - 80, "CLEARED", 0xE04040, 4);
            view_text_centred(v, v.vh / 2 + 30, line, COL_TEXT, 1);
            view_text_centred(v, v.vh / 2 + 50, line2, COL_TEXT, 1);
            view_text_centred(v, v.vh / 2 + 80, "space to play again   esc to quit", COL_DIM_TEXT, 1);
            present(v.buf);
        }
    }
    dealloc(line);
    dealloc(line2);
    return next;
}

// Everything made once, the frame buffer, the art, the world's memory. Then
// the scenes take over. The sizes passed to art_load are the ones play_scene
// gives the entities (PLAYER_D, CELL_D, ANTI_D, MINI_D). A drawn sprite of
// any other size is refused, because size decides what collides.
int main() {
    int winfo = win_info();
    if (winfo == 0) { return 200; }
    int g = alloc(sizeof(Game));
    int v = alloc(sizeof(View));
    if (g == 0 || v == 0) { return 202; }
    v.vw = winfo / 65536;
    v.vh = winfo % 65536;
    v.cam_x = 0;
    v.cam_y = 0;
    // Sized for the LARGEST window this machine can hand out, not for the one
    // we happen to have been given. The tile can be resized under us at any
    // time (see view_poll_resize, called each frame) and alloc() cannot grow
    // an allocation afterwards -- so the only buffer that is always big enough
    // is one that was always big enough.
    v.buf = view_alloc_max(v);
    if (v.buf == 0) { return 201; }
    g.g_v = v;

    // The art. Each one is the drawn file when there is a usable one on the
    // filesystem and the baked-in default otherwise, so the game runs on a
    // machine where nobody has opened pensel and improves on one where
    // somebody has.
    g.g_sp_player = art_load("player.spr", 16, 16, draw_player);
    g.g_sp_cell = art_load("cell.spr", 32, 32, draw_cell);
    g.g_sp_factory = art_load("factory.spr", 32, 32, draw_factory);
    g.g_sp_anti = art_load("anti.spr", 18, 18, draw_anti);
    g.g_sp_mini = art_load("mini.spr", 8, 8, draw_mini);
    if (g.g_sp_player == 0 || g.g_sp_cell == 0 || g.g_sp_factory == 0
        || g.g_sp_anti == 0 || g.g_sp_mini == 0) {
        print("infecteria: out of memory loading art\n");
        return 203;
    }
    g.g_seed = alloc(8);
    g.g_pool = pool_alloc(160);
    if (g.g_seed == 0 || g.g_pool == 0) { return 202; }
    if (text_init() == 0) {
        print("infecteria: the kernel would not hand over its font\n");
        return 204;
    }
    scene_run(title_scene, g);
    return 0;
}
