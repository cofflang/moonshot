// expect: 5
// synth's instruments (programs/lib/synth.c0). One A4 at full velocity per
// instrument, rendered to samples, and each checked for its own shape. Each
// check that holds adds one, so the exit code counts them.
include "noter.c0";
include "synth.c0";

int N = 2000;      // samples looked at, about forty cycles of 440 Hz
int SKIP = 100;    // past the note's ramp in

// Renders instrument `inst` into out as signed values, sample minus 128.
// The drum's note is one step, 2756 samples, so it has mostly died away by
// the end of the stretch looked at. The others are held well past it.
void render(int inst, int out) {
    int s = noter_new(1, 4, 120);
    int len = 16;
    if (inst == 3) { len = 1; }
    noter_add_with(s, 1, 69, 0, len, 127, inst);
    int bytes = alloc(N);
    int mix = alloc(N * 8);
    synth_render(s, 0, N, bytes, mix);
    int i = 0;
    for (i = 0; i < N; i += 1) { store64(out + i * 8, load8(bytes + i) - 128); }
    return;
}

int at(int out, int i) { return load64(out + i * 8); }

int main() {
    int ok = 0;
    int v = alloc(N * 8);
    int i = 0;

    // 1. The square is only ever all the way up or all the way down.
    render(0, v);
    int square = 1;
    for (i = SKIP; i < N; i += 1) {
        if (at(v, i) != 16 && at(v, i) != 0 - 16) { square = 0; }
    }
    if (square == 1) { ok += 1; }

    // 2. The triangle climbs and falls a step at a time, never jumping, and
    // reaches both ends.
    render(1, v);
    int jump = 0;
    int top = 0;
    int bottom = 0;
    for (i = SKIP; i < N; i += 1) {
        int d = at(v, i) - at(v, i - 1);
        if (d > 2 || d < 0 - 2) { jump = 1; }
        if (at(v, i) >= 14) { top = 1; }
        if (at(v, i) <= 0 - 14) { bottom = 1; }
    }
    if (jump == 0 && top == 1 && bottom == 1) { ok += 1; }

    // 3. The sawtooth climbs a step at a time and drops all the way once a
    // cycle, about forty times in this stretch.
    render(2, v);
    int drops = 0;
    int bad = 0;
    for (i = SKIP; i < N; i += 1) {
        int d = at(v, i) - at(v, i - 1);
        if (d <= 0 - 20) { drops += 1; }
        else if (d < 0 - 1 || d > 2) { bad = 1; }
    }
    if (bad == 0 && drops >= 36 && drops <= 44) { ok += 1; }

    // 4. The drum is noise, changing sign far more often than a 440 Hz wave
    // would (about eighty times in this stretch, the noise about two
    // hundred and forty), and fading over the note.
    render(3, v);
    int flips = 0;
    int early = 0;
    int late = 0;
    for (i = SKIP; i < N; i += 1) {
        if ((at(v, i) > 0) != (at(v, i - 1) > 0)) { flips += 1; }
    }
    for (i = SKIP; i < SKIP + 400; i += 1) {
        int a = at(v, i);
        if (a < 0) { a = 0 - a; }
        early += a;
    }
    for (i = N - 400; i < N; i += 1) {
        int a = at(v, i);
        if (a < 0) { a = 0 - a; }
        late += a;
    }
    if (flips > 150 && early > late * 2) { ok += 1; }

    // 5. The four are not the same sound twice. The square and the triangle
    // already differ in shape above, so this compares the first stretch of
    // the triangle and the sawtooth directly.
    int t = alloc(N * 8);
    render(1, t);
    render(2, v);
    int differ = 0;
    for (i = SKIP; i < SKIP + 200; i += 1) {
        if (at(t, i) != at(v, i)) { differ += 1; }
    }
    if (differ > 100) { ok += 1; }

    return ok;
}
