int SYS_EXIT       = 0;
int SYS_DEBUG_PRINT = 1;
int SYS_WIN_INFO    = 2;
int SYS_FILL        = 3;
int SYS_KEY_POLL    = 4;
int SYS_ALLOC       = 6;
int SYS_TICKS       = 7;
int SYS_READFILE    = 8;
int SYS_PRESENT     = 9;
int SYS_WIN_MAX     = 10;
int SYS_MOUSE_POLL  = 11;
int SYS_GLYPH       = 12;
int SYS_DEALLOC     = 13;
int SYS_SOUND       = 14;
int SYS_WRITEFILE   = 15;
int SYS_SLEEP       = 16;
int SYS_ARGC        = 17;
int SYS_ARGV        = 18;
int SYS_LISTDIR     = 19;
int SYS_SPAWN       = 20;
int SYS_PROTECT     = 21;
int SYS_EDIT        = 22;
int SYS_OPEN        = 23;
int SYS_READ        = 24;
int SYS_WRITE       = 25;
int SYS_CLOSE       = 26;
int SYS_EXIT_CLOSE  = 27;
int SYS_SHELL       = 28;
int SYS_WAIT        = 29;
int SYS_REMOVE      = 30;
int SYS_SOUND_FORMAT = 31;
int SYS_CLOSE_KEY   = 32;
int SYS_CLOCK       = 33;
int SYS_INFO        = 34;
int SYS_KILL        = 35;
int SYS_POINTER     = 36;
int SYS_WHEEL       = 37;

// Copies a path out of user memory into a fresh kmalloc'd buffer, bounded by
// what jakel allows, and returns it (the caller kfrees it), or 0.
//
// Its own buffer, never jakel's name scratch, which is where jakel_open
// builds each component. A path copied there would have its '/' overwritten
// by the first component's terminating 0, so "test/x" would resolve to the
// directory "test".
int sys_copy_path(int src) {
    int max = JAKEL_NAME_LEN * 4;
    int buf = kmalloc(max);
    if (!buf) { return 0; }
    int i = 0;
    for (i = 0; i < max - 1; i += 1) {
        int c = load8(src + i);
        store8(buf + i, c);
        if (!c) { return buf; }
    }
    store8(buf + i, 0);
    return buf;
}


// A ring-3 process's open files, FD_SLOTS of them per task. Slot i is fd
// i + 3, since 0, 1 and 2 are the console. A slot holds its jakel id plus 1
// (0 for a free slot), the offset the next read or write starts at, and 1
// when it was opened for writing. The ELF loader empties a task's slots, so
// nothing a previous process in that task left open carries over.
int FD_SLOTS = 8;
// Per task, the directory SYS_OPEN's relative paths start from, the shell's
// current directory when start ran the program. 0, the root, for anything
// started some other way.
int task_cwd_base = 0;

// Per task, 1 when what the program prints goes to the serial line only,
// for a program another one runs in the background (SYS_SPAWN's flag 1).
int task_quiet_base = 0;

int task_quiet(int tid) {
    if (!task_quiet_base) { return 0; }
    return load64(task_quiet_base + tid * 8);
}

void task_set_quiet(int tid, int q) {
    if (!task_quiet_base) {
        task_quiet_base = kmalloc(MAX_TASKS * 8);
        if (!task_quiet_base) { return; }
        int i = 0;
        for (i = 0; i < MAX_TASKS; i += 1) { store64(task_quiet_base + i * 8, 0); }
    }
    store64(task_quiet_base + tid * 8, q);
    return;
}

int task_cwd(int tid) {
    if (!task_cwd_base) { return 0; }
    return load64(task_cwd_base + tid * 8);
}

// Per task, how the program in it ended. 1 when it called exit, with the
// code in task_exit_code_base, 2 when the kernel stopped it for a fault,
// and 3 while it runs or when it was killed. A finished task's slot is
// reaped within a tick, so this is what the shell's execute reads once the
// task is no longer runnable.
int task_end_base = 0;
int task_exit_code_base = 0;

void task_set_end(int tid, int how, int code) {
    if (!task_end_base) {
        task_end_base = kmalloc(MAX_TASKS * 8);
        task_exit_code_base = kmalloc(MAX_TASKS * 8);
    }
    store64(task_end_base + tid * 8, how);
    store64(task_exit_code_base + tid * 8, code);
    return;
}
int fd_file_base = 0;
int fd_off_base = 0;
int fd_wr_base = 0;

void fd_reset(int tid) {
    int i = 0;
    if (!fd_file_base) {
        fd_file_base = kmalloc(MAX_TASKS * FD_SLOTS * 8);
        fd_off_base = kmalloc(MAX_TASKS * FD_SLOTS * 8);
        fd_wr_base = kmalloc(MAX_TASKS * FD_SLOTS * 8);
        for (i = 0; i < MAX_TASKS * FD_SLOTS; i += 1) { store64(fd_file_base + i * 8, 0); }
    }
    for (i = 0; i < FD_SLOTS; i += 1) { store64(fd_file_base + (tid * FD_SLOTS + i) * 8, 0); }
    return;
}

// The table index of the current task's fd, or -1 for one that is not open.
int fd_slot(int fd) {
    if (!fd_file_base || fd < 3 || fd >= 3 + FD_SLOTS) { return 0 - 1; }
    int k = sched_current * FD_SLOTS + fd - 3;
    if (!load64(fd_file_base + k * 8)) { return 0 - 1; }
    return k;
}

// Writes len bytes at s to the console, the serial port and the process's
// window, or the focused one when it has none.
int sys_console_write(int s, int len) {
    int wid = load64(task_win_base + sched_current * 8);
    int quiet = task_quiet(sched_current);
    int i = 0;
    for (i = 0; i < len; i += 1) {
        int ch = load8(s + i);
        serial_putc(ch);
        if (quiet == 1) {
            // Started by another program to work in the background (see
            // SYS_SPAWN's flags), so nothing reaches the screen.
        } else if (wid >= 0 && kakel_active == 1) {
            kakel_putc_fg(wid, ch, FB_FG);
        } else {
            sk_putc(ch);
        }
    }
    return len;
}

// Closes the calling task's own tavla, for SYS_EXIT_CLOSE. The window is
// let go of first, so kakel_close_id finds no live owner to kill and the task
// stays where it is, about to exit. The shells are prompted again as Alt+W
// does, since the window that takes the focus may be a shell waiting at a
// prompt it never drew.
void sys_close_own_window() {
    int tid = sched_current;
    int wid = load64(task_win_base + tid * 8);
    if (wid < 0 || kakel_active != 1 || kakel_is_tavla(wid) == 0) { return; }
    if (load64(kakel_owner_base + wid * 8) != tid) { return; }
    store64(kakel_owner_base + wid * 8, 0 - 1);
    store64(task_win_base + tid * 8, 0 - 1);
    if (kakel_close_id(wid) == 1) {
        shell_reprompt_others(0 - 1);
        shell_prompt_session(kakel_focus);
    }
    return;
}

// --- what insyn shows ------------------------------------------------------------

int sys_calls = 0;           // system calls since boot
int task_presents_base = 0;  // per task, SYS_PRESENT calls since it started
int task_name_base = 0;      // per task, its program's name, kmalloc'd, or 0
int task_parent_base = 0;    // per task, the task that started it, or -1

void task_info_reset(int tid) {
    klick_pointer_reset(tid);
    if (!task_presents_base) {
        task_presents_base = kmalloc(MAX_TASKS * 8);
        task_name_base = kmalloc(MAX_TASKS * 8);
        task_parent_base = kmalloc(MAX_TASKS * 8);
        if (!task_presents_base || !task_name_base || !task_parent_base) { return; }
        int i = 0;
        for (i = 0; i < MAX_TASKS; i += 1) {
            store64(task_presents_base + i * 8, 0);
            store64(task_name_base + i * 8, 0);
            store64(task_parent_base + i * 8, 0 - 1);
        }
    }
    store64(task_presents_base + tid * 8, 0);
    store64(task_parent_base + tid * 8, 0 - 1);
    int nm = load64(task_name_base + tid * 8);
    if (nm) { kfree(nm); }
    store64(task_name_base + tid * 8, 0);
    return;
}

// Copies the string s, at most n - 1 bytes and a NUL, to dst.
void info_str(int dst, int s, int n) {
    int i = 0;
    while (s && i < n - 1 && load8(s + i) != 0) {
        store8(dst + i, load8(s + i));
        i += 1;
    }
    while (i < n) { store8(dst + i, 0); i += 1; }
    return;
}

int INFO_TASK_BYTES = 96;

// SYS_INFO's three views, written into buf (kernel-checked to be the
// caller's own), at most max bytes. Returns the bytes written, or -1.
int sys_info(int what, int buf, int max) {
    if (what == 0) {
        // The machine, sixteen numbers, or seventeen.
        if (max < 128) { return 0 - 1; }
        store64(buf, pit_ticks);
        store64(buf + 8, 100);
        store64(buf + 16, pmm_total_pages());
        store64(buf + 24, pmm_available_pages());
        store64(buf + 32, heap_end - heap_start);
        store64(buf + 40, arena_used(heap_start, heap_end));
        store64(buf + 48, jakel_used_bytes());
        store64(buf + 56, JAKEL_ARENA_PAGES * 4096);
        store64(buf + 64, sys_calls);
        store64(buf + 72, key_irqs);
        store64(buf + 80, klick_packets);
        store64(buf + 88, oljud_irqs);
        store64(buf + 96, fb_width);
        store64(buf + 104, fb_height);
        store64(buf + 112, MAX_TASKS);
        store64(buf + 120, clock_utc());
        // A seventeenth for a caller with room, the bytes of sound mixed for
        // programs, ever. It stands still while nothing plays, unlike the
        // interrupts, which the card raises for silence too.
        if (max >= 136) {
            store64(buf + 128, oljud_played);
            return 136;
        }
        return 128;
    }
    if (what == 1) {
        // Every task slot, INFO_TASK_BYTES each. state, timer ticks it was
        // found working (10ms of CPU each), heap bytes, window, presents,
        // how it ended, then its name in 48 bytes.
        int n = 0;
        int t = 0;
        for (t = 0; t < MAX_TASKS && (n + 1) * INFO_TASK_BYTES <= max; t += 1) {
            int r = buf + n * INFO_TASK_BYTES;
            store64(r, load64(task_state_base + t * 8));
            store64(r + 8, load64(task_cpu_base + t * 8));
            store64(r + 16, lager_in_use(t));
            store64(r + 24, load64(task_win_base + t * 8));
            int pr = 0;
            if (task_presents_base) { pr = load64(task_presents_base + t * 8); }
            store64(r + 32, pr);
            int how = 0;
            if (task_end_base) { how = load64(task_end_base + t * 8); }
            store64(r + 40, how);
            int nm = 0;
            if (task_name_base) { nm = load64(task_name_base + t * 8); }
            if (!nm && t == shell_task_id) { nm = "skalman"; }
            if (!nm) { nm = "kernel"; }
            info_str(r + 48, nm, 48);
            n += 1;
        }
        return n * INFO_TASK_BYTES;
    }
    if (what == 2) {
        // The hardware. cpuid leaves 0, 1 and the brand string, then the
        // devices. 0..15 vendor, 16..63 brand, 64 leaf 1 eax (family,
        // model, stepping), 72 ecx features, 80 edx features, 88 framebuffer
        // bits per pixel, 96 disk present, 104 disk sectors jakel uses, 112
        // mouse present, 120 sound card DSP version (major * 256 + minor).
        if (max < 128) { return 0 - 1; }
        int regs = kmalloc(32);
        if (!regs) { return 0 - 1; }
        int cpuid = cpuid_into;
        cpuid(0, regs);
        int i = 0;
        for (i = 0; i < 16; i += 1) { store8(buf + i, 0); }
        store32(buf, load64(regs + 8));
        store32(buf + 4, load64(regs + 24));
        store32(buf + 8, load64(regs + 16));
        for (i = 0; i < 48; i += 1) { store8(buf + 16 + i, 0); }
        cpuid(0x80000000, regs);
        if (load64(regs) >= 0x80000004) {
            int leaf = 0;
            for (leaf = 0; leaf < 3; leaf += 1) {
                cpuid(0x80000002 + leaf, regs);
                int k = 0;
                for (k = 0; k < 4; k += 1) {
                    store32(buf + 16 + leaf * 16 + k * 4, load64(regs + k * 8));
                }
            }
        }
        store8(buf + 63, 0);
        cpuid(1, regs);
        store64(buf + 64, load64(regs));
        store64(buf + 72, load64(regs + 16));
        store64(buf + 80, load64(regs + 24));
        kfree(regs);
        store64(buf + 88, 32);
        store64(buf + 96, ata_present);
        store64(buf + 104, JAKEL_ARENA_PAGES * 8);
        store64(buf + 112, klick_active);
        store64(buf + 120, oljud_dsp_version);
        return 128;
    }
    return 0 - 1;
}

int sys_dispatch(int num, int a1, int a2, int a3, int a4, int a5, int a6) {
    sys_calls += 1;
    // A program closed with alt+w or its [x] is ended from an interrupt,
    // and when that interrupt came while the program itself was running,
    // the CPU goes back to it and it runs on until the next tick. Its next
    // call must do nothing, least of all sleep, which would mark it BLOCKED
    // and so bring it back after it was ended. It parks the way SYS_EXIT
    // does, halting with interrupts on until the scheduler switches away
    // from it for good and the reaper frees it.
    if (load64(task_state_base + sched_current * 8) == TASK_EXITED) {
        int on0 = enable_interrupts;
        on0();
        while (1) { cpu_wait(); }
    }
    // SYS_EXIT_CLOSE(code) -- SYS_EXIT for a program whose window means
    // nothing once it is gone, like an editor that was quit. A plain exit
    // leaves the last frame on screen (see kakel_tavla_orphan), which is right
    // for a game or a page and wrong here. A separate number and not an
    // argument to SYS_EXIT, since a program returning from main reaches
    // SYS_EXIT with whatever its last call left in rsi.
    if (num == SYS_EXIT_CLOSE) {
        sys_close_own_window();
        num = 0;
    }
    if (!num) {
        int tid = sched_current;
        store64(task_state_base + tid * 8, TASK_EXITED);
        serial_print("[syscall] exit code=");
        serial_print_int(a1);
        serial_print("\n");
        task_set_end(sched_current, 1, a1);
        // The SYSCALL instruction's SFMASK MSR (boot.s) clears RFLAGS.IF on
        // entry -- normally restored by SYSRET, but this handler
        // deliberately never reaches it (see the halt loop below), so IF
        // would otherwise stay clear FOREVER. On this single-core kernel
        // that means the timer could never fire again to switch away from
        // this now-EXITED task -- not a slow leak, a total freeze the
        // instant any ring-3 process calls sys_exit, with no fault and no
        // panic. enable_interrupts (boot.s,
        // reached by name) is the same "c0 cannot execute a privileged
        // instruction" hand-off halt() below already uses for `hlt`.
        int sti = enable_interrupts;
        sti();
        // Loop-halt. The timer ISR's scheduler will swap away from this
        // EXITED task on the next tick. An NMI can wake hlt, so looping
        // ensures we never accidentally sysretq back to ring 3.
        while (1 == 1) {
            cpu_wait();
        }
        return 0;
    }
    if (num == 1) {
        // sys_write(str, len) — write to serial and screen.
        // If this task has its own kakel window (windowed spawn), route
        // screen output there directly instead of through sk_putc (which
        // goes to kakel_focus — the shell's focus, not this process's).
        return sys_console_write(a1, a2);
    }
    if (num == 2) {
        // SYS_WIN_INFO — returns the task's window pixel dimensions packed as
        // width * 65536 + height, or 0 if no window is attached (non-windowed
        // spawn, or VGA-only fallback).
        //
        // Cell geometry MUST go through FONT_W/FONT_H, never literals. All
        // FONT_H is 8, not 16, and a hardcoded 16 would double every height
        // and every y origin, so a program would be told its window is twice as
        // tall as it is and bounce its sprite off an edge far below anything
        // visible.
        int wid2 = load64(task_win_base + sched_current * 8);
        if (wid2 < 0 || !kakel_active) { return 0; }
        int w = load64(kakel_cols_base + wid2 * 8) * FONT_W;
        int h = load64(kakel_rows_base + wid2 * 8) * FONT_H;
        // Once one pixel short after the window comes back into view, so the
        // program sees a change and draws a whole frame (kakel_nudge_live).
        if (kakel_take_nudge(wid2) == 1) { h -= 1; }
        // Remember what we told it. A program sizes its frame buffer from this
        // answer and in practice keeps it (it has nothing to realloc with), so
        // this is the pitch its buffer will be written at for as long as it
        // runs -- SYS_PRESENT needs that, not the window's size today. See
        // task_win_reported_base (chrone.c0).
        store64(task_win_reported_base + sched_current * 8, (w << 16) | h);
        return (w << 16) | h;
    }
    if (num == 3) {
        // SYS_FILL(x, y, w, h, color) — fill a rectangle in the task's
        // window. Coordinates are window-relative; the handler translates
        // to absolute screen coordinates and clips to both the window
        // bounds and the framebuffer edges.
        int wid3 = load64(task_win_base + sched_current * 8);
        if (wid3 < 0 || !kakel_active) { return -1; }
        kakel_fill(wid3, a1, a2, a3, a4, a5);
        return 0;
    }
    if (num == 4) {
        // SYS_KEY_POLL — dequeues one raw key event from THIS TASK'S queue
        // and returns make_code * 2 + is_break, or -1 if empty. Per-task, so
        // two graphical programs running at once cannot drain each other's
        // input; the keyboard handler pushes only to the owner of the focused
        // tavla, so a program sees only keys typed at its own window.
        return key_task_poll(sched_current);
    }
    if (num == 5) {
        // SYS_BLIT(buf, x, y, w, h) — copy w*h pixels from a user-space
        // buffer to the task's window. Each pixel is 4 bytes (0xRRGGBB
        // in framebuffer order, blue at offset 0, green 1, red 2, zero 3).
        // Coordinates are window-relative; clipped to window bounds.
        int wid5 = load64(task_win_base + sched_current * 8);
        if (wid5 < 0 || !kakel_active) { return -1; }
        if (kakel_shown(wid5) == 0) { return 0; }
        int wx5 = load64(kakel_cx_base + wid5 * 8) * FONT_W;
        int wy5 = load64(kakel_cy_base + wid5 * 8) * FONT_H;
        int ww5 = load64(kakel_cols_base + wid5 * 8) * FONT_W;
        int wh5 = load64(kakel_rows_base + wid5 * 8) * FONT_H;
        fb_blit(a1, a2, a3, a4, a5, wx5, wy5, ww5, wh5);
        return 0;
    }
    if (num == 6) {
        // SYS_ALLOC(n) -- n bytes (rounded up to 8), zeroed, from this
        // task's own ring-3 heap. Returns 0 on a bad request or when the heap
        // is exhausted. lager.c0 keeps the block table and reuses what
        // SYS_DEALLOC gave back. Until lager this was a bump pointer with no
        // free at all.
        return lager_alloc(sched_current, a1);
    }
    if (num == 13) {
        // SYS_DEALLOC(ptr) -- gives back a block SYS_ALLOC returned. Returns
        // 0, or -1 (and a line in the serial log) for anything that is not
        // the start of a live block. See lager.c0.
        return lager_free(sched_current, a1);
    }
    if (num == 7) {
        // SYS_TICKS — the kernel's own monotonic ~100Hz PIT tick counter
        // (interrupts.c0's `pit_ticks`, incremented by timer_tick, never
        // reset). Deliberately NOT sched_tick_count (chrone.c0) -- that
        // one is a countdown that wraps every SCHED_SWITCH_PERIOD ticks
        // for scheduling quantum bookkeeping, useless as an elapsed-time
        // source. Lets a ring-3 program (Gnista) measure real elapsed
        // time between frames instead of tying movement speed to however
        // fast its own loop happens to spin.
        return pit_ticks;
    }
    if (num == 8) {
        // SYS_READFILE(name, buf, max) — read a file from jakel into the
        // process's own memory. Returns the number of bytes copied, or -1 if
        // the path does not resolve to a file.
        //
        // With buf == 0 it returns the file's SIZE and copies nothing, so a
        // program can size its alloc() before the real read. That is why
        // there is no separate stat syscall, and this costs one branch.
        //
        // This is the syscall that makes runtime assets possible. Without it a
        // ring-3 program could not read a file at all, so every sprite would have
        // to be baked into the ELF by a host script and changing one pixel would
        // mean a recompile -- see pensel, which draws sprites on Moonshot itself.
        //
        // Pointers arrive as the process's own virtual addresses and are used
        // directly, since SYSCALL does not switch CR3, so the process's address
        // space is still live here, the same way SYS_DEBUG_PRINT already
        // reads its string and SYS_BLIT its pixel buffer.
        //
        // `buf` IS bounds-checked against USER_VIRT_BASE though, unlike those
        // two. They only READ through a user pointer; this one writes through
        // it, so a bad value would have the kernel scribble file contents
        // into its own memory. Not a security model -- ring 3 has none here
        // yet -- just refusing the one operation that can corrupt the kernel.
        if (!a1) { return -1; }
        int nbuf = sys_copy_path(a1);
        if (!nbuf) { return -1; }
        int fid = jakel_open(0, nbuf);
        kfree(nbuf);
        if (fid < 0) { return -1; }
        if (load64(jakel_type_base + fid * 8) != JAKEL_TYPE_FILE) { return -1; }
        int fsz = load64(jakel_size_base + fid * 8);
        if (!a2) { return fsz; }
        if (a2 < USER_VIRT_BASE) {
            serial_print("[syscall] readfile: refusing non-user buffer\n");
            return -1;
        }
        int n = fsz;
        if (a3 < n) { n = a3; }
        if (n <= 0) { return 0; }
        jakel_read(fid, 0, a2, n);
        return n;
    }
    if (num == 9) {
        // SYS_PRESENT(buf) — copy a whole window's worth of pixels from the
        // caller's buffer straight onto the framebuffer. The fast path for a
        // program that composites entire frames, which is what anything with
        // a scrolling camera has to do. When the view moves, every pixel
        // changes, and SYS_BLIT's per-pixel work becomes the frame budget.
        //
        // How much work it removes is the point. SYS_BLIT reads four bytes
        // and multiplies them together to rebuild each pixel, checks it
        // against colour 0 so sprites can have holes, then writes through
        // fb_put_pixel. Several memory accesses and a handful of arithmetic
        // ops per pixel.
        //
        // This does none of it. It copies whole rows, eight bytes (two pixels) at a
        // time, no per-pixel branch and no arithmetic. It can, because a
        // full-window present has no transparency to honour -- every pixel
        // is replaced -- and because kakel's geometry is CELL aligned, so a
        // row is always a whole number of 8-byte groups. That is the same
        // argument kakel_scroll's row copy already relies on, that a window's x
        // origin is cx*FONT_W pixels (32 bytes) and its width cols*FONT_W
        // pixels, both multiples of 8 bytes.
        //
        // The buffer must hold exactly width*height pixels for the task's own
        // window, in framebuffer order. Returns 0, or -1 if the task has no
        // window.
        int wid9 = load64(task_win_base + sched_current * 8);
        if (wid9 < 0 || !kakel_active) { return -1; }
        // Hidden behind a maximized window or rotated out of view, the frame
        // goes nowhere. The program carries on as if it had been shown.
        if (kakel_shown(wid9) == 0) { return 0; }
        if (task_presents_base) {
            store64(task_presents_base + sched_current * 8,
                    load64(task_presents_base + sched_current * 8) + 1);
        }
        if (!a1) { return -1; }
        int wx9 = load64(kakel_cx_base + wid9 * 8) * FONT_W;
        int wy9 = load64(kakel_cy_base + wid9 * 8) * FONT_H;
        int ww9 = load64(kakel_cols_base + wid9 * 8) * FONT_W;
        int wh9 = load64(kakel_rows_base + wid9 * 8) * FONT_H;
