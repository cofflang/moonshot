//
// expect: 0
// The x of every corner of ship.form, in the root, added up in sixteenths
// of a unit (form's handle snap), plus 128, as the exit code, for
// verify_form_handles.sh. 255 when a corner is off the sixteenths. There is
// no ship.form when the ELF tests run on their own, so then it is 0.
include "djup.c0";

int main() {
    int m = djup_load("/ship.form", 512, 1024);
    if (!m) { return 0; }
    int sum = 0;
    int i = 0;
    for (i = 0; i < m.dh_verts; i += 1) {
        int x = load64(djup_vert(m, i));
        if (x % 4096 != 0) { return 255; }
        sum += x / 4096;
    }
    return 128 + sum;
}
