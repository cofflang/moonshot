        return 0;
    }
    if (num == SYS_POINTER) {
        // SYS_POINTER(shape) -- how the mouse pointer looks while it is over
        // the caller's window, 0 the block, 1 left and right (stretching),
        // 2 four ways (dragging). See klick.c0. Returns 0, or -1 for a shape
        // there is none of.
        return klick_set_pointer(sched_current, a1);
    }
    if (num == SYS_WHEEL) {
        // SYS_WHEEL() -- the mouse wheel's steps over the caller's window
        // since it last asked, positive turned towards the user. See klick.c0.
        return klick_wheel_take(sched_current);
    }
    if (num == SYS_INFO) {
        // SYS_INFO(what, buf, max) -- read-only facts about the machine for
        // insyn, the debug panel. 0 the machine's counters, 1 every task
        // slot, 2 the hardware. See sys_info for the layouts. buf must lie
        // wholly in the caller's own heap, since the kernel writes it.
        int hmap = load64(task_heap_mapped_base + sched_current * 8);
        if (a2 < USER_VIRT_BASE || a3 <= 0 || a2 + a3 > hmap) { return 0 - 1; }
        return sys_info(a1, a2, a3);
    }
    if (num == SYS_CLOCK) {
        // SYS_CLOCK(what, value) -- the wall clock. what 0 gives seconds since
        // 1970 in UTC, 1 milliseconds since boot (in steps of ten), 2 the
        // offset in minutes the time is shown with, and 3 sets that offset
        // to value, from -24 to +24 hours, returning 0. Saving it is the
        // caller's (tid.zone holds it, and boot reads it). -1 otherwise.
        if (a1 == 0) { return clock_utc(); }
        if (a1 == 1) { return pit_ticks * 10; }
        if (a1 == 2) { return clock_offset; }
        if (a1 == 3 && a2 >= 0 - 1440 && a2 <= 1440) {
            clock_offset = a2;
            serial_print("[clock] offset set to ");
            serial_print_int(a2);
            serial_print(" min\n");
            return 0;
        }
        return 0 - 1;
    }
    if (num == SYS_CLOSE_KEY) {
        // SYS_CLOSE_KEY(on) -- with on 1, Alt+W on the caller's window sends
        // it the key 127 instead of stopping it, so it can save or ask first.
        // If that key is still unread a second later, the next Alt+W stops
        // the program anyway. See key_close_request. Returns 0.
        if (key_close_base) { store64(key_close_base + sched_current * 8, a1 == 1); }
        return 0;
    }
    if (num == SYS_SOUND_FORMAT) {
        // SYS_SOUND_FORMAT(fmt) -- what the caller's SYS_SOUND bytes are from
        // now on, 0 8-bit unsigned mono (every program starts there), 1
        // 16-bit signed mono, 2 16-bit signed stereo. See oljud_set_format.
        return oljud_set_format(a1);
    }
    if (num == SYS_REMOVE) {
        // SYS_REMOVE(path) -- deletes a file, from the caller's folder like
        // SYS_OPEN. Never a folder. Returns 0, or -1 when there is no such
        // file or the user may not change it.
        if (!a1 || a1 < USER_VIRT_BASE) { return 0 - 1; }
        int rpath = sys_copy_path(a1);
        if (!rpath) { return 0 - 1; }
        int rfid = jakel_open(task_cwd(sched_current), rpath);
        kfree(rpath);
        if (rfid < 0) { return 0 - 1; }
        if (load64(jakel_type_base + rfid * 8) != JAKEL_TYPE_FILE) { return 0 - 1; }
        if (jakel_can_write(jakel_current_uid, rfid) == 0) { return 0 - 1; }
        if (jakel_remove(rfid) != 0) { return 0 - 1; }
        return 0;
    }
    if (num == 23) {
        // SYS_OPEN(path, mode) -- opens a file for reading (mode 0) or for
        // writing (mode 1), which creates it when it does not exist and
        // empties it when it does. Returns an fd, 3 or more, or -1. With
        // SYS_READ, SYS_WRITE and SYS_CLOSE this is what c0's open_read,
        // open_write, read, write and close become under coff --elf, so a
        // program written for Linux files, coff and smed among them, runs
        // here unchanged. A path starts from the directory the program was
        // started in, or from the root when it begins with '/'.
        if (!a1 || (a2 != 0 && a2 != 1)) { return 0 - 1; }
        int opath = sys_copy_path(a1);
        if (!opath) { return 0 - 1; }
        int ocwd = task_cwd(sched_current);
        int ofid = jakel_open(ocwd, opath);
        if (ofid < 0 && a2 == 1) { ofid = jakel_create_at(ocwd, opath); }
        kfree(opath);
        if (ofid < 0) { return 0 - 1; }
        if (load64(jakel_type_base + ofid * 8) != JAKEL_TYPE_FILE) { return 0 - 1; }
        if (a2 == 0 && jakel_can_read(jakel_current_uid, ofid) == 0) { return 0 - 1; }
        if (a2 == 1) {
            if (jakel_can_write(jakel_current_uid, ofid) == 0) { return 0 - 1; }
            store64(jakel_size_base + ofid * 8, 0);
        }
        if (!fd_file_base) { fd_reset(sched_current); }
        int oi = 0;
        for (oi = 0; oi < FD_SLOTS; oi += 1) {
            int ok = sched_current * FD_SLOTS + oi;
            if (!load64(fd_file_base + ok * 8)) {
                store64(fd_file_base + ok * 8, ofid + 1);
                store64(fd_off_base + ok * 8, 0);
                store64(fd_wr_base + ok * 8, a2);
                return oi + 3;
            }
        }
        return 0 - 1;
    }
    if (num == 24) {
        // SYS_READ(fd, buf, n) -- reads up to n bytes from where the last read
        // ended. Returns how many, 0 at the end of the file, -1 for a bad fd.
        int rk = fd_slot(a1);
        if (rk < 0 || a3 < 0) { return 0 - 1; }
        if (a2 < USER_VIRT_BASE) {
            serial_print("[syscall] read: refusing non-user buffer\n");
            return 0 - 1;
        }
        int roff = load64(fd_off_base + rk * 8);
        int rn = jakel_read(load64(fd_file_base + rk * 8) - 1, roff, a2, a3);
        store64(fd_off_base + rk * 8, roff + rn);
        return rn;
    }
    if (num == 25) {
        // SYS_WRITE(fd, buf, n) -- fd 1 and 2 are the console, the same as
        // SYS_DEBUG_PRINT. Any other fd must be open for writing, and the n
        // bytes go after what was written before. Returns n, or -1. Like
        // SYS_WRITEFILE it changes jakel in memory only, `sync` saves it.
        if (a1 == 1 || a1 == 2) { return sys_console_write(a2, a3); }
        int wk = fd_slot(a1);
        if (wk < 0 || a3 < 0 || load64(fd_wr_base + wk * 8) != 1) { return 0 - 1; }
        if (a2 < USER_VIRT_BASE) {
            serial_print("[syscall] write: refusing non-user buffer\n");
            return 0 - 1;
        }
        if (a3 == 0) { return 0; }
        int woff = load64(fd_off_base + wk * 8);
        if (jakel_write(load64(fd_file_base + wk * 8) - 1, woff, a2, a3) != a3) { return 0 - 1; }
        store64(fd_off_base + wk * 8, woff + a3);
        return a3;
    }
    if (num == 26) {
        // SYS_CLOSE(fd) -- frees the fd. 0, or -1 for one that is not open.
        int ck = fd_slot(a1);
        if (ck < 0) { return 0 - 1; }
        store64(fd_file_base + ck * 8, 0);
        return 0;
    }
    if (num == 14) {
        // SYS_SOUND(buf, len) -- queues len bytes of PCM at 22050 Hz, in the
        // caller's format (SYS_SOUND_FORMAT, 8-bit mono to begin with), for
        // the Sound Blaster 16 and returns how many fit; buf == 0
        // returns how many are still waiting, and buf == 0 with len -1 stops
        // everything at once. -1 when there is no card. See oljud.c0.
        return oljud_submit(a1, a2);
    }
    serial_print("[syscall] unknown syscall ");
    serial_print_int(num);
    serial_print("\n");
    return -1;
}

// Load a flat binary from `code` (length `code_len` bytes) into a fresh,
// process-private address space and execute it in ring 3. Returns only on
// error.
//
// Each call to this function gets its OWN pt_create()'d PML4 -- real
// per-process isolation, not the old scheme of flipping U/S bits on the
// kernel's shared identity map. The code and stack pages are ordinary
// pmm_alloc_page() physical frames (their physical addresses are irrelevant
// to the process itself); they are mapped into the new address space at the
// fixed virtual range USER_VIRT_BASE.. (code) and USER_VIRT_BASE+4096..
// (stack) via map_page_user (jenna.c0). Every process therefore sees the
// SAME virtual layout while actually owning different physical pages --
// process A's USER_VIRT_BASE and process B's USER_VIRT_BASE resolve through
// separate PDPT/PD/PT chains that were never shared to begin with.
//
// Per task, the title for the tavla its windowed spawn is about to create,
// an owned copy of the file's name that spawn_program handed it; 0 means "no
// name given, use the generic label". Per task, since two spawns can be on
// their way at once (a kernel task can start two programs in a row).
int ring3_title_base = 0;

// The current task's title, falling back to `fallback` when it has none (the
// built-in test, which has no filename to name a window after). The slot is
// emptied first, so the title is the caller's alone even if the task is
// stopped right after.
int ring3_title_take(int fallback) {
    if (!ring3_title_base) { return fallback; }
    int t = load64(ring3_title_base + sched_current * 8);
    if (!t) { return fallback; }
    store64(ring3_title_base + sched_current * 8, 0);
    return t;
}

void ring3_title_clear() {
    if (ring3_title_base) { store64(ring3_title_base + sched_current * 8, 0); }
    return;
}

// When `windowed` is 1 and the windowing layer is active (kakel_active),
// the process gets its own dedicated kakel window (via kakel_split) before
// entering ring 3, and all SYS_DEBUG_PRINT output routes to that window
// instead of wherever the shell happens to be focused. start and SYS_SPAWN
// use this so a ring-3 process's output appears in its own tile alongside
// the shell. run3/run3 (file) pass windowed=0 (blocks the calling task,
// no separate window needed -- the shell IS the output surface).
void run_ring3_binary(int code, int code_len, int windowed) {
    if (code_len > 4096) {
        serial_print("[ring3] binary too large\n");
        return;
    }
    int code_page = pmm_alloc_page();
    if (!code_page) { serial_print("[ring3] no code page\n"); return; }
    int stack_page = pmm_alloc_page();
    if (!stack_page) { serial_print("[ring3] no stack page\n"); return; }

    serial_print("[ring3] loading ");
    serial_print_int(code_len);
    serial_print(" bytes\n");

    // Copy the code into the physical page. This runs in kernel context
    // (CR3 still the kernel's own pml4_phys, which identity-maps all
    // physical RAM), so code_page works directly as a virtual address here
    // -- it is only once the process is actually running in ring 3 that its
    // code lives at USER_VIRT_BASE instead.
    int i = 0;
    for (i = 0; i < code_len; i += 1) {
        store8(code_page + i, load8(code + i));
    }

    // Patch the string address immediate if this is the built-in test binary.
    // The test binary has a mov edi, imm32 at offset 5; the immediate (4
    // bytes at offset 6) must be the VIRTUAL address the string will be read
    // at once running -- USER_VIRT_BASE + MSG_OFFSET, not the physical
    // code_page, since the ring-3 binary only ever sees USER_VIRT_BASE.
    if (code_len == RING3_TEST_LEN && load8(code) == 0xB8 && load8(code + 1) == 1) {
        int str_addr = USER_VIRT_BASE + RING3_TEST_MSG_OFF;
        int off = RING3_TEST_STRADDR_OFF;
        store32(code_page + off, str_addr);
    }

    int proc_pml4 = pt_create();
    map_page_user(proc_pml4, USER_VIRT_BASE, code_page);
    map_page_user_data(proc_pml4, USER_VIRT_BASE + 4096, stack_page);
    serial_print("[ring3] private pml4=");
    serial_print_int(proc_pml4);
    serial_print("\n");

    // Record this task's page-table root so a future preemption resumes it
    // on its own address space (see chrone.c0's task_cr3_base/sched_tick).
    int tid = sched_current;
    store64(task_cr3_base + tid * 8, proc_pml4);

    // When this is a windowed spawn, create a dedicated kakel window for the
    // process's output before dropping to ring 3. If kakel is not active
    // (VGA fallback) or the layout is full, kakel_split returns -1 and we
    // fall back to the existing behaviour (output goes wherever sk_putc
    // routes it -- the shell's focus or the full-screen framebuffer).
    if (windowed == 1 && kakel_active == 1) {
        int wid = kakel_split();
        store64(task_win_base + tid * 8, wid);
        if (wid >= 0) {
            kakel_tavla_claim(wid, tid, ring3_title_take("ring3"));
            // kakel_tavla_claim reflows, which clears every visible window --
            // including the prompts in the ones this spawn did not touch.
            shell_reprompt_after_spawn(wid);
            serial_print("[ring3] windowed spawn wid=");
            serial_print_int(wid);
            serial_print("\n");
        }
    }
    ring3_title_clear();

    int kstack = load64(task_stack_base + tid * 8);
    int fn = enter_ring3;
    fn(USER_VIRT_BASE, USER_VIRT_BASE + 4096 + 4096, kstack + TASK_STACK_SIZE, proc_pml4);
    serial_print("[ring3] ERROR: returned from enter_ring3\n");
    return;
}

// Built-in ring-3 test, sys_debug_print("hello from ring 3\n", 18) + sys_exit(0).
// The string address is patched at runtime (load time) by c0 code, since the
// binary does not know its final load address until run_ring3_binary allocates
// the code page.
// Binary layout
//   0-1:   mov eax, imm32 (syscall number)
//   5-9:   mov edi, imm32 (string address — patched at load time)
//   10-14: mov esi, imm32 (string length)
//   15-16: syscall
//   ... same for sys_exit
//   ... msg bytes

int RING3_TEST_LEN = 48;
int ring3_test_code() {
    int p = elf_scratch;
    int i = 0;
    for (i = 0; i < RING3_TEST_LEN; i += 1) { store8(p + i, 0); }

    // sys_debug_print(msg, 18)
    store8(p+0,0xB8);store8(p+1,0x01);store8(p+2,0x00);store8(p+3,0x00);store8(p+4,0x00);
    // mov edi, <placeholder> — patched to code_page+29 at load time
    store8(p+5,0xBF);store8(p+6,0x00);store8(p+7,0x00);store8(p+8,0x00);store8(p+9,0x00);
    store8(p+10,0xBE);store8(p+11,0x12);store8(p+12,0x00);store8(p+13,0x00);store8(p+14,0x00);
    store8(p+15,0x0F);store8(p+16,0x05);

    // sys_exit(0)
    store8(p+17,0xB8);store8(p+18,0x00);store8(p+19,0x00);store8(p+20,0x00);store8(p+21,0x00);
    store8(p+22,0x31);store8(p+23,0xFF);
    store8(p+24,0x0F);store8(p+25,0x05);
    store8(p+26,0xF4);

    // msg at offset 27, "hello from ring 3\n" (18 bytes)
    store8(p+27,'h');store8(p+28,'e');store8(p+29,'l');store8(p+30,'l');store8(p+31,'o');
    store8(p+32,' ');store8(p+33,'f');store8(p+34,'r');store8(p+35,'o');store8(p+36,'m');
    store8(p+37,' ');store8(p+38,'r');store8(p+39,'i');store8(p+40,'n');store8(p+41,'g');
    store8(p+42,' ');store8(p+43,'3');store8(p+44,'\n');
    return p;
}

// Offset within the binary where the string address immediate is stored.
int RING3_TEST_STRADDR_OFF = 6;
int RING3_TEST_MSG_OFF = 27;
int RING3_TEST_MSG_LEN = 18;

void run_ring3_test() {
    int code = ring3_test_code();
    run_ring3_binary(code, RING3_TEST_LEN, 0);
}

// --- ELF64 loader ---------------------------------------------------------
// Loads a real ELF64 executable (parsed from an in-memory buffer, e.g. read
// from a jakel file) into a process's own private address space, instead of
// the single hand-crafted flat binary above. Deliberately minimal, with no
// dynamic linking, no relocations, no section headers -- just the ELF
// header and PT_LOAD program headers, which is everything a static,
// position-independent-free executable actually needs to run. Adding more
// (a real .bss, multiple segments with different permissions, dynamic
// symbols) is a later problem, once something actually needs it -- same
// "do not pre-build a general format, follow real friction" discipline c0's
// own feature growth has always used.

// Writes a little-endian 32-bit immediate at `addr`, factored out here
// since the ELF test binary below needs it for several fields.
void store_imm32_le(int addr, int v) {
    store32(addr, v);
}

// Checks the ELF64 magic, class (64-bit), endianness (little), type
// (ET_EXEC -- statically linked, fixed load address, no PT_INTERP/dynamic
// linker support here), and machine (x86-64). Anything else is rejected
// outright rather than partially loaded.
int elf_validate(int buf, int len) {
    if (len < 64) { return 0; }
    if (load8(buf + 0) != 0x7F) { return 0; }
    if (load8(buf + 1) != 'E') { return 0; }
    if (load8(buf + 2) != 'L') { return 0; }
    if (load8(buf + 3) != 'F') { return 0; }
    if (load8(buf + 4) != 2) { return 0; } // EI_CLASS is ELFCLASS64
    if (load8(buf + 5) != 1) { return 0; } // EI_DATA is ELFDATA2LSB
    int e_type = load8(buf + 16) + load8(buf + 17) * 256;
    if (e_type != 2) { return 0; } // ET_EXEC
    int e_machine = load8(buf + 18) + load8(buf + 19) * 256;
    if (e_machine != 62) { return 0; } // EM_X86_64
    return 1;
}

// Set by elf_load to the first unused page-aligned virtual address right
// after the highest PT_LOAD segment it mapped -- run_elf_binary places the
// process's stack there, so it can never collide with the program's own
// code/data regardless of how many segments or how large they are.
int elf_next_free_virt = 0;

// Maps every PT_LOAD segment of a validated ELF64 image already resident in
// kernel memory at `buf` (length `len`) into `pml4`'s private address
// space, page by page. Each page gets a fresh physical frame, zeroed (so
// any part of the page beyond p_filesz -- a real .bss -- reads as zero
// exactly like a real loader's demand-zero pages), then whatever slice of
// [p_offset, p_offset+p_filesz) falls within that page is copied in before
// the page is mapped user-accessible. Returns the entry point (e_entry) on
// success, 0 if the image fails validation.
int elf_load(int pml4, int buf, int len) {
    if (elf_validate(buf, len) == 0) { return 0; }
    int e_entry = load64(buf + 24);
    int e_phoff = load64(buf + 32);
    int e_phentsize = load8(buf + 54) + load8(buf + 55) * 256;
    int e_phnum = load8(buf + 56) + load8(buf + 57) * 256;

    elf_next_free_virt = 0;
    int i = 0;
    for (i = 0; i < e_phnum; i += 1) {
        int ph = buf + e_phoff + i * e_phentsize;
        int p_type = load32(ph);
        if (p_type == 1) { // PT_LOAD
            int p_offset = load64(ph + 8);
            int p_vaddr  = load64(ph + 16);
            int p_filesz = load64(ph + 32);
            int p_memsz  = load64(ph + 40);
            // What the segment may do. Code that may not be written, data
            // that may not be run, and an image of one segment that is both
            // is mapped as both.
            int p_flags  = load32(ph + 4);
            int run_it = (p_flags & 1) == 1;
            int write_it = (p_flags & 2) == 2;

            int seg_start = (p_vaddr / 4096) * 4096;
            int seg_end = ((p_vaddr + p_memsz + 4095) / 4096) * 4096;
            if (seg_end > elf_next_free_virt) { elf_next_free_virt = seg_end; }

            int page = 0;
            for (page = seg_start; page < seg_end; page += 4096) {
                int frame = pmm_alloc_page();
                zero_page(frame);
                // The part of this page the file supplies, the rest stays zero.
                int lo = page;
                if (lo < p_vaddr) { lo = p_vaddr; }
                int hi = page + 4096;
                if (hi > p_vaddr + p_filesz) { hi = p_vaddr + p_filesz; }
                if (hi > lo) {
                    mem_copy(frame + (lo - page), buf + p_offset + (lo - p_vaddr), hi - lo);
                }
                if (run_it && write_it) {
                    map_page_user(pml4, page, frame);
                } else if (run_it) {
                    map_page_user(pml4, page, frame);
                    int leaf = pt_leaf(pml4, page);
                    if (leaf) { store64(leaf, frame | 5); }
                } else {
                    map_page_user_data(pml4, page, frame);
                }
            }
        }
    }
    return e_entry;
}

// Parses and runs a real ELF64 executable in ring 3, the same per-process-
// isolated way run_ring3_binary runs the hand-crafted flat binary, with its own
// pt_create()'d address space, its own task_cr3_base entry, its own kernel
// stack. The stack page is placed at elf_next_free_virt (set by elf_load),
// guaranteed clear of every loaded segment. Right after the stack, every
// process also gets a fixed-size, eagerly-mapped heap region (HEAP_PAGES
// pages) for SYS_ALLOC to bump-allocate from -- eager rather than demand-
// paged, matching this codebase's general preference for the simpler
// option until real need (a program that actually needs more than
// HEAP_PAGES worth) forces something more sophisticated.
//
// When `windowed` is 1 and the windowing layer is active, the process gets
// its own dedicated kakel window -- same semantics as run_ring3_binary's
// windowed parameter (see its comment).
// 32MB per ring-3 process (see SYS_ALLOC and lager.c0). coff compiling
// its own source on Moonshot peaks at about 13MB. A scrolling game has
// a camera, so every pixel of the view moves every frame and an incremental
// bounding-box redraw buys nothing. It has to composite a whole frame and
// present it in one blit, and a full tavla-sized frame is ~1.5MB on its own.
//
// A program that wants to survive its window being resized has to size its
// frame buffer for the LARGEST window it could ever be given -- ~2.97MB at
// 1024x768 -- because there is no realloc to grow it with. That leaves a game
// about 29MB for everything else. This is address space plus one-off mapping work, not a standing
// cost per process beyond what each actually allocates.
int HEAP_PAGES = 8192;

// Pages of stack every ring-3 program gets, 64KB.
int USER_STACK_PAGES = 16;

// The largest ELF image run3/start will load, checked in skalman (before it
// copies the file) and here. 256KB leaves room for utsikt, which carries
// image drawing, with headroom. The image is copied into
// the kernel heap while it loads, which is the one real cost, 256KB of the
// 1MB, briefly. File contents do not live in that heap at all (see
// jakel_arena_init).
int ELF_MAX_BYTES = 262144;
void run_elf_binary(int code, int code_len, int windowed) {
    // ELF_MAX_BYTES (above). kmalloc sizes the caller's buffer to the real
    // file size, and elf_load's PT_LOAD mapping loop handles multi-page
    // images, so the cap is only a sanity limit, sized with generous
    // headroom past the largest program rather than exactly to it, the same
    // way coff's source-read buffer and jenna's ring-3 heap are sized.
    //
    // `code` is the caller's kmalloc'd copy of the file, and it is freed here
    // once elf_load has copied it into the program's own pages. Kept, it
    // would cost the kernel heap a whole image per start, and after a few
    // dozen starts no program would load at all.
    if (code_len > ELF_MAX_BYTES) {
        serial_print("[elf] image too large\n");
        spawn_image_release(code);
        kfree(code);
        return;
    }
    int proc_pml4 = pt_create();
    int entry = elf_load(proc_pml4, code, code_len);
    spawn_image_release(code);
    kfree(code);
    if (!entry) {
        serial_print("[elf] invalid ELF64 image\n");
        return;
    }

    // One page above the image stays unmapped, so a stack that runs off its
    // bottom touches nothing of the program's own.
    int stack_virt = elf_next_free_virt + 4096;
    int sp_i = 0;
    for (sp_i = 0; sp_i < USER_STACK_PAGES; sp_i += 1) {
        int stack_page = pmm_alloc_page();
        if (!stack_page) { serial_print("[elf] no stack page\n"); return; }
        zero_page(stack_page);
        map_page_user_data(proc_pml4, stack_virt + sp_i * 4096, stack_page);
    }
    int stack_top = stack_virt + USER_STACK_PAGES * 4096;

    int heap_virt = stack_top;
    // The heap region is RESERVED here, not mapped. Pages are attached by
    // SYS_ALLOC as the program actually asks for memory -- see there.
    //
    // Mapping it eagerly would cost every spawn the whole HEAP_PAGES of
    // physical memory whether the program used a byte of it or not, and the
    // kernel only identity-maps the low IDMAP_PAGES worth, so a few ring-3
    // processes in a boot would run off the end of it. Programs that allocate
    // nothing cost nothing, and HEAP_PAGES is a ceiling rather than a price.

    serial_print("[elf] loaded, entry=");
    serial_print_int(entry);
    serial_print(" stack=");
    serial_print_int(stack_virt);
    serial_print(" heap=");
    serial_print_int(heap_virt);
    serial_print(" pml4=");
    serial_print_int(proc_pml4);
    serial_print("\n");

    int tid = sched_current;
    store64(task_cr3_base + tid * 8, proc_pml4);
    store64(task_heap_next_base + tid * 8, heap_virt);
    store64(task_heap_mapped_base + tid * 8, heap_virt);
    store64(task_heap_end_base + tid * 8, heap_virt + HEAP_PAGES * 4096);
    lager_place(tid, heap_virt + HEAP_PAGES * 4096);
    fd_reset(tid);

    if (windowed >= 1 && kakel_active == 1) {
        // kakel_split refuses (returns -1) when the visible layout is full,
        // and the process then runs unwindowed with its output going to
        // whichever window has focus. Say so, rather than leaving the user to
        // wonder why the fourth game did not get a tile of its own -- and see
        // the note in kakel_split about slots being consumed even when the
        // layout cannot show them.
        int wid = kakel_split();
        store64(task_win_base + tid * 8, wid);
        if (wid < 0) {
            int lost = ring3_title_take(0);
            if (lost) { kfree(lost); }
            serial_print("[elf] no window available, running unwindowed\n");
            sk_print("start: no free window, close one first\n");
        }
        if (wid >= 0) {
            kakel_tavla_claim(wid, tid, ring3_title_take("elf"));
            if (windowed == 2) { kakel_focus_to(wid); }
            shell_reprompt_after_spawn(wid);
            serial_print("[elf] windowed spawn wid=");
            serial_print_int(wid);
            serial_print("\n");
        }
    }
    ring3_title_clear();

    int kstack = load64(task_stack_base + tid * 8);
    int fn = enter_ring3;
    fn(entry, stack_top, kstack + TASK_STACK_SIZE, proc_pml4);
    serial_print("[elf] ERROR: returned from enter_ring3\n");
    return;
}

// --- spawnelf runs an ELF binary as an independent task -------------------
// What spawn_program hands the task it starts, a record of SPAWN_REC bytes
// in the task's slot of spawn_rec_base, the task's entry point taking no
// arguments. The ELF image, its length, the arguments block (see chrone.c0),
// the directory relative paths start from, windowed (0 the focused window, 1
// one of its own), focus, and the window's title. Per task, since a kernel
// task calling spawn_program twice in a row can be preempted before the
// first task has read what it was given.
//
// The record stays in the slot, owning the image, until run_elf_binary is
// done with it, and the arguments and the title leave it as they are moved
// to where the task keeps them. So a task stopped part of the way through
// starting leaves the reaper (spawn_slot_drop) whatever it still had. Each
// field is emptied before it is stored elsewhere, so a stop between the two
// loses it rather than freeing it twice.
int SPAWN_REC = 56;
int spawn_rec_base = 0;

// run_elf_binary has copied `code` into the program's pages and is about to
// free it. The current task's record, if code is its image, has nothing
// left to own and goes.
void spawn_image_release(int code) {
    if (!spawn_rec_base) { return; }
    int me = sched_current;
    int rec = load64(spawn_rec_base + me * 8);
    if (!rec || load64(rec) != code) { return; }
    store64(spawn_rec_base + me * 8, 0);
    kfree(rec);
    return;
}
// 0 when the next spawn_program should run its program in the window that
// has the focus instead of one of its own. Read once, then back to 1.
int spawn_next_windowed = 1;
// 1 when the next spawn_program's window should take the focus, as an
// editor opened from the shell or hylla does. start leaves the focus where
// it is. Read once, then back to 0.
int spawn_next_focus = 0;
// 1 when the next spawn_program's program should print to the serial line
// only (task_quiet). Read once, then back to 0.
int spawn_next_quiet = 0;

// Opens `args` in the editor program `prog` (its path and a space, such as
// "/skrift.elf "), in a window of its own that takes the focus. `cwd` is
// where a relative path starts from. Returns the editor's task id, or
// spawn_program's negative answer.
int editor_open(int cwd, int prog, int args) {
    int np = 0;
    while (load8(prog + np) != 0) { np += 1; }
    int n = 0;
    while (load8(args + n) != 0) { n += 1; }
    int line = kmalloc(np + n + 1);
    if (!line) { return 0 - 5; }
    int i = 0;
    for (i = 0; i < np; i += 1) { store8(line + i, load8(prog + i)); }
    for (i = 0; i <= n; i += 1) { store8(line + np + i, load8(args + i)); }
    spawn_next_focus = 1;
    int tid = spawn_program(cwd, line);
    spawn_next_focus = 0;
    kfree(line);
    return tid;
}

// Starts the program a command line names, in a task and a window of its
// own, the way the shell's start does, with the rest of the line as its
// arguments. `cwd` is the directory the name is found from. Returns the new
// task's id, or -1 for an empty line, -2 when there is no such file, -3
// when it is not a file, -4 when it is empty or too large to load, -5 when
// the task table is full, -6 when it is not an ELF program. start and
// SYS_SPAWN both come here.
// A window's title for the program at `path`, its last name without
// ".elf", kmalloc'd.
int elf_title(int path) {
    int start = 0;
    int n = 0;
    while (load8(path + n) != 0) {
        if (load8(path + n) == '/') { start = n + 1; }
        n += 1;
    }
    int len = n - start;
    if (len > 4 && load8(path + n - 4) == '.' && load8(path + n - 3) == 'e'
        && load8(path + n - 2) == 'l' && load8(path + n - 1) == 'f') {
        len -= 4;
    }
    int t = kmalloc(len + 1);
    if (!t) { return 0; }
    int i = 0;
    for (i = 0; i < len; i += 1) { store8(t + i, load8(path + start + i)); }
    store8(t + len, 0);
    return t;
}

int spawn_program(int cwd, int line) {
    int args = sk_args_block(line);
    if (!args) { return 0 - 1; }
    int name = args + 8;    // the first word, NUL-terminated
    int fid = jakel_open(cwd, name);
    if (fid < 0) { kfree(args); return 0 - 2; }
    if (load64(jakel_type_base + fid * 8) != JAKEL_TYPE_FILE) { kfree(args); return 0 - 3; }
    int fsize = load64(jakel_size_base + fid * 8);
    if (fsize == 0 || fsize > ELF_MAX_BYTES) { kfree(args); return 0 - 4; }
    int buf = kmalloc(fsize);
    if (!buf) { kfree(args); return 0 - 4; }
    int task_nm = 0;
    jakel_read(fid, 0, buf, fsize);
    if (fsize < 4 || load8(buf) != 0x7F || load8(buf + 1) != 'E'
        || load8(buf + 2) != 'L' || load8(buf + 3) != 'F') {
        kfree(buf);
        kfree(args);
        return 0 - 6;
    }
    if (!spawn_rec_base) {
        int rb = kmalloc(MAX_TASKS * 8);
        int tb = kmalloc(MAX_TASKS * 8);
        if (!rb || !tb) { kfree(buf); kfree(args); return 0 - 5; }
        int ri = 0;
        for (ri = 0; ri < MAX_TASKS; ri += 1) {
            store64(rb + ri * 8, 0);
            store64(tb + ri * 8, 0);
        }
        ring3_title_base = tb;
        spawn_rec_base = rb;
    }
    int rec = kmalloc(SPAWN_REC);
    if (!rec) { kfree(buf); kfree(args); return 0 - 4; }
    store64(rec, buf);
    store64(rec + 8, fsize);
    store64(rec + 16, args);
    store64(rec + 24, cwd);
    store64(rec + 32, spawn_next_windowed);
    spawn_next_windowed = 1;
    store64(rec + 40, spawn_next_focus);
    spawn_next_focus = 0;
    int quiet = spawn_next_quiet;
    spawn_next_quiet = 0;
    // Name the tavla after the file. An owned copy, not `name` itself, since
    // the caller's line is gone long before the spawned task reaches
    // kakel_tavla_claim.
    if (load8(name) == '/') { task_nm = sk_strdup(name + 1); }
    else { task_nm = sk_strdup(name); }
    store64(rec + 48, elf_title(name));
    int tid = task_spawn(spawn_elf_entry);
    // The task waits for this before it does anything.
    if (tid >= 0) { store64(spawn_rec_base + tid * 8, rec); }
    // Set for every spawn, so a slot never keeps the last program's choice.
    // The task has not run yet, this is still the caller's syscall.
    if (tid >= 0) {
        task_set_quiet(tid, quiet);
        task_info_reset(tid);
        if (task_name_base) { store64(task_name_base + tid * 8, task_nm); }
        if (task_parent_base) { store64(task_parent_base + tid * 8, sched_current); }
    } else if (task_nm) {
        kfree(task_nm);
    }
    if (tid < 0) {
        if (load64(rec + 48)) { kfree(load64(rec + 48)); }
        kfree(rec);
        kfree(buf);
        kfree(args);
        return 0 - 5;
    }
    return tid;
}

// For the reaper. A task stopped before it took its record, or before its
// window took the title, leaves them in its slot, and the next task there
// must not find them.
void spawn_slot_drop(int tid) {
    if (spawn_rec_base) {
        int rec = load64(spawn_rec_base + tid * 8);
        if (rec) {
            if (load64(rec)) { kfree(load64(rec)); }
            if (load64(rec + 16)) { kfree(load64(rec + 16)); }
            if (load64(rec + 48)) { kfree(load64(rec + 48)); }
            kfree(rec);
            store64(spawn_rec_base + tid * 8, 0);
        }
    }
    if (ring3_title_base) {
        int t = load64(ring3_title_base + tid * 8);
        if (t) { kfree(t); }
        store64(ring3_title_base + tid * 8, 0);
    }
    return;
}

void spawn_elf_entry() {
    // A task spawned from a kernel task can run before spawn_program has
    // stored its record, so it waits for it.
    int me = sched_current;
    while (load64(spawn_rec_base + me * 8) == 0) { cpu_wait(); }
    int rec = load64(spawn_rec_base + me * 8);
    int code = load64(rec);
    int len  = load64(rec + 8);
    int win  = load64(rec + 32);
    int focus = load64(rec + 40);
    int cwd = load64(rec + 24);
    int args = load64(rec + 16);
    store64(rec + 16, 0);
    store64(task_args_base + me * 8, args);
    int title = load64(rec + 48);
    store64(rec + 48, 0);
    store64(ring3_title_base + me * 8, title);
    if (!task_cwd_base) {
        task_cwd_base = kmalloc(MAX_TASKS * 8);
        int ci = 0;
        for (ci = 0; ci < MAX_TASKS; ci += 1) { store64(task_cwd_base + ci * 8, 0); }
    }
    store64(task_cwd_base + me * 8, cwd);
    task_set_end(me, 3, 0);
    if (focus == 1 && win == 1) { win = 2; }
    run_elf_binary(code, len, win);
    // run_elf_binary only comes back when the program could not be started
    // (not an ELF it can load, no memory), and a task's entry point has
    // nowhere to return to.
    task_exit();
}

// Hand-built minimal ELF64 executable, a 64-byte ELF header, one 56-byte
// PT_LOAD program header, then the same sys_debug_print+sys_exit machine
// code run_ring3_binary's built-in test uses -- except every address here
// is a compile-time-known constant (USER_VIRT_BASE plus a fixed file
// layout), so nothing needs load-time patching the way the flat binary's
// string address does. Seeded onto the filesystem in jakel_init (jakel.c0)
// as hello.elf, the same "demo file for testing" role demo.c0 plays for the
// REPL -- this is genuinely parsed by elf_load, not a shortcut.
int ELF_TEST_HDR_LEN = 120;   // 64-byte ELF header + one 56-byte phdr
int ELF_TEST_CODE_LEN = 42;   // 27 bytes of instructions + 15-byte message
int ELF_TEST_LEN = 162;       // ELF_TEST_HDR_LEN + ELF_TEST_CODE_LEN

int elf_test_code() {
    int p = elf_scratch;
    int i = 0;
    for (i = 0; i < ELF_TEST_LEN; i += 1) { store8(p + i, 0); }

    int entry = USER_VIRT_BASE + ELF_TEST_HDR_LEN;
    int msg_addr = entry + 27;

    // --- ELF header (e_ident, then the fixed-layout fields) ---
    store8(p+0, 0x7F); store8(p+1, 'E'); store8(p+2, 'L'); store8(p+3, 'F');
    store8(p+4, 2);  // ELFCLASS64
    store8(p+5, 1);  // ELFDATA2LSB
    store8(p+6, 1);  // EV_CURRENT
    store8(p+7, 0);  // ELFOSABI_SYSV (bytes 7-15 stay zero, OSABI/ABIVERSION/padding)
    store8(p+16, 2); store8(p+17, 0);   // e_type = ET_EXEC
    store8(p+18, 62); store8(p+19, 0);  // e_machine = EM_X86_64
    store_imm32_le(p+20, 1);            // e_version = EV_CURRENT
    store64(p+24, entry);               // e_entry
    store64(p+32, 64);                  // e_phoff (right after this header)
    store64(p+40, 0);                   // e_shoff (no section headers)
    store_imm32_le(p+48, 0);            // e_flags
    store8(p+52, 64); store8(p+53, 0);  // e_ehsize
    store8(p+54, 56); store8(p+55, 0);  // e_phentsize
    store8(p+56, 1); store8(p+57, 0);   // e_phnum = 1
    store8(p+58, 0); store8(p+59, 0);   // e_shentsize
    store8(p+60, 0); store8(p+61, 0);   // e_shnum
    store8(p+62, 0); store8(p+63, 0);   // e_shstrndx

    // --- Program header (PT_LOAD, offset 64) ---
    store_imm32_le(p+64, 1);            // p_type = PT_LOAD
    store_imm32_le(p+68, 5);            // p_flags = PF_R | PF_X
    store64(p+72, 0);                   // p_offset -- load the whole file
    store64(p+80, USER_VIRT_BASE);      // p_vaddr
    store64(p+88, USER_VIRT_BASE);      // p_paddr (unused)
    store64(p+96, ELF_TEST_LEN);        // p_filesz
    store64(p+104, ELF_TEST_LEN);       // p_memsz (no bss)
    store64(p+112, 4096);               // p_align

    // --- Code, at file offset 120 / virtual address `entry` ---
    int c = p + ELF_TEST_HDR_LEN;
    store8(c+0, 0xB8); store_imm32_le(c+1, SYS_DEBUG_PRINT); // mov eax, 1
    store8(c+5, 0xBF); store_imm32_le(c+6, msg_addr);        // mov edi, msg_addr
    store8(c+10, 0xBE); store_imm32_le(c+11, 15);            // mov esi, 15
    store8(c+15, 0x0F); store8(c+16, 0x05);                  // syscall
    store8(c+17, 0xB8); store_imm32_le(c+18, SYS_EXIT);      // mov eax, 0
    store8(c+22, 0x31); store8(c+23, 0xFF);                  // xor edi, edi
    store8(c+24, 0x0F); store8(c+25, 0x05);                  // syscall
    store8(c+26, 0xF4);                                       // hlt (safety)

    // msg at code+27 (=entry+27=msg_addr) is "hello from elf\n" (15 bytes)
    store8(c+27,'h');store8(c+28,'e');store8(c+29,'l');store8(c+30,'l');store8(c+31,'o');
    store8(c+32,' ');store8(c+33,'f');store8(c+34,'r');store8(c+35,'o');store8(c+36,'m');
    store8(c+37,' ');store8(c+38,'e');store8(c+39,'l');store8(c+40,'f');store8(c+41,'\n');

    return p;
}
