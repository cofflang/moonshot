//
// expect: 49
// Started as `start test/etNN.elf write`, writes the malformed ELF corpus
// verify_elf_corpus.sh starts, test/m01.elf to test/m49.elf, and returns how
// many it wrote. Moonshot cannot receive a file from the host, so the corpus
// is made here, on the machine, and every file in it comes from this source
// and nothing else. Started any other way, as verify_elf_backend.sh starts
// it, it builds every image the same way and writes none, since jakel's 128
// nodes are nearly all taken by then, and returns how many it built.
//
// Each case is a working program with one thing wrong. The program is a
// header, its program headers and 13 bytes of code that exit with 77, so an
// image the loader should have refused and did not shows up on serial as
// exit code 77 rather than as nothing. m45 to m47 are the other way round,
// unusual layouts that are valid and must still load and exit with 77. The
// table of cases, with the finding each one stands for, is in
// verify_elf_corpus.sh.
//
// Started as `start test/etNN.elf pages` it writes nothing and returns the
// number of free physical pages instead, the measure the test takes before
// and after the corpus to see that refused images give back what they took.
//
// Started as `start test/etNN.elf spawn 2 3 17` it starts test/m02.elf,
// test/m03.elf and test/m17.elf through SYS_SPAWN, one at a time, waiting
// for each to end, and returns how many of them ran to an exit code of
// their own, plus 100 for each that SYS_SPAWN did not start at all. For
// cases the loader must refuse that is 0.
include "moon.c0";

int BASE = 0x80000000;
int IMG = 0;

void put16(int a, int v) {
    store8(a, v & 255);
    store8(a + 1, (v >> 8) & 255);
}

void put32(int a, int v) {
    put16(a, v & 65535);
    put16(a + 2, (v >> 16) & 65535);
}

void clear(int n) {
    int i = 0;
    for (i = 0; i < n; i += 1) { store8(IMG + i, 0); }
}

// The ELF header of a static x86-64 executable with `phnum` program headers
// right after it.
void header(int phnum, int entry) {
    store8(IMG, 0x7F);
    store8(IMG + 1, 'E');
    store8(IMG + 2, 'L');
    store8(IMG + 3, 'F');
    store8(IMG + 4, 2);
    store8(IMG + 5, 1);
    store8(IMG + 6, 1);
    put16(IMG + 16, 2);
    put16(IMG + 18, 62);
    put32(IMG + 20, 1);
    store64(IMG + 24, entry);
    store64(IMG + 32, 64);
    put16(IMG + 52, 64);
    put16(IMG + 54, 56);
    put16(IMG + 56, phnum);
}

void phdr(int i, int flags, int off, int vaddr, int filesz, int memsz) {
    int p = IMG + 64 + i * 56;
    put32(p, 1);
    put32(p + 4, flags);
    store64(p + 8, off);
    store64(p + 16, vaddr);
    store64(p + 24, vaddr);
    store64(p + 32, filesz);
    store64(p + 40, memsz);
    store64(p + 48, 4096);
}

// mov eax, 0 (exit), mov edi, 77, syscall, hlt.
void payload(int at) {
    int c = IMG + at;
    store8(c, 0xB8);
    put32(c + 1, 0);
    store8(c + 5, 0xBF);
    put32(c + 6, 77);
    store8(c + 10, 0x0F);
    store8(c + 11, 0x05);
    store8(c + 12, 0xF4);
}

// One segment over the whole file at BASE, entry at the code. 133 bytes.
int ONE = 133;
void one_segment() {
    clear(ONE);
    header(1, BASE + 120);
    phdr(0, 5, 0, BASE, ONE, ONE);
    payload(120);
}

// The same with a second program header, which each case fills in. The
// first segment still covers the whole file. 189 bytes.
int TWO = 189;
void two_segments() {
    clear(TWO);
    header(2, BASE + 176);
    phdr(0, 5, 0, BASE, TWO, TWO);
    payload(176);
}

// One segment that is writable as well as executable (p_flags 7), whose
// code writes the exit code into its own next instruction before running
// it. mov byte [rip + 6], 77, then the exit with edi 0 that the store turns
// into 77. A loader that maps the segment RWX lets it exit with 77, one that
// maps it without write stops it with a page fault. 140 bytes.
int RWX = 140;
void rwx_segment() {
    clear(RWX);
    header(1, BASE + 120);
    phdr(0, 7, 0, BASE, RWX, RWX);
    int c = IMG + 120;
    store8(c, 0xC6);
    store8(c + 1, 0x05);
    put32(c + 2, 6);
    store8(c + 6, 77);
    payload(127);
    put32(IMG + 127 + 6, 0);
}

int written = 0;
int name = 0;
int out = 0;

void save(int n, int len) {
    if (!out) { written += 1; return; }
    int i = 0;
    int s = "test/m00.elf";
    for (i = 0; i < 13; i += 1) { store8(name + i, load8(s + i)); }
    store8(name + 6, '0' + n / 10);
    store8(name + 7, '0' + n % 10);
    if (writefile(name, IMG, len) == len) { written += 1; }
}

int same(int a, int b) {
    int i = 0;
    while (load8(a + i) != 0 || load8(b + i) != 0) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i += 1;
    }
    return 1;
}

// The number the string at `s` spells in decimal.
int number(int s) {
    int v = 0;
    int i = 0;
    while (load8(s + i) >= '0' && load8(s + i) <= '9') {
        v = v * 10 + load8(s + i) - '0';
        i += 1;
    }
    return v;
}

// Starts each case the arguments after "spawn" name, as described above.
int spawn_cases() {
    int line = alloc(16);
    if (!line) { return 1000; }
    int s = "test/m00.elf";
    int bad = 0;
    int a = 2;
    for (a = 2; a < argc(); a += 1) {
        int n = number(argv(a));
        int i = 0;
        for (i = 0; i < 13; i += 1) { store8(line + i, load8(s + i)); }
        store8(line + 6, '0' + n / 10);
        store8(line + 7, '0' + n % 10);
        int tid = spawn_with(line, 1);
        if (tid < 0) {
            bad += 100;
        } else if (wait_for(tid, 1500) != 0 - 1000) {
            bad += 1;
        }
        // The reaper takes an ended task on a later tick, and until then its
        // slot and stack are not there for the next spawn.
        sleep(5);
    }
    return bad;
}

int main() {
    if (argc() >= 2 && same(argv(1), "pages") == 1) {
        int b = alloc(128);
        sysinfo(0, b, 128);
        return load64(b + 24);
    }
    if (argc() >= 2 && same(argv(1), "spawn") == 1) { return spawn_cases(); }
    if (argc() >= 2 && same(argv(1), "write") == 1) { out = 1; }
    IMG = alloc(262145);
    name = alloc(16);
    if (!IMG || !name) { return 0; }

    // m01 not an ELF at all, the shell refuses it before the loader.
    one_segment(); store8(IMG, '#'); store8(IMG + 1, '!'); save(1, ONE);
    // m02 the four magic bytes and nothing else.
    one_segment(); save(2, 4);
    // m03 a valid image cut one byte short of its own ELF header.
    one_segment(); save(3, 63);
    // m04 ELFCLASS32.
    one_segment(); store8(IMG + 4, 1); save(4, ONE);
    // m05 big-endian.
    one_segment(); store8(IMG + 5, 2); save(5, ONE);
    // m06 ET_DYN.
    one_segment(); put16(IMG + 16, 3); save(6, ONE);
    // m07 EM_386.
    one_segment(); put16(IMG + 18, 3); save(7, ONE);
    // m08 identification version 0.
    one_segment(); store8(IMG + 6, 0); save(8, ONE);
    // m09 a 52-byte ELF header size, the 32-bit one.
    one_segment(); put16(IMG + 52, 52); save(9, ONE);
    // m10 no program headers.
    one_segment(); put16(IMG + 56, 0); save(10, ONE);
    // m11 program header stride 0, one header.
    one_segment(); put16(IMG + 54, 0); save(11, ONE);
    // m12 stride 0 and 4096 headers, the same one read 4096 times (E-03).
    one_segment(); put16(IMG + 54, 0); put16(IMG + 56, 4096); save(12, ONE);
    // m13 a stride of 32, shorter than a program header.
    one_segment(); put16(IMG + 54, 32); save(13, ONE);
    // m14 the program header table a megabyte past the end (F-02).
    one_segment(); store64(IMG + 32, 1000000); save(14, ONE);
    // m15 a negative program header offset (F-02).
    one_segment(); store64(IMG + 32, 0 - 64); save(15, ONE);
    // m16 one program header more than the file holds (F-02).
    one_segment(); put16(IMG + 56, 2); save(16, ONE);
    // m17 a segment below the user range, entry in it (F-01).
    one_segment(); header(1, 0x7F000000 + 120); phdr(0, 5, 0, 0x7F000000, ONE, ONE); save(17, ONE);
    // m18 a segment over the kernel's identity map (F-01).
    one_segment(); header(1, 0x100000 + 120); phdr(0, 5, 0, 0x100000, ONE, ONE); save(18, ONE);
    // m19 p_vaddr -4096 (F-01, E-01).
    one_segment(); header(1, 0 - 4096 + 120); phdr(0, 5, 0, 0 - 4096, ONE, ONE); save(19, ONE);
    // m20 a segment in the kernel half, 0xFFFF800000000000 (F-01).
    int kh = 0 - 0x800000000000;
    one_segment(); header(1, kh + 120); phdr(0, 5, 0, kh, ONE, ONE); save(20, ONE);
    // m21 the whole last canonical page, 0x7FFFFFFFF000, a segment that ends
    // exactly at the canonical boundary 0x800000000000.
    one_segment(); header(1, 0x7FFFFFFFF000 + 120); phdr(0, 5, 0, 0x7FFFFFFFF000, ONE, 4096); save(21, ONE);
    // m22 a non-canonical segment, 0x800000000000.
    one_segment(); header(1, 0x800000000000 + 120); phdr(0, 5, 0, 0x800000000000, ONE, ONE); save(22, ONE);
    // m23 the same program header twice (E-03).
    two_segments(); phdr(1, 5, 0, BASE, TWO, TWO); save(23, TWO);
    // m24 two segments with distinct bytes in the same page (E-03).
    two_segments(); phdr(1, 6, 0, BASE + 2048, 0, 16); save(24, TWO);
    // m25 two segments overlapping in their second page (E-03).
    two_segments(); phdr(0, 5, 0, BASE, TWO, 8192); phdr(1, 6, 0, BASE + 4096, 0, 4096); save(25, TWO);
    // m26 one byte over the largest image start takes.
    one_segment(); save(26, 262145);
    // m27 a 256MB bss, more than the machine has (F-02).
    one_segment(); phdr(0, 5, 0, BASE, ONE, 0x10000000); save(27, ONE);
    // m28 a second segment of 0x7FFFFFFFFFFFF000 bytes (E-01).
    two_segments(); phdr(1, 6, 0, BASE + 0x10000, 0, 0x7FFFFFFFFFFFF000); save(28, TWO);
    // m29 a second segment of -4096 bytes (E-01).
    two_segments(); phdr(1, 6, 0, BASE + 0x10000, 0, 0 - 4096); save(29, TWO);
    // m30 a second segment whose end fits and whose page rounding wraps (E-01).
    int top = 0x7FFFFFFFFFFFFFFF;
    two_segments(); phdr(1, 6, 0, BASE + 0x10000, 0, top - (BASE + 0x10000) - 100); save(30, TWO);
    // m31 p_filesz larger than p_memsz, the entry inside p_memsz and the
    // code running on past it, so only the p_filesz check refuses it (F-02).
    one_segment(); phdr(0, 5, 0, BASE, ONE, 128); save(31, ONE);
    // m32 p_offset a megabyte past the end (F-02).
    one_segment(); phdr(0, 5, 1000000, BASE, ONE, ONE); save(32, ONE);
    // m33 p_filesz one byte past the end of the file (F-02).
    one_segment(); phdr(0, 5, 0, BASE, ONE + 1, ONE + 1); save(33, ONE);
    // m34 p_offset -64 (F-02).
    one_segment(); phdr(0, 5, 0 - 64, BASE, ONE, ONE); save(34, ONE);
    // m35 entry 0x0001000000000000, not canonical (E-02).
    one_segment(); store64(IMG + 24, 0x0001000000000000); save(35, ONE);
    // m36 entry 0x0000800000000000, the first non-canonical address (E-02).
    one_segment(); store64(IMG + 24, 0x800000000000); save(36, ONE);
    // m37 entry in the kernel half, 0xFFFF800000000000 (E-02).
    one_segment(); store64(IMG + 24, kh); save(37, ONE);
    // m38 entry in user space no segment covers (E-02).
    one_segment(); store64(IMG + 24, 0x90000000); save(38, ONE);
    // m39 entry in a segment that is not executable (E-02).
    one_segment(); phdr(0, 6, 0, BASE, ONE, ONE); save(39, ONE);
    // m40 entry one byte past the end of its segment (E-02).
    one_segment(); store64(IMG + 24, BASE + ONE); save(40, ONE);
    // m41 e_version 0.
    one_segment(); put32(IMG + 20, 0); save(41, ONE);
    // m42 a bss segment of no file bytes whose p_offset is a megabyte past
    // the end, file bounds hold for it too (F-02).
    two_segments(); phdr(1, 6, 1000000, BASE + 0x10000, 0, 4096); save(42, TWO);
    // m43 a segment 16MB under the top of the user range, too high for the
    // stack, heap and block table that go above it (F-01).
    int high = 0x7FFFFF000000;
    one_segment(); header(1, high + 120); phdr(0, 5, 0, high, ONE, ONE); save(43, ONE);
    // m44 a segment 16MB under 4GB, under the tables the kernel shares for
    // the framebuffer at 0xFD000000, with its heap running on past 4GB into
    // the ones it shares there (F-01).
    one_segment(); header(1, 0xFF000000 + 120); phdr(0, 5, 0, 0xFF000000, ONE, ONE); save(44, ONE);
    // m45 valid, a second segment of bss only, 8192 bytes of memory and no
    // file bytes.
    two_segments(); phdr(1, 6, 0, BASE + 0x10000, 0, 8192); save(45, TWO);
    // m46 valid, a second segment of no memory at address 0, which maps
    // nothing.
    two_segments(); phdr(1, 6, 0, 0, 0, 0); save(46, TWO);
    // m47 valid, a program header stride of 64, longer than a header.
    one_segment(); put16(IMG + 54, 64); save(47, ONE);
    // m48 a segment 16MB under 3GB, in the process's own tables, whose heap
    // would run on past 3GB into the ones the kernel shares there for the
    // framebuffer (F-01).
    one_segment(); header(1, 0xBF000000 + 120); phdr(0, 5, 0, 0xBF000000, ONE, ONE); save(48, ONE);
    // m49 one segment both writable and executable, W^X.
    rwx_segment(); save(49, RWX);

    return written;
}
