//
// Packs the compiled ELF test programs into one file the kernel embeds.
//
//     bake pack <output.pack> <manifest> [<name> <source> <expect> <elf>]...
//
// The pack is what jakel_install_pack (jakel.c0) unpacks onto the
// filesystem at boot, as test/<name>.elf. All numbers are little-endian
// int64s.
//
//     0       the number of programs, N
//     8       N records, each:
//               +0   the name, up to 15 bytes, NUL-padded to 16
//               +16  the program's size in bytes, S
//               +24  the program, padded with zeros to a multiple of 8
//
// The manifest is what verify_elf_backend.sh reads to know what to spawn
// and what to expect, one line per program, name, source, expected exit code.
//
// One pack rather than one `embed` per test, because the kernel's sources
// have to compile before any program has been built (the bootstrap audit
// compiles them), so they cannot list the tests by name, and a test can be
// added or removed without touching the kernel.
//
// The programs themselves are embedded with `embed` straight from build/,
// so nothing generated is committed next to the kernel; this packing is
// what bake does.

int out = 0;       // the output, accumulated then written once
int outpos = 0;
int OUTCAP = 8388608;

void die(int msg) {
    print("bake: ");
    print(msg);
    print("\n");
    exit(1);
    return;
}

void put8(int b) {
    if (outpos >= OUTCAP) { die("output larger than the buffer"); }
    store8(out + outpos, b);
    outpos = outpos + 1;
    return;
}

void put64(int v) {
    int i = 0;
    while (i < 8) { put8(v & 255); v = v >> 8; i = i + 1; }
    return;
}

void puts_(int s) {
    int i = 0;
    while (load8(s + i) != 0) { put8(load8(s + i)); i = i + 1; }
    return;
}

int file_len = 0;

int read_file(int name) {
    int fd = open_read(name);
    int cap = 4194304;
    int buf = 0;
    int len = 0;
    int got = 0;
    if (fd < 0) { print("bake: cannot open "); print(name); print("\n"); exit(1); }
    buf = alloc(cap);
    got = read(fd, buf, cap);
    while (got > 0) {
        len = len + got;
        got = read(fd, buf + len, cap - len);
    }
    close(fd);
    if (len >= cap) { die("input larger than the read buffer"); }
    file_len = len;
    return buf;
}

void write_out(int path) {
    int fd = open_write(path);
    if (fd < 0) { print("bake: cannot write "); print(path); print("\n"); exit(1); }
    write(fd, out, outpos);
    close(fd);
    return;
}

int do_pack() {
    int count = (argc() - 4) / 4;
    if (count == 0) { die("no test programs given"); }
    if (argc() != 4 + count * 4) { die("arguments come in fours: name source expect elf"); }
    out = alloc(OUTCAP);

    put64(count);
    int i = 0;
    while (i < count) {
        int name = argv(4 + i * 4);
        int nl = 0;
        while (load8(name + nl) != 0) { nl = nl + 1; }
        if (nl > 15) { die("a test name is longer than 15 bytes"); }
        int k = 0;
        while (k < 16) {
            if (k < nl) { put8(load8(name + k)); } else { put8(0); }
            k = k + 1;
        }
        int data = read_file(argv(7 + i * 4));
        int n = file_len;
        put64(n);
        k = 0;
        while (k < n) { put8(load8(data + k)); k = k + 1; }
        while (k % 8 != 0) { put8(0); k = k + 1; }
        i = i + 1;
    }
    write_out(argv(2));

    outpos = 0;
    i = 0;
    while (i < count) {
        puts_(argv(4 + i * 4)); puts_(" ");
        puts_(argv(5 + i * 4)); puts_(" ");
        puts_(argv(6 + i * 4)); puts_("\n");
        i = i + 1;
    }
    write_out(argv(3));
    print("wrote ");
    print(argv(2));
    print("\n");
    return 0;
}

int streq(int a, int b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] != b[i]) { return 0; }
    return 1;
}

int main() {
    if (argc() >= 2 && streq(argv(1), "pack") == 1) { return do_pack(); }
    die("usage: bake pack <output.pack> <manifest> [<name> <source> <expect> <elf>]...");
    return 1;
}
