// jenna.c0 -- memory management, the physical-page allocator (a bump
// allocator with an intrusive LIFO free-list) and the 4-level page tables
// c0 builds and switches to.

// Paging. PRESENT_WRITE (0x3) is the present|writable flag pair every
// entry carries; since page frames are 4096-aligned the low 12 bits are
// pure flags. IDMAP_PAGES is a page *count*, not an address/flag, so it
// stays decimal (4096 * 4096 bytes = 16MB the c0-built tables
// identity-map -- ample for the kernel, its stack, every page-table
// frame, jenna's arena, and GRUB's own low-memory structures).
// SENTINEL_VIRT is a high virtual address deliberately ABOVE boot.s's 1GB
// identity map, mapped a second time to a sentinel page as a liveness
// proof (see paging_init) -- 4GB, hence 0x100000000. SENTINEL_VALUE stays
// decimal. It is an arbitrary human-recognizable magic number for
// eyeballing in the serial log, not a hardware-meaningful constant.
int PRESENT_WRITE = 0x3;
int IDMAP_PAGES = 4096;
// The identity map reaches as far as the memory jenna hands out, up to
// this ceiling (256MB). A smaller map than pmm's range would make every
// place that touches a frame by its physical address (zero_page when a
// ring-3 heap grows, for one) fault on the first frame above it. The ceiling
// keeps a machine with gigabytes from spending its boot building page
// tables, and pmm_limit is clamped to it so no frame is ever handed out that
// the kernel cannot reach.
int IDMAP_MAX_PAGES = 65536;
int SENTINEL_VIRT = 0x100000000;
int SENTINEL_VALUE = 1234567890;
int pml4_phys = 0;

// PRESENT_WRITE_USER additionally sets bit 2 (U/S) -- present|writable|user.
//
// USER_VIRT_BASE (2GB) is the private per-process virtual range every
// pt_create()'d address space gets. Two constraints pin it here.
//
// 1. It must be < 4GB. The existing ring-3 test binary (ring3_test_code)
//    passes its syscall string argument via `mov edi, imm32` -- a 32-bit
//    immediate, zero-extended into rdi -- so any virtual address at or
//    above 4GB is simply unrepresentable by it. 512GB (a PML4 index the
//    kernel never touches at all) would fault for
//    exactly this reason, since the patched immediate would truncate.
// 2. Since every representable address is < 4GB, it unavoidably falls
//    inside PML4 index 0 -- the SAME top-level entry the kernel's own 16MB
//    identity map lives in (one PML4 entry spans 512GB). So pt_create()
//    gives every process its own copy of the kernel's PDPT 0 and marks the
//    edge to that copy user-traversable. The entries copied into it still
//    point at the kernel's own tables, supervisor-only, and stay that way.
//    The CPU checks U/S at every level of a walk, so ring 3 reaches none of
//    the pages under them, and no mapper ever writes through such an entry
//    or raises its U bit (see pt_map).
//
// 2GB (PDPT index 2 of that copy) is chosen specifically clear of the
// kernel's actual populated ranges. The 16MB identity map (PDPT index 0),
// the framebuffer, the 4GB sentinel and the 5GB demand-paging test address.
// Only the fresh, process-private PD/PT chains map_page_user builds in
// slots the kernel left empty are ever actually user-accessible.
int PRESENT_WRITE_USER = 0x7;

// The physical address bits of a page-table entry. Bit 63 is NX, so an entry
// for a non-executable page is negative, and dividing it by 4096 would round
// the wrong way.
int PTE_ADDR = 0xFFFFFFFFFF000;
int USER_VIRT_BASE = 0x80000000;

// VIRT_LIMIT is 2^47, the end of the lower canonical half. No mapping is made
// at or above it. USER_TOP ends the user range one page short of it, so the
// last canonical page is never a user page.
int VIRT_LIMIT = 0x800000000000;
int USER_TOP = 0x7FFFFFFFF000;

// Demand-paging test (see page_fault_handler/knekt.c0's kernel_post_init).
// a virtual address deliberately left unmapped (5GB, hence 0x140000000 --
// above the 16MB identity map and the 4GB paging sentinel, so touching it
// is a guaranteed page fault), and the value the fault handler seeds the
// freshly-mapped page with so the recovered read is verifiable.
// FAULT_SENTINEL stays decimal for the same eyeballing reason as
// SENTINEL_VALUE above.
int boot_fault_authorized = 0;
int FAULT_TEST_VIRT = 0x140000000;
int FAULT_SENTINEL = 2020202020;

int pmm_start = 0;
int pmm_next = 0;
int pmm_limit = 0;
// Head of the intrusive free-list (0 = empty). Freed pages are linked
// through their own first 8 bytes, so no separate bookkeeping array is
// needed -- see pmm_free_page/pmm_alloc_page.
int pmm_free_head = 0;

// Tracks how many pages currently sit on the free list, for the on-screen
// status bar. Incremented by pmm_free_page, decremented by the free-list pop
// in pmm_alloc_page. Does NOT count pages that simply have not been bumped
// yet — those are "available" rather than "freed."
int pmm_free_count = 0;

// 1 while pt_selftest runs jenna dry on purpose, so pmm_alloc_page does not
// print the out-of-memory line that other tests read as a failure.
int pmm_quiet = 0;

// Walks the Multiboot memory map (a variable-length list of {size, addr,
// len, type} entries, `size` NOT counting itself -- next entry is at
// `entry + size + 4`) and picks the largest available (type 1) region that
// can actually hold something at-or-after kernel_end, as jenna's initial
// physical-memory arena. Prints every region regardless of type/fit, so
// the full map is visible over serial, not just whichever one got picked.
//
// addr/len are real 64-bit fields (unlike Multiboot's other u32 fields),
// so this uses load64 directly -- no load32 reconstruction needed here.
int hardware_map_count = 0;

void pmm_init(int mb_info) {
    int flags = load32(mb_info);
    // bit 6 of flags means mmap_addr/mmap_length valid. Same isolate-one-bit
    // arithmetic as the mem_lower/upper check in knekt.c0's main() (bit 0),
    // just shifted, so (flags/64) - (flags/128)*2 keeps only bit 6.
    int has_mmap = (flags / 64) - (flags / 128) * 2;
    if (has_mmap != 1) {
        serial_print("No memory map from bootloader\n");
        return;
    }

    int mmap_length = load32(mb_info + 44);
    int mmap_addr = load32(mb_info + 48);
    int entry = mmap_addr;
    int end = mmap_addr + mmap_length;

    serial_print("Memory map:\n");
    while (entry < end) {
        int size = load32(entry);
        int base = load64(entry + 4);
        int len = load64(entry + 12);
        int type = load32(entry + 20);

        serial_print("  base=");
        serial_print_int(base);
        serial_print(" len=");
        serial_print_int(len);
        serial_print(" type=");
        serial_print_int(type);
        serial_print("\n");

        if (hardware_map_count < 128) {
            int row = hardware_map + hardware_map_count * 24;
            store64(row, base); store64(row + 8, len); store64(row + 16, type);
            hardware_map_count += 1;
        }
        if (type == 1) {
            int region_start = base;
            if (region_start < _kernel_end) { region_start = _kernel_end; }
            // Round up to a 4096-byte page boundary (same no-bitwise-ops
            // idiom as everywhere else, only round up if not already
            // aligned, using the remainder from integer division).
            int rem = region_start % 4096;
            int aligned = region_start;
            if (rem != 0) { aligned = region_start + (4096 - rem); }
            int region_end = base + len;
            if (region_end > IDMAP_MAX_PAGES * 4096) { region_end = IDMAP_MAX_PAGES * 4096; }
            if (aligned + 4096 <= region_end
                    && region_end - aligned > pmm_limit - pmm_start) {
                pmm_start = aligned;
                pmm_next = aligned;
                pmm_limit = region_end;
            }
        }

        entry += size + 4;
    }

    serial_print("Allocator range: ");
    serial_print_int(pmm_start);
    serial_print(" .. ");
    serial_print_int(pmm_limit);
    serial_print("\n");
    return;
}

// Returns a 4096-byte physical page to the allocator by pushing it onto an
// intrusive free-list. The page is free, so its own first 8 bytes are ours
// to reuse as the link to the previous free-list head -- no separate
// bookkeeping array or bitmap needed. LIFO, so the most recently freed page
// is the next one handed back out (pmm_alloc_page pops from this same head).
void pmm_free_page(int addr) {
    store64(addr, pmm_free_head);
    pmm_free_head = addr;
    pmm_free_count += 1;
    return;
}

// Allocates one 4096-byte physical page. Checks the free-list first --
// popping the most recently freed page, whose stored link becomes the new
// head -- and only bumps the watermark upward through the region when the
// free-list is empty. This is what makes jenna a real allocator rather than
// a pure bump arena, since freed pages actually get reused. Returns 0 on true
// exhaustion (free-list empty AND the watermark has reached the region
// limit); a richer out-of-memory story (spanning multiple regions, eviction)
// is a later problem.
int pmm_alloc_page() {
    int p = pmm_free_head;
    if (p != 0) {
        pmm_free_head = load64(p);
        pmm_free_count -= 1;
        return p;
    }
    if (pmm_next + 4096 > pmm_limit) {
        if (!pmm_quiet) { serial_print("pmm: out of memory\n"); }
        return 0;
    }
    p = pmm_next;
    pmm_next += 4096;
    zero_page(p);
    return p;
}

// Allocates n physically contiguous pages from the top of pmm's range,
// never from the free list, whose pages can come from anywhere. Returns the
// first page, or 0 when the range is used up. Task stacks are the one thing
// that needs this (see task_spawn).
int pmm_alloc_run(int n) {
    if (pmm_next + n * 4096 > pmm_limit) {
        serial_print("pmm: out of memory\n");
        return 0;
    }
    int p = pmm_next;
    pmm_next += n * 4096;
    int i = 0;
    for (i = 0; i < n; i += 1) { zero_page(p + i * 4096); }
    return p;
}

// Returns the count of pages currently on the intrusive free list -- the
// pages that have been freed and can be reallocated. Does not include pages
// that simply have not been bumped past pmm_next yet (those are "available"
// rather than "freed"). pmm_available_pages counts both.
int pmm_free_pages() {
    return pmm_free_count;
}

// Every page that can still be handed out, the freed ones on the list plus
// the ones never bumped past yet. What the status bar calls free.
int pmm_available_pages() {
    return pmm_free_count + (pmm_limit - pmm_next) / 4096;
}

// Returns the total number of 4096-byte pages in the arena [pmm_start,
// pmm_limit). This is a compile-time constant for any given boot, since
// pmm_init carves one fixed region from the Multiboot memory map.
int pmm_total_pages() {
    return (pmm_limit - pmm_start) / 4096;
}

// Fresh PMM pages contain arbitrary RAM. Zero every page-table page before
// installing it, so its contents cannot be interpreted as present mappings
// to unrelated frames.
// Writes 512 zero quads (one 4096-byte page).
void zero_page(int addr) {
    int i = 0;
    for (i = 0; i < 512; i += 1) {
        store64(addr + i * 8, 0);
    }
    return;
}

// --- Kernel heap, kmalloc / kfree -------------------------------------
// The first thing in Moonshot that hands out sub-page, variable-size memory
// -- pmm_alloc_page only ever gives whole 4096-byte pages, which is too
// coarse the moment anything wants many small, differently-sized pieces
// (shell line/argument buffers now; a filesystem's nodes later). A plain
// first-fit allocator over one contiguous arena carved from jenna.
//
// Layout. The arena is a packed sequence of blocks, each an implicit-list
// node with a 16-byte header -- [block+0] = payload size in bytes,
// [block+8] = free flag (1 free / 0 used) -- immediately followed by its
// payload. The NEXT block always sits at (block + 16 + size), so no explicit
// next-pointer is stored, since the list is walked by address. That address-order
// walk is also what lets kfree coalesce neighbours (a separate free-list
// would throw away the adjacency information). Payloads stay 8-aligned
// because heap_start is page-aligned, the header is 16 bytes, and every
// requested size is rounded up to a multiple of 8.
// Callers use sizeof(HeapBlock) directly rather than a separate HEAP_HDR
// constant, so the header size cannot drift out of sync with this shape.
layout HeapBlock {
    int size;
    int free;
}
int heap_start = 0;
int heap_end = 0;

// Lays `num_pages` contiguous pages out of jenna as one big free block and
// returns the first page. MUST be called early, while pmm's free-list is
// still empty, so pmm_alloc_page takes its bump path and returns physically
// contiguous pages -- an arena's implicit list requires one unbroken address
// range. Contiguity is asserted, not assumed, and a loud serial warning fires if
// it ever stops holding. `who` names the arena in that warning.
int arena_carve(int num_pages, int who) {
    int first = pmm_alloc_page();
    if (!first) { jenna_stop("arena_carve: no pages at boot, halting\n"); }
    int expect = first + 4096;
    int i = 1;
    for (i = 1; i < num_pages; i += 1) {
        int pg = pmm_alloc_page();
        if (!pg) { jenna_stop("arena_carve: no pages at boot, halting\n"); }
        if (pg != expect) {
            serial_print(who);
            serial_print(": NON-CONTIGUOUS pmm page, arena broken\n");
        }
        expect += 4096;
    }
    int end = first + num_pages * 4096;
    first.size = end - first - sizeof(HeapBlock); // one big block...
    first.free = 1;                               // ...marked free
    return first;
}

// The kernel heap is one arena. jakel's file data is another (see
// jakel_arena_init), kept apart so a big file cannot starve the kernel.
void heap_init(int num_pages) {
    heap_start = arena_carve(num_pages, "heap_init");
    heap_end = heap_start + num_pages * 4096;
    return;
}

// Allocates `n` usable bytes (rounded up to 8), first-fit across the arena
// [start, end). When the chosen block is big enough to ALSO hold another
// header plus a minimal 8-byte payload, it splits, leaving the remainder as
// a smaller free block so the slack stays reusable instead of being lost to
// internal fragmentation. Returns the payload address, or 0 if nothing fits
// -- an arena is fixed in size.
int arena_alloc(int start, int end, int n) {
    if (n <= 0) { return 0; }
    n = ((n + 7) / 8) * 8;
    int b = start;
    while (b < end) {
        int size = b.size;
        int free = b.free;
        if (free == 1 && size >= n) {
            if (size >= n + sizeof(HeapBlock) + 8) {
                int rem = b + sizeof(HeapBlock) + n;
                rem.size = size - n - sizeof(HeapBlock);
                rem.free = 1;
                b.size = n;
            }
            b.free = 0;
            return b + sizeof(HeapBlock);
        }
        b += sizeof(HeapBlock) + size;
    }
    return 0;
}

// Returns 0 when the 1MB kernel heap has no room, and a number of callers
// never check, so running out is said here, where every one of them passes.
// Bytes handed out from the arena [start, end), blocks in use only.
int arena_used(int start, int end) {
    int used = 0;
    int b = start;
    while (b < end) {
        if (b.free != 1) { used += b.size + sizeof(HeapBlock); }
        b += sizeof(HeapBlock) + b.size;
    }
    return used;
}

int kmalloc(int n) {
    int p = arena_alloc(heap_start, heap_end, n);
    if (p == 0 && n > 0) {
        int sl = serial_line_begin();
        serial_print("[jenna] kmalloc: no room for ");
        serial_print_int(n);
        serial_print(" bytes in the kernel heap\n");
        serial_line_end(sl);
    }
    return p;
}

// Merges every run of adjacent free blocks into one, walking the arena once
// in address order. Called after each free so freed neighbours recombine
// into blocks big enough for later, larger requests -- without it, repeated
// split/free would ratchet the arena into ever-smaller unusable fragments.
// Absorbing a block deliberately does NOT advance the cursor, so a whole run
// of adjacent free blocks collapses in this single pass.
void arena_coalesce(int start, int end) {
    int b = start;
    while (b < end) {
        int size = b.size;
        int free = b.free;
        int nxt = b + sizeof(HeapBlock) + size;
        if (free == 1 && nxt < end && nxt.free == 1) {
            b.size = size + sizeof(HeapBlock) + nxt.size;
        } else {
            b = nxt;
        }
    }
    return;
}

void heap_coalesce() {
    arena_coalesce(heap_start, heap_end);
    return;
}

// Frees a block returned by arena_alloc -- its header sits just below the
// payload -- then coalesces. A null pointer is a safe no-op, same as
// free(NULL) in C. `who` prefixes the refusal messages below.
void arena_free(int start, int end, int ptr, int who) {
    if (!ptr) { return; }
    // Two guards, both of which exist because of one bug and the day it cost.
    //
    // The write below stores the number 1 eight bytes before `ptr`. If `ptr`
    // is not a pointer this allocator handed out, that store lands wherever
    // the bad value happens to point, and the symptom is a wrong value in
    // something entirely unrelated, later. The REPL freed a for loop's body
    // twice (see repl.c0's `layout Node`), and the second free read its
    // fields out of a header that coalescing had already overwritten -- so
    // the "pointers" it then freed were whatever those bytes now held. A
    // wild store of the number 1 is a very good way to turn -(5 + 3) into
    // -(5 + 1), which is -6, which is what the REPL once answered.
    //
    // Neither guard makes a double free correct. They make it LOUD. An
    // allocator that refuses a pointer it never handed out turns a silent
    // corruption at a distance into a line in the serial log naming the
    // caller's bad value, which is the difference between an afternoon and
    // a month.
    if (ptr < start + sizeof(HeapBlock) || ptr >= end) {
        int sl = serial_line_begin();
        serial_print_in(sl, who);
        serial_print(": pointer outside the heap, refusing: ");
        serial_print_int(ptr);
        serial_print("\n");
        serial_line_end(sl);
        return;
    }
    int b = ptr - sizeof(HeapBlock);
    if (b.free == 1) {
        int sl2 = serial_line_begin();
        serial_print_in(sl2, who);
        serial_print(": double free at ");
        serial_print_int(ptr);
        serial_print("\n");
        serial_line_end(sl2);
        return;
    }
    b.free = 1;
    arena_coalesce(start, end);
    return;
}

// 1 when `ptr` is a block of the kernel heap, so a caller holding either a
// kmalloc'd string or a constant one knows which it may free.
int kheap_owns(int ptr) {
    return ptr >= heap_start + sizeof(HeapBlock) && ptr < heap_end;
}

void kfree(int ptr) {
    arena_free(heap_start, heap_end, ptr, "[jenna] kfree");
    return;
}

// The index into the table at `level` (0 the PML4, 3 the page table) that
// the lower-half address `virt` selects, always 0..511.
int pt_index(int virt, int level) {
    return (virt >> (39 - level * 9)) & 511;
}

// 1 when the entry `e` of a process's table and the entry `ke` of the
// kernel's table at the same place in the tree both point at the same
// frame. That frame and everything under it belong to the kernel and are
// shared by every process. Only the frame address decides it, since the
// flags of the two entries can differ.
int pt_shared(int e, int ke) {
    return (e & 1) == 1 && (ke & 1) == 1 && (e & PTE_ADDR) == (ke & PTE_ADDR);
}

// Maps the 4096-byte page `virt` to the frame `phys` under the root `pml4`
// with the leaf flags `flags`, building any missing PDPT/PD/PT on the way.
// `user` 1 makes the path user-accessible. Returns 1, or 0 with the tree
// exactly as it was.
//
// What is checked before anything is written. `virt` is page-aligned and
// below VIRT_LIMIT, and a user page lies in [USER_VIRT_BASE, USER_TOP).
// `phys` is a nonzero aligned frame. Under a process's root it must be a
// frame jenna hands out, because pt_free gives every leaf of a process
// back to jenna. Only the kernel's own root takes borrowed frames, the
// identity map and the framebuffer at boot, and no user page goes there.
//
// The walk compares each entry of a process's table with the kernel's
// entry at the same place and refuses one that is shared, so a process
// mapping never writes into a kernel table. It also refuses a large page,
// and for a user page any entry without U, which keeps lager's
// supervisor-only block table out of a user mapping's reach. A leaf that is
// already present is refused rather than replaced, so its frame is never
// lost.
//
// Missing tables are allocated, zeroed and linked to each other first, and
// only then is the top one written into the tree. When an allocation fails
// the ones already taken go back and the tree is untouched.
int pt_map(int pml4, int virt, int phys, int flags, int user) {
    if (pml4 <= 0 || pml4 % 4096 != 0) { return 0; }
    if (virt < 0 || virt >= VIRT_LIMIT || virt % 4096 != 0) { return 0; }
    if (phys <= 0 || phys % 4096 != 0 || phys > PTE_ADDR) { return 0; }
    int own = pml4 != pml4_phys;
    if (own && (phys < pmm_start || phys >= pmm_limit)) { return 0; }
    if (user && (!own || virt < USER_VIRT_BASE || virt >= USER_TOP)) { return 0; }
    int dir = PRESENT_WRITE;
    if (user) { dir = PRESENT_WRITE_USER; }

    // `t` is this root's table at `level`, `k` the kernel's table at the
    // same place, or 0 where the kernel has none.
    int t = pml4;
    int k = 0;
    if (own) { k = pml4_phys; }
    int level = 0;
    while (level < 3) {
        int e = load64(t + pt_index(virt, level) * 8);
        if ((e & 1) == 0) { break; }
        if ((e & 128) != 0) { return 0; }
        int ke = 0;
        if (k) { ke = load64(k + pt_index(virt, level) * 8); }
        if (pt_shared(e, ke)) { return 0; }
        if (user && (e & 4) == 0) { return 0; }
        k = 0;
        if ((ke & 1) == 1 && (ke & 128) == 0) { k = ke & PTE_ADDR; }
        t = e & PTE_ADDR;
        level += 1;
    }

    if (level == 3) {
        int leaf = t + pt_index(virt, 3) * 8;
        if ((load64(leaf) & 1) == 1) { return 0; }
        store64(leaf, phys | flags);
        return 1;
    }

    // The tables for levels level+1 to 3, `a` the topmost.
    int need = 3 - level;
    int a = pmm_alloc_page();
    int b = 0;
    int c = 0;
    if (a && need >= 2) { b = pmm_alloc_page(); }
    if (b && need == 3) { c = pmm_alloc_page(); }
    if (!a || (need >= 2 && !b) || (need == 3 && !c)) {
        if (a) { pmm_free_page(a); }
        if (b) { pmm_free_page(b); }
        return 0;
    }
    zero_page(a);
    int bottom = a;
    if (b) {
        zero_page(b);
        store64(a + pt_index(virt, level + 1) * 8, b + dir);
        bottom = b;
    }
    if (c) {
        zero_page(c);
        store64(b + pt_index(virt, level + 2) * 8, c + dir);
        bottom = c;
    }
    store64(bottom + pt_index(virt, 3) * 8, phys | flags);
    store64(t + pt_index(virt, level) * 8, a + dir);
    return 1;
}

// Maps one 4096-byte virtual page `virt` to physical page `phys`, present
// and writable, supervisor-only. On the kernel's root this is a boot-time
// operation (the identity map, the sentinel, the framebuffer). On a
// process's root it maps private kernel data, lager's block table, which
// ring 3 never reaches. Returns 1, or 0 with nothing changed (see pt_map).
int map_page(int pml4, int virt, int phys) {
    return pt_map(pml4, virt, phys, PRESENT_WRITE, 0);
}

// Maps one 4096-byte virtual page as user-accessible (present|write|user at
// every level) in a process's own pt_create()'d root, inside the user range.
// Returns 1, or 0 with nothing changed (see pt_map).
int map_page_user(int pml4, int virt, int phys) {
    return pt_map(pml4, virt, phys, PRESENT_WRITE_USER, 1);
}

// map_page_user for a page that holds data, the heap and the stack, which is
// not executable (bit 63, NX). The only way to run code from one is
// SYS_PROTECT, which makes it read-only first.
int map_page_user_data(int pml4, int virt, int phys) {
    return pt_map(pml4, virt, phys, PRESENT_WRITE_USER | (1 << 63), 1);
}

// 1 when every page of [lo, hi) is in the user range and none of it lies
// under an entry the process root `pml4` shares with the kernel's root, so
// pt_map can map anything in it. 0 for an empty or reversed range. Only the
// PML4 and PDPT levels are looked at, since under a private PDPT entry the
// whole subtree is the process's own (pt_create, pt_map). The ELF loader
// asks this of every segment and of the stack, heap and block table it will
// place after them, before it maps a single page.
int pt_private_range(int pml4, int lo, int hi) {
    if (pml4 <= 0 || pml4 % 4096 != 0 || pml4 == pml4_phys) { return 0; }
    if (lo < USER_VIRT_BASE || lo >= hi || hi > USER_TOP) { return 0; }
    int top_i = 0;
    for (top_i = pt_index(lo, 0); top_i <= pt_index(hi - 1, 0); top_i += 1) {
        int e = load64(pml4 + top_i * 8);
        int ke = load64(pml4_phys + top_i * 8);
        if (pt_shared(e, ke)) { return 0; }
        if ((e & 1) == 1) {
            if ((e & 128) != 0 || (e & 4) == 0) { return 0; }
            int k = 0;
            if ((ke & 1) == 1 && (ke & 128) == 0) { k = ke & PTE_ADDR; }
            // The part of [lo, hi) under this PML4 entry, 512GB each.
            int a = top_i * 0x8000000000;
            int b = a + 0x8000000000;
            if (a < lo) { a = lo; }
            if (b > hi) { b = hi; }
            int j = 0;
            for (j = pt_index(a, 1); j <= pt_index(b - 1, 1); j += 1) {
                int e3 = load64((e & PTE_ADDR) + j * 8);
                int ke3 = 0;
                if (k) { ke3 = load64(k + j * 8); }
                if (pt_shared(e3, ke3)) { return 0; }
                if ((e3 & 1) == 1 && ((e3 & 128) != 0 || (e3 & 4) == 0)) { return 0; }
            }
        }
    }
    return 1;
}

// Creates a fresh, process-private PML4, or returns 0 when jenna has no
// pages left. Starts as a shallow copy of all 512 top-level entries from
// the kernel's own page tables (pml4_phys) BY VALUE -- every process shares
// the kernel's mappings (the 16MB identity map, the scratch buffers, IDT,
// dispatch, the heap, the 4GB sentinel) without re-walking or re-allocating
// a single frame for them, since copying a PML4 entry copies only a pointer
// to the existing PDPT frame, not its contents.
//
// PML4 index 0 then gets special treatment, and this is NOT optional the
// way it might look. USER_VIRT_BASE has to sit under 4GB (see its own
// comment), which puts it inside this exact same index 0 the kernel's
// identity map lives in. A plain pointer copy, like every other index gets,
// would leave every process sharing the SAME physical PDPT frame for index
// 0 -- meaning USER_VIRT_BASE's own PDPT slot underneath it would be shared
// too, not private. So index 0 gets its own private PDPT frame here, seeded
// with the SAME 512 entries the kernel's PDPT has (so the identity map,
// sentinel, and fault-test region all stay reachable from the kernel) except
// for USER_VIRT_BASE's own slot, deliberately left absent so map_page_user
// builds a fresh, PRIVATE PD/PT chain there -- once per process, not once
// ever. The edge to that private PDPT is user-traversable. The kernel's
// entries copied into it are not, and pt_map never changes them.
int pt_create() {
    int new_pml4 = pmm_alloc_page();
    if (!new_pml4) { return 0; }
    int priv_pdpt0 = pmm_alloc_page();
    if (!priv_pdpt0) {
        pmm_free_page(new_pml4);
        return 0;
    }
    int i = 0;
    for (i = 0; i < 512; i += 1) {
        store64(new_pml4 + i * 8, load64(pml4_phys + i * 8));
    }

    int kernel_pdpt0 = load64(pml4_phys) & PTE_ADDR;
    int j = 0;
    for (j = 0; j < 512; j += 1) {
        store64(priv_pdpt0 + j * 8, load64(kernel_pdpt0 + j * 8));
    }
    store64(priv_pdpt0 + pt_index(USER_VIRT_BASE, 1) * 8, 0);
    store64(new_pml4, priv_pdpt0 + PRESENT_WRITE_USER);
    return new_pml4;
}

// The address of the 4K leaf entry that maps `virt` under `pml4`, or 0 when
// a level on the way is missing or maps a large page instead.
int pt_leaf(int pml4, int virt) {
    int page = virt >> 12;
    int t = pml4;
    int shift = 27;
    int level = 0;
    for (level = 0; level < 3; level += 1) {
        int e = load64(t + ((page >> shift) & 511) * 8);
        if ((e & 1) == 0 || (e & 128) != 0) { return 0; }
        t = e & PTE_ADDR;
        shift -= 9;
    }
    int leaf = t + (page & 511) * 8;
    if ((load64(leaf) & 1) == 0) { return 0; }
    return leaf;
}

// Gives back everything private under the table `t` at `level` of a
// process's tree, children before the tables that hold them. `k` is the
// kernel's table at the same place, or 0. An entry shared with it is the
// kernel's and is skipped whole. A leaf outside jenna's range, or a large
// page, cannot have been made by pt_map, so it is reported and kept rather
// than handed to jenna as a free page. Returns how many pages went back.
int pt_free_level(int t, int k, int level) {
    int freed = 0;
    int i = 0;
    for (i = 0; i < 512; i += 1) {
        int e = load64(t + i * 8);
        int ke = 0;
        if (k) { ke = load64(k + i * 8); }
        if ((e & 1) == 1 && !pt_shared(e, ke)) {
            int f = e & PTE_ADDR;
            if (level < 3 && (e & 128) == 0) {
                int nk = 0;
                if ((ke & 1) == 1 && (ke & 128) == 0) { nk = ke & PTE_ADDR; }
                freed += pt_free_level(f, nk, level + 1);
                pmm_free_page(f);
                freed += 1;
            } else if (level == 3 && f >= pmm_start && f < pmm_limit) {
                pmm_free_page(f);
                freed += 1;
            } else {
                int sl = serial_line_begin();
                serial_print("[jenna] pt_free: kept a frame it does not own, ");
                serial_print_int(f);
                serial_print("\n");
                serial_line_end(sl);
            }
        }
    }
    return freed;
}

// Gives back everything private to an address space pt_create built. Every
// one of the 512 PML4 slots is walked, not only slot 0, so a page mapped
// anywhere in the process's range comes back. The frames the user range
// maps (code, stack, heap, all of them the process's own), lager's table,
// the page tables above them, its own copy of PDPT 0 and the PML4 itself.
// Entries that point where the kernel's do are the kernel's and stay. The
// caller must not be running on this address space. Returns how many
// pages went back to pmm.
int pt_free(int pml4) {
    if (pml4 == 0 || pml4 == pml4_phys) { return 0; }
    int freed = pt_free_level(pml4, pml4_phys, 0);
    pmm_free_page(pml4);
    return freed + 1;
}

// Stops the machine for good. Only for the kernel's own tables, at boot or
// in a fault taken by kernel code, where no smaller thing can be given up.
// A process that cannot be built gets an error instead (see pt_create).
void jenna_stop(int why) {
    serial_print(why);
    while (1) { halt(); }
    return;
}

// Builds a fresh 4-level page table (4KB granularity) entirely from
// jenna-allocated frames. Identity-maps the low physical memory the kernel
// actually runs on (its code/data/stack, every fixed hand-off slot, all the
// page-table frames allocated right here, and jenna's arena -- all well
// under 16MB), deliberately re-creating at 4KB granularity what boot.s set
// up statically with 2MB pages. The point is not a different map, it is that
// from here on the kernel runs on tables IT built dynamically from
// allocated frames -- the foundation every later VM feature (higher-half
// kernel, per-process spaces, on-demand mapping) needs.
//
// Physical page 0 is left out, so a null pointer in kernel code faults
// instead of reading or writing whatever lies at address 0, and
// page_fault_handler never maps it back. Nothing in the kernel keeps data in
// that page. The fixed hand-off slots start at 1MB (see linker.ld), and the
// Multiboot structures GRUB leaves are read by main() before boot.s loads
// these tables.
//
// The kernel's own tables must be whole before boot.s loads them, so a
// frame that cannot be had or mapped here stops the machine, before CR3 is
// ever pointed at a half-built tree.
void paging_init() {
    pml4_phys = pmm_alloc_page();
    if (!pml4_phys) { jenna_stop("Paging: no page for the PML4, halting\n"); }
    zero_page(pml4_phys);

    int pages = pmm_limit / 4096;
    if (pages > IDMAP_MAX_PAGES) {
        pages = IDMAP_MAX_PAGES;
        pmm_limit = pages * 4096;
    }
    if (pages < IDMAP_PAGES) { pages = IDMAP_PAGES; }
    int i = 0;
    for (i = 1; i < pages; i += 1) {
        int p = i * 4096;
        if (!map_page(pml4_phys, p, p)) {
            jenna_stop("Paging: identity map could not be built, halting\n");
        }
    }
    serial_print("Paging: identity map covers ");
    serial_print_int(pages * 4);
    serial_print(" KB\n");

    // Liveness proof. Stash a sentinel in a fresh physical page, then map
    // that page a SECOND time at a high virtual address boot.s's 1GB
    // identity map does not cover. If paging_verify() (run by boot.s right
    // after it switches CR3) can read the sentinel back through
    // SENTINEL_VIRT, the CPU is provably using THESE tables -- a read
    // through 4GB would fault on boot.s's map.
    int sentinel_phys = pmm_alloc_page();
    if (!sentinel_phys) { jenna_stop("Paging: no page for the sentinel, halting\n"); }
    store64(sentinel_phys, SENTINEL_VALUE);
    if (!map_page(pml4_phys, SENTINEL_VIRT, sentinel_phys)) {
        jenna_stop("Paging: sentinel could not be mapped, halting\n");
    }

    // Hand the new PML4's physical address to boot.s, which does the actual
    // `mov cr3` (c0 cannot execute it) -- same fixed-slot technique as the
    // IDTR. See linker.ld's .cr3info.
    store64(CR3INFO_ADDR, pml4_phys);

    serial_print("Paging: built c0 page tables, PML4 at ");
    serial_print_int(pml4_phys);
    serial_print("\n");
    return;
}

// Called from boot.s immediately after it loads CR3 with the c0-built PML4.
// Reads the sentinel back through the high virtual address that only exists
// in these tables, so returning without faulting AND matching the value proves
// the switch to c0-built paging is live. boot.s runs this before enabling
// interrupts, so nothing else is competing for the serial port.
void paging_verify() {
    int v = load64(SENTINEL_VIRT);
    if (v == SENTINEL_VALUE) {
        serial_print("Paging: live on c0 tables (sentinel via 4GB OK)\n");
    } else {
        serial_print("Paging: sentinel mismatch\n");
    }
    return;
}

// Installed at IDT vector 14 (see knekt.c0's main) and reached through the
// shared ISR trampoline + dispatch table like any other handler. This is a
// RECOVERING handler, not a panic. It demand-maps the faulting page and
// returns, so the instruction that faulted re-executes and succeeds. `cr2`
// is the faulting linear address (read off CR2 by boot.s's isr_common and
// handed in); `errcode` is the CPU's page-fault error code. The page is
// aligned down to a 4KB boundary, backed by a fresh zeroed frame from
// jenna, seeded with FAULT_SENTINEL so the recovered read is independently
// verifiable, and mapped into the live c0 page tables (pml4_phys). No
// explicit TLB flush is needed, since x86 never caches a non-present translation,
// so the re-walk after iretq sees the new entry. A real kernel would
// consult a VMA list to decide map-vs-kill here; this always-map path
// proves the fault path and recovery mechanics that any real demand-paging
// policy would build on.
void page_fault_handler(int vector, int errcode, int cr2, int rip) {
    serial_print("page fault: addr=");
    serial_print_int(cr2);
    serial_print(" errcode=");
    serial_print_int(errcode);
    serial_print("\n");
    int page_base = cr2 - (cr2 & 4095);

    // A ring-3 program has no demand paging, its pages are all mapped when
    // it is loaded or asks for memory. So any fault it takes is a bad
    // address of its own, and it ends the program, not the machine. The
    // demand paging below maps into the kernel's tables, which would not
    // even help a program running on its own.
    if (sched_kill_faulted(vector, errcode, cr2, rip) == 1) { return; }

    int cr = read_cr3;
    int site = boot_fault_probe_site;
    if (boot_fault_authorized == 1 && page_base == FAULT_TEST_VIRT
            && rip == site && (cr() & PTE_ADDR) == pml4_phys && errcode == 0) {
        boot_fault_authorized = 0;
        int frame = pmm_alloc_page();
        if (!frame) { jenna_stop("page fault: no page to map, halting\n"); }
        zero_page(frame);
        store64(frame, FAULT_SENTINEL);
        if (!map_page(pml4_phys, page_base, frame)) {
            pmm_free_page(frame);
            jenna_stop("page fault: address cannot be mapped, halting\n");
        }
        return;
    }
    jenna_stop("KERNEL PANIC: unguarded kernel page fault\n");
    return;
}

// --- Boot checks of the page-table builders --------------------------------
// Run by kernel_post_init on a kernel booted with `test` (see grub_test.cfg),
// after the demand-paging probe and before any process exists, with
// interrupts still off. Each check prints one "[jenna] check" line that
// tests/test_page_tables.sh reads, ending in ok or FAIL.

// What pt_check_walk found in the kernel's tree. Entries with U set above
// the leaves and in the leaves, and a fingerprint of every present entry.
// The fingerprint leaves out the accessed and dirty bits (5 and 6), which
// the CPU sets on its own as the kernel runs.
int pt_check_dir_u = 0;
int pt_check_leaf_u = 0;
int pt_check_sum = 0;

void pt_check_walk(int t, int level) {
    int i = 0;
    for (i = 0; i < 512; i += 1) {
        int e = load64(t + i * 8);
        if ((e & 1) == 1) {
            pt_check_sum = pt_check_sum * 31 + (e - (e & 0x60)) + i;
            if (level < 3) {
                if ((e & 4) != 0) { pt_check_dir_u += 1; }
                if ((e & 128) == 0) { pt_check_walk(e & PTE_ADDR, level + 1); }
            } else if ((e & 4) != 0) {
                pt_check_leaf_u += 1;
            }
        }
    }
    return;
}

// Walks the whole kernel tree, the identity map over 0..16MB and every
// subtree a process inherits, the framebuffer, the sentinel and the probe.
void pt_check_tree() {
    pt_check_dir_u = 0;
    pt_check_leaf_u = 0;
    pt_check_sum = 0;
    pt_check_walk(pml4_phys, 0);
    return;
}

void pt_check_end(int ok) {
    if (ok) { serial_print(" ok\n"); } else { serial_print(" FAIL\n"); }
    return;
}

// Every address a process must not get is refused, the kernel's tree is the
// same entry for entry afterwards with no U bit anywhere in it, a duplicate
// leaf keeps its first frame, lager-style supervisor tables refuse a user
// page, and pt_free gives back exactly what the root took.
void pt_check_refusals() {
    pt_check_tree();
    int sum0 = pt_check_sum;
    int avail0 = pmm_available_pages();
    int root = pt_create();
    int f = pmm_alloc_page();
    int g = pmm_alloc_page();
    int h = pmm_alloc_page();
    if (!root || !f || !g || !h) {
        serial_print("[jenna] check refusals, no pages FAIL\n");
        return;
    }
    int wrong = 0;
    wrong += map_page_user(root, 0x200000, 0x200000);
    wrong += map_page_user(root, 0x1000000000000, f);
    wrong += map_page_user(root, 0 - 4096, f);
    wrong += map_page_user(root, USER_VIRT_BASE + 8, f);
    wrong += map_page_user(root, USER_TOP, f);
    wrong += map_page_user(root, 0x7F000000, f);
    wrong += map_page_user(root, SENTINEL_VIRT, f);
    wrong += map_page_user(root, FAULT_TEST_VIRT, f);
    wrong += map_page_user(root, USER_VIRT_BASE, 0);
    wrong += map_page_user(pml4_phys, USER_VIRT_BASE, f);
    wrong += map_page(root, 0x200000, f);
    wrong += map_page(root, SENTINEL_VIRT + 4096, f);
    wrong += map_page(root, USER_VIRT_BASE, 0x100000);

    int good = map_page_user(root, USER_VIRT_BASE, f);
    wrong += map_page_user(root, USER_VIRT_BASE, g);
    int leaf = pt_leaf(root, USER_VIRT_BASE);
    int kept = leaf != 0 && (load64(leaf) & PTE_ADDR) == f;
    good = good && map_page(root, USER_VIRT_BASE + 0x400000, h);
    wrong += map_page_user(root, USER_VIRT_BASE + 0x401000, g);
    pmm_free_page(g);

    pt_check_tree();
    int same = pt_check_sum == sum0;
    int freed = pt_free(root);
    int avail1 = pmm_available_pages();

    serial_print("[jenna] check refusals wrongly mapped=");
    serial_print_int(wrong);
    serial_print(" kernel U dirs=");
    serial_print_int(pt_check_dir_u);
    serial_print(" leaves=");
    serial_print_int(pt_check_leaf_u);
    serial_print(" tree same=");
    serial_print_int(same);
    serial_print(" first frame kept=");
    serial_print_int(kept);
    serial_print(" freed=");
    serial_print_int(freed);
    serial_print(" pages before=");
    serial_print_int(avail0);
    serial_print(" after=");
    serial_print_int(avail1);
    pt_check_end(wrong == 0 && good && kept && same && pt_check_dir_u == 0
        && pt_check_leaf_u == 0 && avail0 == avail1);
    return;
}

// A page mapped under PML4 slot 1, outside the slot pt_create copies, comes
// back with its tables when the root is freed.
void pt_check_reclaim() {
    int before = pmm_available_pages();
    int root = pt_create();
    int f = pmm_alloc_page();
    int mapped = 0;
    if (root && f) { mapped = map_page_user(root, 0x8000000000, f); }
    if (!mapped && f) { pmm_free_page(f); }
    int freed = 0;
    if (root) { freed = pt_free(root); }
    int after = pmm_available_pages();
    serial_print("[jenna] check reclaim at 0x8000000000 mapped=");
    serial_print_int(mapped);
    serial_print(" freed=");
    serial_print_int(freed);
    serial_print(" pages before=");
    serial_print_int(before);
    serial_print(" after=");
    serial_print_int(after);
    pt_check_end(mapped && before == after);
    return;
}

// With jenna run dry, free list and all, pt_create returns 0 and writes
// nothing at physical page 0. With one page left it gives that page back
// when the second allocation fails, and a mapping that needs three new
// tables fails with the tree and the page count as they were.
//
// Page 0 is not mapped, so it is looked at through the sentinel's address,
// whose leaf points at frame 0 for the length of this check only.
void pt_check_exhaustion() {
    int leaf = pt_leaf(pml4_phys, SENTINEL_VIRT);
    int pr = pt_create();
    int pf = pmm_alloc_page();
    if (!leaf || !pr || !pf) {
        serial_print("[jenna] check exhaustion, no pages FAIL\n");
        return;
    }
    int flush = flush_tlb;
    int saved_leaf = load64(leaf);
    store64(leaf, PRESENT_WRITE);
    flush();
    int saved0 = load64(SENTINEL_VIRT);
    int mark = 3141592653;
    store64(SENTINEL_VIRT, mark);

    int head = pmm_free_head;
    int count = pmm_free_count;
    int limit = pmm_limit;
    int next = pmm_next;
    pmm_quiet = 1;
    pmm_free_head = 0;
    pmm_free_count = 0;

    pmm_limit = pmm_next;
    int r0 = pt_create();
    int marker = load64(SENTINEL_VIRT) == mark;

    pmm_limit = pmm_next + 4096;
    int r1 = pt_create();
    int one_back = pmm_available_pages() == 1;
    int r2 = map_page_user(pr, 0x8000000000, pf);
    int still_one = pmm_available_pages() == 1;
    int slot_empty = load64(pr + 8) == 0;

    // Every page the check took came back, so jenna is put back exactly.
    // Otherwise what was lost stays lost and the line says FAIL.
    if (pmm_free_count == (pmm_next - next) / 4096) { pmm_next = next; }
    pmm_free_head = head;
    pmm_free_count = count;
    pmm_limit = limit;
    pmm_quiet = 0;

    store64(SENTINEL_VIRT, saved0);
    store64(leaf, saved_leaf);
    flush();
    if (!r2) { pmm_free_page(pf); }
    pt_free(pr);

    serial_print("[jenna] check exhaustion pt_create with none=");
    serial_print_int(r0);
    serial_print(" marker kept=");
    serial_print_int(marker);
    serial_print(" with one=");
    serial_print_int(r1);
    serial_print(" page back=");
    serial_print_int(one_back);
    serial_print(" map with one=");
    serial_print_int(r2);
    serial_print(" page back=");
    serial_print_int(still_one);
    serial_print(" slot empty=");
    serial_print_int(slot_empty);
    pt_check_end(r0 == 0 && marker && r1 == 0 && one_back && r2 == 0
        && still_one && slot_empty);
    return;
}

void pt_selftest() {
    pt_check_refusals();
    pt_check_reclaim();
    pt_check_exhaustion();
    return;
}
