// kakel.c0 -- the windowing layer (Swedish for "tile", a fixed set of
// non-overlapping rectangular regions tiling the screen). This is NOT a
// window manager yet -- no overlap, no z-order, no dragging or resizing, no
// borders (a tavla's title strip is the one piece of window decoration that
// exists), and no clicking to focus. klick tracks a mouse pointer, but
// nothing reacts to it yet. What it genuinely adds over punkt's single
// full-screen terminal
// are the two mechanics a real windowing layer is built from, CLIPPING
// (each window's text wraps and scrolls inside its own rectangle, never
// touching a neighbour's pixels) and MULTIPLE SIMULTANEOUS CURSOR STATES
// (each window keeps its own cursor position; punkt's fb_row/fb_col were
// screen-global). Input goes to whichever window has FOCUS, cycled from
// the keyboard (Alt+Tab -- see keyboard.c0); the focused window's cursor
// is drawn bright, unfocused ones dim, so focus is visible on screen.
//
// A "window" is represented the same way chrone's task table represents a
// task -- parallel fixed-size arrays indexed by a small window id, each
// kmalloc'd from the kernel heap in kakel_init (c0 has no structs; this
// is the established idiom, see .sctable and task_rsp_base). Geometry is
// stored in character CELLS (FONT_W x FONT_H pixels), not pixels, so every
// window is cell-aligned, which keeps kakel_scroll's 8-bytes-at-a-time
// row copy legal (a cell row is 8 pixels = 32 bytes, always a multiple
// of 8) and lets kakel_draw_cursor reuse punkt's fb_draw_cursor
// (absolute-cell interface) directly.
//
// punkt stays the single owner of the real hardware framebuffer
// (fb_addr/fb_pitch/fb_width/fb_height stay global -- there is still only
// one device underneath); kakel draws exclusively through punkt's
// primitives (fb_draw_char/fb_fill_rect/fb_draw_cursor) plus direct
// load64/store64 row copies in kakel_scroll, punkt's own fb_scroll idiom
// bounded to a sub-rectangle. The full-screen punkt terminal path still
// exists and still works (the boot banner uses it before kakel_init runs,
// and fb_panic_screen deliberately takes over the WHOLE screen on a
// panic, ignoring windows) -- kakel sits above it, it does not replace it.

int KAKEL_MAX_WIN = 12;
int KAKEL_MAX_RING = 8;

// --- Window kinds ---
// A window is either a shell session (the default, a text console skalman
// owns and prompts into) or a TAVLA -- the window kind a graphical ring-3
// program gets, created by run_ring3_binary/run_elf_binary.
//
// A tavla differs from a shell window in three ways, all of them here in
// kakel rather than scattered across the callers.
//   1. It has a kakel-owned title strip (KAKEL_TAVLA_TITLE_ROWS cells) that
//      the owning program cannot draw over -- see kakel_resize, which insets
//      the window's own rectangle below the strip, so cx/cy/cols/rows (and
//      therefore every kakel_putc, SYS_FILL and SYS_BLIT) already mean the
//      CLIENT area. Nothing outside kakel needs to know the strip exists.
//   2. It shows focus. A bright vs dim text cursor alone cannot show it,
//      since a graphical program never draws a cursor -- so a tavla and
//      the shell would look equally focused at the same time, with no way to tell
//      which one keys were going to. The title strip renders bright when
//      focused and dim otherwise.
//   3. Keys go exclusively to its owner via the key ring buffer
//      (SYS_KEY_POLL) -- but only while it HAS a live owner, see below.
//
// A tavla is still an ordinary tile in the ring, with the same geometry rules, same
// Alt+Tab order, shown alongside skalman rather than taking over the screen.
// That is deliberate -- a graphical program being able to talk to the shell
// is wanted later, and a sealed-off fullscreen mode would foreclose it.
int KAKEL_KIND_SHELL = 0;
int KAKEL_KIND_TAVLA = 1;
int KAKEL_TAVLA_TITLE_ROWS = 1;

// Per-window kind (KAKEL_KIND_*), kmalloc'd in kakel_init.
int kakel_kind_base = 0;

// Per-window owning task id for tavlas, or -1 for "no live owner" -- both
// for shell windows (which never have one) and for a tavla whose program has
// exited. That second case is why this is an owner id and not a flag. A dead
// tavla must STOP consuming keys. Otherwise it would swallow every keystroke
// forever, and closing skalman's own window while a graphical
// program was open would leave the machine with no reachable shell at all.
int kakel_owner_base = 0;

// Per-window title string (kmalloc'd copy, 0 = none) shown in the strip.
int kakel_title_base = 0;

// Height of the status bar at the bottom of the screen, in character rows.
// Changing this requires updating knekt.c0's readback check (which uses
// KAKEL_LOG_ROWS directly to locate the shell-window bottom boundary).
int KAKEL_LOG_ROWS = 1;

// 0 until kakel_init has run (and stays 0 when GRUB granted no usable
// framebuffer -- the VGA text fallback has no windowing; keyboard.c0 and
// skalman.c0 branch on this the same way they branch on fb_available).
int kakel_active = 0;
int kakel_count = 0;
int kakel_focus = 0;
int kakel_prompt_col_base = 0;

// Id of the status-bar tile (-1 = not created). A 1-row strip at the very
// bottom of the screen showing live system info (uptime, task count, memory).
// NOT a shell session and NOT focusable — kakel_focus_next skips it.
int kakel_stats_win = -1;

// Number of focusable (shell) windows. Equals kakel_count minus the
// non-shell windows (stats bar). skalman.c0's shell_init uses this to
// allocate only as many line buffers as there are real interactive
// sessions.
int kakel_shell_wins = 0;

// Parallel per-window arrays (heap, allocated in kakel_init), all indexed
// by window id at stride 8.
//   cx/cy      window origin, in cells (absolute screen cell coordinates)
//   cols/rows  window size, in cells
//   row/col    text cursor position, RELATIVE to the window's own origin
//   crow/ccol  where the cursor glyph was last drawn (window-relative);
//              -1 = not drawn yet, same convention as fb_cursor_row
//   bg         per-window background color -- windows get slightly
//              different backgrounds so the tiling (and any clipping bug)
//              is visible to the eye, not only to readback checks
int kakel_cx_base = 0;
int kakel_cy_base = 0;
int kakel_cols_base = 0;
int kakel_rows_base = 0;
int kakel_row_base = 0;
int kakel_col_base = 0;
int kakel_crow_base = 0;
int kakel_ccol_base = 0;
int kakel_bg_base = 0;

// --- Ring state ---
// Each row (0..1) has a ring of window ids, ring_ids[row*MAX_RING + i].
// ring_head[row] is the index of the first VISIBLE window (left/top slot).
// ring_vis[row] is how many windows are visible (1 or 2). The visible
// windows occupy slots head and (head+1)%ring_cnt.
// ring_cnt[row] is total windows in the ring (visible + hidden).
// kakel_rows is 1 or 2 active rows. Row 0 is the top, row 1 the bottom.
int kakel_ring_ids = 0;    // kmalloc(2 * KAKEL_MAX_RING * 8)
int kakel_ring_cnt = 0;    // kmalloc(2 * 8)
int kakel_ring_head = 0;   // kmalloc(2 * 8)
int kakel_ring_vis = 0;    // kmalloc(2 * 8)
int kakel_rows = 0;

// Background colours for dynamically-created windows, cycled through so
// each window is visually distinct. Six colours chosen for contrast.
int kakel_bg_palette = 0;  // kmalloc(6 * 8), populated in kakel_init

// Unfocused windows' cursor color (focused windows use FB_FG) -- built in
// kakel_init via fb_rgb, same reason FB_FG/FB_BG are built at runtime.
int KAKEL_DIM = 0;

// Small readers for other subsystems (keyboard.c0's serial echo logs, the
// Tab column-stop loop) -- the window-relative cursor cell.
int kakel_get_row(int id) {
    return load64(kakel_row_base + id * 8);
}
int kakel_get_col(int id) {
    return load64(kakel_col_base + id * 8);
}

// Draws (or erases, when called with the window's bg) the cursor underline
// at a window-RELATIVE cell -- a thin wrapper translating to the absolute
// cell fb_draw_cursor expects. Legal because windows are cell-aligned.
// 1 while raket's login screen covers everything, at boot until a user logs
// in and after Alt+L. No window draws then.
int kakel_locked = 0;

// The window that fills the screen while the others wait behind it (Alt+M,
// or the [+] in a tavla's title strip), or -1 for the usual layout.
int kakel_max = -1;

// Per window, 1 when its program should be told to draw again (see
// kakel_nudge_live and SYS_WIN_INFO).
int kakel_nudge_base = 0;

// 1 when window id is on screen and may draw. A window rotated out of its
// row's ring, or behind a maximized one, keeps its old rectangle, and
// drawing there would paint over whatever is on screen in its place. Every
// kakel routine that touches the framebuffer for a window asks this first,
// and so do SYS_PRESENT and SYS_BLIT.
int kakel_shown(int id) {
    if (kakel_active != 1) { return 1; }
    if (kakel_locked == 1) { return 0; }
    if (id == kakel_stats_win) { return 1; }
    if (kakel_max >= 0) { return id == kakel_max; }
    int r = 0;
    for (r = 0; r < kakel_rows; r += 1) {
        int cnt = load64(kakel_ring_cnt + r * 8);
        int vis = load64(kakel_ring_vis + r * 8);
        int head = load64(kakel_ring_head + r * 8);
        int i = 0;
        for (i = 0; i < vis; i += 1) {
            if (load64(kakel_ring_ids + (r * KAKEL_MAX_RING + kakel_wrap_inc(head + i, cnt)) * 8) == id) {
                return 1;
            }
        }
    }
    return 0;
}

// Asks every graphical program with a live window to draw again. A window
// coming back from behind a maximized one gets its old rectangle back, so a
// program that only draws when its size changes would see nothing to do
// and leave the maximized window's pixels standing. A nudged window reports
// one pixel less height once through SYS_WIN_INFO, then its real size, which
// any program that follows its window's size answers with a full frame.
void kakel_nudge_live() {
    if (!kakel_nudge_base) {
        kakel_nudge_base = kmalloc(KAKEL_MAX_WIN * 8);
        if (!kakel_nudge_base) { return; }
    }
    int i = 0;
    for (i = 0; i < KAKEL_MAX_WIN; i += 1) {
        store64(kakel_nudge_base + i * 8, kakel_tavla_live(i));
    }
    return;
}

// 1 once for a nudged window, then 0.
int kakel_take_nudge(int id) {
    if (!kakel_nudge_base || id < 0 || id >= KAKEL_MAX_WIN) { return 0; }
    int n = load64(kakel_nudge_base + id * 8);
    store64(kakel_nudge_base + id * 8, 0);
    return n;
}

void kakel_draw_cursor(int id, int row, int col, int color) {
    if (kakel_shown(id) == 0) { return; }
    fb_draw_cursor(load64(kakel_cy_base + id * 8) + row,
                   load64(kakel_cx_base + id * 8) + col, color);
    return;
}

// The color this window's cursor should currently be drawn in -- bright
// for the focused window, dim otherwise, so focus is visible on screen
// without borders or any other decoration (it has none).
int kakel_cursor_color(int id) {
    if (id == kakel_focus) { return FB_FG; }
    // The window's own background, i.e. NO cursor at all rather than a dim
    // one. Dim-vs-bright is too subtle to answer "which window am I typing
    // into", and it kept reading as two windows being active at once --
    // especially against a tavla running a game, which animates whether or
    // not it has focus. Present-vs-absent is unambiguous.
    return load64(kakel_bg_base + id * 8);
}

// --- tavla ---
// Title-strip colors, built in kakel_init for the same reason FB_FG/FB_BG
// and KAKEL_DIM are, since fb_rgb needs the framebuffer's channel positions,
// which are not known until punkt has read the multiboot tag.
int KAKEL_TAVLA_BAR = 0;
int KAKEL_TAVLA_BAR_DIM = 0;

int kakel_is_tavla(int id) {
    if (load64(kakel_kind_base + id * 8) == KAKEL_KIND_TAVLA) { return 1; }
    return 0;
}

// 1 only for a tavla whose owning program is still running. Keys are routed
// exclusively to a tavla's owner, so an orphaned one must answer 0 here or it
// swallows every keystroke aimed at a program that no longer exists.
int kakel_tavla_live(int id) {
    if (kakel_is_tavla(id) == 0) { return 0; }
    if (load64(kakel_owner_base + id * 8) < 0) { return 0; }
    return 1;
}

// Draws a NUL-terminated string into the title strip starting at a
// window-relative cell column, clipped to the window's width. Returns the
// column just past the last character drawn.
int kakel_title_draw_str(int cx, int trow, int col, int maxcol, int s, int fg, int bg) {
    if (!s) { return col; }
    int i = 0;
    for (i = 0; load8(s + i) != 0 && col < maxcol; i += 1) {
        fb_draw_char((cx + col) * FONT_W, trow * FONT_H, load8(s + i), fg, bg);
        col += 1;
    }
    return col;
}

int kakel_str_cells(int s) {
    if (!s) { return 0; }
    int n = 0;
    while (load8(s + n) != 0) { n += 1; }
    return n;
}

// Repaints one tavla's title strip -- the row directly ABOVE the window's
// stored rectangle, since kakel_resize already inset the client area below
// it. Bright bar = focused, dim bar = not. Cheap enough to call on every
// focus change and every reflow; never called per tick.
void kakel_tavla_paint_title(int id) {
    if (kakel_active != 1) { return; }
    if (kakel_is_tavla(id) == 0) { return; }
    if (kakel_shown(id) == 0) { return; }
    int cx = load64(kakel_cx_base + id * 8);
    int cy = load64(kakel_cy_base + id * 8);
    int cols = load64(kakel_cols_base + id * 8);
    int trow = cy - KAKEL_TAVLA_TITLE_ROWS;
    if (trow < 0) { return; }
    int bar = KAKEL_TAVLA_BAR_DIM;
    int fg = KAKEL_DIM;
    if (id == kakel_focus) {
        bar = KAKEL_TAVLA_BAR;
        fg = FB_FG;
    }
    fb_fill_rect(cx * FONT_W, trow * FONT_H,
                 cols * FONT_W, KAKEL_TAVLA_TITLE_ROWS * FONT_H, bar);
    int col = kakel_title_draw_str(cx, trow, 1, cols,
                                   load64(kakel_title_base + id * 8), fg, bar);
    // The window's number, the one insyn shows in its window column.
    // The upper half of kakel_scratch, since the status bar, drawn from the
    // timer, writes its digits into the lower half.
    int num = kakel_scratch + 40;
    store8(num, ' ');
    store8(num + 1, '#');
    if (id >= 10) {
        store8(num + 2, '0' + id / 10);
        store8(num + 3, '0' + id % 10);
        store8(num + 4, 0);
    } else {
        store8(num + 2, '0' + id);
        store8(num + 3, 0);
    }
    col = kakel_title_draw_str(cx, trow, col, cols, num, KAKEL_DIM, bar);
    if (load64(kakel_owner_base + id * 8) < 0) {
        col = kakel_title_draw_str(cx, trow, col, cols, " [exited]", fg, bar);
    }
    // Two boxes at the right end on every tavla, since a click works on any
    // of them. [+] fills the screen ([-] goes back), [x] closes.
    int icon = "[+]";
    if (id == kakel_max) { icon = "[-]"; }
    if (cols > col + KAKEL_ICON_CELLS * 2 + 2) {
        kakel_title_draw_str(cx, trow, cols - KAKEL_ICON_CELLS * 2 - 2, cols, icon, fg, bar);
        kakel_title_draw_str(cx, trow, cols - KAKEL_ICON_CELLS - 1, cols, "[x]", fg, bar);
    }
    // Right-aligned close hint, only on the focused tavla -- alt+w acts on
    // the focused window, so showing it anywhere else would be a lie.
    if (id == kakel_focus) {
        int hint_len = kakel_str_cells("alt+w close");
        int start = cols - hint_len - KAKEL_ICON_CELLS * 2 - 3;
        if (start > col + 1) {
            kakel_title_draw_str(cx, trow, start, cols, "alt+w close", fg, bar);
        }
    }
    return;
}

int KAKEL_ICON_CELLS = 3;

// 1 when screen pixel (px, py) is on window id's maximize box, 2 when it is
// on its close box, else 0.
int kakel_icon_hit(int id, int px, int py) {
    if (kakel_is_tavla(id) == 0) { return 0; }
    int cx = load64(kakel_cx_base + id * 8);
    int cy = load64(kakel_cy_base + id * 8);
    int cols = load64(kakel_cols_base + id * 8);
    int y0 = (cy - KAKEL_TAVLA_TITLE_ROWS) * FONT_H;
    if (py < y0 || py >= cy * FONT_H) { return 0; }
    int xm = (cx + cols - KAKEL_ICON_CELLS * 2 - 2) * FONT_W;
    int xc = (cx + cols - KAKEL_ICON_CELLS - 1) * FONT_W;
    if (px >= xm && px < xm + KAKEL_ICON_CELLS * FONT_W) { return 1; }
    if (px >= xc && px < xc + KAKEL_ICON_CELLS * FONT_W) { return 2; }
    return 0;
}

// Repaints every visible tavla's title strip. Called after any reflow (which
// recomputes geometry and clears window interiors) and after a focus change.
void kakel_paint_titles() {
    if (kakel_active != 1) { return; }
    if (kakel_max >= 0) { kakel_tavla_paint_title(kakel_max); return; }
    int r = 0;
    for (r = 0; r < kakel_rows; r += 1) {
        int cnt = load64(kakel_ring_cnt + r * 8);
        int vis = load64(kakel_ring_vis + r * 8);
        int head = load64(kakel_ring_head + r * 8);
        int i = 0;
        for (i = 0; i < vis; i += 1) {
            int wid = load64(kakel_ring_ids + (r * KAKEL_MAX_RING + kakel_wrap_inc(head + i, cnt)) * 8);
            kakel_tavla_paint_title(wid);
        }
    }
    return;
}

// Turns an already-created window into a tavla owned by task `owner`, titled
// `name`. Reflows so the title strip's inset is applied to the geometry
// (kakel_resize does that, and only runs from reflow) and repaints.
//
// `name` is stored by pointer and outlives this call, so it must be a string
// literal or a caller-owned copy -- NOT a slice of the shell's line buffer,
// which is overwritten by the time the spawned task gets here.
//
// Callers that own shell prompts must call shell_reprompt_others afterwards.
// the reflow here clears every visible window, prompts included.
void kakel_tavla_claim(int wid, int owner, int name) {
    if (kakel_active != 1 || wid < 0) { return; }
    store64(kakel_kind_base + wid * 8, KAKEL_KIND_TAVLA);
    store64(kakel_owner_base + wid * 8, owner);
    store64(kakel_title_base + wid * 8, name);
    kakel_reflow();
    // The reflow above deliberately does not clear a live tavla, and this
    // window is one as of three lines ago -- so it would keep whatever was
    // on that part of the screen until the program's first frame, which for
    // something like utsikt is seconds away. Clear it here instead. This is
    // the one moment when doing so is safe, since kakel_tavla_claim runs in the
    // spawning task's OWN kernel context, on its way to ring 3, so the owner
    // that would otherwise be presenting into this rectangle is the caller.
    kakel_clear(wid);
    kakel_paint_titles();
    return;
}

// Marks a tavla's owner as gone, without closing the window. The last frame
// the program drew stays on screen (there is nothing to scroll back to in a
// graphical window, so closing it out from under the user would just make the
// result unviewable), but it stops consuming keys and its title says so.
// Called from sched_reap, i.e. from the timer ISR -- so it repaints one strip
// and nothing else, the same budget the status bar already runs on.
void kakel_tavla_orphan(int wid) {
    if (kakel_active != 1 || wid < 0) { return; }
    if (kakel_is_tavla(wid) == 0) { return; }
    store64(kakel_owner_base + wid * 8, 0 - 1);
    kakel_tavla_paint_title(wid);
    return;
}

// Scrolls ONE window's contents up by one cell row and blanks its bottom
// row -- fb_scroll's idiom (8 bytes = 2 pixels at a time, here one
// mem_copy per pixel row) bounded to the window's rectangle instead of the
// whole framebuffer. The byte quantities are always multiples of 8 because
// geometry is in cells, so the window's left-edge byte offset is
// cx*FONT_W*4 (cx cells of 8 pixels of 4 bytes) and its width in bytes is
// cols*FONT_W*4. This per-window scroll is what makes the windows real
// tiles rather than viewports onto one shared console, so window 1 can
// scroll a hundred times while window 0's pixels stay untouched (proven
// by test_kakel_scroll.sh's readback, not just asserted here).
void kakel_scroll(int id) {
    int g = 0;
    if (kakel_grid_base && id >= 0 && id < KAKEL_MAX_WIN) { g = load64(kakel_grid_base + id * 8); }
    if (g) {
        int last = load64(kakel_rows_base + id * 8);
        if (last > GRID_ROWS) { last = GRID_ROWS; }
        int r = 0;
        for (r = 0; r + 1 < last; r += 1) {
            int k = 0;
            for (k = 0; k < GRID_COLS; k += 1) {
                store32(g + (r * GRID_COLS + k) * 4, load32(g + ((r + 1) * GRID_COLS + k) * 4));
            }
        }
        if (last > 0) { kakel_grid_wipe_rows(g, last - 1, last); }
    }
    if (kakel_shown(id) == 0) { return; }
    int cx = load64(kakel_cx_base + id * 8);
    int cy = load64(kakel_cy_base + id * 8);
    int cols = load64(kakel_cols_base + id * 8);
    int rows = load64(kakel_rows_base + id * 8);
    // Lift klick's pointer if it is over the window, since this moves whole
    // rows of pixels underneath it.
    klick_lift_rect(cx * FONT_W, cy * FONT_H, cols * FONT_W, rows * FONT_H);
    int bg = load64(kakel_bg_base + id * 8);
    int x0 = cx * FONT_W * 4;
    int wbytes = cols * FONT_W * 4;
    int ybot = (cy + rows) * FONT_H;
    int y = cy * FONT_H;
    int dst = fb_addr + y * fb_pitch + x0;
    int gap = FONT_H * fb_pitch;
    while (y < ybot - FONT_H) {
        mem_copy(dst, dst + gap, wbytes);
        dst += fb_pitch;
        y += 1;
    }
    fb_fill_rect(cx * FONT_W, ybot - FONT_H, cols * FONT_W, FONT_H, bg);
    klick_drop();
    return;
}

// Draws one character at a window's cursor and advances it -- fb_putc's
// shape (erase old cursor glyph / draw+advance / handle newline, wrap,
// scroll / redraw cursor), but against the window's OWN cursor state and
// clipped to its own rectangle, and the wrap check is against the window's
// cols (not the screen edge) and running off the window's bottom scrolls
// only that window. The foreground color is the shared FB_FG; the
// background is the window's own.
// --- what each shell window shows -------------------------------------------
//
// Every character drawn into a shell window is also kept in that window's
// grid, a character and its colour per cell, so a window that changes size,
// or comes back from behind another, gets its text back instead of a blank
// rectangle. A window that is not shown still writes its grid, just
// nothing to the screen. The grids are whole pages from jenna, all made the
// first time any window writes, and a cell is the character in its low byte
// and the colour above it.

int GRID_COLS = 128;      // the widest window, 1024 pixels of 8
int GRID_ROWS = 96;
int GRID_PAGES = 12;      // 128 * 96 cells of 4 bytes
int kakel_grid_base = 0;  // per window, its grid, or 0
int kakel_old_row_base = 0;  // per window, its cursor before the last resize
int kakel_old_col_base = 0;
int kakel_restored_base = 0; // per window, 1 when a relayout gave its text back

int kakel_grid(int id) {
    if (id < 0 || id >= KAKEL_MAX_WIN || id == kakel_stats_win) { return 0; }
    if (!kakel_grid_base) {
        kakel_grid_base = kmalloc(KAKEL_MAX_WIN * 8);
        kakel_old_row_base = kmalloc(KAKEL_MAX_WIN * 8);
        kakel_old_col_base = kmalloc(KAKEL_MAX_WIN * 8);
        kakel_restored_base = kmalloc(KAKEL_MAX_WIN * 8);
        if (!kakel_grid_base || !kakel_old_row_base || !kakel_old_col_base || !kakel_restored_base) {
            kakel_grid_base = 0;
            return 0;
        }
        // Every window's grid at once, the first time any is needed, so the
        // pages are taken once at boot and never again, whichever window
        // slots come and go.
        int i = 0;
        for (i = 0; i < KAKEL_MAX_WIN; i += 1) {
            int gi = pmm_alloc_run(GRID_PAGES);
            if (gi) { kakel_grid_wipe_rows(gi, 0, GRID_ROWS); }
            store64(kakel_grid_base + i * 8, gi);
            store64(kakel_old_row_base + i * 8, 0);
            store64(kakel_old_col_base + i * 8, 0);
            store64(kakel_restored_base + i * 8, 0);
        }
    }
    return load64(kakel_grid_base + id * 8);
}

void kakel_grid_wipe_rows(int g, int from, int to) {
    int i = from * GRID_COLS;
    while (i < to * GRID_COLS) {
        store32(g + i * 4, ' ');
        i += 1;
    }
    return;
}

void kakel_grid_set(int id, int row, int col, int ch, int fg) {
    if (row < 0 || col < 0 || row >= GRID_ROWS || col >= GRID_COLS) { return; }
    int g = kakel_grid(id);
    if (!g) { return; }
    store32(g + (row * GRID_COLS + col) * 4, (ch & 255) | ((fg & 16777215) << 8));
    return;
}

// Blanks columns [from, to) of one row, for a shell redrawing its line.
void kakel_grid_clear_span(int id, int row, int from, int to) {
    int c = from;
    while (c < to) {
        kakel_grid_set(id, row, c, ' ', FB_FG);
        c += 1;
    }
    return;
}

// 1 once, after a relayout put window f's text back, for whoever would
// otherwise print a fresh prompt into it.
int kakel_take_restored(int id) {
    if (!kakel_restored_base || id < 0 || id >= KAKEL_MAX_WIN) { return 0; }
    int r = load64(kakel_restored_base + id * 8);
    store64(kakel_restored_base + id * 8, 0);
    return r;
}

// Puts a shell window's text back after its rectangle changed. The rows
// nearest the cursor are kept, so the prompt stays in view, and columns past
// the new width wait in the grid for the window to be wide again.
void kakel_restore(int id) {
    int g = 0;
    if (kakel_grid_base) { g = load64(kakel_grid_base + id * 8); }
    // An empty grid is a fresh window, which gets a clear rectangle and,
    // from whoever prompts, a prompt.
    int any = 0;
    int k0 = 0;
    for (k0 = 0; g && k0 < GRID_ROWS * GRID_COLS && !any; k0 += 1) {
        if ((load32(g + k0 * 4) & 255) != ' ') { any = 1; }
    }
    if (!any) { kakel_clear(id); return; }
    int rows = load64(kakel_rows_base + id * 8);
    int cols = load64(kakel_cols_base + id * 8);
    int row = load64(kakel_old_row_base + id * 8);
    int col = load64(kakel_old_col_base + id * 8);
    int shift = row + 1 - rows;
    if (shift < 0) { shift = 0; }
    if (shift > 0) {
        int r = 0;
        for (r = 0; r + shift < GRID_ROWS; r += 1) {
            int k = 0;
            for (k = 0; k < GRID_COLS; k += 1) {
                store32(g + (r * GRID_COLS + k) * 4, load32(g + ((r + shift) * GRID_COLS + k) * 4));
            }
        }
        kakel_grid_wipe_rows(g, GRID_ROWS - shift, GRID_ROWS);
        row -= shift;
    }
    if (col >= cols) { col = cols - 1; }
    store64(kakel_row_base + id * 8, row);
    store64(kakel_col_base + id * 8, col);
    if (kakel_shown(id) == 1) {
        int cx = load64(kakel_cx_base + id * 8);
        int cy = load64(kakel_cy_base + id * 8);
        int bg = load64(kakel_bg_base + id * 8);
        fb_fill_rect(cx * FONT_W, cy * FONT_H, cols * FONT_W, rows * FONT_H, bg);
        int r2 = 0;
        for (r2 = 0; r2 < rows && r2 < GRID_ROWS; r2 += 1) {
            int c2 = 0;
            for (c2 = 0; c2 < cols && c2 < GRID_COLS; c2 += 1) {
                int cell = load32(g + (r2 * GRID_COLS + c2) * 4);
                int ch = cell & 255;
                if (ch != ' ' && ch != 0) {
                    fb_draw_char((cx + c2) * FONT_W, (cy + r2) * FONT_H, ch, (cell >> 8) & 16777215, bg);
                }
            }
        }
        store64(kakel_crow_base + id * 8, row);
        store64(kakel_ccol_base + id * 8, col);
        kakel_draw_cursor(id, row, col, kakel_cursor_color(id));
    }
    store64(kakel_restored_base + id * 8, 1);
    return;
}

// One character into a window in colour fg, the cursor moving on, the
// window scrolling when it reaches the bottom. The grid always, the screen
// only while the window is shown.
void kakel_put(int id, int ch, int fg) {
    if (id < 0 || id >= KAKEL_MAX_WIN) { return; }
    int shown = kakel_shown(id);
    int bg = load64(kakel_bg_base + id * 8);
    int crow = load64(kakel_crow_base + id * 8);
    if (shown == 1 && crow >= 0 && id != kakel_stats_win) {
        kakel_draw_cursor(id, crow, load64(kakel_ccol_base + id * 8), bg);
    }
    int row = load64(kakel_row_base + id * 8);
    int col = load64(kakel_col_base + id * 8);
    if (ch == '\n') {
        row += 1;
        col = 0;
    } else {
        kakel_grid_set(id, row, col, ch, fg);
        if (shown == 1) {
            fb_draw_char((load64(kakel_cx_base + id * 8) + col) * FONT_W,
                         (load64(kakel_cy_base + id * 8) + row) * FONT_H,
                         ch, fg, bg);
        }
        col += 1;
        if (col >= load64(kakel_cols_base + id * 8)) {
            col = 0;
            row += 1;
        }
    }
    if (row >= load64(kakel_rows_base + id * 8)) {
        kakel_scroll(id);
        row -= 1;
    }
    store64(kakel_row_base + id * 8, row);
    store64(kakel_col_base + id * 8, col);
    // No cursor in the status bar (it flickers and serves no purpose).
    if (id != kakel_stats_win) {
        store64(kakel_crow_base + id * 8, row);
        store64(kakel_ccol_base + id * 8, col);
        if (shown == 1) { kakel_draw_cursor(id, row, col, kakel_cursor_color(id)); }
    }
    return;
}

void kakel_putc(int id, int ch) {
    kakel_put(id, ch, FB_FG);
    return;
}

// Like kakel_putc but with a caller-specified foreground colour. Used by
// skalman's sk_putc to support coloured REPL output through kakel windows.
void kakel_putc_fg(int id, int ch, int fg) {
    kakel_put(id, ch, fg);
    return;
}

// Erases the previous character in a window -- fb_backspace's shape and
// its same deliberate limitation (only within the current row; a previous
// newline/wrap is not unwound), window-relative.
void kakel_backspace(int id) {
    int col = load64(kakel_col_base + id * 8);
    if (col > 0) {
        int shown = kakel_shown(id);
        int bg = load64(kakel_bg_base + id * 8);
        int crow = load64(kakel_crow_base + id * 8);
        if (shown == 1 && crow >= 0) {
            kakel_draw_cursor(id, crow, load64(kakel_ccol_base + id * 8), bg);
        }
        int row = load64(kakel_row_base + id * 8);
        col -= 1;
        kakel_grid_set(id, row, col, ' ', FB_FG);
        if (shown == 1) {
            fb_draw_char((load64(kakel_cx_base + id * 8) + col) * FONT_W,
                         (load64(kakel_cy_base + id * 8) + row) * FONT_H,
                         ' ', FB_FG, bg);
        }
        store64(kakel_col_base + id * 8, col);
        store64(kakel_crow_base + id * 8, row);
        store64(kakel_ccol_base + id * 8, col);
        if (shown == 1) { kakel_draw_cursor(id, row, col, kakel_cursor_color(id)); }
    }
    return;
}

// Like kakel_putc but draws in dim grey (KAKEL_DIM) instead of FB_FG.
// Used for the shell prompt so it is visually distinct from typed text.
void kakel_putc_dim(int id, int ch) {
    kakel_put(id, ch, KAKEL_DIM);
    return;
}

void kakel_print(int id, int s) {
    int i = 0;
    for (i = 0; load8(s + i) != 0; i += 1) {
        kakel_putc(id, load8(s + i));
    }
    return;
}

// Dim variant — prints a string with dimmed foreground.
void kakel_print_dim(int id, int s) {
    int i = 0;
    for (i = 0; load8(s + i) != 0; i += 1) {
        kakel_putc_dim(id, load8(s + i));
    }
    return;
}

// Puts a window's console cursor back at its top-left without painting
// anything. Split out of kakel_clear because a live tavla needs the
// bookkeeping half and must not have the painting half -- see
// kakel_reflow's repaint loop. The cursor glyph is left undrawn (crow -1),
// same as fb_clear; the next kakel_putc draws it.
void kakel_reset_cursor(int id) {
    if (id < 0 || id >= KAKEL_MAX_WIN) { return; }
    store64(kakel_row_base + id * 8, 0);
    store64(kakel_col_base + id * 8, 0);
    store64(kakel_crow_base + id * 8, 0 - 1);
    store64(kakel_ccol_base + id * 8, 0 - 1);
    return;
}

// Fills one window's rectangle with its background and resets its cursor
// to the window's top-left -- fb_clear bounded to the window.
// Fills the rectangle (x, y, w, h), in window id's own pixel coordinates,
// with color, clipped to the window. A rectangle hanging off the left or
// top edge loses the part that hangs off, rather than being moved inside.
// SYS_FILL is this, for the calling task's window.
void kakel_fill(int id, int x, int y, int w, int h, int color) {
    if (kakel_shown(id) == 0) { return; }
    int ww = load64(kakel_cols_base + id * 8) * FONT_W;
    int wh = load64(kakel_rows_base + id * 8) * FONT_H;
    int x0 = x;
    int y0 = y;
    int x1 = x + w;
    int y1 = y + h;
    if (x0 < 0) { x0 = 0; }
    if (y0 < 0) { y0 = 0; }
    if (x1 > ww) { x1 = ww; }
    if (y1 > wh) { y1 = wh; }
    if (x1 <= x0 || y1 <= y0) { return; }
    fb_fill_rect(load64(kakel_cx_base + id * 8) * FONT_W + x0,
                 load64(kakel_cy_base + id * 8) * FONT_H + y0,
                 x1 - x0, y1 - y0, color);
    return;
}

// Boot readback for kakel_fill. Four rectangles on window id, hanging off
// its left, top, right and bottom edges, and three patches compared pixel
// by pixel with what each pixel should be, the fill colour where a rectangle
// covers it inside the window and what was there before everywhere else.
// That includes up to four pixels past the right and the bottom edge, where
// the screen goes on past them, which at boot is the status bar below
// window 0. Returns the number of pixels that differ.
int kakel_fill_mismatches(int id) {
    int ox = load64(kakel_cx_base + id * 8) * FONT_W;
    int oy = load64(kakel_cy_base + id * 8) * FONT_H;
    int ww = load64(kakel_cols_base + id * 8) * FONT_W;
    int wh = load64(kakel_rows_base + id * 8) * FONT_H;
    int color = 0x2468AC;
    // Two patches, (px, py, pw, ph) in window coordinates.
    int patches = kmalloc(12 * 8);
    int rects = kmalloc(16 * 8);
    if (!patches || !rects) { return 0 - 1; }
    store64(patches, 0); store64(patches + 8, 0);
    store64(patches + 16, 16); store64(patches + 24, 32);
    store64(patches + 32, ww - 8); store64(patches + 40, 20);
    int beyond = fb_width - (ox + ww);
    if (beyond > 4) { beyond = 4; }
    if (beyond < 0) { beyond = 0; }
    store64(patches + 48, 8 + beyond); store64(patches + 56, 8);
    int below = fb_height - (oy + wh);
    if (below > 4) { below = 4; }
    if (below < 0) { below = 0; }
    store64(patches + 64, 16); store64(patches + 72, wh - 6);
    store64(patches + 80, 12); store64(patches + 88, 6 + below);
    store64(rects, 0 - 4); store64(rects + 8, 24); store64(rects + 16, 10); store64(rects + 24, 4);
    store64(rects + 32, 6); store64(rects + 40, 0 - 3); store64(rects + 48, 5); store64(rects + 56, 8);
    store64(rects + 64, ww - 3); store64(rects + 72, 22); store64(rects + 80, 10); store64(rects + 88, 3);
    store64(rects + 96, 20); store64(rects + 104, wh - 3); store64(rects + 112, 6); store64(rects + 120, 8);
    int before = kmalloc((16 * 32 + 12 * 8 + 12 * 10) * 8);
    if (!before) { return 0 - 1; }
    int n = 0;
    int p = 0;
    for (p = 0; p < 3; p += 1) {
        int y = 0;
        for (y = 0; y < load64(patches + p * 32 + 24); y += 1) {
            int x = 0;
            for (x = 0; x < load64(patches + p * 32 + 16); x += 1) {
                store64(before + n * 8, fb_get_pixel(ox + load64(patches + p * 32) + x,
                                                     oy + load64(patches + p * 32 + 8) + y));
                n += 1;
            }
        }
    }
    int r = 0;
    for (r = 0; r < 4; r += 1) {
        kakel_fill(id, load64(rects + r * 32), load64(rects + r * 32 + 8),
                   load64(rects + r * 32 + 16), load64(rects + r * 32 + 24), color);
    }
    int bad = 0;
    n = 0;
    for (p = 0; p < 3; p += 1) {
        int y = 0;
        for (y = 0; y < load64(patches + p * 32 + 24); y += 1) {
            int x = 0;
            for (x = 0; x < load64(patches + p * 32 + 16); x += 1) {
                int wx = load64(patches + p * 32) + x;
                int wy = load64(patches + p * 32 + 8) + y;
                int want = load64(before + n * 8);
                for (r = 0; r < 4; r += 1) {
                    int rx = load64(rects + r * 32);
                    int ry = load64(rects + r * 32 + 8);
                    if (wx >= rx && wx < rx + load64(rects + r * 32 + 16)
                            && wy >= ry && wy < ry + load64(rects + r * 32 + 24)
                            && wx >= 0 && wx < ww && wy >= 0 && wy < wh) {
                        want = color;
                    }
                }
                if (fb_get_pixel(ox + wx, oy + wy) != want) { bad += 1; }
                n += 1;
            }
        }
    }
    kfree(patches);
    kfree(rects);
    kfree(before);
    return bad;
}

void kakel_clear(int id) {
    if (id < 0 || id >= KAKEL_MAX_WIN) { return; }
    if (kakel_grid_base && load64(kakel_grid_base + id * 8)) {
        kakel_grid_wipe_rows(load64(kakel_grid_base + id * 8), 0, GRID_ROWS);
        store64(kakel_restored_base + id * 8, 0);
    }
    if (kakel_shown(id) == 1) {
        fb_fill_rect(load64(kakel_cx_base + id * 8) * FONT_W,
                     load64(kakel_cy_base + id * 8) * FONT_H,
                     load64(kakel_cols_base + id * 8) * FONT_W,
                     load64(kakel_rows_base + id * 8) * FONT_H,
                     load64(kakel_bg_base + id * 8));
    }
    kakel_reset_cursor(id);
    return;
}

// Wraps val to [0, limit) when val < 2*limit — only used for advancing
// ring indices by 1, where the wrap is always at most one subtraction.
int kakel_wrap_inc(int val, int limit) {
    if (val >= limit) { return val - limit; }
    return val;
}

// Finds which row a given window id belongs to. Returns 0 or 1, or -1 if
// the window is not in any ring (should not happen for shell windows).
int kakel_find_row(int wid) {
    int r = 0;
    for (r = 0; r < kakel_rows; r += 1) {
        int cnt = load64(kakel_ring_cnt + r * 8);
        int i = 0;
        for (i = 0; i < cnt; i += 1) {
            if (load64(kakel_ring_ids + (r * KAKEL_MAX_RING + i) * 8) == wid) {
                return r;
            }
        }
    }
    return -1;
}

// Finds a window's position in its row's ring. Returns the ring index, or -1.
int kakel_ring_pos(int row, int wid) {
    int cnt = load64(kakel_ring_cnt + row * 8);
    int i = 0;
    for (i = 0; i < cnt; i += 1) {
        if (load64(kakel_ring_ids + (row * KAKEL_MAX_RING + i) * 8) == wid) {
            return i;
        }
    }
    return -1;
}

// Moves focus to the next window in reading order (top row left-to-right,
// then bottom row left-to-right, then wrap). If the next window is beyond
// the visible ones in its ring, the ring is rotated (head advanced) to
// bring it into view. Called from keyboard_handler on Alt+Tab.
void kakel_focus_next() {
    int old = kakel_focus;
    int row = kakel_find_row(old);
    if (row < 0) { return; }
    int pos = kakel_ring_pos(row, old);
    if (pos < 0) { return; }
    int cnt = load64(kakel_ring_cnt + row * 8);
    int vis = load64(kakel_ring_vis + row * 8);
    int head = load64(kakel_ring_head + row * 8);

    // Next position in this row's ring
    int next_pos = pos + 1;
    int next_row = row;
    if (next_pos >= cnt) {
        // End of this row's ring, so move to the next row
        next_row = row + 1;
        if (next_row >= kakel_rows) { next_row = 0; }
        next_pos = 0;
        cnt = load64(kakel_ring_cnt + next_row * 8);
        if (!cnt) { return; }  // should not happen
    }

    // If the next window is not currently visible, rotate the row's ring
    // so it becomes the leftmost visible slot.
    vis = load64(kakel_ring_vis + next_row * 8);
    head = load64(kakel_ring_head + next_row * 8);
    if (next_pos >= vis) {
        head += 1;
        if (head >= cnt) { head -= cnt; }
        store64(kakel_ring_head + next_row * 8, head);
        kakel_reflow();
    }

    int nf = load64(kakel_ring_ids + (next_row * KAKEL_MAX_RING + next_pos) * 8);

    // Skip a tavla whose program has exited. It still shows its last frame,
    // which is the point of leaving it open, but it consumes every keystroke
    // sent to it and has no shell behind it to answer -- so landing on one
    // makes the whole keyboard look dead. Only alt+w and another Alt+Tab work
    // there, which is not discoverable.
    //
    // Bounded by the window count rather than looping until something live is
    // found. If EVERY window is a dead tavla there is nothing better to land
    // on, and spinning forever inside the keyboard interrupt would be worse
    // than focusing a dead one.
    int guard = 0;
    for (guard = 0; kakel_is_tavla(nf) == 1 && load64(kakel_owner_base + nf * 8) < 0
           && guard < KAKEL_MAX_WIN; guard += 1) {
        next_pos += 1;
        if (next_pos >= load64(kakel_ring_cnt + next_row * 8)) {
            next_row += 1;
            if (next_row >= kakel_rows) { next_row = 0; }
            next_pos = 0;
        }
        nf = load64(kakel_ring_ids + (next_row * KAKEL_MAX_RING + next_pos) * 8);
    }
    // While maximized, Alt+Tab brings the next window up maximized in its
    // place. Its rectangle may be the full one it had before, so it is
    // nudged to draw.
    if (kakel_max >= 0) {
        kakel_max = nf;
        if (kakel_nudge_base) { store64(kakel_nudge_base + nf * 8, kakel_tavla_live(nf)); }
        kakel_focus = nf;
        kakel_reflow();
    }
    kakel_focus_to(nf);
    return;
}

// Alt+M and the maximize box. The focused window fills the screen and the
// others keep running behind it, drawing nothing, or the usual layout comes
// back with every window where it was. The callers prompt the shells again,
// as after any reflow.
void kakel_maximize_toggle() {
    if (kakel_active != 1) { return; }
    if (kakel_max >= 0) {
        kakel_max = 0 - 1;
        kakel_nudge_live();
    } else {
        if (kakel_focus == kakel_stats_win) { return; }
        kakel_max = kakel_focus;
    }
    kakel_reflow();
    kakel_paint_titles();
    serial_print("kakel maximized: win=");
    serial_print_int(kakel_max);
    serial_print("\n");
    return;
}

// Moves focus to window `nf` and repaints what shows focus, the text cursor
// of the old and new window, and their title strips if they are tavlas (a
// tavla draws no text cursor, so without the strip a graphical window gives
// no sign at all of whether it holds focus, and the one that just lost it
// would keep looking active). Shared by Alt+Tab and by a mouse click.
void kakel_focus_to(int nf) {
    int old = kakel_focus;
    kakel_focus = nf;
    int crow = load64(kakel_crow_base + old * 8);
    if (crow >= 0) {
        kakel_draw_cursor(old, crow, load64(kakel_ccol_base + old * 8), KAKEL_DIM);
    }
    crow = load64(kakel_crow_base + nf * 8);
    if (crow >= 0) {
        kakel_draw_cursor(nf, crow, load64(kakel_ccol_base + nf * 8), FB_FG);
    }
    kakel_tavla_paint_title(old);
    kakel_tavla_paint_title(nf);
    return;
}

// The visible window under screen pixel (px, py), or -1. A tavla's title
// strip counts as part of it, since that is where the eye says the window
// begins. The status bar is never returned, since it is not a session and cannot
// take focus. Walks the rings rather than the id table so a window rotated
// out of view (which keeps its stale geometry) can never be hit.
int kakel_win_at(int px, int py) {
    if (kakel_active != 1) { return 0 - 1; }
    if (kakel_max >= 0) {
        int mx0 = load64(kakel_cx_base + kakel_max * 8) * FONT_W;
        int my0 = load64(kakel_cy_base + kakel_max * 8) * FONT_H;
        int mx1 = mx0 + load64(kakel_cols_base + kakel_max * 8) * FONT_W;
        int my1 = my0 + load64(kakel_rows_base + kakel_max * 8) * FONT_H;
        if (kakel_is_tavla(kakel_max) == 1) { my0 -= KAKEL_TAVLA_TITLE_ROWS * FONT_H; }
        if (px >= mx0 && px < mx1 && py >= my0 && py < my1) { return kakel_max; }
        return 0 - 1;
    }
    int r = 0;
    for (r = 0; r < kakel_rows; r += 1) {
        int cnt = load64(kakel_ring_cnt + r * 8);
        int vis = load64(kakel_ring_vis + r * 8);
        int head = load64(kakel_ring_head + r * 8);
        int i = 0;
        for (i = 0; i < vis; i += 1) {
            int wid = load64(kakel_ring_ids + (r * KAKEL_MAX_RING + kakel_wrap_inc(head + i, cnt)) * 8);
            if (wid != kakel_stats_win) {
                int x0 = load64(kakel_cx_base + wid * 8) * FONT_W;
                int y0 = load64(kakel_cy_base + wid * 8) * FONT_H;
                int x1 = x0 + load64(kakel_cols_base + wid * 8) * FONT_W;
                int y1 = y0 + load64(kakel_rows_base + wid * 8) * FONT_H;
                if (kakel_is_tavla(wid) == 1) { y0 -= KAKEL_TAVLA_TITLE_ROWS * FONT_H; }
                if (px >= x0 && px < x1 && py >= y0 && py < y1) { return wid; }
            }
        }
    }
    return 0 - 1;
}

// Click-to-focus. A left button press over a window focuses it. Called from
// klick_drain on the press edge only, so holding the button and moving does
// not keep re-focusing. Focusing a tavla whose program has exited is allowed
// here, unlike Alt+Tab, which skips them, since a click is an explicit choice of
// that window, and alt+w still closes it. Returns the window focused, or -1
// when the click landed on nothing focusable or on the window that already
// had focus.
int kakel_click(int px, int py) {
    if (kakel_locked == 1) {
        raket_lock_click(px, py);
        return 0 - 1;
    }
    int wid = kakel_win_at(px, py);
    if (wid < 0) { return 0 - 1; }
    // The title's boxes. The press is spent on them, so the program under
    // the pointer never sees it, whether or not the window had the focus.
    int box = kakel_icon_hit(wid, px, py);
    if (box == 1) {
        if (wid != kakel_focus) { kakel_focus_to(wid); }
        kakel_maximize_toggle();
        shell_reprompt_others(0 - 1);
        shell_prompt_session(kakel_focus);
        return wid;
    }
    if (box == 2) {
        if (wid != kakel_focus) { kakel_focus_to(wid); }
        key_close_focused();
        return wid;
    }
    if (wid == kakel_focus) { return 0 - 1; }
    kakel_focus_to(wid);
    serial_print("kakel focus: win=");
    serial_print_int(kakel_focus);
    serial_print(" (click)\n");
    return wid;
}

// Allocates a window slot (first with rows == 0, i.e. unused) and sets its
// geometry. Returns the id, or -1 if the table is full.
int kakel_win_new(int cx, int cy, int cols, int rows, int bg) {
    int id = 0;
    for (id = 0; id < KAKEL_MAX_WIN; id += 1) {
        if (load64(kakel_rows_base + id * 8) == 0 && id != kakel_stats_win) {
            break;
        }
    }
    if (id >= KAKEL_MAX_WIN) { return -1; }
    store64(kakel_cx_base + id * 8, cx);
    store64(kakel_cy_base + id * 8, cy);
    store64(kakel_cols_base + id * 8, cols);
    store64(kakel_rows_base + id * 8, rows);
    store64(kakel_row_base + id * 8, 0);
    store64(kakel_col_base + id * 8, 0);
    store64(kakel_crow_base + id * 8, 0 - 1);
    store64(kakel_ccol_base + id * 8, 0 - 1);
    store64(kakel_bg_base + id * 8, bg);
    store64(kakel_kind_base + id * 8, KAKEL_KIND_SHELL);
    store64(kakel_owner_base + id * 8, 0 - 1);
    store64(kakel_title_base + id * 8, 0);
    // A window id is reused after its slot is freed, and every per-session
    // array (raket's login state, skalman's uid/cwd) is indexed by that id --
    // so a fresh window must not inherit the closed session's. `split` sets
    // its new window's session state explicitly right after this returns,
    // which is what makes inheriting-on-purpose still work there.
    raket_reset_session(id);
    return id;
}

// Marks a window slot as free so kakel_win_new can reuse it.
void kakel_win_free(int id) {
    if (kakel_grid_base && load64(kakel_grid_base + id * 8)) {
        kakel_grid_wipe_rows(load64(kakel_grid_base + id * 8), 0, GRID_ROWS);
        store64(kakel_restored_base + id * 8, 0);
    }
    store64(kakel_rows_base + id * 8, 0);
    store64(kakel_cols_base + id * 8, 0);
    store64(kakel_cx_base + id * 8, 0);
    store64(kakel_cy_base + id * 8, 0);
    store64(kakel_cols_base + id * 8, 0);
    store64(kakel_row_base + id * 8, 0);
    store64(kakel_crow_base + id * 8, 0 - 1);
    store64(kakel_ccol_base + id * 8, 0 - 1);
    store64(kakel_kind_base + id * 8, KAKEL_KIND_SHELL);
    store64(kakel_owner_base + id * 8, 0 - 1);
    // A program's title is a copy of its file name made for this window.
    int title = load64(kakel_title_base + id * 8);
    if (kheap_owns(title)) { kfree(title); }
    store64(kakel_title_base + id * 8, 0);
    return;
}

// Updates a window's cell geometry and clamps its cursor if it now falls
// outside the new bounds.
//
// The layout (kakel_reflow) hands every window its OUTER rectangle. For a
// tavla the stored rectangle is inset below the title strip, and this is the
// single place that inset happens -- which is why nothing else in the kernel
// knows the strip exists. cx/cy/cols/rows mean the client area from here on,
// so kakel_putc, kakel_scroll, kakel_clear and all three ring-3 graphics
// syscalls stay correct with no change and no way for a program to paint over
// its own title.
void kakel_resize(int id, int cx, int cy, int cols, int rows) {
    if (kakel_is_tavla(id) == 1 && rows > KAKEL_TAVLA_TITLE_ROWS) {
        cy += KAKEL_TAVLA_TITLE_ROWS;
        rows -= KAKEL_TAVLA_TITLE_ROWS;
    }
    store64(kakel_cx_base + id * 8, cx);
    store64(kakel_cy_base + id * 8, cy);
    store64(kakel_cols_base + id * 8, cols);
    store64(kakel_rows_base + id * 8, rows);
    int row = load64(kakel_row_base + id * 8);
    int col = load64(kakel_col_base + id * 8);
    if (kakel_old_row_base) {
        store64(kakel_old_row_base + id * 8, row);
        store64(kakel_old_col_base + id * 8, col);
    }
    if (row >= rows) { row = rows - 1; }
    if (col >= cols) { col = 0; }
    store64(kakel_row_base + id * 8, row);
    store64(kakel_col_base + id * 8, col);
    return;
}

// Recalculates the cell geometry of every visible window from the ring
// state. Called after split, close, or a ring rotation. Also updates
// kakel_shell_wins to reflect the total number of visible shell windows.
void kakel_reflow() {
    int all_cols = fb_width / FONT_W;
    int all_rows = fb_height / FONT_H;
    int shell_rows = all_rows - KAKEL_LOG_ROWS;
    int total_vis = 0;

    if (kakel_max >= 0) {
        kakel_resize(kakel_max, 0, 0, all_cols, shell_rows);
        kakel_shell_wins = 1;
        if (kakel_tavla_live(kakel_max) == 1) {
            kakel_reset_cursor(kakel_max);
        } else if (kakel_is_tavla(kakel_max) == 0) {
            kakel_restore(kakel_max);
        } else {
            kakel_clear(kakel_max);
        }
        kakel_tavla_paint_title(kakel_max);
        return;
    }

    if (kakel_rows == 1) {
        int vis0 = load64(kakel_ring_vis);
        int cnt0 = load64(kakel_ring_cnt);
        int head0 = load64(kakel_ring_head);
        if (vis0 == 1) {
            int w = load64(kakel_ring_ids + (0 * KAKEL_MAX_RING + head0) * 8);
            kakel_resize(w, 0, 0, all_cols, shell_rows);
            total_vis = 1;
        } else {
            int half = all_cols / 2;
            int w0 = load64(kakel_ring_ids + (0 * KAKEL_MAX_RING + head0) * 8);
            int w1i = kakel_wrap_inc(head0 + 1, cnt0);
            int w1 = load64(kakel_ring_ids + (0 * KAKEL_MAX_RING + w1i) * 8);
            kakel_resize(w0, 0, 0, half, shell_rows);
            kakel_resize(w1, half, 0, all_cols - half, shell_rows);
            total_vis = 2;
        }
    } else {
        int row_h = shell_rows / 2;
        // Row 0 (top)
        int vis0 = load64(kakel_ring_vis);
        int cnt0 = load64(kakel_ring_cnt);
        int head0 = load64(kakel_ring_head);
        if (vis0 == 1) {
            int w = load64(kakel_ring_ids + (0 * KAKEL_MAX_RING + head0) * 8);
            kakel_resize(w, 0, 0, all_cols, row_h);
            total_vis += 1;
        } else {
            int half = all_cols / 2;
            int w0 = load64(kakel_ring_ids + (0 * KAKEL_MAX_RING + head0) * 8);
            int w1i = kakel_wrap_inc(head0 + 1, cnt0);
            int w1 = load64(kakel_ring_ids + (0 * KAKEL_MAX_RING + w1i) * 8);
            kakel_resize(w0, 0, 0, half, row_h);
            kakel_resize(w1, half, 0, all_cols - half, row_h);
            total_vis += 2;
        }
        // Row 1 (bottom)
        int vis1 = load64(kakel_ring_vis + 8);
        int cnt1 = load64(kakel_ring_cnt + 8);
        int head1 = load64(kakel_ring_head + 8);
        if (vis1 == 1) {
            int w = load64(kakel_ring_ids + (1 * KAKEL_MAX_RING + head1) * 8);
            kakel_resize(w, 0, row_h, all_cols, shell_rows - row_h);
            total_vis += 1;
        } else {
            int half = all_cols / 2;
            int w0 = load64(kakel_ring_ids + (1 * KAKEL_MAX_RING + head1) * 8);
            int w1i = kakel_wrap_inc(head1 + 1, cnt1);
            int w1 = load64(kakel_ring_ids + (1 * KAKEL_MAX_RING + w1i) * 8);
            kakel_resize(w0, 0, row_h, half, shell_rows - row_h);
            kakel_resize(w1, half, row_h, all_cols - half, shell_rows - row_h);
            total_vis += 2;
        }
    }
    kakel_shell_wins = total_vis;

    // Repaint every visible window (clear + redraw would lose content, but
    // clearing is the safest way to avoid stale pixels from old geometries).
    // The shell will re-prompt on the next Enter anyway.
    //
    // Every window except a tavla with a living owner. That one exception is
    // not a nicety, it is a correctness rule.
    //
    // The clear below is a fb_fill_rect over the whole window, and a full
    // width tavla is 1024x752 pixels drawn one at a time. That takes the
    // better part of a second under QEMU -- long enough that the scheduler
    // preempts it several times over. If the window's owner is a ring-3
    // program, one of those preemptions hands it the CPU, it notices through
    // win_info() that its window changed size, re-renders, and SYS_PRESENT
    // copies a whole new frame into the very rectangle this fill is halfway
    // through. The fill then resumes where it left off and paints the tavla's
    // background over the bottom of a frame that is newer than the fill is.
    // The result is a window whose top is the program's picture and whose
    // bottom is flat background, and it stays that way until something else
    // makes the program repaint.
    //
    // There is no ordering to fix here, because the kernel has no business
    // painting those pixels at all. A tavla's client area belongs to its
    // owner, and the owner repaints it the moment it sees the new
    // geometry. A ring-3 program cannot be called from here, so for a tavla
    // "the owner puts it back" means "leave it alone and let the owner get
    // there". Skipping the
    // fill also covers a quieter case, a reflow that
    // leaves a tavla's geometry untouched, which would otherwise blank a program that only
    // presents when something changed.
    //
    // An ORPHANED tavla still gets cleared. There is no owner left to repaint
    // it, so there is nobody to race with, and its last frame is the wrong
    // size for the new rectangle.
    //
    // A tavla that has just been created is cleared by kakel_tavla_claim
    // instead, which runs in the spawning task's own context before it ever
    // reaches ring 3 -- so, again, with nobody to race against.
    int r = 0;
    for (r = 0; r < kakel_rows; r += 1) {
        int cnt = load64(kakel_ring_cnt + r * 8);
        int vis = load64(kakel_ring_vis + r * 8);
        int head = load64(kakel_ring_head + r * 8);
        int i = 0;
        for (i = 0; i < vis; i += 1) {
            int wid = load64(kakel_ring_ids + (r * KAKEL_MAX_RING + kakel_wrap_inc(head + i, cnt)) * 8);
            if (kakel_tavla_live(wid) == 1) {
                kakel_reset_cursor(wid);
            } else if (kakel_is_tavla(wid) == 0) {
                kakel_restore(wid);
            } else {
                kakel_clear(wid);
            }
            kakel_tavla_paint_title(wid);
        }
    }
    return;
}

// Adds a window to a row's ring after a given position. If after_pos < 0,
// appends to the end of the ring. Returns 0 on success, -1 if the ring is
// full (KAKEL_MAX_RING windows already in this row).
int kakel_ring_add(int row, int wid, int after_pos) {
    int cnt = load64(kakel_ring_cnt + row * 8);
    if (cnt >= KAKEL_MAX_RING) { return -1; }
    // Shift everything after the insertion point right by one
    int i = 0;
    for (i = cnt; i > after_pos + 1; i -= 1) {
        int prev = load64(kakel_ring_ids + (row * KAKEL_MAX_RING + i - 1) * 8);
        store64(kakel_ring_ids + (row * KAKEL_MAX_RING + i) * 8, prev);
    }
    store64(kakel_ring_ids + (row * KAKEL_MAX_RING + after_pos + 1) * 8, wid);
    store64(kakel_ring_cnt + row * 8, cnt + 1);
    return 0;
}

// Removes a window from a row's ring by compacting. Returns 0 on success.
void kakel_ring_remove(int row, int wid) {
    int cnt = load64(kakel_ring_cnt + row * 8);
    int head = load64(kakel_ring_head + row * 8);
    int vis = load64(kakel_ring_vis + row * 8);
    int w = 0;
    int found = -1;
    int i = 0;
    for (i = 0; i < cnt; i += 1) {
        if (load64(kakel_ring_ids + (row * KAKEL_MAX_RING + i) * 8) == wid) {
            found = i;
        }
    }
    if (found < 0) { return; }
    // Compact
    for (i = found; i < cnt - 1; i += 1) {
        int next = load64(kakel_ring_ids + (row * KAKEL_MAX_RING + i + 1) * 8);
        store64(kakel_ring_ids + (row * KAKEL_MAX_RING + i) * 8, next);
    }
    store64(kakel_ring_cnt + row * 8, cnt - 1);
    // Adjust head if we removed something before or at the head
    if (found < head) {
        store64(kakel_ring_head + row * 8, head - 1);
    } else if (found == head && cnt > 1) {
        // Head removed, so the new head is the next one, wrapping
        int new_cnt = cnt - 1;
        if (head >= new_cnt) { store64(kakel_ring_head + row * 8, 0); }
    }
    return;
}

// Splits the focused window's row. If 1 visible, becomes 2 columns. If 2
// visible and only 1 row, splits into 2 rows (creating a new row with 2
// windows — taking total visible from 2 to 4). Otherwise adds a hidden
// window to the focused row's ring.
//
// Returns the new window's id, or -1 if the layout is already full (all 4
// slots visible) or window creation otherwise failed. Used both by the
// shell's own `split` command (which ignores the return value -- it only
// cares that a window appeared somewhere the user can Alt+Tab to) and by
// start (syscall.c0), which need the id itself to give a
// ring-3 process its own dedicated output window (see run_ring3_binary's
// windowed variant).
int kakel_split() {
    // A new window is one more to see, so the usual layout comes back first.
    if (kakel_max >= 0) {
        kakel_max = 0 - 1;
        kakel_nudge_live();
    }
    int row = kakel_find_row(kakel_focus);
    if (row < 0) { return 0 - 1; }
    int vis = load64(kakel_ring_vis + row * 8);
    int cnt = load64(kakel_ring_cnt + row * 8);
    int head = load64(kakel_ring_head + row * 8);
    int pos = kakel_ring_pos(row, kakel_focus);

    if (vis == 1) {
        // Split 1 column → 2 columns in the same row.
        int nid = kakel_win_new(0, 0, 1, 1,
            load64(kakel_bg_palette + ((kakel_shell_wins % 6) * 8)));
        if (nid < 0) { return 0 - 1; }
        kakel_ring_add(row, nid, head);
        store64(kakel_ring_vis + row * 8, 2);
        kakel_reflow();
        return nid;
    } else if (vis == 2 && kakel_rows == 1) {
        // Split 1 row → 2 rows. Create a new row 1 with one new window.
        store64(kakel_ring_cnt + 8, 0);
        store64(kakel_ring_head + 8, 0);
        store64(kakel_ring_vis + 8, 1);
        int nid = kakel_win_new(0, 0, 1, 1,
            load64(kakel_bg_palette + ((kakel_shell_wins % 6) * 8)));
        if (nid >= 0) { kakel_ring_add(1, nid, -1); }
        kakel_rows = 2;
        kakel_reflow();
        return nid;
    } else if (vis == 2 && kakel_rows == 2) {
        // Focused row is full. If the other row has room, split that one.
        int other = 1 - row;
        int other_vis = load64(kakel_ring_vis + other * 8);
        if (other_vis == 1) {
            int nid = kakel_win_new(0, 0, 1, 1,
                load64(kakel_bg_palette + ((kakel_shell_wins % 6) * 8)));
            if (nid >= 0) {
                int ohead = load64(kakel_ring_head + other * 8);
                kakel_ring_add(other, nid, ohead);
                store64(kakel_ring_vis + other * 8, 2);
                kakel_reflow();
                return nid;
            }
            return 0 - 1;
        } else {
            sk_print("split: all 4 slots are full\n");
            return 0 - 1;
        }
    } else {
        // Refused, and nothing was allocated -- important, because a spawn
        // that silently consumed a window slot it could not display would
        // exhaust the KAKEL_MAX_WIN table long before the four visible tiles
        // suggest, and the failure surfaces far away as kakel_win_new
        // returning -1 during an unrelated close.
        sk_print("split: all 4 slots are full\n");
        return 0 - 1;
    }
}

// Kills a tavla's owning program, if it still has one. Setting TASK_EXITED is
// exactly what SYS_EXIT does; the scheduler skips the task from the next tick
// and sched_reap frees its stack. task_win_base is cleared here too so the
// dying task cannot write into a window id that is about to be reused.
void kakel_tavla_kill(int wid) {
    if (kakel_tavla_live(wid) == 0) { return; }
    int owner = load64(kakel_owner_base + wid * 8);
    store64(task_state_base + owner * 8, TASK_EXITED);
    store64(task_win_base + owner * 8, 0 - 1);
    store64(kakel_owner_base + wid * 8, 0 - 1);
    serial_print("[tavla] closed win=");
    serial_print_int(wid);
    serial_print(" killed task=");
    serial_print_int(owner);
    serial_print("\n");
    return;
}

// Removes the FOCUSED window -- the shell's `close` command, and alt+w.
int kakel_close() {
    return kakel_close_id(kakel_focus);
}

// Removes a window by id. If its row had 2 visible, drops to 1 (full width).
// If it had 1 visible, the entire row is removed and the other row expands to
// fill the space. The window's shell session is abandoned (its line buffer
// stays allocated — leak is bounded by KAKEL_MAX_WIN). If this is the last
// window (1 row, 1 visible), it is closed and a single fresh window replaces
// it so the screen is never windowless.
//
// Focus only moves if the window being closed is the one that had it.
//
// Returns 1 if the layout actually changed (and therefore kakel_reflow ran,
// clearing every visible window), 0 if nothing happened. Callers that repaint
// per-window content afterwards -- skalman's prompts -- MUST check this.
// repainting when no reflow occurred stacks a second copy on top of the first.
int kakel_close_id(int wid) {
    int row = kakel_find_row(wid);
    if (row < 0) { return 0; }
    if (wid == kakel_max) {
        kakel_max = 0 - 1;
        kakel_nudge_live();
    }
    int vis = load64(kakel_ring_vis + row * 8);
    int was_focused = 0;
    if (wid == kakel_focus) { was_focused = 1; }
    // Closing a tavla is how a graphical program is meant to be shut down, so
    // the window and the program go together -- otherwise the program would
    // keep running with nowhere to draw.
    kakel_tavla_kill(wid);

    if (vis == 2) {
        // Drop to 1 visible in this row.
        kakel_ring_remove(row, wid);
        kakel_win_free(wid);
        store64(kakel_ring_vis + row * 8, 1);
        if (was_focused == 1 && load64(kakel_ring_cnt + row * 8) > 0) {
            int head = load64(kakel_ring_head + row * 8);
            kakel_focus = load64(kakel_ring_ids + (row * KAKEL_MAX_RING + head) * 8);
        }
        kakel_reflow();
        return 1;
    }
    if (vis == 1 && kakel_rows == 2) {
        // Remove this entire row. The other row expands to fill the screen.
        kakel_ring_remove(row, wid);
        kakel_win_free(wid);
        if (!row) {
            // Row 0 removed, so shift row 1's ring up to row 0.
            int i = 0;
            int cnt1 = load64(kakel_ring_cnt + 8);
            while (i < cnt1) {
                int w = load64(kakel_ring_ids + (1 * KAKEL_MAX_RING + i) * 8);
                store64(kakel_ring_ids + (0 * KAKEL_MAX_RING + i) * 8, w);
                i += 1;
            }
            store64(kakel_ring_cnt, cnt1);
            store64(kakel_ring_head, load64(kakel_ring_head + 8));
            store64(kakel_ring_vis, load64(kakel_ring_vis + 8));
        }
        // Row 1 ring state is stale but ignored once kakel_rows == 1.
        kakel_rows = 1;
        store64(kakel_ring_cnt + 8, 0);
        if (load64(kakel_ring_cnt) > 0) {
            kakel_focus = load64(kakel_ring_ids + (0 * KAKEL_MAX_RING + 0) * 8);
        }
        kakel_reflow();
        return 1;
    }
    // Last window (1 row, 1 visible). Replace it with a fresh window so the
    // screen is never windowless — the old session is abandoned.
    if (vis == 1 && kakel_rows == 1) {
        int old = wid;
        // Pick a bg colour that cycles past the just-freed window's palette
        // slot so the new window looks distinct.
        int new_bg = load64(kakel_bg_palette + ((kakel_count % 6) * 8));
        kakel_ring_remove(row, old);
        kakel_win_free(old);
        // The ring is now empty — add one fresh window.
        int nid = kakel_win_new(0, 0, 1, 1, new_bg);
        if (nid >= 0) {
            kakel_ring_add(0, nid, -1);
        }
        store64(kakel_ring_vis, 1);
        if (load64(kakel_ring_cnt) > 0) {
            kakel_focus = load64(kakel_ring_ids + (0 * KAKEL_MAX_RING + 0) * 8);
        }
        kakel_reflow();
        // Guarded, unlike before. This sat OUTSIDE the `nid >= 0` check above,
        // so a failed kakel_win_new printed into window -1 -- indexing
        // kakel_bg_base minus 8 and handing fb_fill_rect garbage geometry, an
        // out-of-bounds write from inside the keyboard interrupt. Reported as
        // "closed the last window and everything crashed".
        if (nid >= 0) {
            kakel_print(nid, "\ntype 'help' for commands.\n");
        }
        return 1;
    }
    return 0;
}

// --- Status bar helpers (kakel_stats_win) ---
// The stats bar is a 1-row window at the top of the log strip, refreshed
// each scheduler tick with live system info. These thin wrappers guard
// against the window not existing (VGA fallback, pre-init).

void kakel_stats_putc(int c) {
    if (kakel_stats_win < 0) { return; }
    kakel_putc(kakel_stats_win, c);
    return;
}

void kakel_stats_print(int s) {
    if (kakel_stats_win < 0) { return; }
    kakel_print(kakel_stats_win, s);
    return;
}

void kakel_stats_clear() {
    if (kakel_stats_win < 0) { return; }
    kakel_clear(kakel_stats_win);
    return;
}

// Writes an unsigned integer into the stats bar, one character at a time,
// using the same digit-extraction shape as serial_print_int.
void kakel_stats_int(int v) {
    if (kakel_stats_win < 0) { return; }
    int tmp = kakel_scratch;
    int i = 31;
    if (!v) { kakel_putc(kakel_stats_win, '0'); return; }
    while (v > 0) {
        i -= 1;
        store8(tmp + i, '0' + (v % 10));
        v /= 10;
    }
    while (i < 31) {
        kakel_putc(kakel_stats_win, load8(tmp + i));
        i += 1;
    }
    return;
}

// Brings up the initial window layout, one full-screen shell window (minus
// the 1-row status bar at the very bottom). The user can split it into
// more windows at runtime via the `split` command in skalman. The ring
// state tracks which windows are visible and in what order. Runs in
// kernel_post_init AFTER the full-screen boot banner and BEFORE
// shell_init.
void kakel_init() {
    if (fb_available != 1) { return; }
    kakel_cx_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_cy_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_cols_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_rows_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_row_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_col_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_crow_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_ccol_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_bg_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_prompt_col_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_kind_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_owner_base = kmalloc(KAKEL_MAX_WIN * 8);
    kakel_title_base = kmalloc(KAKEL_MAX_WIN * 8);
    KAKEL_DIM = fb_rgb(100, 100, 100);
    KAKEL_TAVLA_BAR = fb_rgb(48, 48, 128);
    KAKEL_TAVLA_BAR_DIM = fb_rgb(24, 24, 40);

    // Ring state, two rows, each with KAKEL_MAX_RING slots
    kakel_ring_ids = kmalloc(2 * KAKEL_MAX_RING * 8);
    kakel_ring_cnt = kmalloc(2 * 8);
    kakel_ring_head = kmalloc(2 * 8);
    kakel_ring_vis = kmalloc(2 * 8);

    // Background palette for dynamically-created windows
    kakel_bg_palette = kmalloc(6 * 8);
    store64(kakel_bg_palette, FB_BG);                         // black
    store64(kakel_bg_palette + 8, fb_rgb(16, 16, 48));       // navy
    store64(kakel_bg_palette + 16, fb_rgb(16, 48, 16));      // dark green
    store64(kakel_bg_palette + 24, fb_rgb(48, 16, 16));      // dark red
    store64(kakel_bg_palette + 32, fb_rgb(48, 48, 16));      // dark yellow
    store64(kakel_bg_palette + 40, fb_rgb(48, 16, 48));      // dark magenta

    int all_cols = fb_width / FONT_W;
    int all_rows = fb_height / FONT_H;
    int shell_rows = all_rows - KAKEL_LOG_ROWS;

    // One full-screen shell window
    int w0 = kakel_win_new(0, 0, all_cols, shell_rows, FB_BG);
    kakel_focus = w0;

    // Status bar at the very bottom -- not focusable
    kakel_stats_win = kakel_win_new(0, shell_rows, all_cols, 1,
                                     fb_rgb(12, 12, 48));

    // Initialize the ring, where row 0 has 1 visible window (w0)
    store64(kakel_ring_cnt, 1);
    store64(kakel_ring_head, 0);
    store64(kakel_ring_vis, 1);
    store64(kakel_ring_ids, w0);
    store64(kakel_ring_cnt + 8, 0);
    store64(kakel_ring_head + 8, 0);
    store64(kakel_ring_vis + 8, 0);
    kakel_rows = 1;
    kakel_shell_wins = 1;

    kakel_clear(w0);
    kakel_clear(kakel_stats_win);
    kakel_active = 1;
    return;
}

// Test-only scroll proof for test_kakel_scroll.sh. Dead code in normal
// boots — called only when the test injects a call in kernel_post_init
// (same pattern as trigger_doublefault in boot.s). Writes a marker 'M' at
// the current cursor (row 3 after the boot banner), floods newlines to
// trigger exactly one scroll, then reads back pixel rows 16 (where the
// marker should have moved to) and 24 (where it was, which should
// now be background).
void kakel_test_scroll() {
    // Put marker at row 1 (pixel row 8), then flood newlines to trigger
    // one scroll. shell_rows = 95, starting from row 2 after the first
    // NL, 94 more NLs → row 96 → scroll at 95. After scroll the marker
    // moves from pixel row 8 to pixel row 0.
    kakel_putc(0, '\n');
    kakel_putc(0, 'M');
    kakel_putc(0, '\n');
    int i = 0;
    for (i = 0; i < 93; i += 1) {
        kakel_putc(0, '\n');
    }
    int moved = 0;
    int cleared = 0;
    int py = 0;
    int px = 0;
    while (py < 8) {
        px = 0;
        for (px = 0; px < 8; px += 1) {
            if (load32(fb_addr + (0 + py) * fb_pitch + px * 4) == FB_FG) {
                moved += 1;
            }
            if (load32(fb_addr + (8 + py) * fb_pitch + px * 4) == FB_FG) {
                cleared += 1;
            }
        }
        py += 1;
    }
    serial_print("kakel scroll: moved=");
    serial_print_int(moved);
    serial_print(" cleared=");
    serial_print_int(cleared);
    serial_print("\n");
    return;
}
