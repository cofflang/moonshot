//
// expect: 0
// How many faces of ship.form, in the root, are yellow (0xe8d04a), as the
// exit code, for verify_form.sh. There is no ship.form when the ELF tests
// run on their own, so then it is 0.
include "djup.c0";

int main() {
    int m = djup_load("/ship.form", 512, 1024);
    if (!m) { return 0; }
    int n = 0;
    int i = 0;
    for (i = 0; i < m.dh_faces; i += 1) {
        if (load64(djup_face(m, i) + 24) == 0xe8d04a) { n += 1; }
    }
    return n;
}
