// synth -- turns a noter song into sound oljud can play at 22050 samples a
// second, either 8-bit unsigned mono, 128 being silence (synth_render), or
// 16-bit signed stereo (synth_render16), where each instrument sits where its
// pan in the song puts it. A ring-3 library, included after noter.c0.
//
// A note's instrument picks its wave, a square, a triangle, a sawtooth, or
// noise that dies away over the note for a drum. Its loudness is its
// velocity, scaled so that
// eight notes at full velocity add up to exactly the 8-bit range, so up to eight
// voices never clip, at the cost of one note alone being fairly quiet. Each
// note ramps in and out over SYNTH_RAMP samples (3ms), because a square wave
// switched on or off mid-swing clicks.
//
// There is no per-voice state. A note's phase at sample t is simply
// (t - its first sample) times its phase step, so any stretch of a song can
// be rendered on its own, in any order, and comes out the same. That is what
// lets a player hand the song to oljud a block at a time, since oljud's queue holds
// about three seconds and a song can be longer.
//
// Only integers. Pitch to frequency goes through a table of one octave in
// millihertz, doubled or halved for the others.

int SYNTH_RATE = 22050;
int SYNTH_RAMP = 64;          // samples, about 3ms
int SYNTH_AMP = 16;           // a full-velocity voice swings +-16
int SYNTH_ONE = 4294967296;   // one whole cycle of phase

// Instruments not heard, one bit each, bit 0 the square. A player's mute and
// solo set it. The song itself does not change.
int synth_muted = 0;

// MIDI 60-71 (C4 to B4) in millihertz, equal temperament, A4 = 440 Hz.
int synth_mhz(int n) {
    if (!n) { return 261626; }
    if (n == 1) { return 277183; }
    if (n == 2) { return 293665; }
    if (n == 3) { return 311127; }
    if (n == 4) { return 329628; }
    if (n == 5) { return 349228; }
    if (n == 6) { return 369994; }
    if (n == 7) { return 391995; }
    if (n == 8) { return 415305; }
    if (n == 9) { return 440000; }
    if (n == 10) { return 466164; }
    return 493883;
}

// The phase step per sample for a MIDI pitch, the fraction of a cycle one
// sample advances, out of SYNTH_ONE. Worked out at octave 4 and shifted, so
// every C is exactly twice the C below it.
int synth_step(int pitch) {
    int inc = synth_mhz(pitch % 12) * SYNTH_ONE / (SYNTH_RATE * 1000);
    int oct = 0;
    for (oct = pitch / 12 - 5; oct > 0; oct -= 1) { inc *= 2; }
    while (oct < 0) { inc /= 2; oct += 1; }
    return inc;
}

// The sample at which grid step k begins. Computed from k every time rather
// than by adding up a per-step length, so a long song does not drift. At 120
// beats per minute a sixteenth is 2756.25 samples, and the quarter would
// otherwise be lost on every step.
int synth_at(int s, int k) {
    return k * SYNTH_RATE * 60 / (s.nh_tempo * s.nh_steps);
}

// How many samples the whole song lasts, to the end of its last note.
int synth_length(int s) {
    int end = 0;
    int i = 0;
    for (i = 0; i < s.nh_count; i += 1) {
        int r = noter_note(s, i);
        if (r.nn_start + r.nn_length > end) { end = r.nn_start + r.nn_length; }
    }
    return synth_at(s, end);
}

// A well-mixed 64-bit hash of x, splitmix64's finisher. Consecutive inputs
// give unrelated outputs, which is what noise needs. Simpler hashes of a
// counter come out nearly periodic, and that is heard as a tone. c0's >> keeps
// the sign, so each shift is masked to make it a logical one, and the
// constants are written as the signed numbers with the same 64 bits.
int synth_mix(int x) {
    int z = x * (0 - 7046029254386353131);
    z = (z ^ ((z >> 30) & 17179869183)) * (0 - 4658895280553007687);
    z = (z ^ ((z >> 27) & 137438953471)) * (0 - 7723592293110705685);
    return z ^ ((z >> 31) & 8589934591);
}

// One sample of instrument `inst` at `amp`, `k` samples into a note `len`
// samples long whose phase is now `phase` of SYNTH_ONE. The drum ignores the
// phase. Its noise changes value every `hold` samples, longer for a lower
// pitch, so pitch still says how deep it sounds, and it fades out over the
// note.
int synth_wave(int inst, int phase, int k, int len, int pitch, int amp) {
    int x = phase >> 16;   // 0 to 65535 across one cycle
    if (inst == 1) {
        int d = 2 * x - 65536;
        if (d < 0) { d = 0 - d; }
        return amp * (65536 - 2 * d) / 65536;
    }
    if (inst == 2) { return amp * (2 * x - 65536) / 65536; }
    if (inst == 3) {
        int hold = 1 + (127 - pitch) / 16;
        int v = amp;
        if (((synth_mix(k / hold + pitch * 7919) >> 40) & 1) == 1) { v = 0 - amp; }
        return v * (len - k) / len;
    }
    if (phase >= SYNTH_ONE / 2) { return 0 - amp; }
    return amp;
}

// Adds every note sounding in samples [from, from + n) into `mix`, in the
// 8-bit scale. Mono, one int64 a sample, when stereo is 0. Left and right
// apart, two a sample, when it is 1, each side's share out of 8 from the
// note's pan (noter_note_pan). The middle is the whole voice on both sides, as mono
// is, and a side falls to nothing as the pan goes to the other end.
void synth_voices(int s, int from, int n, int mix, int stereo) {
    int i = 0;
    for (i = 0; i < n * (1 + stereo); i += 1) { store64(mix + i * 8, 0); }
    int to = from + n;
    int k = 0;
    for (k = 0; k < s.nh_count; k += 1) {
        int r = noter_note(s, k);
        int a = synth_at(s, r.nn_start);
        if (a >= to) { break; }   // sorted by start, so nothing later sounds here
        int b = synth_at(s, r.nn_start + r.nn_length);
        int inst = r.nn_instrument;
        if (b > from && ((synth_muted >> inst) & 1) == 0) {
            int amp = r.nn_velocity * SYNTH_AMP / 127;
            int inc = synth_step(r.nn_pitch);
            int t = a;
            if (t < from) { t = from; }
            int stop = b;
            if (stop > to) { stop = to; }
            int pan = noter_note_pan(s, r);
            int gl = 2 * (NOTER_PAN_MAX - pan);
            int gr = 2 * pan;
            if (gl > 8) { gl = 8; }
            if (gr > 8) { gr = 8; }
            // The phase is carried from sample to sample, which gives the
            // same value as working it out from t each time without a
            // division per sample. Only its start needs one.
            int phase = (t - a) * inc % SYNTH_ONE;
            while (t < stop) {
                int v = amp;
                if (inst == 0) {
                    if (phase >= SYNTH_ONE / 2) { v = 0 - amp; }
                } else {
                    v = synth_wave(inst, phase, t - a, b - a, r.nn_pitch, amp);
                }
                // The ramps, in and out, so the edges do not click.
                if (t - a < SYNTH_RAMP) { v = v * (t - a) / SYNTH_RAMP; }
                if (b - t < SYNTH_RAMP) { v = v * (b - t) / SYNTH_RAMP; }
                if (stereo) {
                    int p = mix + (t - from) * 16;
                    store64(p, load64(p) + v * gl);
                    store64(p + 8, load64(p + 8) + v * gr);
                } else {
                    int q = mix + (t - from) * 8;
                    store64(q, load64(q) + v);
                }
                phase += inc;
                if (phase >= SYNTH_ONE) { phase -= SYNTH_ONE; }
                t += 1;
            }
        }
    }
    return;
}

// Renders samples [from, from + n) of the song into `out`, one byte each,
// 8-bit unsigned mono. `mix` is scratch space for n int64 sums, owned by the
// caller so a player rendering block after block allocates it once. Pans do
// not matter here.
void synth_render(int s, int from, int n, int out, int mix) {
    synth_voices(s, from, n, mix, 0);
    int i = 0;
    for (i = 0; i < n; i += 1) {
        int v = load64(mix + i * 8) + 128;
        // Only a song with more than eight notes at once can get here; lira
        // does not let one be made, but a file from elsewhere could.
        if (v < 0) { v = 0; }
        if (v > 255) { v = 255; }
        store8(out + i, v);
    }
    return;
}

// Renders samples [from, from + n) as 16-bit signed stereo frames into
// `out`, four bytes each, for a program that called sound_format(2). `mix`
// is scratch for 2n int64 sums. The 8-bit scale times 256, so a song is as
// loud as through synth_render, with 256 times the steps.
void synth_render16(int s, int from, int n, int out, int mix) {
    synth_voices(s, from, n, mix, 1);
    int i = 0;
    for (i = 0; i < n; i += 1) {
        // Each side was added up out of 8, so 256 / 8.
        int l = load64(mix + i * 16) * 32;
        int r = load64(mix + i * 16 + 8) * 32;
        if (l > 32767) { l = 32767; }
        if (l < 0 - 32768) { l = 0 - 32768; }
        if (r > 32767) { r = 32767; }
        if (r < 0 - 32768) { r = 0 - 32768; }
        store32(out + i * 4, (l & 65535) | ((r & 65535) << 16));
    }
    return;
}

// Plays the song through oljud from start to end and returns when the last
// of it is queued. `block` bytes are rendered at a time; while oljud's queue
// has no room for the next block, this waits. Returns 0 if there is no sound
// card or no memory, 1 otherwise.
int synth_play(int s, int block) {
    int out = alloc(block);
    int mix = alloc(block * 8);
    if (out == 0 || !mix) { return 0; }
    int len = synth_length(s);
    int at = 0;
    while (at < len) {
        int n = block;
        if (len - at < n) { n = len - at; }
        synth_render(s, at, n, out, mix);
        int sent = 0;
        while (sent < n) {
            int got = sound(out + sent, n - sent);
            if (got < 0) { dealloc(out); dealloc(mix); return 0; }
            sent += got;
        }
        at += n;
    }
    dealloc(out);
    dealloc(mix);
    return 1;
}
