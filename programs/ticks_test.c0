//
// Verifies ticks() (SYS_TICKS) end to end from ring 3. It reads the counter,
// spins long enough for the timer to fire, reads it again, and exits 1 if the
// second read is strictly greater. verify_ticks.sh looks for that exit code
// and for the line printed below. gen_programs.sh compiles it into build/
// and the kernel embeds it.
int main() {
    int t0 = 0;
    int t1 = 0;
    int i = 0;
    t0 = ticks();
    i = 0;
    while (i < 20000000) { i = i + 1; }
    t1 = ticks();
    print("ticks test ok\n");
    if (t1 > t0) { return 1; }
    return 0;
}
