// expect: 111
// SYS_READFILE end to end: the syscall that lets a ring-3 program read a
// file at all. Reads demo.c0, which jakel seeds into the root directory on a
// fresh filesystem and whose first bytes are known ("print(777);...").
//
// Also checks the buf == 0 size query, which is how a program sizes its
// alloc() before the real read -- there is no separate stat syscall.
int main() {
    int size = readfile("demo.c0", 0, 0);
    if (size <= 0) { return 220; }

    int buf = alloc(size + 1);
    if (buf == 0) { return 221; }

    int n = readfile("demo.c0", buf, size);
    if (n != size) { return 222; }

    // "print(" -- the file is generated byte by byte in jakel_init, so these
    // are exact, not a guess.
    if (load8(buf) != 'p') { return 223; }
    if (load8(buf + 1) != 'r') { return 224; }
    if (load8(buf + 2) != 'i') { return 225; }
    if (load8(buf + 3) != 'n') { return 226; }
    if (load8(buf + 4) != 't') { return 227; }
    if (load8(buf + 5) != '(') { return 228; }

    // A path that does not exist must fail cleanly rather than returning
    // garbage or faulting the kernel.
    if (readfile("nosuchfile.xyz", 0, 0) != 0 - 1) { return 229; }

    return 111;
}
