// expect: 107
// Chained if/else and while in sequence. The label-collision bug (if/while/
// print took two label ids but only bumped the counter by one) made each
// control-flow statement reuse the previous one's end label, so false
// branches jumped into function epilogues. Every branch below is taken or
// skipped for a different reason, so a mis-targeted jump changes the total.
int main() {
    int t = 0;
    int i = 0;
    if (1 < 2) { t = t + 1; } else { t = t + 100; }
    if (2 < 1) { t = t + 100; } else { t = t + 2; }
    while (i < 4) { t = t + 4; i = i + 1; }
    if (t == 19) { t = t + 8; } else { t = t + 100; }
    i = 0;
    while (i < 3) {
        if (i == 1) { t = t + 16; } else { t = t + 32; }
        i = i + 1;
    }
    return t;
}
