//
// gnista -- a game engine for Moonshot, written in c0.
//
// Where this is: a real entity pool (not one hand-named entity), a general
// AABB overlap test callable between any two entities, all-pairs collision
// resolution, and per-entity compositing. Movement, animation, arrow-key
// input and window-edge bouncing carry over from the first demo.
//
// Sprites are LOADED FROM A FILE at runtime, via SYS_READFILE -- draw one in
// pensel, spawn the game, see it, with no rebuild anywhere. A baked-in sprite
// (sprite_demo_data.c0, generated by gen_sprite.py) is still compiled in and
// used as the fallback, so the demo runs on a machine where nobody has drawn
// anything yet.
//
// That fallback is the whole of what used to be here: before SYS_READFILE a
// ring-3 program could not read a file at all, so every sprite was baked in
// by a host script and changing one pixel meant rebuilding the kernel.
//
// Drawing is composited into a small local buffer and presented with a
// SINGLE blit() per entity, not separate fill()+fill()+blit() calls. Found
// the hard way: fill()/blit() write straight to the live framebuffer with
// no double-buffering, and each syscall is individually atomic (SYSCALL's
// SFMASK clears RFLAGS.IF for its duration) but the scheduler CAN preempt
// a task BETWEEN two separate syscalls -- so a multi-call draw sequence
// can get visibly torn by a task switch landing mid-sequence. Compositing
// locally and presenting with one syscall makes each entity's visible
// update atomic regardless of scheduler timing.

layout Entity {
    int x;
    int y;
    int prev_x;
    int prev_y;
    int vx;
    int vy;
    int w;
    int h;
    int sprite;
    int frame;
    int frame_ticks;
    // Immovable: collided against and drawn, but never moved or bounced.
    // This is what lets a static block be an ordinary pool member instead
    // of a separate kind of thing with its own layout, its own collision
    // path and its own drawing path -- see the header on aabb_hit.
    int fixed;
    // Fill colour for an entity with no sprite (sprite == 0), which is how
    // the static blocks are drawn.
    int color;
}

layout Sprite {
    int width;
    int height;
    int frames;
    int pixels;  // address of frames * width * height * 4 raw BGR0 bytes
}

// Field names deliberately do not collide with Entity's x/y/w/h: coff.c0
// keeps one flat field-name -> offset table shared across every `layout`
// (see field_declare_or_check), so a shared name must land at the same
// offset in every layout that uses it. Entity's w/h sit after prev_x/
// prev_y/vx/vy (offset 48/56); a same-named w/h here would sit right after
// x/y (offset 16/24) -- a real offset conflict, not a naming preference.
// Hit this directly: it compiles to a bare CODEGENERROR with no further
// detail, so this is not a hypothetical to guard against speculatively.

include "sprite_demo_data.c0";

// Not globals: --elf mode has no support for global-variable reads yet
// (see coff.c0's gen_expr, ND_VAR's raw_mode branch) -- only locals and
// the stack. Passed down as plain locals/params instead.

int make_sprite_demo() {
    int s;
    s = alloc(sizeof(Sprite));
    s.width = 12;
    s.height = 12;
    s.frames = 2;
    s.pixels = alloc(seed_sprite_demo_size());
    seed_sprite_demo(s.pixels);
    return s;
}

// Loads a sprite written by pensel, moonshot's pixel editor. Returns 0 if the
// file is missing or malformed, so the caller can fall back to the baked-in
// one -- the demo has to run on a machine where nobody has drawn anything
// yet.
//
// This is what SYS_READFILE was added for. Until it existed a ring-3 program
// could not read a file at all, so the sprite below had to be compiled in by
// a host script and changing one pixel meant rebuilding the kernel. Now the
// loop closes on the machine itself: draw it in pensel, spawn the game, see
// it.
//
// The file's layout is deliberately the shape this `Sprite` already has --
// three int64s then the pixels -- so loading is three reads and a pointer
// into the buffer rather than a parse.
int load_sprite(int name) {
    int size;
    int buf;
    int s;
    size = readfile(name, 0, 0);
    // 24 bytes of header plus at least one pixel.
    if (size < 28) { return 0; }
    buf = alloc(size);
    if (buf == 0) { return 0; }
    if (readfile(name, buf, size) != size) { return 0; }
    s = alloc(sizeof(Sprite));
    if (s == 0) { return 0; }
    s.width = load64(buf);
    s.height = load64(buf + 8);
    s.frames = load64(buf + 16);
    // The pixels are already in the right format and byte order, so the
    // sprite just points into the buffer instead of copying it.
    s.pixels = buf + 24;
    if (s.width <= 0 || s.height <= 0 || s.frames <= 0) { return 0; }
    if (24 + s.width * s.height * s.frames * 4 > size) { return 0; }
    return s;
}

// --- the entity pool ------------------------------------------------------
//
// One flat allocation of `count` Entity records, addressed by index. c0 has
// no arrays and no pointer types -- an entity "reference" is just the
// address of its record, which is exactly what `layout` field access already
// expects -- so a pool is one alloc and a multiply, and iterating it is a
// loop over indices. Allocated once at startup: SYS_ALLOC's ring-3 heap is
// bump-only with no free, so anything allocated per frame would exhaust it
// within seconds.
int pool_alloc(int count) {
    return alloc(count * sizeof(Entity));
}

int pool_at(int pool, int i) {
    return pool + i * sizeof(Entity);
}

// Initialises one pool slot. Six parameters is the most a call can take in
// --elf mode (arguments are register-passed only; the stack-passed path that
// text mode has for 7+ was never implemented in the raw backend), so the
// remaining fields are set by the caller afterwards.
//
// Worth noting that parameters 5 and 6 were, until recently, silently
// broken in this backend -- they arrived holding parameter 4's value,
// because the prologue emitted `mov r8, rax` where it meant `mov rax, r8`.
// A five-argument call like this one would have quietly done the wrong
// thing. It is fixed now, and verify_elf_backend.sh covers it.
void entity_init(int e, int x, int y, int vx, int vy) {
    e.x = x;
    e.y = y;
    e.prev_x = x;
    e.prev_y = y;
    e.vx = vx;
    e.vy = vy;
    e.frame = 0;
    e.frame_ticks = 0;
    e.fixed = 0;
    e.color = 0;
    e.sprite = 0;
    e.w = 0;
    e.h = 0;
    return;
}

// --- collision ------------------------------------------------------------

// The general axis-aligned bounding-box overlap test, between ANY two
// entities. The first demo checked one hardcoded obstacle inline with the
// entity's own coordinates spelled out; this takes two entity references and
// nothing else, which is what makes all-pairs collision below possible and
// what makes a static block just another entity.
//
// Touching edges do not count as overlapping (strict <, not <=), so two
// entities that come to rest exactly against each other are not reported as
// colliding forever.
int aabb_hit(int a, int b) {
    if (a.x + a.w <= b.x) { return 0; }
    if (b.x + b.w <= a.x) { return 0; }
    if (a.y + a.h <= b.y) { return 0; }
    if (b.y + b.h <= a.y) { return 0; }
    return 1;
}

// Bounces `e` off `other`, which it is known to overlap. Resolution picks
// the axis of SHALLOWEST penetration and reverses only that one, rather than
// reversing both: reversing both is what the one-obstacle demo did, and with
// several entities it makes a glancing corner hit send things back the way
// they came on both axes, which reads as entities sticking to each other.
//
// The entity is also pushed back out along that axis. Without it, two
// entities that are still overlapping on the next frame collide again,
// reverse again, and vibrate in place instead of separating.
void bounce_off(int e, int other) {
    int pen_left;
    int pen_right;
    int pen_up;
    int pen_down;
    int pen_x;
    int pen_y;

    pen_left = e.x + e.w - other.x;      // e overlapping other's left edge
    pen_right = other.x + other.w - e.x; // e overlapping other's right edge
    pen_up = e.y + e.h - other.y;
    pen_down = other.y + other.h - e.y;

    pen_x = pen_left;
    if (pen_right < pen_x) { pen_x = pen_right; }
    pen_y = pen_up;
    if (pen_down < pen_y) { pen_y = pen_down; }

    if (pen_x < pen_y) {
        if (pen_left < pen_right) { e.x = other.x - e.w; } else { e.x = other.x + other.w; }
        e.vx = 0 - e.vx;
    } else {
        if (pen_up < pen_down) { e.y = other.y - e.h; } else { e.y = other.y + other.h; }
        e.vy = 0 - e.vy;
    }
    return;
}

// All-pairs collision across the pool: every unordered pair tested once
// (j starts at i+1). O(n^2), which is the right amount of machinery at this
// scale -- a broad phase would be a real cost in code and a real risk of
// being subtly wrong, to save comparisons that are not being felt. Revisit
// when the entity count is large enough to measure, not before.
//
// A fixed entity is never moved by a collision, so a mover hitting a static
// block bounces alone, and two static blocks that happen to overlap simply
// stay put rather than pushing each other apart forever.
void resolve_collisions(int pool, int count) {
    int i;
    int j;
    int a;
    int b;
    i = 0;
    while (i < count) {
        a = pool_at(pool, i);
        j = i + 1;
        while (j < count) {
            b = pool_at(pool, j);
            if (aabb_hit(a, b) == 1) {
                if (a.fixed == 0) { bounce_off(a, b); }
                if (b.fixed == 0) { bounce_off(b, a); }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return;
}

// --- drawing --------------------------------------------------------------

// Writes one BGR0 pixel (blue, green, red, 0 -- Moonshot's blit() pixel
// format) into `buf` at byte offset `off`, from a 0xRRGGBB-packed `color`.
void buf_put_pixel(int buf, int off, int color) {
    int b;
    int g;
    int r;
    b = color - (color / 256) * 256;
    g = (color / 256) - (color / 65536) * 256;
    r = (color / 65536) - (color / 16777216) * 256;
    store8(buf + off, b);
    store8(buf + off + 1, g);
    store8(buf + off + 2, r);
    store8(buf + off + 3, 0);
    return;
}

// Draws entity `e` into the compose buffer, clipped to the box
// [bx, bx+bw) x [by, by+bh) in screen coordinates. Used both for the entity
// being presented and for any OTHER entity that overlaps its box -- which is
// what keeps the pool from erasing itself: compositing entity A's box paints
// background over whatever was there, and if B happened to be inside it, B
// would vanish until its own turn came round. Drawing every intersecting
// entity into the box means the box is always correct when it lands.
void draw_entity_into(int e, int buf, int bx, int by, int bw, int bh) {
    int spr;
    int frame_size;
    int row;
    int col;
    int sx;
    int sy;
    int off;
    int spx;
    int spy;
    int spr_off;
    int a;

    row = 0;
    while (row < bh) {
        col = 0;
        while (col < bw) {
            sx = bx + col;
            sy = by + row;
            if (sx >= e.x && sx < e.x + e.w && sy >= e.y && sy < e.y + e.h) {
                off = (row * bw + col) * 4;
                if (e.sprite == 0) {
                    buf_put_pixel(buf, off, e.color);
                } else {
                    spr = e.sprite;
                    frame_size = spr.width * spr.height * 4;
                    spx = sx - e.x;
                    spy = sy - e.y;
                    spr_off = e.frame * frame_size + (spy * spr.width + spx) * 4;
                    a = load8(spr.pixels + spr_off) + load8(spr.pixels + spr_off + 1) * 256
                        + load8(spr.pixels + spr_off + 2) * 65536
                        + load8(spr.pixels + spr_off + 3) * 16777216;
                    // Colour 0 is transparent, matching SYS_BLIT itself, so
                    // a round sprite does not carry a square of background.
                    if (a != 0) {
                        store8(buf + off, load8(spr.pixels + spr_off));
                        store8(buf + off + 1, load8(spr.pixels + spr_off + 1));
                        store8(buf + off + 2, load8(spr.pixels + spr_off + 2));
                        store8(buf + off + 3, 0);
                    }
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }
    return;
}

// Composites the bounding box of entity `e`'s old and new positions -- the
// background, then every entity that intersects that box -- and presents it
// with exactly one blit().
//
// `max_bbox` hard-caps how large that bounding box is allowed to get. This
// is not a cosmetic limit -- c0 has no optimizer at all, so this per-pixel
// loop is genuinely expensive per pixel, and if a scheduling delay ever let
// an entity drift further from its last-rendered position than expected
// (round-robining against several other tasks means this process does not
// see every tick individually; it can see a handful at once, in bursts),
// the loop would grow with the SQUARE of the gap and just keep grinding --
// not just slow for this demo, but stealing real CPU time from every other
// task on the system. Found exactly this way: letting the box grow unbounded
// visibly slowed down the whole OS, not just this window. When the real box
// would exceed the cap, fall back to just the entity's own (small, fixed)
// footprint at its new position -- the old position does not get cleanly
// erased in that rare case (a brief visual ghost, not a crash or a
// slowdown), which is a far better trade than unbounded work.
void compose_and_present(int e, int pool, int count, int buf, int max_bbox) {
    int bbox_x;
    int bbox_y;
    int bbox_x2;
    int bbox_y2;
    int bbox_w;
    int bbox_h;
    int row;
    int col;
    int i;
    int other;

    bbox_x = e.prev_x; if (e.x < bbox_x) { bbox_x = e.x; }
    bbox_y = e.prev_y; if (e.y < bbox_y) { bbox_y = e.y; }
    bbox_x2 = e.prev_x + e.w; if (e.x + e.w > bbox_x2) { bbox_x2 = e.x + e.w; }
    bbox_y2 = e.prev_y + e.h; if (e.y + e.h > bbox_y2) { bbox_y2 = e.y + e.h; }
    bbox_w = bbox_x2 - bbox_x;
    bbox_h = bbox_y2 - bbox_y;

    if (bbox_w > max_bbox || bbox_h > max_bbox) {
        bbox_x = e.x;
        bbox_y = e.y;
        bbox_w = e.w;
        bbox_h = e.h;
    }

    // Background first, over the whole box.
    row = 0;
    while (row < bbox_h) {
        col = 0;
        while (col < bbox_w) {
            buf_put_pixel(buf, (row * bbox_w + col) * 4, 0x102040);
            col = col + 1;
        }
        row = row + 1;
    }

    // Then every entity that intersects the box, this one included. Drawn in
    // pool order, so a later entity wins where two overlap -- consistent
    // between frames, which is what stops overlapping entities from
    // flickering against each other.
    i = 0;
    while (i < count) {
        other = pool_at(pool, i);
        if (other.x < bbox_x + bbox_w && other.x + other.w > bbox_x
            && other.y < bbox_y + bbox_h && other.y + other.h > bbox_y) {
            draw_entity_into(other, buf, bbox_x, bbox_y, bbox_w, bbox_h);
        }
        i = i + 1;
    }

    blit(buf, bbox_x, bbox_y, bbox_w, bbox_h);
    return;
}

int main() {
    int pool;
    int count;
    int e;
    int spr;
    int winfo;
    int ww;
    int wh;
    int prev_ticks;
    int t;
    int dt;
    int key;
    int make_code;
    int is_break;
    int frame_interval;
    int compose_buf;
    int compose_max_dim;
    int MAX_STEP;
    int SPEED;
    int dt_real;
    int i;

    frame_interval = 15;  // ticks between animation frame swaps (~150ms)
    SPEED = 2;            // pixels moved per rendered frame
    MAX_STEP = 1;

    // Prefer a sprite drawn in pensel; fall back to the baked-in one so the
    // demo still runs on a machine where nothing has been drawn yet.
    spr = load_sprite("hero.spr");
    if (spr == 0) {
        spr = make_sprite_demo();
        print("gnista: using built-in sprite\n");
    } else {
        print("gnista: loaded hero.spr\n");
    }

    // Four movers and two static blocks in one pool. The statics are
    // ordinary entities with fixed = 1 and no sprite -- there is no separate
    // obstacle type any more, which is what makes one collision routine and
    // one drawing routine cover both.
    count = 6;
    pool = pool_alloc(count);

    i = 0;
    while (i < 4) {
        e = pool_at(pool, i);
        entity_init(e, 20 + i * 26, 20 + i * 18, SPEED, SPEED);
        e.sprite = spr;
        e.w = spr.width;
        e.h = spr.height;
        // Alternate the starting directions so they actually meet rather
        // than travelling in formation forever.
        if (i == 1) { e.vx = 0 - SPEED; }
        if (i == 2) { e.vy = 0 - SPEED; }
        if (i == 3) { e.vx = 0 - SPEED; e.vy = 0 - SPEED; }
        // Stagger the animation so they do not all twinkle in lockstep --
        // but never past the sprite's real frame count.
        e.frame = i - (i / 2) * 2;
        if (e.frame >= spr.frames) { e.frame = 0; }
        i = i + 1;
    }

    e = pool_at(pool, 4);
    entity_init(e, 100, 80, 0, 0);
    e.w = 40; e.h = 20; e.fixed = 1; e.color = 0x606060;

    e = pool_at(pool, 5);
    entity_init(e, 170, 150, 0, 0);
    e.w = 20; e.h = 44; e.fixed = 1; e.color = 0x606060;

    // compose_max_dim is the ONE source of truth for both how big this
    // buffer is and how large compose_and_present is allowed to let its
    // bounding box grow (passed in below) -- these must never drift apart,
    // or the per-pixel loop can write past what is actually allocated here.
    compose_max_dim = spr.width * 3;
    if (spr.height * 3 > compose_max_dim) { compose_max_dim = spr.height * 3; }
    compose_buf = alloc(compose_max_dim * compose_max_dim * 4);

    winfo = win_info();
    ww = winfo / 65536;
    wh = winfo - ww * 65536;

    // Full-window clear happens exactly once, here -- every redraw after
    // this only recomposes the small bounding boxes the movers actually
    // touch (see compose_and_present), not the whole window.
    fill(0, 0, ww, wh, 0x102040);
    i = 0;
    while (i < count) {
        e = pool_at(pool, i);
        compose_and_present(e, pool, count, compose_buf, compose_max_dim);
        i = i + 1;
    }

    prev_ticks = ticks();
    print("gnista demo running\n");

    while (1) {
        // Drain all pending input this frame. Arrow keys steer entity 0;
        // the rest just get on with it.
        key = key_poll();
        while (key >= 0) {
            make_code = key / 2;
            is_break = key - make_code * 2;
            if (is_break == 0) {
                e = pool_at(pool, 0);
                if (make_code == 72) { e.vy = 0 - SPEED; }  // up
                if (make_code == 80) { e.vy = SPEED; }      // down
                if (make_code == 75) { e.vx = 0 - SPEED; }  // left
                if (make_code == 77) { e.vx = SPEED; }      // right
                if (make_code == 1) { exit(0); }            // Esc
            }
            key = key_poll();
        }

        t = ticks();
        dt = t - prev_ticks;
        if (dt > 0) {
            dt_real = dt;
            prev_ticks = t;

            // Movement advances by a fixed amount per RENDERED frame,
            // not by elapsed time. This is a deliberate reversal of the
            // frame-rate-independent movement this demo started with, and
            // it is worth being precise about why.
            //
            // Measured on real Moonshot: with a scheduler quantum of 10
            // ticks and several runnable tasks, this process rendered
            // roughly 10 frames in a row (one per tick, moving one pixel
            // each) and was then descheduled for about 30 ticks. Honest
            // dt-based movement has to make that time up, so the next frame
            // jumped the whole way at once: about 70% of all motion happened
            // in a single frame out of eleven. That is what read as jerky --
            // the step sizes were wildly irregular, not merely large. (The
            // quantum is 1 tick now, which spaces frames evenly, but the
            // reasoning holds for any future scheduling gap.)
            //
            // Nothing can be drawn during the time this task is not running,
            // so correct wall-clock speed and even motion cannot both be
            // had: catching up after a gap IS the lurch. For a demo, even
            // motion wins, so the step is pinned to one tick's worth and the
            // speed set per step instead.
            //
            // dt_real (below) keeps the UNCLAMPED elapsed time, so the
            // animation timer stays wall-clock correct even though movement
            // no longer is.
            dt = MAX_STEP;

            // Re-read the window before bouncing anything off its edges: a
            // tile is resized by any reflow (a `split` typed in another
            // window, a spawn3, a close) and nothing announces it. Without
            // this, entities kept bouncing off the boundaries of a window
            // that no longer exists -- off-screen in a shrunken tile, or in
            // mid-air well short of the edge in an enlarged one.
            //
            // This demo composites per entity through blit(), which clips
            // window-relative on every call, so a stale size here was only
            // ever wrong-looking, never unsafe. Infecteria presents whole
            // frames and had to care rather more (see view_poll_resize).
            winfo = win_info();
            if (winfo != 0) {
                ww = winfo / 65536;
                wh = winfo - ww * 65536;
            }

            // Move every non-fixed entity, then bounce off the window edges.
            i = 0;
            while (i < count) {
                e = pool_at(pool, i);
                e.prev_x = e.x;
                e.prev_y = e.y;
                if (e.fixed == 0) {
                    e.x = e.x + e.vx * dt;
                    e.y = e.y + e.vy * dt;
                    if (e.x < 0) { e.x = 0; e.vx = 0 - e.vx; }
                    if (e.y < 0) { e.y = 0; e.vy = 0 - e.vy; }
                    if (e.x + e.w > ww) { e.x = ww - e.w; e.vx = 0 - e.vx; }
                    if (e.y + e.h > wh) { e.y = wh - e.h; e.vy = 0 - e.vy; }

                    e.frame_ticks = e.frame_ticks + dt_real;
                    if (e.frame_ticks >= frame_interval) {
                        e.frame_ticks = 0;
                        // Wrap by the sprite's OWN frame count, not a hard 2.
                        // A sprite loaded from a file may have any number of
                        // frames -- pensel writes one -- and the old
                        // `1 - e.frame` flipped to frame 1 regardless, which
                        // reads past the end of a single-frame sprite's pixel
                        // data.
                        int esp = e.sprite;
                        e.frame = e.frame + 1;
                        if (e.frame >= esp.frames) { e.frame = 0; }
                    }
                }
                i = i + 1;
            }

            // Collisions AFTER every entity has moved, not interleaved with
            // movement: resolving as each one moves would test entity 0
            // against entity 3's position from the previous frame, so the
            // result would depend on pool order.
            resolve_collisions(pool, count);

            // One atomic blit per entity that actually moved. Fixed entities
            // are skipped -- they are still drawn, by whichever mover's box
            // they intersect, so re-presenting them every frame would be
            // pure cost.
            i = 0;
            while (i < count) {
                e = pool_at(pool, i);
                if (e.fixed == 0) {
                    compose_and_present(e, pool, count, compose_buf, compose_max_dim);
                }
                i = i + 1;
            }
        }
    }
    return 0;
}
