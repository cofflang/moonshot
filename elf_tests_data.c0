// Seeds every test ELF into directory `dir`. Any stale copy is removed
// first: disk.img survives reboots, so a rebuilt test would otherwise
// be silently ignored in favour of the previous run's bytes. Called on
// EVERY boot from jakel_init, not just the first -- see the fixture
// section there for why that placement is load-bearing.
void seed_elf_tests_install(int dir) {
    int stale_et01 = jakel_lookup(dir, "et01.elf");
    if (stale_et01 >= 0) { jakel_remove(stale_et01); }
    int f_et01 = jakel_make_file(dir, "et01.elf");
    if (f_et01 >= 0) {
        int b_et01 = kmalloc(831);
        if (b_et01 != 0) {
            seed_et01(b_et01);
            jakel_write(f_et01, 0, b_et01, 831);
            kfree(b_et01);
        }
    }
    int stale_et02 = jakel_lookup(dir, "et02.elf");
    if (stale_et02 >= 0) { jakel_remove(stale_et02); }
    int f_et02 = jakel_make_file(dir, "et02.elf");
    if (f_et02 >= 0) {
        int b_et02 = kmalloc(1921);
        if (b_et02 != 0) {
            seed_et02(b_et02);
            jakel_write(f_et02, 0, b_et02, 1921);
            kfree(b_et02);
        }
    }
    int stale_et03 = jakel_lookup(dir, "et03.elf");
    if (stale_et03 >= 0) { jakel_remove(stale_et03); }
    int f_et03 = jakel_make_file(dir, "et03.elf");
    if (f_et03 >= 0) {
        int b_et03 = kmalloc(492);
        if (b_et03 != 0) {
            seed_et03(b_et03);
            jakel_write(f_et03, 0, b_et03, 492);
            kfree(b_et03);
