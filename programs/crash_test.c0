//
// Takes the CPU exception its argument names, so verify_crash.sh can check
// that a faulting program ends alone and the system carries on. div divides
// by zero, null reads address 0 (kernel memory, a protection fault), wild
// reads an address nothing maps, gp reads a non-canonical address, one past
// the lower half, and heap runs an instruction it wrote into its own heap,
// which may not be run. jit does the same on a page it made runnable with
// protect() first, which works and returns 9. wcode writes into its own
// code, which may only be run, and rundata runs a string, which may only be
// read and written. deaf asks for Alt+W as a key and then never reads a key,
// for verify_alt_w.sh. The port kinds are for verify_ports.sh and run a few
// bytes of port I/O from a page made runnable, since coff refuses inb and
// outb in ring 3. port reads port 0x70, kbdport the keyboard controller
// status at 0x64, diskport the disk error register at 0x1F1, highport the
// disk alternate status at 0x3F6, and postport writes a zero to 0x80. None of
// them changes a device. A read that goes through returns 256 plus the byte
// read, a write that goes through returns 512. tf and badrsp are for
// verify_tf_syscall.sh. tf sets the trap flag and then makes a syscall, and
// badrsp makes a syscall with its stack pointer at 0, which the kernel may
// not return to. flags sets DF, AC and NT and asks for IOPL 3 before a
// syscall, then prints which of them it finds set after it. spin makes
// syscalls for two seconds, so a test can send NMIs while it runs. tfbusy
// starts spin in the background first and then does what tf does, so another
// task is runnable when the trap stops this one.
include "moon.c0";

int str_same(int a, int b) {
    int i = 0;
    for (i = 0; load8(a + i) == load8(b + i); i += 1) {
        if (load8(a + i) == 0) { return 1; }
    }
    return 0;
}

// Prints a line to the serial log, so a test can read it.
int serial_line(int text) {
    int n = 0;
    while (load8(text + n) != 0) { n += 1; }
    return syscall(1, text, n, 0, 0, 0);
}

// Writes n in decimal at buf and returns the byte after it.
int put_num(int buf, int n) {
    int digits = alloc(24);
    int k = 0;
    if (n == 0) { store8(digits, 48); k = 1; }
    while (n > 0) { store8(digits + k, 48 + n % 10); n = n / 10; k += 1; }
    while (k > 0) { k -= 1; store8(buf, load8(digits + k)); buf += 1; }
    return buf;
}

// Copies text to buf and returns the byte after it.
int put_text(int buf, int text) {
    int i = 0;
    while (load8(text + i) != 0) { store8(buf, load8(text + i)); buf += 1; i += 1; }
    return buf;
}

int flags_probe() {
    int raw = alloc(8192);
    int page = (raw + 4095) & (0 - 4096);
    int msg = page + 256;
    int i = 0;
    int text = "flags syscall ran\n";
    while (load8(text + i) != 0) { store8(msg + i, load8(text + i)); i += 1; }
    store8(msg + i, 0);
    int c = page;
    // pushfq; pop rcx; or rcx, DF|NT|AC|IOPL3; push rcx; popfq
    store8(c + 0, 0x9C);
    store8(c + 1, 0x59);
    store8(c + 2, 0x48); store8(c + 3, 0x81); store8(c + 4, 0xC9); store32(c + 5, 0x47400);
    store8(c + 9, 0x51);
    store8(c + 10, 0x9D);
    // mov rax, 1 (SYS_DEBUG_PRINT)
    store8(c + 11, 0x48); store8(c + 12, 0xC7); store8(c + 13, 0xC0); store32(c + 14, 1);
    // mov rdi, msg (movabs)
    store8(c + 18, 0x48); store8(c + 19, 0xBF); store64(c + 20, msg);
    // mov rsi, 18
    store8(c + 28, 0x48); store8(c + 29, 0xC7); store8(c + 30, 0xC6); store32(c + 31, 18);
    // syscall
    store8(c + 35, 0x0F); store8(c + 36, 0x05);
    // pushfq; pop rax, the flags SYSRET returned with
    store8(c + 37, 0x9C);
    store8(c + 38, 0x58);
    // push 0x202; popfq, so the c0 code after it runs with plain flags
    store8(c + 39, 0x68); store32(c + 40, 0x202);
    store8(c + 44, 0x9D);
    // ret
    store8(c + 45, 0xC3);
    protect(page, 1, 0);
    int code = page;
    int fl = code();
    int out = alloc(128);
    int p = put_text(out, "flags df=");
    p = put_num(p, (fl >> 10) & 1);
    p = put_text(p, " ac=");
    p = put_num(p, (fl >> 18) & 1);
    p = put_text(p, " nt=");
    p = put_num(p, (fl >> 14) & 1);
    p = put_text(p, " iopl=");
    p = put_num(p, (fl >> 12) & 3);
    p = put_text(p, " tf=");
    p = put_num(p, (fl >> 8) & 1);
    p = put_text(p, "\n");
    store8(p, 0);
    serial_line(out);
    return 0;
}

int spin() {
    int start = clock(1, 0);
    int calls = 0;
    while (clock(1, 0) - start < 2000) { calls += 1; }
    int out = alloc(64);
    int p = put_text(out, "spin ok ");
    p = put_num(p, calls);
    p = put_text(p, " syscalls\n");
    store8(p, 0);
    serial_line(out);
    return 0;
}

int run_port(int op, int port) {
    int raw = alloc(8192);
    int page = (raw + 4095) & (0 - 4096);
    int done = 256;
    if (op == 0xEE) { done = 512; }
    // xor eax, eax
    store8(page, 0x31);
    store8(page + 1, 0xC0);
    // mov dx, port
    store8(page + 2, 0x66);
    store8(page + 3, 0xBA);
    store8(page + 4, port & 255);
    store8(page + 5, (port >> 8) & 255);
    // in al, dx or out dx, al
    store8(page + 6, op);
    // or eax, done then ret
    store8(page + 7, 0x0D);
    store32(page + 8, done);
    store8(page + 12, 0xC3);
    protect(page, 1, 0);
    int code = page;
    return code();
}

int main() {
    if (argc() < 2) { return 1; }
    int kind = argv(1);
    print("crash test ");
    print(kind);
    print("\n");
    int zero = argc() - 2;
    if (str_same(kind, "div")) { return 7 / zero; }
    if (str_same(kind, "null")) { return load64(zero); }
    if (str_same(kind, "wild")) { return load64(0x7000000000 + zero); }
    if (str_same(kind, "gp")) { return load64(0x800000000000 + zero); }
    if (str_same(kind, "wcode")) {
        int here = str_same;
        store8(here + zero, 0x90);
        return 1;
    }
    if (str_same(kind, "rundata")) {
        int ret = "\t";        // 0x09, and the ret after it is written in
        store8(ret, 0xC3);
        return ret();
    }
    if (str_same(kind, "flags")) { return flags_probe(); }
    if (str_same(kind, "spin")) { return spin(); }
    if (str_same(kind, "port")) { return run_port(0xEC, 0x70); }
    if (str_same(kind, "kbdport")) { return run_port(0xEC, 0x64); }
    if (str_same(kind, "diskport")) { return run_port(0xEC, 0x1F1); }
    if (str_same(kind, "highport")) { return run_port(0xEC, 0x3F6); }
    if (str_same(kind, "postport")) { return run_port(0xEE, 0x80); }
    if (str_same(kind, "deaf")) {
        close_key(1);
        while (1) { sleep(100); }
    }
    if (str_same(kind, "heap") || str_same(kind, "jit")) {
        int raw = alloc(8192);
        int page = (raw + 4095) & (0 - 4096);
        // mov eax, 9 then ret
        store8(page, 0xB8);
        store32(page + 1, 9);
        store8(page + 5, 0xC3);
        if (str_same(kind, "jit")) { protect(page, 1, 0); }
        int code = page;
        return code();
    }
    if (str_same(kind, "tfbusy")) { spawn_with("test/crash.elf spin", 1); }
    if (str_same(kind, "tf") || str_same(kind, "tfbusy")) {
        int raw = alloc(8192);
        int page = (raw + 4095) & (0 - 4096);
        int msg = page + 256;
        int i = 0;
        int text = "tf syscall ok\n";
        while (load8(text + i) != 0) { store8(msg + i, load8(text + i)); i += 1; }
        store8(msg + i, 0);
        int c = page;
        // mov rax, 1 (SYS_DEBUG_PRINT)
        store8(c + 0, 0x48); store8(c + 1, 0xC7); store8(c + 2, 0xC0); store32(c + 3, 1);
        // mov rdi, msg (movabs)
        store8(c + 7, 0x48); store8(c + 8, 0xBF); store64(c + 9, msg);
        // mov rsi, 14
        store8(c + 17, 0x48); store8(c + 18, 0xC7); store8(c + 19, 0xC6); store32(c + 20, 14);
        // pushfq; pop rcx; or rcx, 0x100; push rcx; popfq
        store8(c + 24, 0x9C);
        store8(c + 25, 0x59);
        store8(c + 26, 0x48); store8(c + 27, 0x81); store8(c + 28, 0xC9); store32(c + 29, 0x100);
        store8(c + 33, 0x51);
        store8(c + 34, 0x9D);
        // syscall
        store8(c + 35, 0x0F); store8(c + 36, 0x05);
        // mov rdi, 0; mov rax, 0; syscall (exit)
        store8(c + 37, 0x48); store8(c + 38, 0xC7); store8(c + 39, 0xC7); store32(c + 40, 0);
        store8(c + 44, 0x48); store8(c + 45, 0xC7); store8(c + 46, 0xC0); store32(c + 47, 0);
        store8(c + 51, 0x0F); store8(c + 52, 0x05);
        protect(page, 1, 0);
        int code = page;
        return code();
    }
    if (str_same(kind, "badrsp")) {
        int raw = alloc(8192);
        int page = (raw + 4095) & (0 - 4096);
        int msg = page + 256;
        int i = 0;
        int text = "badrsp syscall ran\n";
        while (load8(text + i) != 0) { store8(msg + i, load8(text + i)); i += 1; }
        store8(msg + i, 0);
        int c = page;
        // mov rax, 1 (SYS_DEBUG_PRINT)
        store8(c + 0, 0x48); store8(c + 1, 0xC7); store8(c + 2, 0xC0); store32(c + 3, 1);
        // mov rdi, msg (movabs)
        store8(c + 7, 0x48); store8(c + 8, 0xBF); store64(c + 9, msg);
        // mov rsi, 19
        store8(c + 17, 0x48); store8(c + 18, 0xC7); store8(c + 19, 0xC6); store32(c + 20, 19);
        // xor esp, esp
        store8(c + 24, 0x31); store8(c + 25, 0xE4);
        // syscall
        store8(c + 26, 0x0F); store8(c + 27, 0x05);
        // ud2, reached only when the kernel returns to the zero stack
        store8(c + 28, 0x0F); store8(c + 29, 0x0B);
        protect(page, 1, 0);
        int code = page;
        return code();
    }
    return 1;
}
