// expect: 12
// The file builtins under coff --elf, Moonshot's SYS_OPEN (23), SYS_READ
// (24), SYS_WRITE (25) and SYS_CLOSE (26). They are what lets coff and smed
// run here unchanged. Each check that holds adds one.

int same(int a, int b, int n) {
    int i = 0;
    for (i = 0; i < n; i += 1) {
        if (load8(a + i) != load8(b + i)) { return 0; }
    }
    return 1;
}

int main() {
    int ok = 0;
    int buf = alloc(64);

    // 1-2. A new file, written in two pieces that land one after the other.
    int w = open_write("test/et18.txt");
    if (w >= 3) { ok += 1; }
    if (write(w, "hello ", 6) == 6 && write(w, "moon", 4) == 4) { ok += 1; }
    // 3. Closing frees the fd, and a closed fd is refused.
    if (close(w) == 0 && write(w, "x", 1) == 0 - 1) { ok += 1; }

    // 4-5. Read back in pieces, from where the last read ended.
    int r = open_read("test/et18.txt");
    if (read(r, buf, 6) == 6 && same(buf, "hello ", 6) == 1) { ok += 1; }
    if (read(r, buf, 64) == 4 && same(buf, "moon", 4) == 1) { ok += 1; }
    // 6. The end of the file reads 0.
    if (read(r, buf, 64) == 0) { ok += 1; }
    // 7. A file opened for reading cannot be written.
    if (write(r, "x", 1) == 0 - 1) { ok += 1; }
    close(r);

    // 8. Opening for writing empties the file.
    w = open_write("test/et18.txt");
    write(w, "ab", 2);
    close(w);
    r = open_read("test/et18.txt");
    if (read(r, buf, 64) == 2 && same(buf, "ab", 2) == 1) { ok += 1; }
    close(r);

    // 9. A missing file cannot be opened for reading.
    if (open_read("test/no_such_file") == 0 - 1) { ok += 1; }
    // 10. Nor can a directory.
    if (open_read("test") == 0 - 1) { ok += 1; }
    // 11. fd 1 is the console, and an fd that was never opened is refused.
    if (write(1, "", 0) == 0 && read(7, buf, 1) == 0 - 1) { ok += 1; }

    // 12. Eight fds at once and no more, each its own.
    int fds = alloc(9 * 8);
    int i = 0;
    int distinct = 1;
    for (i = 0; i < 9; i += 1) { store64(fds + i * 8, open_read("test/et18.txt")); }
    for (i = 0; i < 8; i += 1) {
        if (load64(fds + i * 8) != 3 + i) { distinct = 0; }
    }
    if (distinct == 1 && load64(fds + 64) == 0 - 1) { ok += 1; }
    for (i = 0; i < 8; i += 1) { close(load64(fds + i * 8)); }

    return ok;
}
