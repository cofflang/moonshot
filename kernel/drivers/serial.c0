// serial.c0 -- COM1 output, one byte at a time via outb. serial_init sets
// the 16550 up the way real hardware needs it, 115200 baud, 8 data bits, no
// parity, one stop bit, FIFOs on, and checks the chip in loopback mode
// first. Automated testing reads the serial log, so this stays the
// verification channel alongside the real graphical output
// (see vga.c0/punkt.c0).

int SERIAL_PORT = 0x3f8;

// 1 once serial_init found a working UART. Until then, and on a machine
// without one, serial_putc writes without waiting, which is what QEMU has
// always accepted and costs nothing where there is no chip to wait for.
int serial_ready = 0;

// Programs COM1 and proves it answers. In loopback mode the chip feeds what
// it sends straight back to its own receiver, so a byte written and read
// back unchanged means there is a working 16550 at the port. Returns 1, or
// 0 when there is not, in which case the port is left alone.
int serial_init() {
    int b = SERIAL_PORT;
    outb(b + 1, 0x00);   // no UART interrupts, this driver polls
    outb(b + 3, 0x80);   // DLAB on, the next two writes are the divisor
    outb(b + 0, 0x01);   // divisor 1, 115200 baud
    outb(b + 1, 0x00);
    outb(b + 3, 0x03);   // DLAB off, 8 bits, no parity, one stop bit
    outb(b + 2, 0xC7);   // FIFOs on and cleared, 14-byte trigger level
    outb(b + 4, 0x1E);   // loopback, RTS, OUT1, OUT2
    outb(b + 0, 0xAE);
    int i = 0;
    while (i < 100000 && (inb(b + 5) & 1) == 0) { i += 1; }
    if (inb(b + 0) != 0xAE) { return 0; }
    outb(b + 4, 0x0F);   // normal operation, DTR, RTS, OUT1, OUT2
    serial_ready = 1;
    return 1;
}

// Real hardware needs the transmitter to have room before each byte. An
// empty transmit register (line status bit 5) means the whole 16-byte FIFO
// is free, so the status is read once per sixteen bytes rather than before
// every one. Each read is a trip out of the guest under QEMU, and the kernel
// logs a lot. The wait is bounded, so a UART that stops answering costs a
// moment rather than a hung kernel.
int serial_room = 0;

void serial_putc(int c) {
    if (serial_ready == 1) {
        if (serial_room == 0) {
            int i = 0;
            while (i < 100000 && (inb(SERIAL_PORT + 5) & 32) == 0) { i += 1; }
            serial_room = 16;
        }
        serial_room -= 1;
    }
    outb(SERIAL_PORT, c);
    return;
}

void serial_print(int msg) {
    int i = 0;
    for (i = 0; load8(msg + i) != 0; i += 1) {
        serial_putc(load8(msg + i));
    }
    return;
}

// Prints v as unsigned hex, no 0x prefix. Like serial_print_int it keeps
// no digits in memory, each nibble is shifted out of v as it is printed, so
// an interrupt handler printing in the middle cannot change what this prints.
void serial_print_hex(int v) {
    if (!v) { serial_putc('0'); return; }
    int k = 15;
    while (((v >> (k * 4)) & 15) == 0) { k -= 1; }
    while (k >= 0) {
        int d = (v >> (k * 4)) & 15;
        if (d < 10) { serial_putc('0' + d); }
        else { serial_putc('a' + d - 10); }
        k -= 1;
    }
    return;
}

// Prints v in decimal. The digits are not kept in a buffer, they come from
// dividing by a power of ten as they are printed, since the keyboard and
// timer handlers print numbers too, and one landing in the middle of
// another's digits would rewrite the ones not printed yet. v is worked on
// as a negative number, which every int has, -2^63 included.
void serial_print_int(int v) {
    if (v < 0) { serial_putc('-'); }
    else { v = 0 - v; }
    int p = 1;
    while (v / p <= 0 - 10) { p *= 10; }
    while (p > 0) {
        serial_putc('0' - (v / p) % 10);
        p /= 10;
    }
    return;
}
