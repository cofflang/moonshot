int jt = 0;
int jc = 0;
int quant = 0;
int component_count = 0;
int maxh = 0;
int maxv = 0;
int cols = 0;
int rows = 0;
int progressive = 0;
int restart = 0;
int eob = 0;
int jpeg_byte() {
