// expect: 42
// exit() from deep inside nested loops and conditionals.
//
// print() and exit() are builtins compiled by the same backend, and a
// program that keeps running after exit() looks like a print loop that
// never ends, so the exit has to be checked from deep inside.
int main() {
    int i;
    int j;
    i = 0;
    while (i < 10) {
        if (i > 2) {
            if (i > 3) {
                j = 0;
                while (j < 10) {
                    if (j == 4) {
                        if (i == 4) {
                            exit(42);
                        }
                    }
                    j += 1;
                }
            }
        }
        i += 1;
    }
    // Reaching here at all means the exit above did not take.
    return 99;
}
