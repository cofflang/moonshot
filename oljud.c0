//
// oljud -- the Sound Blaster 16 driver. Ring 3 hands it PCM, it plays it.
//
// The SB16 is an ISA card, which is the reason it was picked over AC'97 and
// HDA, since everything is at fixed addresses, so there is no PCI bus to walk.
// The DSP sits at 0x220, the card raises IRQ 5 (vector 37 after pic_remap),
// and the samples reach it through the ISA DMA controller on 16-bit channel 5.
// Those are the card's factory defaults and QEMU's `-device sb16` defaults.
//
// Programs hand it 8-bit unsigned mono at 22050 Hz, where 128 is silence.
// That is enough for a piano roll, and every ring-3 program can build it
// with store8 and nothing else. The card plays 16-bit signed, because
// several programs can sound at once and their samples are added together.
// In 8 bits two loud ones would clip; in 16 there are eight bits of headroom.
// Each sample becomes (s - 128) * 256, so one program alone sounds exactly
// as it would through an 8-bit card.
//
// How playback works. The DMA controller can only reach the first 16MB of
// physical memory, and a 16-bit channel cannot cross a 128KB boundary, so
// the card reads from two contiguous pages taken from pmm at boot, checked
// to sit inside one 128KB block. They are a ring of two halves. The DMA
// runs in auto-init mode, so it wraps around them forever with no help from
// the CPU, and the DSP is told the block size is one half, so it raises
// IRQ 5 each time it finishes a half. By then it is reading the OTHER half,
// so oljud_irq refills the one just finished, mixing whatever every
// program has queued, with silence where nothing is. Playback starts at
// boot and never stops. An idle card plays silence, which costs one
// interrupt every 93ms.
//
// Every task has its own 64KB queue (about three seconds of sound) between
// its syscalls and the interrupt. SYS_SOUND copies into the caller's queue
// and returns how many bytes fit, so a program that has more to say tries
// again later, and sound(0, -1) empties the caller's queue and silences the
// card at once. Two programs playing at once are heard together. A queue
// is emptied when its task is spawned or reaped, so a program that dies
// mid-song stops sounding.
//
// The latency is the queue's depth plus up to two halves (about 190ms) for a
// sample submitted to an empty queue.

int OLJUD_RESET  = 0x226;  // write 1, wait, write 0 to reset the DSP
int OLJUD_READ   = 0x22A;  // DSP read data
int OLJUD_WRITE  = 0x22C;  // DSP write command/data; bit 7 on read = busy
int OLJUD_STATUS = 0x22E;  // bit 7 = data waiting
int OLJUD_ACK16  = 0x22F;  // reading it acks a 16-bit IRQ

int OLJUD_RATE  = 22050;
int OLJUD_HALF  = 2048;    // samples per half of the DMA ring, one IRQ each
int OLJUD_QSIZE = 65536;   // one task's queue, about three seconds
int OLJUD_QPAGES = 16;

int oljud_active = 0;      // 1 once the card is found and playing
int oljud_dma = 0;         // the DMA ring, two pages (physical = virtual)
int oljud_q = 0;           // the queues, MAX_TASKS of them back to back
int oljud_qhead_base = 0;  // per task, where its next byte to play is
int oljud_qcount_base = 0; // per task, how many bytes it has waiting
int oljud_mix = 0;         // one half's worth of mixed samples, as ints
int oljud_irqs = 0;        // halves finished, which also says which half is next
int oljud_played = 0;      // queue bytes mixed into the DMA ring, ever

// Takes the DMA ring and the queues. Runs early in main, right after jakel's
// arena, and takes contiguous runs from the top of pmm. It is done whether
// or not there is a card (that is not known yet), and costs about half a
// megabyte of the machine's 128MB.
void oljud_mem_init() {
    oljud_dma = pmm_alloc_run(2);
    // A 16-bit DMA transfer cannot cross a 128KB boundary. A run that does
    // is given up and the next one taken, which is clear of it.
    if (oljud_dma != 0 && (oljud_dma >> 17) != ((oljud_dma + 8191) >> 17)) {
        oljud_dma = pmm_alloc_run(2);
    }
    oljud_q = pmm_alloc_run(OLJUD_QPAGES * MAX_TASKS);
    oljud_qhead_base = kmalloc(MAX_TASKS * 8);
    oljud_qcount_base = kmalloc(MAX_TASKS * 8);
    oljud_mix = kmalloc(OLJUD_HALF * 8);
    if (!oljud_qhead_base || !oljud_qcount_base || !oljud_mix) {
        oljud_q = 0;
        return;
    }
    int t = 0;
    for (t = 0; t < MAX_TASKS; t += 1) { oljud_task_reset(t); }
    return;
}

// Empties task tid's queue. chrone calls it when a slot is spawned into and
// when it is reaped.
void oljud_task_reset(int tid) {
    if (!oljud_qhead_base) { return; }
    store64(oljud_qhead_base + tid * 8, 0);
    store64(oljud_qcount_base + tid * 8, 0);
    return;
}

// Waits until the DSP will take a byte, then writes it. Returns 0 if the DSP
// never became ready, so a card that dies halfway through setup is reported
// rather than hung on.
int oljud_dsp_write(int v) {
    int i = 0;
    for (i = 0; i < 100000; i += 1) {
        if (inb(OLJUD_WRITE) / 128 == 0) {
            outb(OLJUD_WRITE, v);
            return 1;
        }
    }
    return 0;
}

// Waits for a byte from the DSP. Returns -1 on timeout.
int oljud_dsp_read() {
    int i = 0;
    for (i = 0; i < 100000; i += 1) {
        if (inb(OLJUD_STATUS) / 128 == 1) { return inb(OLJUD_READ); }
    }
    return 0 - 1;
}

// Fills one half of the DMA ring. Every task's queued bytes are added
// together, as 16-bit samples, and clipped to the 16-bit range, with silence
// wherever nobody has anything queued. Two samples go out per store32.
void oljud_fill(int half) {
    int i = 0;
    for (i = 0; i < OLJUD_HALF; i += 1) { store64(oljud_mix + i * 8, 0); }
    int t = 0;
    for (t = 0; t < MAX_TASKS; t += 1) {
        int count = load64(oljud_qcount_base + t * 8);
        if (count > 0) {
            int q = oljud_q + t * OLJUD_QSIZE;
            int head = load64(oljud_qhead_base + t * 8);
            int n = count;
            if (n > OLJUD_HALF) { n = OLJUD_HALF; }
            for (i = 0; i < n; i += 1) {
                int m = oljud_mix + i * 8;
                store64(m, load64(m) + ((load8(q + head) - 128) << 8));
                head = (head + 1) & (OLJUD_QSIZE - 1);
            }
            store64(oljud_qhead_base + t * 8, head);
            store64(oljud_qcount_base + t * 8, count - n);
            oljud_played += n;
        }
    }
    int dst = oljud_dma + half * OLJUD_HALF * 2;
    for (i = 0; i < OLJUD_HALF; i += 2) {
        int a = load64(oljud_mix + i * 8);
        int b = load64(oljud_mix + i * 8 + 8);
        if (a > 32767) { a = 32767; }
        if (a < 0 - 32768) { a = 0 - 32768; }
        if (b > 32767) { b = 32767; }
        if (b < 0 - 32768) { b = 0 - 32768; }
        store32(dst + i * 2, (a & 65535) | ((b & 65535) << 16));
    }
    return;
}

// Finds the card and starts it playing silence. Returns 1 if it is playing.
//
// The reset handshake is the detection, since a real DSP answers a reset with
// 0xAA, and an empty ISA slot reads back 0xFF from every port, so it never
// does.
int oljud_init() {
    if (oljud_dma == 0 || !oljud_q) { return 0; }
    if (oljud_dma + 8192 > 16777216) {
        serial_print("[oljud] DMA ring above 16MB, ISA DMA cannot reach it\n");
        return 0;
    }
    outb(OLJUD_RESET, 1);
    // The DSP wants the reset line held for at least 3 microseconds. A
    // hundred port reads take longer than that on any machine.
    int d = 0;
    for (d = 0; d < 100; d += 1) { inb(OLJUD_STATUS); }
    outb(OLJUD_RESET, 0);
    int ack = oljud_dsp_read();
    if (ack != 0xAA) {
        serial_print("[oljud] no Sound Blaster 16 at 0x220\n");
        return 0;
    }
    // DSP version 4.x is an SB16. The older cards have no 0x41 rate command
    // and no 16-bit output, so they are refused rather than half driven.
    oljud_dsp_write(0xE1);
    int major = oljud_dsp_read();
    int minor = oljud_dsp_read();
    if (major < 4) {
        serial_print("[oljud] DSP ");
        serial_print_int(major);
        serial_print(" is not a Sound Blaster 16, not using it\n");
        return 0;
    }

    oljud_fill(0);
    oljud_fill(1);

    // ISA DMA channel 5, 16-bit, on the second controller. Mask the channel
    // while it is programmed, clear the controller's byte flip-flop so the
    // low byte goes first, then the mode, 0x59 = single transfer, auto-init,
    // memory to device, channel 5. A 16-bit channel counts in words, so the
    // address register takes the address halved, the page register (0x8B for
    // channel 5) bits 16-23 of the address itself, and the count is one less
    // than the samples.
    int words = oljud_dma >> 1;
    outb(0xD4, 0x05);
    outb(0xD8, 0);
    outb(0xD6, 0x59);
    outb(0xC4, words & 255);
    outb(0xC4, (words >> 8) & 255);
    outb(0x8B, (oljud_dma >> 16) & 255);
    outb(0xC6, (2 * OLJUD_HALF - 1) & 255);
    outb(0xC6, (2 * OLJUD_HALF - 1) >> 8);
    outb(0xD4, 0x01);

    // IRQ 5 is bit 5 of the master PIC's mask. Read and clear just that bit.
    // klick writes the whole mask, and this must not undo its cascade line.
    int mask = inb(0x21);
    if (((mask >> 5) & 1) == 1) { outb(0x21, mask - 32); }
    oljud_active = 1;

    // Speaker on, output rate, then 0xB6, 16-bit output, auto-init, FIFO on.
    // Mode byte 0x10 is mono signed. The block length is one half, in
    // samples, less one.
    oljud_dsp_write(0xD1);
    oljud_dsp_write(0x41);
    oljud_dsp_write(OLJUD_RATE >> 8);
    oljud_dsp_write(OLJUD_RATE & 255);
    oljud_dsp_write(0xB6);
    oljud_dsp_write(0x10);
    oljud_dsp_write((OLJUD_HALF - 1) & 255);
    int ok = oljud_dsp_write((OLJUD_HALF - 1) >> 8);
    if (!ok) {
        serial_print("[oljud] DSP stopped answering during setup\n");
        oljud_active = 0;
        return 0;
    }
    serial_print("[oljud] Sound Blaster 16, DSP ");
    serial_print_int(major);
    serial_print(".");
    serial_print_int(minor);
    serial_print(", ");
    serial_print_int(OLJUD_RATE);
    serial_print(" Hz 16-bit mono, mixing up to ");
    serial_print_int(MAX_TASKS);
    serial_print(" programs, DMA ring ");
    serial_print_int(oljud_dma);
    serial_print("\n");
    return 1;
}

// IRQ 5, dispatched through vector 37. The DSP has finished a half and moved
// on to the other one, so this half is free to refill. Reading the 16-bit
// acknowledge port is the card's acknowledgement, and without it the card
// raises no further interrupts, while the DMA goes on looping the same ring.
void oljud_irq() {
    inb(OLJUD_ACK16);
    if (oljud_active == 1) {
        oljud_fill(oljud_irqs % 2);
        oljud_irqs += 1;
    }
    outb(0x20, 0x20);
    return;
}

// Stops the caller's sound now. It drops everything the task has queued and
// fills BOTH halves of the DMA ring with silence, including the one the card
// is reading at this moment, so even the sound already handed to the card
// stops within the card's FIFO rather than after up to two halves (190ms).
// Whatever other programs had in those halves is cut short too, a gap of at
// most that long, which is the price of stopping at once. Returns how many
// queued bytes were dropped. This is sound(0, -1).
int oljud_flush(int tid) {
    int dropped = load64(oljud_qcount_base + tid * 8);
    oljud_task_reset(tid);
    int i = 0;
    for (i = 0; i < 4 * OLJUD_HALF; i += 8) {
        store64(oljud_dma + i, 0);
    }
    return dropped;
}

// SYS_SOUND(buf, len). Queues up to len bytes from the caller's memory and
// returns how many fit. buf == 0 returns how many bytes of the caller's are
// still waiting, so a program can tell when its sound has been played, and
// buf == 0 with len -1 stops the caller's sound (oljud_flush). -1 when there
// is no card, or for a buffer outside the caller's own memory, since the
// kernel only reads through it, but reading kernel memory out of the speaker
// is still a leak.
//
// No locking, since SYSCALL clears IF on entry, so oljud_irq cannot run halfway
// through this.
int oljud_submit(int buf, int len) {
    if (!oljud_active) { return 0 - 1; }
    int tid = sched_current;
    if (buf == 0 && len < 0) { return oljud_flush(tid); }
    int count = load64(oljud_qcount_base + tid * 8);
    if (!buf) { return count; }
    if (len < 0) { return 0 - 1; }
    if (buf < USER_VIRT_BASE) {
        serial_print("[oljud] sound: refusing a non-user buffer\n");
        return 0 - 1;
    }
    int n = OLJUD_QSIZE - count;
    if (len < n) { n = len; }
    int q = oljud_q + tid * OLJUD_QSIZE;
    int tail = (load64(oljud_qhead_base + tid * 8) + count) & (OLJUD_QSIZE - 1);
    int i = 0;
    for (i = 0; i < n; i += 1) {
        store8(q + tail, load8(buf + i));
        tail = (tail + 1) & (OLJUD_QSIZE - 1);
    }
    store64(oljud_qcount_base + tid * 8, count + n);
    return n;
}
