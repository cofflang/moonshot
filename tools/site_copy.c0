int image = 0;
int nodes = 1;
int cursor = 8704;
int bytes = 0;
int length = 0;

void die(int message) {
    print("site copy refuses "); print(message); print("\n"); exit(1);
}
int equal(int a, int b) {
    int i = 0;
    while (load8(a+i) == load8(b+i)) {
        if (load8(a+i) == 0) { return 1; }
        i += 1;
    }
    return 0;
}
int read_input(int path) {
    int fd = open_read(path);
    if (fd < 0) { die("an unreadable input"); }
    int buf = alloc(1048577);
    int n = 0;
    while (n < 1048577) {
        int got = read(fd, buf+n, 1048577-n);
        if (got < 0) { close(fd); die("an input read error"); }
        if (got == 0) { break; }
        n += got;
    }
    close(fd);
    if (n > 1048576) { die("the 1 MiB site byte budget"); }
    length = n;
    return buf;
}
int make_node(int parent, int name, int type) {
    int size = 0;
    while (load8(name+size) != 0) { size += 1; }
    if (size < 1 || size > 31 || equal(name,".") || equal(name,"..")) { die("an invalid node name"); }
    int i = 1;
    while (i < nodes) {
        int entry = image+512+i*64;
        if (load64(entry+8) == parent && equal(entry+32,name)) {
            if (load64(entry) != type || type == 1) { die("a duplicate or conflicting destination"); }
            return i;
        }
        i += 1;
    }
    if (nodes >= 40) { die("the site node budget of 40 including root, reserving 88 slots"); }
    int node = nodes;
    nodes += 1;
    int entry = image+512+node*64;
    store64(entry,type); store64(entry+8,parent); store64(entry+24,size);
    for (i=0; i<size; i+=1) { store8(entry+32+i,load8(name+i)); }
    return node;
}
int destination(int path) {
    int parent = 1;
    int start = 0;
    int i = 0;
    int component = alloc(32);
    while (1) {
        int ch = load8(path+i);
        if (ch == 0 || ch == '/') {
            int size = i-start;
            if (size < 1 || size > 31) { die("an invalid destination path"); }
            int k = 0;
            for (k=0; k<size; k+=1) { store8(component+k,load8(path+start+k)); }
            store8(component+size,0);
            int type = 2;
            if (ch == 0) { type = 1; }
            parent = make_node(parent,component,type);
            if (ch == 0) { return parent; }
            start = i+1;
        } else {
            if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '.' || ch == '_' || ch == '-')) {
                die("an invalid destination character");
            }
        }
        i += 1;
        if (i > 255) { die("an overlong destination"); }
    }
    return -1;
}
int main() {
    if (argc() < 2 || (argc()-2)%2 != 0) { die("arguments, expected output and destination/input pairs"); }
    image = alloc(10485760);
    int i = 0;
    for (i=0; i<10485760; i+=1) { store8(image+i,0); }
    int magic = "JAKELBK";
    for (i=0; i<7; i+=1) { store8(image+i,load8(magic+i)); }
    store64(image+8,1); store64(image+16,128); store64(image+24,32); store64(image+32,17);
    store64(image+512,2); store64(image+536,1); store8(image+544,'/');
    if (argc() > 2) { make_node(0,"site",2); }
    int buffers = alloc(128*8);
    for (i=2; i<argc(); i+=2) {
        int node = destination(argv(i));
        int data = read_input(argv(i+1));
        if (length > 1048576-bytes) { die("the 1 MiB site byte budget"); }
        bytes += length;
        store64(image+512+node*64+16,length);
        store64(buffers+node*8,data);
    }
    for (i=1; i<nodes; i+=1) {
        int entry = image+512+i*64;
        if (load64(entry) == 1) {
            int size = load64(entry+16);
            int data = load64(buffers+i*8);
            int k = 0;
            for (k=0; k<size; k+=1) { store8(image+cursor+k,load8(data+k)); }
            cursor += ((size+511)/512)*512;
        }
    }
    store64(image+40,(cursor-8704)/512);
    int fd = open_write(argv(1));
    if (fd < 0) { die("an unwritable output"); }
    int written = 0;
    while (written < 10485760) {
        int got = write(fd,image+written,10485760-written);
        if (got <= 0) { close(fd); die("an output write error"); }
        written += got;
    }
    close(fd);
    print("site copy wrote a private disk image\n");
    return 0;
}
