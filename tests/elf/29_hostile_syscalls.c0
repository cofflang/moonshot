int c_info_arguments() {
    int b = alloc(4096);
    if (bad(syscall(34, 7, b, 128, 0, 0))) { return 1; }
    if (bad(syscall(34, 0 - 1, b, 128, 0, 0))) { return 2; }
    if (bad(syscall(34, 1 << 62, b, 128, 0, 0))) { return 3; }
    if (bad(syscall(34, 1 << 63, b, 128, 0, 0))) { return 4; }
    if (bad(syscall(34, 0, 0, 128, 0, 0))) { return 5; }
    if (bad(syscall(34, 0, p_low(), 128, 0, 0))) { return 6; }
    if (bad(syscall(34, 0, p_high(), 128, 0, 0))) { return 7; }
    if (bad(syscall(34, 0, p_noncanon(), 128, 0, 0))) { return 8; }
    if (bad(syscall(34, 0, b, 0, 0, 0))) { return 9; }
    if (bad(syscall(34, 0, b, 0 - 1, 0, 0))) { return 10; }
    if (bad(syscall(34, 0, b, 1 << 40, 0, 0))) { return 11; }
    if (bad(syscall(34, 0, b, 1 << 63, 0, 0))) { return 12; }
    if (syscall(34, 0, b, 128, 0, 0) != 128) { return 13; }
    return 0;
}

int c_kill_ids() {
    if (bad(syscall(35, 0 - 1, 0, 0, 0, 0))) { return 1; }
    if (bad(syscall(35, 8, 0, 0, 0, 0))) { return 2; }
    if (bad(syscall(35, 1 << 62, 0, 0, 0, 0))) { return 3; }
    if (bad(syscall(35, 1 << 63, 0, 0, 0, 0))) { return 4; }
    if (bad(syscall(35, 1 << 32, 0, 0, 0, 0))) { return 5; }
    return 0;
}

int c_pointer_shapes() {
    if (bad(syscall(36, 3, 0, 0, 0, 0))) { return 1; }
    if (bad(syscall(36, 0 - 1, 0, 0, 0, 0))) { return 2; }
    if (bad(syscall(36, 1 << 62, 0, 0, 0, 0))) { return 3; }
    if (bad(syscall(36, 1 << 63, 0, 0, 0, 0))) { return 4; }
    if (bad(syscall(36, 1 << 32, 0, 0, 0, 0))) { return 5; }
    syscall(36, 0, 0, 0, 0, 0);
    return 0;
}

int c_present_arguments() {
    int r = syscall(9, 0, 0, 0, 0, 0);
    if (r != 0 && r != 0 - 1) { return 1; }
    return 0;
}

int c_glyph_arguments() {
    int b = alloc(64);
    int cell = syscall(12, 'A', 0, 0, 0, 0);
    if (cell != (8 << 16) + 8) { return 1; }
    if (syscall(12, 'A', b, 0, 0, 0) != cell) { return 2; }
    if (bad(syscall(12, 'A', 8, 0, 0, 0))) { return 3; }
    if (bad(syscall(12, 'A', p_low(), 0, 0, 0))) { return 4; }
    if (bad(syscall(12, 'A', p_high(), 0, 0, 0))) { return 5; }
    if (bad(syscall(12, 'A', p_noncanon(), 0, 0, 0))) { return 6; }
    if (syscall(12, 0 - 1, b, 0, 0, 0) != cell) { return 7; }
    if (syscall(12, 1 << 63, b, 0, 0, 0) != cell) { return 8; }
    if (syscall(12, huge(), 0, 0, 0, 0) != cell) { return 9; }
    return 0;
}

int c_sound_arguments() {
    int b = alloc(64);
    syscall(14, 0, 0, 0, 0, 0);
    syscall(14, 0, 0 - 1, 0, 0, 0);
    if (syscall(14, b, 0, 0, 0, 0) > 0) { return 1; }
    if (syscall(14, b, 0 - 1, 0, 0, 0) > 0) { return 2; }
    if (syscall(14, b, 1 << 63, 0, 0, 0) > 0) { return 3; }
    if (bad(syscall(14, 8, 16, 0, 0, 0))) { return 4; }
    if (bad(syscall(14, p_low(), 16, 0, 0, 0))) { return 5; }
    if (bad(syscall(14, p_high(), 16, 0, 0, 0))) { return 6; }
    if (bad(syscall(14, p_noncanon(), 16, 0, 0, 0))) { return 7; }
    syscall(14, 0, 0 - 1, 0, 0, 0);
    return 0;
}

int c_sound_length_past_buffer() {
    int b = alloc(64);
    syscall(14, b, huge(), 0, 0, 0);
    syscall(14, 0, 0 - 1, 0, 0, 0);
    return 0;
}

// A path or line that is a pointer the program does not own, which the call
// must refuse. The second argument is what the call needs there to get as
// far as reading the path, 0 - 1 for a buffer of its own.
int path_pointer(int num, int ptr, int arg2) {
    if (arg2 == 0 - 1) { arg2 = alloc(64); }
    int r = syscall(num, ptr, arg2, 8, 0, 0);
    if (r >= 0) { return 1; }
    return 0;
}

int c_readfile_unmapped_path() {
    if (path_pointer(8, p_unmapped(), 0 - 1)) { return 1; }
    if (path_pointer(38, p_unmapped(), 0 - 1)) { return 2; }
    return 0;
}

int c_writefile_sentinel_buffer() {
    int r = syscall(15, "test/et29.tmp", p_sentinel(), 8, 0, 0);
    syscall(30, "test/et29.tmp", 0, 0, 0, 0);
    if (r != 0 - 1) { return 1; }
    return 0;
}

int c_readfile_sentinel_buffer() {
    if (syscall(8, "test/et29.can", p_sentinel(), 8, 0, 0) != 0 - 1) { return 1; }
    if (syscall(38, "test/et29.can", p_sentinel(), 8, 0, 0) != 0 - 1) { return 2; }
    return 0;
}

int c_glyph_sentinel_buffer() {
    if (syscall(12, 'A', p_sentinel(), 0, 0, 0) != 0 - 1) { return 1; }
    return 0;
}

int c_sound_sentinel_buffer() {
    if (syscall(14, p_sentinel(), 16, 0, 0, 0) > 0) { return 1; }
    return 0;
}

int c_debug_print_kernel_heap() {
    if (syscall(1, p_low(), 16, 0, 0, 0) != 0 - 1) { return 1; }
    return 0;
}

int c_debug_print_bit63() {
    if (syscall(1, p_noncanon(), 16, 0, 0, 0) != 0 - 1) { return 1; }
    return 0;
}

int c_debug_print_kernel_half() {
    if (syscall(1, p_high(), 16, 0, 0, 0) != 0 - 1) { return 1; }
    return 0;
}

int c_debug_print_unmapped() {
    if (syscall(1, p_unmapped(), 16, 0, 0, 0) != 0 - 1) { return 1; }
    return 0;
}

int c_blit_huge_rows() {
    int b = alloc(256);
    syscall(5, b, 0, 0, 4, 1 << 40);
    return 0;
}

int c_blit_unmapped_source() {
    if (syscall(5, p_unmapped(), 0, 0, 4, 4) != 0 - 1) { return 1; }
    return 0;
}

int c_present_unmapped_source() {
    if (syscall(9, p_unmapped(), 0, 0, 0, 0) != 0 - 1) { return 1; }
    return 0;
}

int c_write_offset_wrap() {
    int b = alloc(64);
    store8(b, 65);
    int fd = syscall(23, "test/et29.tmp", 1, 0, 0, 0);
    if (fd < 3) { return 1; }
    if (syscall(25, fd, b, 1, 0, 0) != 1) { return 2; }
    int r = syscall(25, fd, b, 0x7fffffffffffffff, 0, 0);
    int rd = open_read("test/et29.tmp");
    if (read(rd, b + 8, 8) != 1 || load8(b + 8) != 65) { return 3; }
    close(rd);
    store8(b, 66);
    if (syscall(25, fd, b, 1, 0, 0) != 1) { return 4; }
    syscall(26, fd, 0, 0, 0, 0);
    rd = open_read("test/et29.tmp");
    if (read(rd, b + 8, 8) != 2) { return 5; }
    if (load8(b + 8) != 65 || load8(b + 9) != 66) { return 6; }
    close(rd);
    syscall(30, "test/et29.tmp", 0, 0, 0, 0);
    if (r != 0 - 1) { return 7; }
    return 0;
}

int c_alloc_rounding_wrap() {
    int first = alloc(16);
    int p = syscall(6, 0x7ffffffffffffff9, 0, 0, 0, 0);
    int next = alloc(16);
    if (p != 0) { return 1; }
    if (next <= first) { return 2; }
    return 0;
}

int c_info_wrapping_length() {
    int b = alloc(4096);
    if (syscall(34, 0, b, 0x7ffffffffffffff0, 0, 0) != 0 - 1) { return 1; }
    if (syscall(34, 0, b, 0x7ffffffffffffff8, 0, 0) != 0 - 1) { return 2; }
    return 0;
}

// Pages whose end wraps past the top of the signed range, the first of them
// the last page below it.
int c_protect_wrapped_range() {
    if (bad(syscall(21, 0x7ffffffffffff000, 2, 1, 0, 0))) { return 1; }
    if (bad(syscall(21, 0x7fffffffffff0000, 256, 0, 0, 0))) { return 2; }
    return 0;
}

int c_wait_not_a_child() {
    if (syscall(29, 0, 1, 0, 0, 0) != 0 - 1001) { return 1; }
    if (syscall(29, 1, 1, 0, 0, 0) != 0 - 1001) { return 2; }
    return 0;
}

int run_case(int n) {
    if (n == 54) { print("debug_print_bit63"); return c_debug_print_bit63(); }
    if (n == 55) { print("debug_print_kernel_half"); return c_debug_print_kernel_half(); }
    if (n == 56) { print("debug_print_unmapped"); return c_debug_print_unmapped(); }
    if (n == 57) { print("blit_huge_rows"); return c_blit_huge_rows(); }
    if (n == 58) { print("write_offset_wrap"); return c_write_offset_wrap(); }
    if (n == 59) { print("alloc_rounding_wrap"); return c_alloc_rounding_wrap(); }
    if (n == 114) { print("wait_not_a_child"); return c_wait_not_a_child(); }
    return run_wired(n);
}

int run_wired(int n) {
    if (n == 36) { print("writefile_sentinel_buffer"); return c_writefile_sentinel_buffer(); }
    if (n == 37) { print("readfile_sentinel_buffer"); return c_readfile_sentinel_buffer(); }
    if (n == 38) { print("glyph_sentinel_buffer"); return c_glyph_sentinel_buffer(); }
    if (n == 39) { print("sound_sentinel_buffer"); return c_sound_sentinel_buffer(); }
    if (n == 40) { print("debug_print_kernel_heap"); return c_debug_print_kernel_heap(); }
    if (n == 41) { print("blit_unmapped_source"); return c_blit_unmapped_source(); }
    if (n == 42) { print("present_unmapped_source"); return c_present_unmapped_source(); }
    if (n == 43) { print("info_wrapping_length"); return c_info_wrapping_length(); }
    if (n == 44) { print("readfile_unmapped_path"); return c_readfile_unmapped_path(); }
    if (n == 45) { print("writefile_unmapped_path"); return path_pointer(15, p_unmapped(), 0 - 1); }
    if (n == 46) { print("listdir_unmapped_path"); return path_pointer(19, p_unmapped(), 0 - 1); }
    if (n == 47) { print("spawn_unmapped_line"); return path_pointer(20, p_unmapped(), 1); }
    if (n == 48) { print("edit_unmapped_path"); return path_pointer(22, p_unmapped(), 0); }
    if (n == 49) { print("open_unmapped_path"); return path_pointer(23, p_unmapped(), 0); }
    if (n == 50) { print("remove_unmapped_path"); return path_pointer(30, p_unmapped(), 0); }
    if (n == 51) { print("shell_unmapped_line"); return path_pointer(28, p_unmapped(), 0); }
    if (n == 52) { print("sound_length_past_buffer"); return c_sound_length_past_buffer(); }
    if (n == 53) { print("protect_wrapped_range"); return c_protect_wrapped_range(); }
    if (n == 33) { print("present_arguments"); return c_present_arguments(); }
    if (n == 34) { print("glyph_arguments"); return c_glyph_arguments(); }
    if (n == 35) { print("sound_arguments"); return c_sound_arguments(); }
    return run_base(n);
}

int run_base(int n) {
    if (n == 1) { print("exit_huge_code"); return c_exit_huge_code(); }
    if (n == 2) { print("exit_close_huge_code"); return c_exit_close_huge_code(); }
    if (n == 3) { print("unknown_numbers"); return c_unknown_numbers(); }
    if (n == 4) { print("debug_print_lengths"); return c_debug_print_lengths(); }
    if (n == 5) { print("no_argument_calls"); return c_no_argument_calls(); }
    if (n == 6) { print("fill_geometry"); return c_fill_geometry(); }
    if (n == 7) { print("blit_empty_and_offscreen"); return c_blit_empty_and_offscreen(); }
    if (n == 8) { print("alloc_sizes"); return c_alloc_sizes(); }
    if (n == 9) { print("dealloc_handles"); return c_dealloc_handles(); }
    if (n == 10) { print("sleep_lengths"); return c_sleep_lengths(); }
    if (n == 11) { print("argv_indices"); return c_argv_indices(); }
    if (n == 12) { print("readfile_pointers"); return c_readfile_pointers(); }
    if (n == 13) { print("readfile_lengths"); return c_readfile_lengths(); }
    if (n == 14) { print("writefile_arguments"); return c_writefile_arguments(); }
    if (n == 15) { print("listdir_arguments"); return c_listdir_arguments(); }
    if (n == 16) { print("spawn_arguments"); return c_spawn_arguments(); }
    if (n == 17) { print("protect_arguments"); return c_protect_arguments(); }
    if (n == 18) { print("edit_pointers"); return c_edit_pointers(); }
    if (n == 19) { print("open_arguments"); return c_open_arguments(); }
    if (n == 20) { print("open_exhaust"); return c_open_exhaust(); }
    if (n == 21) { print("bad_handles"); return c_bad_handles(); }
    if (n == 22) { print("read_buffers_and_lengths"); return c_read_buffers_and_lengths(); }
    if (n == 23) { print("write_buffers_and_lengths"); return c_write_buffers_and_lengths(); }
    if (n == 24) { print("remove_arguments"); return c_remove_arguments(); }
    if (n == 25) { print("shell_arguments"); return c_shell_arguments(); }
    if (n == 26) { print("wait_ids"); return c_wait_ids(); }
    if (n == 27) { print("sound_format_values"); return c_sound_format_values(); }
    if (n == 28) { print("close_key_values"); return c_close_key_values(); }
    if (n == 29) { print("clock_values"); return c_clock_values(); }
    if (n == 30) { print("info_arguments"); return c_info_arguments(); }
    if (n == 31) { print("kill_ids"); return c_kill_ids(); }
    if (n == 32) { print("pointer_shapes"); return c_pointer_shapes(); }
    print("none");
    return 0 - 2;
}

// Runs a case and prints its line for the script, 0 when it holds, the number
// of the check that did not otherwise, and -2 for a number with no case.
int report(int id) {
    if (!lbuf) { lbuf = alloc(96); }
    llen = 0;
    lput("[hostile] ");
    lnum(id);
    lput(" ");
    print(lbuf);
    int r = run_case(id);
    llen = 0;
    lput("\n[hostile] ");
    lnum(id);
    if (r == 0 - 2) { lput(" none\n"); print(lbuf); return r; }
    if (r == 0) { lput(" pass\n"); print(lbuf); return 0; }
    lput(" FAIL ");
    lnum(r);
    lput("\n");
    print(lbuf);
    return r;
}

int digits(int s) {
    if (!load8(s)) { return 0; }
    int i = 0;
    while (load8(s + i) != 0) {
        if (load8(s + i) < '0' || load8(s + i) > '9') { return 0; }
        i += 1;
    }
    return 1;
}

int number(int s) {
    int n = 0;
    int i = 0;
    while (load8(s + i) != 0) { n = n * 10 + load8(s + i) - '0'; i += 1; }
    return n;
}

int canary_byte(int i) { return (i * 7 + 3) % 251; }

int write_canary() {
    int b = alloc(256);
    int i = 0;
    for (i = 0; i < 256; i += 1) { store8(b + i, canary_byte(i)); }
    return syscall(15, "test/et29.can", b, 256, 0, 0);
}

int canary_file_intact() {
    int b = alloc(256);
    if (syscall(8, "test/et29.can", b, 256, 0, 0) != 256) { return 0; }
    int i = 0;
    for (i = 0; i < 256; i += 1) {
        if (load8(b + i) != canary_byte(i)) { return 0; }
    }
    return 1;
}

// The second copy. It holds a pattern in its heap and re-reads the canary
// file until the first copy leaves a stop file, so a hostile call that
// changed another program's memory or the filesystem is seen.
int witness() {
    int words = 512;
    int h = alloc(words * 8);
    int i = 0;
    for (i = 0; i < words; i += 1) { store64(h + i * 8, i * 1000003 + 17); }
    print("[hostile] witness ready\n");
    while (syscall(8, "test/et29.stop", 0, 0, 0, 0) < 0) {
        for (i = 0; i < words; i += 1) {
            if (load64(h + i * 8) != i * 1000003 + 17) { return 21; }
        }
        if (canary_file_intact() == 0) { return 22; }
        sleep(5);
    }
    return 77;
}

int main() {
    int mine = 0;
    if (argc() >= 2) {
        int a = argv(1);
        if (same(a, "x0") == 1) { return (1 << 40) + 5; }
        if (same(a, "x27") == 1) { exit_close((1 << 40) + 6); }
        if (same(a, "witness") == 1) { return witness(); }
        mine = digits(a);
        if (mine == 1) {
            if (write_canary() != 256) { return 90; }
            int id = number(a);
            int r = report(id);
            print("[hostile] end\n");
            if (r == 0) { return 77; }
            return r;
        }
        if (same(a, "all") != 1) { return 0; }
    } else {
        return 0;
    }
    syscall(30, "test/et29.stop", 0, 0, 0, 0);
    if (write_canary() != 256) { return 90; }
    int w = spawn_with("test/et29.elf witness", 1);
    if (w < 0) { return 91; }
    sleep(20);
    int held = 0;
    int id = 1;
    for (id = 1; id <= WIRED_LAST; id += 1) {
        if (report(id) == 0) { held += 1; }
    }
    syscall(15, "test/et29.stop", "x", 1, 0, 0);
    int code = wait_for(w, 1000);
    syscall(30, "test/et29.stop", 0, 0, 0, 0);
    int kept = 0;
    if (code == 77 && canary_file_intact() == 1) { kept = 1; }
    if (kept == 1) { print("[hostile] canary kept\n"); }
    print("[hostile] end\n");
    return held + kept;
}
